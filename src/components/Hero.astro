---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Hero Component
 *
 * @description Homepage hero section with customizable content.
 */

// ╔══════════════════════════════════════════════════════════════╗
// ║  外观配置 / Appearance                                       ║
// ║  全屏、背景、颜色、导航主题                                    ║
// ║  Fullscreen, background, colors, navigation theme            ║
// ╚══════════════════════════════════════════════════════════════╝

const fullscreen = false                    // 全屏显示 / Fill viewport
const backgroundImage = 'bg.png'           // 背景图，放 /public 下 / Background image, place in /public
const backgroundVideo = ''                 // 背景视频，放 /public 下 / Background video, place in /public
const backgroundColor = ''                 // 背景颜色，留空透明 / Background color, empty = transparent
const contentColor = '#ffffff'             // 内容颜色 / Content color
const topNavigationTheme = 'dark'          // 顶部导航配色，可选：'dark' | 'light' / Top nav theme, options: 'dark' | 'light'

// ════════════════════════════════════════════════════════════════
//  内部逻辑，一般不需要修改 / Internal logic, no need to modify
// ════════════════════════════════════════════════════════════════

const cssUrl = (value: string) => `url("${value.replace(/"/g, '\\"')}")`
const heroStyle = [
  backgroundColor ? `--hero-background-color: ${backgroundColor}` : '',
  backgroundImage ? `--hero-background-image: ${cssUrl(backgroundImage)}` : '',
  contentColor ? `--hero-content-color: ${contentColor}` : '',
]
  .filter(Boolean)
  .join('; ')
---

<section
  class:list={['hero', fullscreen ? 'section-fullscreen' : 'hero--standard']}
  data-top-navigation-theme={topNavigationTheme}
  style={heroStyle || undefined}
>
  {backgroundVideo && <video class="hero__background-video" src={backgroundVideo} autoplay muted loop playsinline aria-hidden="true" />}
  <div class="container">
    {/* 可编辑区域开始 / Editable Content Start */}

    <div class="hero__content flex flex-col items-center justify-center text-center gap-6">
      <img src="/favicon.svg" alt="Hero Artwork" class="w-24 h-24 object-contain mb-2" />
      <h3>
        Your art doesn't fit in a box
        <br />
        Neither should your website
      </h3>
      <div class="">
        <p class="text-lg">
          Palo is a minimalist Astro theme crafted
          <br class="hidden sm:inline" />
          for artists, musicians, and designers
          <br class="hidden sm:inline" />
          who refuse to look like everyone else.
        </p>
      </div>
      <Link href="https://github.com/petepapa/palo" isButton type="primary" animateOnHover animationType="boop">
        <Icon aria-hidden="true" name="lucide:star" size="1.5rem" />
        Star on GitHub
      </Link>
    </div>

    {/* 可编辑区域结束 / Editable Content End */}
  </div>
</section>

<style lang="scss">
  @layer components {
    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background-color: var(--hero-background-color, transparent);
      background-image: var(--hero-background-image, none);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .hero--standard {
      padding-block-start: calc(6rem + var(--header-height, 0px));
      padding-block-end: 6rem;
    }

    .hero > .container {
      position: relative;
      z-index: 1;
    }

    .hero__background-video {
      position: absolute;
      z-index: 0;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    .hero__content {
      color: var(--hero-content-color, inherit);
    }

  }
</style>
