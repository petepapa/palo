---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { createPageHeaderVisuals } from '@utils/pageHeaderVisuals'

/**
 * Hero Component
 *
 * @description Homepage hero section with customizable content.
 */

// ╔══════════════════════════════════════════════════════════════╗
// ║  外观配置 / Appearance                                       ║
// ║  全屏、背景、颜色、导航主题                                    ║
// ║  Fullscreen, background, colors, navigation theme            ║
// ╚══════════════════════════════════════════════════════════════╝

const fullscreen = true                    // 全屏显示 / Fill viewport
const contentColor = ''             // 内容颜色，留空自动根据主题设定 / Content color, empty for auto-theme color
const backgroundVideo = ''                 // 背景视频，放 /public 下 / Background video, place in /public
const backgroundImage = 'hero-bg.png'           // 背景图，放 /public 下 / Background image, place in /public
const backgroundColor = ''                 // 背景颜色，留空自动根据主题设定 / Background color, empty for auto-theme color
const topNavigationTheme = ''              // 顶部导航配色：'' / 'dark' / 'light' / Top nav theme
const showDivider = true                   // 显示底部分割线 / Show bottom divider

// ════════════════════════════════════════════════════════════════
//  内部逻辑，一般不需要修改 / Internal logic, no need to modify
// ════════════════════════════════════════════════════════════════

const { resolvedTopNavigationTheme, style: pageHeaderVisualStyle } = createPageHeaderVisuals({
  backgroundColor,
  backgroundImage,
  contentColor,
  topNavigationTheme,
})
const heroStyle = pageHeaderVisualStyle
  .replaceAll('--page-header-', '--hero-')
---

<section
  class:list={['hero', fullscreen ? 'section-fullscreen' : 'hero--standard', showDivider && 'hero--with-divider']}
  data-top-navigation-theme={resolvedTopNavigationTheme}
  style={heroStyle || undefined}
>
  {backgroundVideo && <video class="hero__background-video" src={backgroundVideo} autoplay muted loop playsinline aria-hidden="true" />}
  <div class="container hero__content">
    {/* 可编辑区域开始 / Editable Content Start */}

    <div class="flex flex-col items-center justify-center text-center gap-6">
      <img 
  src="/favicon.svg" 
  alt="Hero Artwork" 
  class="w-16 h-16 sm:w-24 sm:h-24 object-contain mb-2" 
/>
      <h2>
        Your art doesn't fit in a box.
        Neither should your website.
      </h2>
      <div class="w-full">
        <p class="text-2xl">
          Palo is a minimalist Astro theme crafted
          <br class="hidden sm:inline" />
          for artists, musicians, and designers
          <br class="hidden sm:inline" />
          who refuse to look like everyone else.
        </p>
      </div>
      
      <Link href="https://github.com/petepapa/palo" size="md" isButton type="primary">
        Get on Github 
        <Icon aria-hidden="true" name="ph:arrow-right" size="24" />
      </Link>

    </div>
    
    {/* 可编辑区域结束 / Editable Content End */}
  </div>
</section>

<style lang="scss">
  @layer components {
    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background-color: var(--hero-background-color, transparent);
      background-image: var(--hero-background-image, none);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .hero--standard {
      padding-block-start: calc(6rem + var(--header-height, 0px));
      padding-block-end: 6rem;
    }

    .hero--with-divider {
      border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    .hero > .container {
      position: relative;
      z-index: 1;
    }

    .hero__background-video {
      position: absolute;
      z-index: 0;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    .hero__content {
      color: var(--hero-content-color, inherit);
    }

    /* Theme-adaptive buttons (only apply when topNavigationTheme is set) */
    .hero[data-top-navigation-theme="light"] .button,
    .hero[data-top-navigation-theme="dark"] .button {
      --btn-bg: var(--hero-button-bg, var(--brand-primary)) !important;
      --btn-text: var(--hero-button-text, var(--color-neutral-100)) !important;
      background-color: var(--btn-bg) !important;
      border-color: var(--hero-button-border, var(--btn-bg)) !important;
      color: var(--btn-text) !important;
    }

    .hero[data-top-navigation-theme="light"] .button:hover,
    .hero[data-top-navigation-theme="dark"] .button:hover {
      background-color: var(--btn-text) !important;
      border-color: var(--btn-text) !important;
      color: var(--btn-bg) !important;
    }

    .hero[data-top-navigation-theme="light"] .button.button--outlined,
    .hero[data-top-navigation-theme="dark"] .button.button--outlined {
      background-color: transparent !important;
      color: var(--hero-button-text) !important;
      border-color: var(--hero-button-border) !important;
    }

    .hero[data-top-navigation-theme="light"] .button.button--outlined:hover,
    .hero[data-top-navigation-theme="dark"] .button.button--outlined:hover {
      background-color: var(--hero-button-border) !important;
      color: var(--hero-button-bg) !important;
    }
  }
</style>
