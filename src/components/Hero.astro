---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

/**
 * Hero Component
 *
 * @description Homepage hero section.
 */
// 首页 Hero 是否全屏显示：true = 撑满首屏，false = 使用普通页面间距
// Homepage hero fullscreen: true = fill the first viewport, false = use normal page spacing
const fullscreen = true

// 首页 Hero 背景图：留空 = 不使用背景图；可填 /public 下的路径，例如 '/hero.jpg'
// Homepage hero background image: empty = none; use a /public path, e.g. '/hero.jpg'
const backgroundImage = 'bg.png'

// 首页 Hero 背景视频：留空 = 不使用背景视频；可填 /public 下的路径，例如 '/hero.mp4'
// Homepage hero background video: empty = none; use a /public path, e.g. '/hero.mp4'
const backgroundVideo = ''

// 首页 Hero 背景颜色：留空 = 透明；支持任意 CSS 颜色，例如 '#111111' / 'oklch(20% 0 0)'
// Homepage hero background color: empty = transparent; accepts any CSS color, e.g. '#111111' / 'oklch(20% 0 0)'
const backgroundColor = ''

// 首页 Hero 内容颜色：留空 = 跟随主题；支持任意 CSS 颜色，例如 '#ffffff' / 'var(--foreground-color)'
// Homepage hero content color: empty = inherit theme; accepts any CSS color, e.g. '#ffffff' / 'var(--foreground-color)'
const contentColor = '#ffffff'

const cssUrl = (value: string) => `url("${value.replace(/"/g, '\\"')}")`
const heroStyle = [
  backgroundColor ? `--hero-background-color: ${backgroundColor}` : '',
  backgroundImage ? `--hero-background-image: ${cssUrl(backgroundImage)}` : '',
  contentColor ? `--hero-content-color: ${contentColor}` : '',
]
  .filter(Boolean)
  .join('; ')
---

<section class:list={['hero', fullscreen ? 'section-fullscreen' : 'py-24']} style={heroStyle || undefined}>
  {
    backgroundVideo && (
      <video class="hero__background-video" src={backgroundVideo} autoplay muted loop playsinline aria-hidden="true" />
    )
  }
  <div class="container">
    <div class="hero__content flex flex-col items-center justify-center text-center gap-6">
      <img src="/favicon.svg" alt="Hero Artwork" class="w-24 h-24 object-contain mb-2" />

      <h3>
        Your art doesn't fit in a box
        <br />
        Neither should your website
      </h3>

      <div class="w-full">
        <p class="text-lg">
          Palo is a minimalist Astro theme crafted
          <br class="hidden sm:inline" />
          for artists, musicians, and designers
          <br class="hidden sm:inline" />
          who refuse to look like everyone else.
        </p>
      </div>
      <Link href="https://github.com/petepapa/palo" isButton type="primary" animateOnHover animationType="boop">
        <Icon aria-hidden="true" name="lucide:star" size="1.5rem" />
        Star on GitHub
      </Link>
    </div>
  </div>
</section>

<style lang="scss">
  @layer components {
    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background-color: var(--hero-background-color, transparent);
      background-image: var(--hero-background-image, none);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .hero > .container {
      position: relative;
      z-index: 1;
    }

    .hero__background-video {
      position: absolute;
      z-index: 0;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    .hero__content {
      color: var(--hero-content-color, inherit);
    }

  }
</style>
