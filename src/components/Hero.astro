---
import { createPageHeaderVisuals } from '@utils/pageHeaderVisuals'

/**
 * Hero Component
 *
 * @description Reusable hero section with customizable visuals and slotted content.
 */

interface Props {
  fullscreen?: boolean
  contentColor?: string
  backgroundVideo?: string
  backgroundImage?: string
  backgroundColor?: string
  backgroundFixed?: boolean
  backgroundOverlayOpacity?: number
  topNavigationTheme?: string
  showDivider?: boolean
  paddingBlock?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8
  contentVerticalAlign?: '' | 'top' | 'center' | 'bottom'
  class?: string
}

const {
  fullscreen = true,
  contentColor = '',
  backgroundVideo = '',
  backgroundImage = '',
  backgroundColor = '',
  backgroundFixed = false,
  backgroundOverlayOpacity = 0,
  topNavigationTheme = '',
  showDivider = true,
  paddingBlock,
  contentVerticalAlign = '',
  class: className = '',
} = Astro.props

const normalizedPaddingBlock = Number(paddingBlock)
const hasCustomPaddingBlock =
  paddingBlock !== undefined &&
  Number.isFinite(normalizedPaddingBlock) &&
  normalizedPaddingBlock >= 0 &&
  normalizedPaddingBlock <= 8

const heroPaddingBlock =
  hasCustomPaddingBlock
    ? normalizedPaddingBlock === 0
      ? '0px'
      : `var(--font-size-${normalizedPaddingBlock})`
    : ''
const resolvedContentVerticalAlign =
  contentVerticalAlign === 'top' || contentVerticalAlign === 'bottom' ? contentVerticalAlign : 'center'
const heroContentAlignMap = {
  top: 'start',
  center: 'center',
  bottom: 'end',
} as const
const normalizedBackgroundOverlayOpacity = Number(backgroundOverlayOpacity)
const resolvedBackgroundOverlayOpacity =
  Number.isFinite(normalizedBackgroundOverlayOpacity)
    ? Math.min(1, Math.max(0, normalizedBackgroundOverlayOpacity))
    : 0

const { resolvedTopNavigationTheme, style: pageHeaderVisualStyle } = createPageHeaderVisuals({
  backgroundColor,
  backgroundImage,
  contentColor,
  topNavigationTheme,
})
const heroStyle = [
  pageHeaderVisualStyle.replaceAll('--page-header-', '--hero-'),
  heroPaddingBlock ? `--hero-padding-block: ${heroPaddingBlock}` : '',
  `--hero-content-align: ${heroContentAlignMap[resolvedContentVerticalAlign]}`,
  `--hero-background-overlay-opacity: ${resolvedBackgroundOverlayOpacity}`,
]
  .filter(Boolean)
  .join('; ')
---

<section
  class:list={[
    className,
    'hero',
    fullscreen ? 'section-fullscreen' : 'hero--standard',
    backgroundFixed && 'hero--background-fixed',
    showDivider && 'hero--with-divider',
  ]}
  data-top-navigation-theme={resolvedTopNavigationTheme}
  style={heroStyle || undefined}
>
  {backgroundVideo && (
    <div class="hero__background-media" aria-hidden="true">
      <video class="hero__background-video" src={backgroundVideo} autoplay muted loop playsinline />
    </div>
  )}

  {!backgroundVideo && backgroundImage && <div class="hero__background-media hero__background-image" aria-hidden="true"></div>}

  {(backgroundVideo || backgroundImage) && <div class="hero__background-overlay" aria-hidden="true"></div>}

  <div class="container hero__content">
    <slot />
  </div>
</section>

<style lang="scss">
  @layer components {
    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background-color: var(--hero-background-color, transparent);
    }

    .hero--background-fixed {
      overflow: hidden;
      overflow: clip;
      contain: paint;
      clip-path: inset(0);
      background-image: none;
    }

    .hero--standard {
      display: grid;
      place-content: var(--hero-content-align, center) center;
      padding-block-start: calc(var(--header-height, 0px) + var(--hero-padding-block, 6rem));
      padding-block-end: var(--hero-padding-block, 6rem);
    }

    .hero--with-divider {
      border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    .hero > .container {
      position: relative;
      z-index: 2;
    }

    .hero__background-media {
      position: absolute;
      z-index: 0;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      pointer-events: none;
    }

    .hero--background-fixed .hero__background-media {
      position: absolute;
      inline-size: 100vw;
      block-size: 100vh;
      transform: translate3d(0, var(--fixed-background-offset, 0px), 0);
    }

    .hero__background-video {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero__background-image {
      background-image: var(--hero-background-image, none);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .hero__background-overlay {
      position: absolute;
      z-index: 1;
      inset: 0;
      pointer-events: none;
      background-color: rgb(0 0 0 / var(--hero-background-overlay-opacity, 0));
    }

    .hero__content {
      color: var(--hero-content-color, inherit);
    }

    /* Theme-adaptive buttons (only apply when topNavigationTheme is set) */
    .hero[data-top-navigation-theme="light"] .button,
    .hero[data-top-navigation-theme="dark"] .button {
      --btn-bg: var(--hero-button-bg, var(--brand-primary)) !important;
      --btn-text: var(--hero-button-text, var(--color-neutral-100)) !important;
      background-color: var(--btn-bg) !important;
      border-color: var(--hero-button-border, var(--btn-bg)) !important;
      color: var(--btn-text) !important;
    }

    .hero[data-top-navigation-theme="light"] .button:hover,
    .hero[data-top-navigation-theme="dark"] .button:hover {
      background-color: var(--btn-text) !important;
      border-color: var(--btn-text) !important;
      color: var(--btn-bg) !important;
    }

    .hero[data-top-navigation-theme="light"] .button.button--outlined,
    .hero[data-top-navigation-theme="dark"] .button.button--outlined {
      background-color: transparent !important;
      color: var(--hero-button-text) !important;
      border-color: var(--hero-button-border) !important;
    }

    .hero[data-top-navigation-theme="light"] .button.button--outlined:hover,
    .hero[data-top-navigation-theme="dark"] .button.button--outlined:hover {
      background-color: var(--hero-button-border) !important;
      color: var(--hero-button-bg) !important;
    }
  }
</style>

<script>
  const win = window as Window & { __paloFixedBackgrounds?: boolean }

  if (!win.__paloFixedBackgrounds) {
    win.__paloFixedBackgrounds = true

    const updateFixedBackgrounds = () => {
      document
        .querySelectorAll<HTMLElement>(
          '.hero--background-fixed, .creative-section.has-fixed-background, .palo-page-header--background-fixed'
        )
        .forEach((section) => {
          section.style.setProperty('--fixed-background-offset', `${section.getBoundingClientRect().top * -1}px`)
        })
    }

    let frame = 0
    const requestUpdate = () => {
      if (frame) return
      frame = window.requestAnimationFrame(() => {
        frame = 0
        updateFixedBackgrounds()
      })
    }

    updateFixedBackgrounds()
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
    document.addEventListener('astro:page-load', updateFixedBackgrounds)
  }
</script>
