---
/**
 * ResponsiveToggle Component
 *
 * @description A toggle button for mobile navigation with animated hamburger icon
 */
interface Props {
  /**
   * Additional classes to apply to the ResponsiveToggle
   */
  class?: string
}

const { class: className } = Astro.props
---

<button class:list={[className, 'responsive-toggle']} aria-expanded="false" aria-label="Open menu navigation">
  <span>Menu</span>
  <div class="hamburger-box" aria-hidden="true">
    <span class="hamburger-line hamburger-line--top"></span>
    <span class="hamburger-line hamburger-line--middle"></span>
    <span class="hamburger-line hamburger-line--bottom"></span>
  </div>
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    // variables
    const responsiveToggle = document.querySelector('.responsive-toggle')
    if (!responsiveToggle) return
    const mobileNavigation = document.querySelector('.mobile-menu')
    if (!mobileNavigation) return

    // functions
    const openMenu = (toggle: Element) => {
      const text = toggle.querySelector('span')
      if (!text) return

      text.textContent = 'Close'
      toggle.setAttribute('aria-expanded', 'true')
      toggle.setAttribute('aria-label', 'Close menu navigation')
    }

    const closeMenu = (toggle: Element) => {
      const text = toggle.querySelector('span')
      if (!text) return

      text.textContent = 'Menu'
      toggle.setAttribute('aria-expanded', 'false')
      toggle.setAttribute('aria-label', 'Open menu navigation')
    }

    const closeMobileMenu = () => {
      if (mobileNavigation.classList.contains('show')) {
        mobileNavigation.classList.remove('show')
        closeMenu(responsiveToggle)
      }
    }

    // execution
    responsiveToggle.addEventListener('click', () => {
      mobileNavigation.classList.toggle('show')
      mobileNavigation.classList.contains('show') ? openMenu(responsiveToggle) : closeMenu(responsiveToggle)
    })

    // Close menu when window resizes to desktop width (matches nav breakpoint: 1050px)
    const mediaQuery = window.matchMedia('(min-width: 1050px)')
    const handleResize = () => {
      if (mediaQuery.matches) {
        closeMobileMenu()
      }
    }
    mediaQuery.addEventListener('change', handleResize)
  })
</script>

<style lang="scss">
  @use 'scss/base/breakpoint' as *;

  .responsive-toggle {
    display: none;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;

    span {
      margin-inline-end: var(--space-3xs);
    }

    .hamburger-box {
      position: relative;
      width: 30px;
      height: 21px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .hamburger-line {
      display: block;
      width: 100%;
      height: 2.667px;
      background-color: var(--foreground-color);
      border-radius: 2px;
      transition: all var(--animation-speed-fast) var(--cubic-bezier);
      transform-origin: center;
    }

    // Animate to X when expanded
    &[aria-expanded='true'] {
      .hamburger-line--top {
        translate: 0 9.166px;
        rotate: 45deg;
      }

      .hamburger-line--middle {
        opacity: 0;
      }

      .hamburger-line--bottom {
        translate: 0 -9.166px;
        rotate: -45deg;
      }
    }

    &:where(:hover, :focus-visible) {
      span {
        text-decoration: underline;
        text-decoration-style: wavy;
        text-decoration-thickness: 1px;
        text-underline-offset: 7px;
      }
    }
  }
</style>