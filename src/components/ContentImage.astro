---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { isImageMetadata } from '@utils/contentImages'

interface Props {
  src: string | ImageMetadata
  alt?: string
  width: number
  height: number
  class?: string
  loading?: 'lazy' | 'eager'
  decoding?: 'async' | 'auto' | 'sync'
  fadeIn?: boolean
  bgColor?: string
  aspectRatio?: string
  /**
   * 图片加载完成后，背景色是否淡出为透明
   * 适用于通栏大图 / 透明 PNG 场景，让图片透明区域透出页面背景
   * @default false
   */
  bgFadesOut?: boolean
}

const {
  src,
  alt = '',
  width,
  height,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  fadeIn = false,
  bgColor = '',
  aspectRatio,
  bgFadesOut = false,
} = Astro.props

const containerClass = fadeIn ? 'progressive-img-container' : undefined
const containerStyle: Record<string, string> = {}

if (bgColor) {
  containerStyle.backgroundColor = bgColor
}

// 自动锁死宽高比以实现 0 CLS
const finalAspectRatio = aspectRatio || (width && height ? `${width} / ${height}` : undefined)
if (finalAspectRatio) {
  containerStyle.aspectRatio = finalAspectRatio
}

// ── 自动计算 5 对响应式 srcset 宽度 ──
const responsiveWidths = (() => {
  if (!width) return undefined
  const base = width
  return [
    Math.round(base * 0.4),
    Math.round(base * 0.6),
    Math.round(base * 0.8),
    base,
    Math.round(base * 1.2),
  ].filter((w, i, arr) => w > 0 && arr.indexOf(w) === i)
})()
---

{
  fadeIn ? (
    <div class:list={[containerClass, className]} style={containerStyle}>
      {typeof src === 'string' ? (
        <img
          src={src}
          alt={alt}
          width={width}
          height={height}
          class="progressive-img-inner"
          loading={loading}
          decoding={decoding}
          data-bg-fades-out={bgFadesOut ? 'true' : undefined}
          onload="if ('decode' in this) { this.decode().then(() => { this.setAttribute('data-loaded', 'true'); if (this.dataset.bgFadesOut === 'true') { this.parentElement?.setAttribute('data-loaded', 'true'); } }).catch(() => { this.setAttribute('data-loaded', 'true'); if (this.dataset.bgFadesOut === 'true') { this.parentElement?.setAttribute('data-loaded', 'true'); } }) } else { this.setAttribute('data-loaded', 'true'); if (this.dataset.bgFadesOut === 'true') { this.parentElement?.setAttribute('data-loaded', 'true'); } }"
        />
      ) : isImageMetadata(src) ? (
        <Image
          src={src}
          alt={alt}
          width={width}
          height={height}
          widths={responsiveWidths}
          class="progressive-img-inner"
          loading={loading}
          decoding={decoding}
          data-bg-fades-out={bgFadesOut ? 'true' : undefined}
          onload="if ('decode' in this) { this.decode().then(() => { this.setAttribute('data-loaded', 'true'); if (this.dataset.bgFadesOut === 'true') { this.parentElement?.setAttribute('data-loaded', 'true'); } }).catch(() => { this.setAttribute('data-loaded', 'true'); if (this.dataset.bgFadesOut === 'true') { this.parentElement?.setAttribute('data-loaded', 'true'); } }) } else { this.setAttribute('data-loaded', 'true'); if (this.dataset.bgFadesOut === 'true') { this.parentElement?.setAttribute('data-loaded', 'true'); } }"
        />
      ) : null}
      <noscript>
        <style>
          .progressive-img-inner {
            opacity: 1 !important;
          }
        </style>
      </noscript>
    </div>
  ) : typeof src === 'string' ? (
    <img src={src} alt={alt} width={width} height={height} class={className} loading={loading} decoding={decoding} />
  ) : isImageMetadata(src) ? (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      widths={responsiveWidths}
      class={className}
      loading={loading}
      decoding={decoding}
    />
  ) : null
}

<script>
  const checkProgressiveImages = () => {
    document.querySelectorAll('.progressive-img-inner').forEach((img) => {
      if (img instanceof HTMLImageElement && img.complete) {
        const markLoaded = () => {
          img.setAttribute('data-loaded', 'true');
          if (img.dataset.bgFadesOut === 'true') {
            img.parentElement?.setAttribute('data-loaded', 'true');
          }
        };
        if ('decode' in img) {
          img.decode()
            .then(markLoaded)
            .catch(markLoaded);
        } else {
          markLoaded();
        }
      }
    });
  };

  // 页面加载后立即扫描，消除缓存图片及快速加载图片的未加载状态
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkProgressiveImages);
  } else {
    checkProgressiveImages();
  }

  // 兼容 View Transitions 或动态更新场景
  document.addEventListener('astro:page-load', checkProgressiveImages);
</script>

<style is:global>
  .progressive-img-container {
    position: relative;
    display: block;
    overflow: hidden;
    inline-size: 100%;
    block-size: 100%;
    transition: background-color 0.45s ease-out;
  }

  .progressive-img-container[data-loaded="true"] {
    background-color: transparent !important;
  }

  .progressive-img-inner {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.45s ease-out !important;
  }

  .progressive-img-inner[data-loaded="true"] {
    opacity: 1 !important;
  }
</style>