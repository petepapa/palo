---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { isImageMetadata } from '@utils/contentImages'

interface Props {
  src: string | ImageMetadata
  alt?: string
  width: number
  height: number
  class?: string
  loading?: 'lazy' | 'eager'
  decoding?: 'async' | 'auto' | 'sync'
}

const {
  src,
  alt = '',
  width,
  height,
  class: className,
  loading = 'lazy',
  decoding = 'async',
} = Astro.props
---

{
  typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      decoding={decoding}
    />
  ) : isImageMetadata(src) ? (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      decoding={decoding}
    />
  ) : null
}
