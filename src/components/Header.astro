---
import Navigation from '@components/Navigation.astro'
import LauncherConfig from '@components/LauncherConfig.astro'
import { HighContrast, ReducedMotion, SkipLink } from 'accessible-astro-components'
import themeConfig from '@config'

/**
 * Header Component
 *
 * @description A component that displays the header of the website
 */
const { layout, site } = themeConfig

// Convert opacity (0–1) to a CSS alpha value for the fixed header background
const headerBgOpacity = themeConfig.navigation?.headerBackgroundOpacity ?? layout.headerBackgroundOpacity ?? 0.75
// Blur strength for the fixed header background
const headerBgBlur = themeConfig.navigation?.headerBackgroundBlur ?? layout.headerBackgroundBlur ?? '12px'
const fixedHeader = themeConfig.navigation?.fixedHeader ?? layout.fixedHeader
const navMinHeight = themeConfig.navigation?.minHeight ?? '4.5rem'
const headerPosition = fixedHeader ? 'fixed' : 'absolute'
---

<header
  class:list={[fixedHeader && 'is-fixed', 'is-at-top']}
  style={`position: ${headerPosition}; top: 0; left: 0; right: 0; width: 100%; min-height: ${navMinHeight}; z-index: 50; --header-bg-opacity: ${headerBgOpacity}; --header-bg-blur: ${headerBgBlur}`}
>
  <SkipLink />
  <!-- Initialize preference components -->
  <div hidden>
    <HighContrast />
    <ReducedMotion />
  </div>

  <Navigation />
  {
    site.launcher && <LauncherConfig />
  }
</header>

<!-- ════════════════════════════════════════════════════════
     Critical CSS: 导航栏骨架刚体样式
     确保在外部 CSS/JS 加载前，顶栏已经完美站住位置，
     不发生 FOUC / 布局塌陷。
     ════════════════════════════════════════════════════════ -->
<style is:inline>
  /* ── 1. 导航栏容器骨架 ── */
  header {
    /* position 由内联 style 属性直接控制，此处不重复设置 */

    /* 刚性高度：在 JS 注入 is-fixed 前预先占用空间 */
    min-height: var(--nav-min-height, 6rem);
  }

  /* ── 2. 固定模式：JS 加载后 is-fixed 类追加，但这里预先埋好选择器 ── */
  header.is-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  /* ── 3. 使用 color-mix 预置背景，避免透明闪烁 ── */
  header {
    background-color: color-mix(
      in oklab,
      var(--background-color, #000) calc(var(--header-bg-opacity, 0.45) * 100%),
      transparent
    );
  }

  /* ── 4. 导航栏内部布局骨架：nav-bar 最小高度 ── */
  #main-navigation .nav-bar {
    min-block-size: var(--nav-min-height, 6rem);
  }

  /* ── 5. 确保 Logo 区域在图片加载前已有刚性尺寸 ── */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .logo-link .logo-image {
    /* 不设置 display——交由 Logo.astro 的 layered CSS 控制明暗切换 */
    width: auto;
    height: 40px;
    block-size: 40px;
    max-inline-size: 100%;
    background-color: transparent;
  }

  /* ── 6. 文本 Logo 备用样式 ── */
  .logo-link .logo-text {
    font-size: 40px;
    line-height: 1;
    text-transform: none;
    white-space: nowrap;
  }

  /* ── 7. wrapper 弹性布局骨架 - 防止导航菜单项换行塌陷 ── */
  #main-navigation > .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
  }

  #main-navigation .nav-bar {
    display: flex;
    flex: 1 1 100%;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m, 1rem);
    min-block-size: var(--nav-min-height, 6rem);
  }

  #main-navigation .wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-m, 1rem);
  }

  /* ── 8. 响应式汉堡按钮 ── */
  .responsive-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2xs, 0.25rem);
  }

  .responsive-toggle svg {
    width: 26px;
    height: 21px;
    flex-shrink: 0;
  }

</style>

<style lang="scss" is:global>
  header {
    width: 100%;
    z-index: 50;
    background-color: color-mix(in oklab, var(--background-color) calc(var(--header-bg-opacity, 0.75) * 100%), transparent);
    backdrop-filter: blur(var(--header-bg-blur, 12px));
    -webkit-backdrop-filter: blur(var(--header-bg-blur, 12px));
    transition:
      background-color 0.18s cubic-bezier(0.2, 0, 0, 1),
      backdrop-filter 0.18s cubic-bezier(0.2, 0, 0, 1);
  }

  header.is-fixed,
  header.is-menu-open {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  body:not(.has-fixed-header):has(main > :where(.hero, .palo-page-header):first-child) > header:not(.is-menu-open) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  header.is-at-top:not(.is-menu-open) {
    background-color: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
  }

  header.is-at-top[data-top-navigation-theme='light'] {
    --foreground-color: var(--color-neutral-800);
    --background-color: var(--color-neutral-100);
    --icon-color: var(--color-neutral-800);
    --link-color: var(--color-neutral-800);
    --link-hover-color: var(--color-neutral-700);
    --border-color: var(--color-neutral-900);
    --text-decoration-color: var(--color-neutral-700);
    --text-decoration-color-hover: var(--color-neutral-900);
    --outline-color: var(--color-outline-200);
    color-scheme: light;
  }

  header.is-at-top[data-top-navigation-theme='dark'] {
    --foreground-color: var(--color-neutral-100);
    --background-color: var(--color-neutral-900);
    --icon-color: var(--color-neutral-100);
    --link-color: var(--color-neutral-100);
    --link-hover-color: var(--color-neutral-200);
    --border-color: var(--color-neutral-100);
    --text-decoration-color: var(--color-neutral-100);
    --text-decoration-color-hover: var(--color-neutral-200);
    --outline-color: var(--color-outline-100);
    color-scheme: dark;
  }

  header.is-at-top[data-top-navigation-theme] {
    color: var(--foreground-color);
  }

  header.is-at-top[data-top-navigation-theme] :where(a, button, svg, .logo-text) {
    color: var(--foreground-color);
  }

  header.is-menu-open {
    background-color: var(--background-color);
    backdrop-filter: blur(var(--header-bg-blur, 12px));
    -webkit-backdrop-filter: blur(var(--header-bg-blur, 12px));
  }

  body.has-fixed-header main {
    padding-top: var(--header-height);
  }

  body.has-fixed-header #main-content {
    scroll-margin-top: var(--header-height);
  }
</style>

<script define:vars={{ fixedHeader }}>
  /**
   * Dynamically measures the fixed header height and sets
   * --header-height on :root so content padding follows suit.
   */
  function observeHeaderHeight() {
    const header = /** @type {HTMLElement} */ (document.querySelector('header'))
    if (!header) return

    document.body.classList.toggle('has-fixed-header', Boolean(fixedHeader))

    const setHeight = () => {
      document.documentElement.style.setProperty('--header-height', header.offsetHeight + 'px')
    }

    setHeight()

    window.__paloHeaderResizeObserver?.disconnect()
    const ro = new ResizeObserver(setHeight)
    ro.observe(header)
    window.__paloHeaderResizeObserver = ro
  }

  const initHeaderHeight = () => {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', observeHeaderHeight, { once: true })
    } else {
      observeHeaderHeight()
    }
  }

  function initHeaderScrollState() {
    const header = /** @type {HTMLElement} */ (document.querySelector('header'))
    if (!header) return

    const syncHeaderScrollState = () => {
      const headerHeight = header.offsetHeight || 1
      const isAtTop = !fixedHeader || window.scrollY <= headerHeight
      const topNavigationSource = /** @type {HTMLElement | null} */ (document.querySelector('main [data-top-navigation-theme]'))
      const topNavigationTheme = topNavigationSource?.dataset.topNavigationTheme

      header.classList.toggle('is-at-top', isAtTop)

      if (isAtTop && (topNavigationTheme === 'light' || topNavigationTheme === 'dark')) {
        header.dataset.topNavigationTheme = topNavigationTheme
      } else {
        delete header.dataset.topNavigationTheme
      }

      // 派发自定义事件，通知下拉菜单更新样式
      window.dispatchEvent(new CustomEvent('palo:header-theme-change'))
    }

    window.__paloHeaderScrollController?.abort()
    const controller = new AbortController()
    window.__paloHeaderScrollController = controller

    syncHeaderScrollState()
    window.addEventListener('scroll', syncHeaderScrollState, { passive: true, signal: controller.signal })
    window.addEventListener('resize', syncHeaderScrollState, { passive: true, signal: controller.signal })
  }

  const initHeader = () => {
    initHeaderHeight()
    initHeaderScrollState()
  }

  document.addEventListener('astro:page-load', initHeader)
  document.addEventListener('astro:after-swap', initHeader)
  initHeader()
</script>

<style lang="scss" is:global>
  @use 'scss/base/breakpoint' as *;

  @layer overrides {
    header {
      li.type-icon {
        display: block;

        @include breakpoint('nav') {
          translate: 0 4px;
        }

        button {
          border: none !important;
          border-radius: 0;
        }

        svg {
          inline-size: 30px;
          block-size: 30px;
        }
      }

      li.type-icon ~ li.type-icon {
        @include breakpoint('nav') {
          margin-inline-start: calc(var(--space-2xs) * -1);
        }
      }

      li.desktop-launcher {
        display: none;
      }

      @include breakpoint('nav') {
        li.desktop-launcher {
          display: block;
        }
      }
    }
  }
</style>