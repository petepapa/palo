---
import ContentImage from '@components/ContentImage.astro'
import type { ImageMetadata } from 'astro'
import { Avatar, Breadcrumbs, BreadcrumbsItem, Button, Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import sanitizeHtml from 'sanitize-html'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import config from '@config'
import { getDominantColor } from '@utils/imageColor'
import { isPngImage, type ResolvedImage } from '@utils/contentImages'
import { getContrastBgColor } from '@utils/pngTheme'
import defaultCover from '../assets/images/posts/default.png'

type Author = {
  name: string
  image: string
  bio: string
}

type DividerPlacement = '' | 'top' | 'bottom' | 'both' | 'none'

type CoverImagePosition = boolean | 'top' | 'head' | 'bottom'

type Props = {
  class?: string
  coverImage?: ImageMetadata | string
  title: string
  subtitle?: string
  author?: Author
  authorImageResolved?: ResolvedImage
  breadcrumbs?: boolean
  customBreadcrumbLabels?: Record<string, string>
  joinLastBreadcrumb?: boolean
  source?: string
  liveDemo?: string
  divider?: DividerPlacement
  coverImagePosition?: CoverImagePosition
  headingLevel?: string
  descClass?: string
}

// 📖 从 config.yaml 读取 PostHeader 全局默认值
const postHeaderDefaults = config.components?.postHeader ?? {}

// ⚡ 空字符串拦截 + Zod catch sentinel 检测：
// 当 Astro 传入空 string 或 Zod Schema 因 frontmatter 无效而 catch 回退时，
// 视为未设置 → 回退至 config.yaml 默认值
function resolveStringProp<T>(prop: any, configDefault: T, fallback: T): T {
  return (prop === '' || prop === undefined || prop === null) ? (configDefault ?? fallback) : (prop as T)
}

/**
 * Zod catch sentinel 检测：
 * Content Collection 的 Zod Schema 会对无效字段做 .catch(sentinel)。
 * 如果传入值 === Zod 默认值，但 config.yaml 有不同配置，则优先使用 config.yaml，
 * 因为用户大概率没有在 frontmatter 中显式设置该值。
 */
function preferConfigOverZodCatch<T>(prop: T, configDefault: T | undefined, zodDefault: T): T {
  // 如果 prop 等于 Zod 默认值（即可能是 catch 回退），且 config.yaml 有显式配置且不同
  if (prop === zodDefault && configDefault !== undefined && configDefault !== zodDefault) {
    return configDefault
  }
  return prop
}

const _props = Astro.props as Props

const className = _props.class
const title = _props.title
const subtitle = _props.subtitle
const coverImage = _props.coverImage
const authorImageResolved = _props.authorImageResolved

// ── 合并并统一提取封面图/默认图的主色调 ──
const finalImage = coverImage || defaultCover
const dominantColor = await getDominantColor(finalImage)

// ── PNG 检测：加载时主色调占位，加载完成后平滑过渡到反差色 ──
const isPng = isPngImage(finalImage)

// PostHeader 属于全宽大图流：
//   PNG 图片：bgColor=主色调（占位），loadedBgColor=反差色（衬托）
//   非 PNG 图片：bgColor=主色调（占位），loadedBgColor=透明（透出页面背景）
const contrastBg = isPng ? getContrastBgColor(dominantColor) : null
const bgColor = dominantColor
const loadedBgColor = isPng ? contrastBg!.cssVar : 'transparent'

const author = _props.author
const customBreadcrumbLabels = _props.customBreadcrumbLabels
const joinLastBreadcrumb = _props.joinLastBreadcrumb ?? false
const source = _props.source
const liveDemo = _props.liveDemo

// ── 识别 Zod catch sentinel —— 若前值 = Zod 默认值，优先采用 config.yaml ──
const rawBreadcrumbs = _props.breadcrumbs ?? postHeaderDefaults.showBreadcrumbs ?? true
const breadcrumbs = preferConfigOverZodCatch(rawBreadcrumbs, postHeaderDefaults.showBreadcrumbs, true)

const rawDivider = resolveStringProp(_props.divider, postHeaderDefaults.divider, 'both') as DividerPlacement
const divider = preferConfigOverZodCatch(rawDivider, postHeaderDefaults.divider, 'both')

const rawCoverImagePosition = resolveStringProp(_props.coverImagePosition, postHeaderDefaults.coverImagePosition, 'head') as boolean | 'top' | 'head' | 'bottom'
const coverImagePosition = preferConfigOverZodCatch(rawCoverImagePosition, postHeaderDefaults.coverImagePosition, 'head')

const headingLevel = _props.headingLevel || postHeaderDefaults.headingLevel || 'h2'
const descClass = _props.descClass || postHeaderDefaults.descClass || 'text-lg'

const formatSegment = (segment: string): string => {
  if (customBreadcrumbLabels?.[segment]) {
    return customBreadcrumbLabels[segment]
  }

  return segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
}

const resolveDividerPlacement = (value: DividerPlacement = 'both'): 'top' | 'both' | 'bottom' | 'none' => {
  if (value === 'none' || value === '') return 'none'
  if (value === 'top') return 'top'
  if (value === 'both') return 'both'
  return 'bottom'
}

const resolveCoverImagePosition = (value: CoverImagePosition = true): 'top' | 'head' | 'bottom' | false => {
  if (value === false) return false
  if (value === 'bottom') return 'bottom'
  if (value === 'head') return 'head'
  return 'top'
}

const dividerPlacement = resolveDividerPlacement(divider)
const coverImagePlacement = resolveCoverImagePosition(coverImagePosition)
const shouldShowCoverImage = !!finalImage && !!coverImagePlacement
const isCoverImageTop = shouldShowCoverImage && coverImagePlacement === 'top'
const isCoverImageHead = shouldShowCoverImage && coverImagePlacement === 'head'
const isCoverImageBottom = shouldShowCoverImage && coverImagePlacement === 'bottom'

const coverImageClass = 'w-full h-full object-cover'

const sanitizedSubtitle: string = subtitle
  ? sanitizeHtml(subtitle, {
      allowedTags: ['b', 'i', 'em', 'strong', 'a', 'span', 'br'],
      allowedAttributes: {
        a: ['href', 'title', 'target', 'rel'],
        span: ['class'],
      },
    })
  : ''

const coverImageBgStyle = `background-color: ${bgColor} !important;`
---

<style is:inline define:vars={{ bgColor }}>
  .post-header__image {
    background-color: var(--bgColor) !important;
  }
  .post-header__image .progressive-img-container {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
    block-size: 100% !important;
    position: relative !important;
    background-color: var(--bgColor) !important;
    overflow: hidden !important;
    aspect-ratio: auto !important;
  }
  .post-header__image .progressive-img-inner:not([src]) {
    opacity: 0 !important;
  }
</style>

<section
  class:list={[
    className,
    'post-header',
    (dividerPlacement === 'top' || dividerPlacement === 'both') && 'post-header--with-divider-top',
    (dividerPlacement === 'bottom' || dividerPlacement === 'both') && 'post-header--with-divider-bottom',
  ]}
>
  {isCoverImageTop && (
    <div class="post-header__image" style={coverImageBgStyle}>
      <ContentImage src={finalImage} alt="" width={1600} height={900} class={coverImageClass} loading="eager" decoding="async" fadeIn={true} bgColor={bgColor} loadedBgColor={loadedBgColor} />
    </div>
  )}

  {breadcrumbs && (
    <div class="container my-3">
      <Breadcrumbs>
        <BreadcrumbsItem href="/" label="Home" hasIcon>
          <Icon aria-hidden="true" name="ph:house" slot="icon" />
        </BreadcrumbsItem>
        {(() => {
          const path = Astro.url.pathname
          const segments = path.split('/').filter(Boolean)

          return segments.map((segment, index) => {
            if (joinLastBreadcrumb && index === segments.length - 1) {
              return null
            }

            const url = ensureTrailingSlash(`/${segments.slice(0, index + 1).join('/')}`)
            const isLast = index === segments.length - 1 || (joinLastBreadcrumb && index === segments.length - 2)

            const formattedName = (() => {
              if (joinLastBreadcrumb && isLast) {
                const prevSegment = segments[segments.length - 2]
                const lastSegment = segments[segments.length - 1]
                return `${formatSegment(prevSegment)}: ${formatSegment(lastSegment)}`
              }
              return formatSegment(segment)
            })()

            const label = isLast && customBreadcrumbLabels?.['current']
              ? customBreadcrumbLabels['current']
              : formattedName

            return (
              <BreadcrumbsItem href={isLast ? undefined : url} label={label} currentPage={isLast} />
            )
          })
        })()}
      </Breadcrumbs>
    </div>
  )}

  {isCoverImageHead && (
    <div class="post-header__image post-header__image--head" style={coverImageBgStyle}>
      <ContentImage src={finalImage} alt="" width={1600} height={900} class={coverImageClass} loading="eager" decoding="async" fadeIn={true} bgColor={bgColor} loadedBgColor={loadedBgColor} />
    </div>
  )}

  <div class="post-header__divider"></div>

  <div class="py-10">
    <div class="space-content container">
      <Heading level={headingLevel}>{title}</Heading>
      {sanitizedSubtitle && <p class={descClass} class:list={['mt-4']} set:html={sanitizedSubtitle} />}
      
      <div class="post-header__meta">
        <div class="post-header__author">
          {author?.name && authorImageResolved && (
            <div class="avatar shape-round type-default">
              <div class="image">
                <ContentImage src={authorImageResolved} alt={author.name} width={80} height={80} loading="eager" decoding="async" />
              </div>
              <div class="content">
                <p class="title">{author.name}</p>
                <p class="subtitle" set:text={author.bio} />
              </div>
            </div>
          )}
          {author?.name && !authorImageResolved && (
            <Avatar title={author.name} subtitle={author.bio} />
          )}
        </div>
        {(source || liveDemo) && (
          <div class="post-header__actions">
            <div class="post-header__links">
              {source && (
                <a href={source} target="_blank" rel="noopener noreferrer">
                  <Button>Source</Button>
                </a>
              )}
              {liveDemo && (
                <a href={liveDemo} target="_blank" rel="noopener noreferrer">
                  <Button>Live Demo</Button>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  {isCoverImageBottom && (
    <div class="post-header__image post-header__image--bottom" style={coverImageBgStyle}>
      <ContentImage src={finalImage} alt="" width={1600} height={900} class={coverImageClass} loading="eager" decoding="async" fadeIn={true} bgColor={bgColor} loadedBgColor={loadedBgColor} />
    </div>
  )}
</section>

<style lang="scss">
  @layer components {
    .post-header {
      .post-header__divider {
        border-block-end: 1px solid var(--border-color-subtle);
      }

      .post-header__meta {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .post-header__author {
        justify-self: start;
      }

      .post-header__actions {
        justify-self: end;
      }

      .post-header__links {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        a {
          text-decoration: none;
        }
      }

      .post-header__image {
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        width: 100vw;
        max-width: 100vw;
        height: 60vh !important;
        min-height: 60dvh !important;
        overflow: hidden;
      }

      .post-header__image--head {
        margin-block-start: 0;
      }

      .post-header__image--bottom {
        border-block-start: 1px solid var(--border-color-subtle);
      }

      .post-header__image > img {
        border-radius: 0;
      }

      &--with-divider-top {
        border-block-start: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
      }

      &--with-divider-bottom {
        border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
      }

      @media (max-width: 768px) {
        .post-header__meta {
          grid-template-columns: 1fr;
        }

        .post-header__author {
          justify-self: start;
        }

        .post-header__actions {
          justify-self: start;
          margin-top: 1rem;
        }
      }

      .post-header__author .avatar {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
      }

      .post-header__author .avatar .image {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        aspect-ratio: 1;
        width: 5rem;
        height: 5rem;
        overflow: clip;
        border-radius: 50%;
      }

      .post-header__author .avatar .image picture {
        display: flex;
        width: 100%;
        height: 100%;
      }

      .post-header__author .avatar .image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .post-header__author .avatar .content {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
      }

      .post-header__author .avatar .title {
        margin: 0;
        font-weight: 500;
        font-size: 1rem;
      }

      .post-header__author .avatar .subtitle {
        margin: 0;
        font-size: 0.875rem;
        color: var(--color-neutral-500, #6b7280);
      }
    }
  }
</style>
