---
import ContentImage from '@components/ContentImage.astro'
import type { ImageMetadata } from 'astro'
import { Avatar, Breadcrumbs, BreadcrumbsItem, Button, Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import sanitizeHtml from 'sanitize-html'
import { ensureTrailingSlash } from '@utils/trailingSlash'

type Author = {
  name: string
  image: string
  bio: string
}

type DividerPlacement = boolean | 'top' | 'both' | 'bottom'

type CoverImagePosition = boolean | 'top' | 'head' | 'bottom'

type Props = {
  class?: string
  coverImage?: ImageMetadata | string
  title: string
  subtitle?: string
  author?: Author
  showBreadcrumbs?: boolean
  customBreadcrumbLabels?: Record<string, string>
  joinLastBreadcrumb?: boolean
  source?: string
  liveDemo?: string
  showDivider?: DividerPlacement
  coverImagePosition?: CoverImagePosition
}

const {
  class: className,
  title,
  subtitle,
  coverImage,
  author,
  showBreadcrumbs = true,
  customBreadcrumbLabels,
  joinLastBreadcrumb = false,
  source,
  liveDemo,
  showDivider = true,
  coverImagePosition = 'head',
} = Astro.props as Props

const formatSegment = (segment: string): string => {
  if (customBreadcrumbLabels?.[segment]) {
    return customBreadcrumbLabels[segment]
  }

  return segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
}

const resolveDividerPlacement = (value: DividerPlacement = true): 'top' | 'both' | 'bottom' | false => {
  if (value === false) return false
  if (value === 'top') return 'top'
  if (value === 'both') return 'both'
  return 'bottom'
}

const resolveCoverImagePosition = (value: CoverImagePosition = true): 'top' | 'head' | 'bottom' | false => {
  if (value === false) return false
  if (value === 'bottom') return 'bottom'
  if (value === 'head') return 'head'
  return 'top'
}

const dividerPlacement = resolveDividerPlacement(showDivider)
const coverImagePlacement = resolveCoverImagePosition(coverImagePosition)
const shouldShowCoverImage = !!coverImage && !!coverImagePlacement
const isCoverImageTop = shouldShowCoverImage && coverImagePlacement === 'top'
const isCoverImageHead = shouldShowCoverImage && coverImagePlacement === 'head'
const isCoverImageBottom = shouldShowCoverImage && coverImagePlacement === 'bottom'

const coverImageClass = 'w-full h-[min(60vh,520px)] object-cover'

const sanitizedSubtitle: string = subtitle
  ? sanitizeHtml(subtitle, {
      allowedTags: ['b', 'i', 'em', 'strong', 'a', 'span', 'br'],
      allowedAttributes: {
        a: ['href', 'title', 'target', 'rel'],
        span: ['class'],
      },
    })
  : ''
---

<section
  class:list={[
    className,
    'post-header',
    (dividerPlacement === 'top' || dividerPlacement === 'both') && 'post-header--with-divider-top',
    (dividerPlacement === 'bottom' || dividerPlacement === 'both') && 'post-header--with-divider-bottom',
  ]}
>
  {isCoverImageTop && coverImage && (
    <div class="post-header__image">
      <ContentImage src={coverImage} alt="" width={1600} height={900} class={coverImageClass} />
    </div>
  )}

  {showBreadcrumbs && (
    <div class="container my-3">
      <Breadcrumbs>
        <BreadcrumbsItem href="/" label="Home" hasIcon>
          <Icon aria-hidden="true" name="ph:house" slot="icon" />
        </BreadcrumbsItem>
        {(() => {
          const path = Astro.url.pathname
          const segments = path.split('/').filter(Boolean)

          return segments.map((segment, index) => {
            if (joinLastBreadcrumb && index === segments.length - 1) {
              return null
            }

            const url = ensureTrailingSlash(`/${segments.slice(0, index + 1).join('/')}`)
            const isLast = index === segments.length - 1 || (joinLastBreadcrumb && index === segments.length - 2)

            const formattedName = (() => {
              if (joinLastBreadcrumb && isLast) {
                const prevSegment = segments[segments.length - 2]
                const lastSegment = segments[segments.length - 1]
                return `${formatSegment(prevSegment)}: ${formatSegment(lastSegment)}`
              }
              return formatSegment(segment)
            })()

            const label = isLast && customBreadcrumbLabels?.['current']
              ? customBreadcrumbLabels['current']
              : formattedName

            return (
              <BreadcrumbsItem href={isLast ? undefined : url} label={label} currentPage={isLast} />
            )
          })
        })()}
      </Breadcrumbs>
    </div>
  )}

  {isCoverImageHead && coverImage && (
    <div class="post-header__image post-header__image--head">
      <ContentImage src={coverImage} alt="" width={1600} height={900} class={coverImageClass} />
    </div>
  )}

  <div class="post-header__divider"></div>

  <div class="py-10">
    <div class="space-content container">
      <Heading level="h2">{title}</Heading>
      {sanitizedSubtitle && <p class="text-lg mt-4" set:html={sanitizedSubtitle} />}
      
      <div class="post-header__meta">
        <div class="post-header__author">
          {author?.name && (
            <Avatar title={author.name} {...(author.image && { img: author.image })} subtitle={author.bio} />
          )}
        </div>
        {(source || liveDemo) && (
          <div class="post-header__actions">
            <div class="post-header__links">
              {source && (
                <a href={source} target="_blank" rel="noopener noreferrer">
                  <Button>Source</Button>
                </a>
              )}
              {liveDemo && (
                <a href={liveDemo} target="_blank" rel="noopener noreferrer">
                  <Button>Live Demo</Button>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  {isCoverImageBottom && coverImage && (
    <div class="post-header__image post-header__image--bottom">
      <ContentImage src={coverImage} alt="" width={1600} height={900} class={coverImageClass} />
    </div>
  )}
</section>

<style lang="scss">
  @layer components {
    .post-header {
      .post-header__divider {
        border-block-end: 1px solid var(--border-color-subtle);
      }

      .post-header__meta {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .post-header__author {
        justify-self: start;
      }

      .post-header__actions {
        justify-self: end;
      }

      .post-header__links {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        a {
          text-decoration: none;
        }
      }

      .post-header__image {
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        width: 100vw;
        max-width: 100vw;
        overflow: hidden;
      }

      .post-header__image--head {
        margin-block-start: 0;
      }

      .post-header__image--bottom {
        border-block-start: 1px solid var(--border-color-subtle);
      }

      .post-header__image > img {
        border-radius: 0;
      }

      &--with-divider-top {
        border-block-start: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
      }

      &--with-divider-bottom {
        border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
      }

      @media (max-width: 768px) {
        .post-header__meta {
          grid-template-columns: 1fr;
        }

        .post-header__author {
          justify-self: start;
        }

        .post-header__actions {
          justify-self: start;
          margin-top: 1rem;
        }
      }
    }
  }
</style>