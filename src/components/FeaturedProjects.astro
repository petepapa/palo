---
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { resolveCollectionCoverImage } from '@utils/contentImages'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'

type FeaturedProjectLayout = 'standard' | 'overlay'

type SortBy = 'latest' | 'earliest'

/**
 * FeaturedProjects Component
 *
 * @description A component that displays featured projects from Astro Content Collections
 */
interface Props {
  /**
   * Additional classes to apply to the section
   */
  class?: string
  /**
   * The number of projects to display
   * @default 3
   */
  limit?: number
  /**
   * The title for the section
   * @default "Featured projects"
   */
  title?: string
  /**
   * Project card layout
   * @default "standard"
   */
  layout?: FeaturedProjectLayout
  /**
   * Project list width
   * @default "container"
   */
  projectListWidth?: ProjectListWidth
  /**
   * Project list gap class
   * @default "gap-12"
   */
  projectListGapClass?: string
  /**
   * Sort projects by: latest (newest first), earliest (oldest first)
   * @default "latest"
   */
  sortBy?: SortBy
}

const {
  class: className,
  limit = 3,
  title = 'Featured projects',
  layout = 'standard',
  projectListWidth = 'container',
  projectListGapClass = 'gap-12',
  sortBy = 'latest',
} = Astro.props
const projectListWidthClass = getProjectListWidthClass(projectListWidth)
const projectListGapSize = resolveTailwindGapClass(projectListGapClass)
const isOverlayLayout = layout === 'overlay'
const isFullWidthList = projectListWidth === 'full'

const listBaseClasses = [
  isOverlayLayout
    ? 'featured-projects__masonry'
    : 'grid grid-cols-1 list-none p-0 md:grid-cols-2 lg:grid-cols-3',
  projectListWidthClass,
  projectListGapClass,
]

// Get projects from content collection
const projects = await getCollection('projects')

// Sort projects based on sortBy parameter
const sortedProjects = [...projects].sort((a, b) => {
  switch (sortBy) {
    case 'latest':
      return (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0)
    case 'earliest':
      return (a.data.publishDate?.valueOf() || 0) - (b.data.publishDate?.valueOf() || 0)
    default:
      return (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0)
  }
})

// Limit projects and add featured images
const featuredProjects = sortedProjects.slice(0, limit).map((project) => ({
  ...project,
  featuredImage: resolveCollectionCoverImage(
    project.data.coverImage,
    project.id,
    'projects',
    getProjectTypeDefaultImage(project.data.type),
  ),
}))
---

<section class:list={[className, 'my-8']}>
  {
    isFullWidthList ? (
      <>
        <div class="container">
          <Heading level="h2" class="mb-8">{title}</Heading>
        </div>
        <ul class:list={listBaseClasses} style={`--featured-projects-gap: ${projectListGapSize}`}>
          {
            featuredProjects.map((project) => (
              <li class:list={[isOverlayLayout && 'featured-projects__masonry-item']}>
                <ProjectCard project={project} image={project.featuredImage} layout={layout} />
              </li>
            ))
          }
        </ul>
        <div class="container mt-12 flex justify-end">
          <Link href={ensureTrailingSlash('/portfolio')} isButton animateOnHover animationType="nudge">
            View all projects
            <Icon aria-hidden="true" name="ph:arrow-right" size="1.5rem" />
          </Link>
        </div>
      </>
    ) : (
      <div class="container">
        <Heading level="h2" class="mb-8">{title}</Heading>
        <ul class:list={listBaseClasses} style={`--featured-projects-gap: ${projectListGapSize}`}>
          {
            featuredProjects.map((project) => (
              <li class:list={[isOverlayLayout && 'featured-projects__masonry-item']}>
                <ProjectCard project={project} image={project.featuredImage} layout={layout} />
              </li>
            ))
          }
        </ul>
        <div class="mt-12 flex justify-end">
          <Link href={ensureTrailingSlash('/portfolio')} isButton animateOnHover animationType="nudge">
            View all projects
            <Icon aria-hidden="true" name="ph:arrow-right" size="1.5rem" />
          </Link>
        </div>
      </div>
    )
  }
</section>

<style lang="scss">
  @layer components {
    .featured-projects__masonry {
      column-count: 1;
      column-gap: var(--featured-projects-gap, var(--space-m, 1.5rem));
      column-fill: balance;
      list-style: none;
      margin: 0;
      padding-block: 0;
      max-inline-size: 100%;
    }

    .featured-projects__masonry-item {
      display: inline-block;
      box-sizing: border-box;
      inline-size: 100%;
      max-inline-size: 100%;
      vertical-align: top;
      break-inside: avoid;
      -webkit-column-break-inside: avoid;
      page-break-inside: avoid;
      margin: 0;
      padding-block: 0 var(--featured-projects-gap, var(--space-m, 1.5rem));
      padding-inline: 0;
      backface-visibility: hidden;
    }

    .featured-projects__masonry-item > .project-card {
      inline-size: 100%;
      max-inline-size: 100%;
    }

    @media (min-width: 640px) {
      .featured-projects__masonry {
        column-count: 2;
      }
    }

    @media (min-width: 1024px) {
      .featured-projects__masonry {
        column-count: 3;
      }
    }
  }
</style>
