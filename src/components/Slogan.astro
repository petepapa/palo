---
/**
 * Slogan Component
 *
 * @description A versatile component for displaying brand slogans with multiple variants
 */
interface Props {
  text: string;
  as?: 'div' | 'p' | 'h1' | 'h2' | 'h3' | '';
  variant?: 'default' | 'inline' | 'marquee';
  class?: string;
  speed?: 'slow' | 'normal' | 'fast';
  direction?: 'left' | 'right';
}

const {
  text,
  as = 'div',
  variant = 'default',
  class: className = '',
  speed = 'normal',
  direction = 'left'
} = Astro.props;

const Tag = as || 'div';

const speedMap = {
  slow: 25,
  normal: 10,
  fast: 5
};

const animationSpeed = speedMap[speed as keyof typeof speedMap] || speedMap.normal;
const isRight = direction === 'right';

const inlineId = `slogan-inline-${Math.random().toString(36).substr(2, 9)}`;
---

{variant === 'marquee' ? (
  <Tag
    class={`palo-marquee-wrapper palo-marquee-${direction} ${className}`}
    data-speed={animationSpeed}
  >
    <div class="palo-marquee-track">
      <span class="palo-marquee-item">{text}</span>
      <span class="palo-marquee-item" aria-hidden="true">{text}</span>
    </div>
  </Tag>
) : variant === 'inline' ? (
  <div class={`palo-slogan-inline-wrapper ${className}`} id={inlineId}>
    <Tag class="palo-slogan-inline" data-slogan-text={text}>
      {text}
    </Tag>
  </div>
) : (
  <Tag class={`palo-slogan-default ${className}`}>
    {text}
  </Tag>
)}

<script define:vars={{ inlineId }}>
  (function () {
    var probe = null;

    function getProbe() {
      if (!probe) {
        probe = document.createElement('span');
        probe.style.cssText = 'position:fixed;visibility:hidden;white-space:nowrap;pointer-events:none;z-index:-1';
        document.body.appendChild(probe);
      }
      return probe;
    }

    function fitTextToWidth() {
      var wrapper = document.getElementById(inlineId);
      if (!wrapper) return;

      var textEl = wrapper.querySelector('.palo-slogan-inline');
      if (!textEl) return;

      var containerWidth = wrapper.clientWidth;
      if (containerWidth <= 0) return;

      var p = getProbe();
      p.textContent = textEl.dataset.sloganText || textEl.textContent;
      if (!p.textContent || p.textContent.length === 0) return;

      p.style.fontSize = '200px';

      var cs = window.getComputedStyle(textEl);
      p.style.fontFamily = cs.fontFamily;
      p.style.fontWeight = cs.fontWeight;
      p.style.fontStyle = cs.fontStyle;
      p.style.letterSpacing = cs.letterSpacing;
      p.style.textTransform = cs.textTransform;

      var measuredWidth = p.offsetWidth;
      if (measuredWidth <= 0) return;

      textEl.style.fontSize = ((containerWidth - 1) * 200 / measuredWidth) + 'px';
    }

    function init() {
      requestAnimationFrame(function () {
        fitTextToWidth();
      });
    }

    function start() {
      document.fonts.ready.then(init);
    }

    if (document.readyState === 'complete') {
      start();
    } else {
      document.addEventListener('readystatechange', function () {
        if (document.readyState === 'complete') start();
      });
    }

    var resizeTimer;
    window.addEventListener('resize', function () {
      if (resizeTimer) cancelAnimationFrame(resizeTimer);
      resizeTimer = requestAnimationFrame(start);
    });
  })();
</script>

<style lang="scss">
  .palo-slogan-default {
    display: block;
    line-height: 1.2;
  }

  .palo-slogan-inline-wrapper {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .palo-slogan-inline {
    display: block;
    line-height: 1;
    white-space: nowrap;
    text-align: left;
    margin: 0;
  }

  /* ========== 跑马灯样式 ========== */
  .palo-marquee-wrapper {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
  }

  .palo-marquee-track {
    display: flex;
    width: max-content;
  }

  .palo-marquee-item {
    display: inline-block;
    line-height: 1;
    padding-inline: 2rem;
    flex-shrink: 0;
  }

  /* Hover 暂停 */
  .palo-marquee-wrapper:hover .palo-marquee-track {
    animation-play-state: paused;
  }

  /* 从左向右滚动 (默认) */
  .palo-marquee-left .palo-marquee-track {
    animation: marquee-left 10s linear infinite;
  }

  @keyframes marquee-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 从右向左滚动 */
  .palo-marquee-right .palo-marquee-track {
    animation: marquee-right 10s linear infinite;
  }

  @keyframes marquee-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* 速度控制 */
  .palo-marquee-wrapper[data-speed="5"] .palo-marquee-track {
    animation-duration: 5s;
  }
  .palo-marquee-wrapper[data-speed="10"] .palo-marquee-track {
    animation-duration: 10s;
  }
  .palo-marquee-wrapper[data-speed="25"] .palo-marquee-track {
    animation-duration: 25s;
  }

  /* 无障碍：减少动态效果 */
  @media (prefers-reduced-motion: reduce) {
    .palo-marquee-wrapper {
      overflow-x: auto;
    }
    .palo-marquee-wrapper .palo-marquee-track {
      animation: none;
    }
  }
</style>
