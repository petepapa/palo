---
// src/components/CreativeSection.astro
import { normalizePublicAssetUrl } from '@utils/pageHeaderVisuals'

type DividerPlacement = boolean | '' | 'top' | 'both' | 'bottom' | '上方' | '上下' | '下方' | 'true' | 'false'

interface Props {
  /**
   * 是否全屏显示 (占满视口高度) / Whether to display fullscreen (fill viewport height)
   * @default false
   */
  fullscreen?: boolean
  /**
   * 前景内容颜色 (支持 Hex, OKLCH, CSS 变量) / Foreground text color (supports Hex, OKLCH, CSS variables)
   * 留空自动跟随 Palo 当前的主题文字颜色 / Empty to automatically follow Palo's default text color
   */
  contentColor?: string
  /**
   * 背景视频路径 (放于 /public 目录下，如 'videos/hero.mp4') / Background video path (placed under /public, e.g. 'videos/hero.mp4')
   */
  backgroundVideo?: string
  /**
   * 背景图片路径 (放于 /public 目录下，如 'images/hero.jpg') / Background image path (placed under /public, e.g. 'images/hero.jpg')
   */
  backgroundImage?: string
  /**
   * 背景颜色 (支持 Hex, OKLCH, CSS 变量) / Background color (supports Hex, OKLCH, CSS variables)
   * 留空默认透明 / Empty for transparent background by default
   */
  backgroundColor?: string
  /**
   * 背景固定不随页面滚动 / Keep background fixed while content scrolls
   * @default false
   */
  backgroundFixed?: boolean
  /**
   * 背景遮罩透明度，0 到 1 / Background overlay opacity, from 0 to 1
   * @default 0
   */
  backgroundOverlayOpacity?: number
  /**
   * 分割线位置 / Divider position.
   * 默认 true 或留空为下方；可选 top/both/bottom/false，也支持 上方/上下/下方.
   * Defaults to bottom when true or empty; accepts top/both/bottom/false.
   */
  showDivider?: DividerPlacement
  /**
   * 内容垂直位置 / Vertical content position
   * 留空等同 center，可选 top / center / bottom / Empty equals center; accepts top / center / bottom
   */
  contentVerticalAlign?: '' | 'top' | 'center' | 'bottom'
  /**
   * 是否使用 container 容器包裹内容 / Whether to wrap content in a container
   * @default true
   */
  useContainer?: boolean
  /**
   * 附加的类名 / Additional CSS classes
   */
  class?: string
}

const {
  fullscreen = false,
  contentColor = '',
  backgroundVideo = '',
  backgroundImage = '',
  backgroundColor = '',
  backgroundFixed = false,
  backgroundOverlayOpacity = 0,
  showDivider = true,
  contentVerticalAlign = '',
  useContainer = true,
  class: className = '',
} = Astro.props

const resolvedContentVerticalAlign =
  contentVerticalAlign === 'top' || contentVerticalAlign === 'bottom' ? contentVerticalAlign : 'center'
const sectionContentAlignMap = {
  top: 'flex-start',
  center: 'center',
  bottom: 'flex-end',
} as const
const resolveDividerPlacement = (value: DividerPlacement = true): 'top' | 'both' | 'bottom' | false => {
  const normalizedValue = typeof value === 'string' ? value.trim().toLowerCase() : value
  if (normalizedValue === false || normalizedValue === 'false') return false
  if (normalizedValue === 'top' || normalizedValue === '上方') return 'top'
  if (normalizedValue === 'both' || normalizedValue === '上下') return 'both'
  return 'bottom'
}
const dividerPlacement = resolveDividerPlacement(showDivider)
const normalizedBackgroundOverlayOpacity = Number(backgroundOverlayOpacity)
const resolvedBackgroundOverlayOpacity =
  Number.isFinite(normalizedBackgroundOverlayOpacity)
    ? Math.min(1, Math.max(0, normalizedBackgroundOverlayOpacity))
    : 0
const resolvedBackgroundImage = normalizePublicAssetUrl(backgroundImage)
const resolvedBackgroundVideo = normalizePublicAssetUrl(backgroundVideo)

// 1. 动态 CSS 变量映射 / Dynamic CSS variables mapping
const sectionStyle = {
  '--section-bg': backgroundColor || 'transparent',
  '--section-content-align': sectionContentAlignMap[resolvedContentVerticalAlign],
  '--section-overlay-opacity': resolvedBackgroundOverlayOpacity,
  ...(contentColor ? { '--section-color': contentColor } : {}),
  ...(resolvedBackgroundImage ? { '--section-bg-image': `url("${resolvedBackgroundImage.replace(/"/g, '\\"')}")` } : {}),
}
---

<section
  class:list={[
    'creative-section',
    { 'is-fullscreen': fullscreen },
    { 'has-fixed-background': backgroundFixed },
    { 'has-divider-top': dividerPlacement === 'top' || dividerPlacement === 'both' },
    { 'has-divider-bottom': dividerPlacement === 'bottom' || dividerPlacement === 'both' },
    className
  ]}
  style={sectionStyle}
>
  <!-- 层 1: 视频或图片媒体背景 / Layer 1: Video or image background media -->
  {backgroundVideo && (
    <div class="media-container" aria-hidden="true" tabindex="-1">
      <video
        autoplay
        loop
        muted
        playsinline
        class="background-media"
      >
        <source src={resolvedBackgroundVideo} type="video/mp4" />
      </video>
    </div>
  )}

  {!backgroundVideo && backgroundImage && (
    <div 
      class="media-container bg-image-layer" 
      aria-hidden="true" 
      tabindex="-1"
    ></div>
  )}

  <!-- 层 2: 可配置半透明遮罩 (当存在背景视频或图片时启用) / Layer 2: Configurable semi-transparent backdrop overlay (enabled when video or image background is present) -->
  {(backgroundVideo || backgroundImage) && (
    <div class="section-overlay" aria-hidden="true" tabindex="-1"></div>
  )}

  <!-- 层 3: 前景内容 Slot (自动居中布局) / Layer 3: Foreground content Slot (auto-centering layout) -->
  <div class:list={['section-content', useContainer && 'container']}>
    <slot />
  </div>
</section>

<style>
  /* 运用 Palo 的 Cascade Layers 治理系统 / Integrate with Palo's CSS Cascade Layers specificity system */
  @layer components {
    .creative-section {
      position: relative;
      overflow: hidden;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: var(--section-content-align, center);
      
      /* 默认背景透明；显式设置变量以避免继承自父级的同名 custom property / Transparent by default; explicitly initialize the variable to avoid inherited overrides */
      background-color: var(--section-bg, transparent);
      color: var(--section-color, var(--color-default-text));
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    .creative-section.has-fixed-background {
      overflow: hidden;
      overflow: clip;
      clip-path: inset(0);
      background-image: none;
    }

    .creative-section.has-divider-top {
      border-block-start: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    .creative-section.has-divider-bottom {
      border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    /* 全屏显示模式 / Fullscreen display mode */
    .creative-section.is-fullscreen {
      /* 全屏高度覆盖整个视口 / Fullscreen height covers the entire viewport */
      block-size: 100vh;
      min-block-size: 100vh;
      box-sizing: border-box;
    }

    /* 媒体容器层 / Background media container layer */
    .media-container {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    .creative-section.has-fixed-background .media-container {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
    }

    .creative-section.has-fixed-background .bg-image-layer {
      display: block;
    }

    .background-media {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    /* 背景图特殊处理：防止网络慢时背景出现空白抖动 / Background image styling: prevents white block flashing during slow network loads */
    .bg-image-layer {
      background-image: var(--section-bg-image);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    /* 可配置半透明遮罩层：用于按需降低背景亮度，提高文字可读性 / Configurable overlay layer: darkens backdrop on demand to improve text readability */
    .section-overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
      background-color: rgb(0 0 0 / var(--section-overlay-opacity, 0));
      backdrop-filter: blur(1px); /* 可选：给背景带来微微的毛玻璃深邃感 / Optional: adds a subtle depth of field blur */
    }

    /* 前景内容层 / Foreground content container layout */
    .section-content {
      position: relative;
      z-index: 3;
      width: 100%;
      margin-inline: auto;
      
      /* 在全屏模式下，子元素自动垂直居中 / Enables automatic vertical alignment inside fullscreen frames */
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* 无障碍减弱动态效果 / Accessibility: motion reduction adaptations */
    @media (prefers-reduced-motion: reduce) {
      .background-media {
        display: none; /* 减弱动态偏好下，隐藏视频背景，退化为配置的背景色 / Hides video background when reduced motion is preferred, fallback to color */
      }
      .creative-section {
        transition: none !important;
      }
    }
  }
</style>
