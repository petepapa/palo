---
import { Link } from 'accessible-astro-components'
import themeConfig from '@config'
import { ensureTrailingSlash } from '@utils/trailingSlash'

/**
 * Logo Component
 *
 * @description Logo description
 */
const logoLight = themeConfig.branding.logoLight ? `/${themeConfig.branding.logoLight.replace(/^\//, '')}` : ''
const logoDark = themeConfig.branding.logoDark ? `/${themeConfig.branding.logoDark.replace(/^\//, '')}` : ''
const hasImageLogo = Boolean(logoLight || logoDark)
---

<Link href="/" class="flex items-center gap-2 logo-link">
  {
    hasImageLogo && logoLight && (
      <img
        class="logo-image logo-image--light"
        src={logoLight}
        alt={themeConfig.site.name}
        width="47"
        height="37"
        loading="eager"
        style="width: auto; height: var(--logo-size, var(--navigation-desktop-font-size, 1rem));"
      />
    )
  }
  {
    hasImageLogo && logoDark && (
      <img
        class="logo-image logo-image--dark"
        src={logoDark}
        alt={themeConfig.site.name}
        width="47"
        height="37"
        loading="eager"
        style="width: auto; height: var(--logo-size, var(--navigation-desktop-font-size, 1rem));"
      />
    )
  }
  {!hasImageLogo && (
    <span
      class="logo-text"
      style={`font-weight: var(--font-weight-heading, ${themeConfig.branding.font.weights.heading}); font-size: var(--logo-size, var(--navigation-desktop-font-size, 1rem)); text-transform: none;`}
    >
      {themeConfig.site.name}
    </span>
  )}
</Link>

<style is:global>
@layer overrides {
  .logo-link,
  .logo-link:hover,
  .logo-link:focus-visible {
    text-decoration: none !important;
  }
  .logo-link .logo-text,
  .logo-link .logo-text:hover,
  .logo-link .logo-text:focus-visible {
    text-decoration: none !important;
  }
  .logo-link .logo-image {
    display: block;
    width: auto;
    height: var(--logo-size, var(--navigation-desktop-font-size, 1rem));
    block-size: var(--logo-size, var(--navigation-desktop-font-size, 1rem));
    inline-size: auto;
    max-inline-size: 100%;
  }
  .logo-link .logo-image--dark {
    display: none;
  }
  .darkmode .logo-link .logo-image--light {
    display: none;
  }
  .darkmode .logo-link .logo-image--dark {
    display: block;
  }
  header.is-at-top[data-top-navigation-theme='light'] .logo-link .logo-image--light {
    display: block;
  }
  header.is-at-top[data-top-navigation-theme='light'] .logo-link .logo-image--dark {
    display: none;
  }
  header.is-at-top[data-top-navigation-theme='dark'] .logo-link .logo-image--light {
    display: none;
  }
  header.is-at-top[data-top-navigation-theme='dark'] .logo-link .logo-image--dark {
    display: block;
  }
  header.is-at-top[data-top-navigation-theme='light'] .darkmode-toggle .icon-light,
  header.is-at-top[data-top-navigation-theme='dark'] .darkmode-toggle .icon-dark {
    display: none;
  }
  header.is-at-top[data-top-navigation-theme='light'] .darkmode-toggle .icon-dark,
  header.is-at-top[data-top-navigation-theme='dark'] .darkmode-toggle .icon-light {
    display: flex;
  }
}
</style>
