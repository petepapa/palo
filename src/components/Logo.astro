---
import { Link } from 'accessible-astro-components'
import themeConfig from '@config'
import { ensureTrailingSlash } from '@utils/trailingSlash'

/**
 * Logo Component
 *
 * @description Logo description
 */
---

<Link href="/" class="flex items-center gap-2 logo-link">
  {
    themeConfig.branding.logo && (
      <img class="logo-image" src={themeConfig.branding.logo} alt={themeConfig.site.name} width="47" height="37" loading="eager" />
    )
  }
  {!themeConfig.branding.logo && (
    <span
      class="logo-text"
      style={`font-weight: var(--font-weight-heading, ${themeConfig.branding.font.weights.heading}); font-size: var(--logo-size, var(--navigation-desktop-font-size, 1rem)); text-transform: none;`}
    >
      {themeConfig.site.name}
    </span>
  )}
</Link>

<style is:global>
@layer overrides {
  .logo-link,
  .logo-link:hover,
  .logo-link:focus-visible {
    text-decoration: none !important;
  }
  .logo-link .logo-text,
  .logo-link .logo-text:hover,
  .logo-link .logo-text:focus-visible {
    text-decoration: none !important;
  }
  .logo-link .logo-image {
    display: block;
    width: auto !important;
    height: var(--logo-size, var(--navigation-desktop-font-size, 1rem)) !important;
    block-size: var(--logo-size, var(--navigation-desktop-font-size, 1rem)) !important;
    inline-size: auto !important;
    max-inline-size: 100%;
  }
}
</style>
