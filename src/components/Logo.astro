---
import { Link } from 'accessible-astro-components'
import themeConfig from '@config'
import { ensureTrailingSlash } from '@utils/trailingSlash'

/**
 * Logo Component
 *
 * @description Logo description
 */
---

<Link href="/" class="flex items-center gap-2">
  {
    themeConfig.branding.logo && (
      <img src={themeConfig.branding.logo} alt={themeConfig.site.name} width="47" height="37" loading="eager" />
    )
  }
  {!themeConfig.branding.logo && (
    <span class="text-sm sm:text-lg" style={`font-weight: var(--font-weight-heading, ${themeConfig.branding.font.weights.heading});`}>
      {themeConfig.site.name}
    </span>
  )}
</Link>
