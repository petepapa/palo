---
import { Link } from 'accessible-astro-components'
import themeConfig from '@config'

/**
 * Logo Component
 *
 * @description Logo description
 */
---

<Link href="/" class="flex items-center gap-2">
  {
    themeConfig.branding.logo && (
      <img src={themeConfig.branding.logo} alt="" aria-hidden="true" width="47" height="37" loading="eager" />
    )
  }
  <span class="text-sm font-bold sm:text-lg">{themeConfig.site.name}</span>
</Link>