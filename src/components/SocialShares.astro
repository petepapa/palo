---
import { Icon } from 'astro-icon/components'
import { Link, Modal } from 'accessible-astro-components'
import { shareConfig } from '../shareConfig'

interface Props {
  url?: string
  title?: string
  description?: string
}

const {
  url = Astro.url.href,
  title = '',
  description = '',
} = Astro.props

const qrCodeApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(url)}`

const wechatModalId = 'palo-wechat-share-modal'
const wechatTriggerId = 'palo-wechat-share-trigger'
---

<ul class="flex flex-wrap gap-2">
  {
    shareConfig.map((channel) => {
      if (channel.actionType === 'link' && channel.buildUrl) {
        const href = channel.buildUrl({ url, title, description })
        return (
          <li>
            <Link
              href={href}
              isButton
              isExternal
              hideIcon
              animateOnHover
              animationType="boop"
              class="button--icon-only"
            >
              <Icon aria-hidden="true" name={channel.icon} />
              <span class="sr-only">{channel.srText ?? `Share on ${channel.name}`}</span>
            </Link>
          </li>
        )
      }

      if (channel.actionType === 'modal') {
        return (
          <li>
            <Link
              href="javascript:void(0)"
              id={wechatTriggerId}
              isButton
              hideIcon
              animateOnHover
              animationType="boop"
              class="button--icon-only"
            >
              <Icon aria-hidden="true" name={channel.icon} />
              <span class="sr-only">{channel.srText ?? `Share on ${channel.name}`}</span>
            </Link>
          </li>
        )
      }

      return null
    })
  }
</ul>

<Modal triggerId={wechatTriggerId} id={wechatModalId} title="Share on WeChat" headingSize="h5">
  <div class="flex flex-col items-center justify-center px-4 pb-16 pt-16 text-center">
      <div class="mb-4 overflow-hidden rounded-lg border bg-white p-2" style="border-color: light-dark(var(--color-neutral-200), var(--color-neutral-700));">
        <img src={qrCodeApiUrl} alt="WeChat QR Code" class="h-[180px] w-[180px]" loading="lazy" />
      </div>
      <p class="font-base" style="color: light-dark(var(--color-neutral-600), var(--color-neutral-400));">
        Open WeChat, scan the QR code to share this page with friends or moments.
      </p>
    </div>
</Modal>
