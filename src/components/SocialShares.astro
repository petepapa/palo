---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

interface Props {
  url?: string
  title?: string
  description?: string
}

const {
  url = Astro.url.href,
  title = '',
  description = '',
} = Astro.props

const encodedUrl = encodeURIComponent(url)
const twitterText = title
  ? encodeURIComponent(`${title}${description ? ` - ${description}` : ''}`)
  : ''
const twitterShareUrl = twitterText
  ? `https://x.com/share?url=${encodedUrl}&text=${twitterText}`
  : `https://x.com/share?url=${encodedUrl}`
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`
---

<ul class="flex flex-wrap gap-2">
  <li>
    <Link
      href={facebookShareUrl}
      isButton
      isExternal
      hideIcon
      animateOnHover
      animationType="boop"
    >
      <Icon aria-hidden="true" name="ph:facebook-logo" size={32} />
      <span class="sr-only">Share on Facebook, opens in a new tab</span>
    </Link>
  </li>
  <li>
    <Link
      href={twitterShareUrl}
      isButton
      isExternal
      hideIcon
      animateOnHover
      animationType="boop"
    >
      <Icon aria-hidden="true" name="ph:twitter-logo" size={32} />
      <span class="sr-only">Share on X (Twitter), opens in a new tab</span>
    </Link>
  </li>
  <li>
    <Link
      href={linkedinShareUrl}
      isButton
      isExternal
      hideIcon
      animateOnHover
      animationType="boop"
    >
      <Icon aria-hidden="true" name="ph:linkedin-logo" size={32} />
      <span class="sr-only">Share on LinkedIn, opens in a new tab</span>
    </Link>
  </li>
</ul>
