---
import { Heading } from 'accessible-astro-components'
import sanitizeHtml from 'sanitize-html'
import { createPageHeaderVisuals } from '@utils/pageHeaderVisuals'

interface Props {
  class?: string
  title: string
  subtitle?: string
  fullscreen?: boolean
  backgroundImage?: string
  backgroundVideo?: string
  backgroundColor?: string
  backgroundFixed?: boolean
  backgroundOverlayOpacity?: number
  contentColor?: string
  topNavigationTheme?: string
  showDivider?: boolean
  paddingBlock?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | '0' | '1' | '2' | '3' | '4' | '5' | '6' | '7' | '8'
  contentVerticalAlign?: '' | 'top' | 'center' | 'bottom'
}

const {
  class: className,
  title,
  subtitle,
  fullscreen = false,
  backgroundImage = '',
  backgroundVideo = '',
  backgroundColor = '',
  backgroundFixed = false,
  backgroundOverlayOpacity = 0,
  contentColor = '',
  topNavigationTheme = '',
  showDivider = true,
  paddingBlock,
  contentVerticalAlign = '',
} = Astro.props

const hasPaddingBlockValue = paddingBlock !== undefined && paddingBlock !== ''
const normalizedPaddingBlock = Number(paddingBlock)
const hasCustomPaddingBlock =
  hasPaddingBlockValue &&
  Number.isFinite(normalizedPaddingBlock) &&
  normalizedPaddingBlock >= 0 &&
  normalizedPaddingBlock <= 8
const pageHeaderPaddingBlock =
  hasCustomPaddingBlock
    ? normalizedPaddingBlock === 0
      ? '0px'
      : `var(--font-size-${normalizedPaddingBlock})`
    : ''
const resolvedContentVerticalAlign =
  contentVerticalAlign === 'top' || contentVerticalAlign === 'bottom' ? contentVerticalAlign : 'center'
const pageHeaderContentAlignMap = {
  top: 'start',
  center: 'center',
  bottom: 'end',
} as const
const normalizedBackgroundOverlayOpacity = Number(backgroundOverlayOpacity)
const resolvedBackgroundOverlayOpacity =
  Number.isFinite(normalizedBackgroundOverlayOpacity)
    ? Math.min(1, Math.max(0, normalizedBackgroundOverlayOpacity))
    : 0

const { resolvedTopNavigationTheme, style: pageHeaderStyle } = createPageHeaderVisuals({
  backgroundColor,
  backgroundImage,
  contentColor,
  topNavigationTheme,
})
const resolvedPageHeaderStyle = [
  pageHeaderStyle,
  pageHeaderPaddingBlock ? `--page-header-padding-block: ${pageHeaderPaddingBlock}` : '',
  `--page-header-content-align: ${pageHeaderContentAlignMap[resolvedContentVerticalAlign]}`,
  `--page-header-background-overlay-opacity: ${resolvedBackgroundOverlayOpacity}`,
]
  .filter(Boolean)
  .join('; ')

const sanitizedSubtitle: string = subtitle
  ? sanitizeHtml(subtitle, {
      allowedTags: ['b', 'i', 'em', 'strong', 'a', 'span', 'br'],
      allowedAttributes: {
        a: ['href', 'title', 'target', 'rel'],
        span: ['class'],
      },
    })
  : ''
---

<section
  class:list={[
    className,
    'palo-page-header',
    fullscreen ? 'section-fullscreen' : 'palo-page-header--standard',
    backgroundFixed && 'palo-page-header--background-fixed',
    showDivider && 'palo-page-header--with-divider',
  ]}
  data-top-navigation-theme={resolvedTopNavigationTheme}
  style={resolvedPageHeaderStyle || undefined}
>
  {backgroundVideo && (
    <div class="palo-page-header__background-media" aria-hidden="true">
      <video class="palo-page-header__background-video" src={backgroundVideo} autoplay muted loop playsinline />
    </div>
  )}

  {!backgroundVideo && backgroundImage && (
    <div class="palo-page-header__background-media palo-page-header__background-image" aria-hidden="true"></div>
  )}

  {(backgroundVideo || backgroundImage) && <div class="palo-page-header__background-overlay" aria-hidden="true"></div>}

  <div class="container palo-page-header__content space-content">
    <Heading level="h1">{title}</Heading>
    {sanitizedSubtitle && <p class="text-lg" set:html={sanitizedSubtitle} />}
  </div>
</section>

<style lang="scss">
  @layer components {
    .palo-page-header {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background-color: var(--page-header-background-color, transparent);
    }

    .palo-page-header--background-fixed {
      overflow: hidden;
      overflow: clip;
      contain: paint;
      clip-path: inset(0);
      background-image: none;
    }

    .palo-page-header--standard {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: var(--page-header-content-align, center);
      justify-content: stretch;
      justify-items: stretch;
      padding-block-start: calc(var(--header-height, 0px) + var(--page-header-padding-block, 6rem));
      padding-block-end: var(--page-header-padding-block, 6rem);
    }

    .palo-page-header--with-divider {
      border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    .palo-page-header > .container {
      position: relative;
      z-index: 2;
      width: 100%;
      inline-size: 100%;
      max-width: none;
      max-inline-size: none;
    }

    .palo-page-header__background-media {
      position: absolute;
      z-index: 0;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      pointer-events: none;
    }

    .palo-page-header--background-fixed .palo-page-header__background-media {
      position: absolute;
      inline-size: 100vw;
      block-size: 100vh;
      transform: translate3d(0, var(--fixed-background-offset, 0px), 0);
    }

    .palo-page-header__background-video {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      object-position: center;
    }

    .palo-page-header__background-image {
      background-image: var(--page-header-background-image, none);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .palo-page-header__background-overlay {
      position: absolute;
      z-index: 1;
      inset: 0;
      pointer-events: none;
      background-color: rgb(0 0 0 / var(--page-header-background-overlay-opacity, 0));
    }

    .palo-page-header__content {
      color: var(--page-header-content-color, inherit);
    }

    .palo-page-header[data-top-navigation-theme='light'] .button,
    .palo-page-header[data-top-navigation-theme='dark'] .button {
      --btn-bg: var(--page-header-button-bg, var(--brand-primary)) !important;
      --btn-text: var(--page-header-button-text, var(--color-neutral-100)) !important;
      background-color: var(--btn-bg) !important;
      border-color: var(--page-header-button-border, var(--btn-bg)) !important;
      color: var(--btn-text) !important;
    }

    .palo-page-header[data-top-navigation-theme='light'] .button:hover,
    .palo-page-header[data-top-navigation-theme='dark'] .button:hover {
      background-color: var(--btn-text) !important;
      border-color: var(--btn-text) !important;
      color: var(--btn-bg) !important;
    }

    .palo-page-header[data-top-navigation-theme='light'] .button.button--outlined,
    .palo-page-header[data-top-navigation-theme='dark'] .button.button--outlined {
      background-color: transparent !important;
      color: var(--page-header-button-text) !important;
      border-color: var(--page-header-button-border) !important;
    }

    .palo-page-header[data-top-navigation-theme='light'] .button.button--outlined:hover,
    .palo-page-header[data-top-navigation-theme='dark'] .button.button--outlined:hover {
      background-color: var(--page-header-button-border) !important;
      color: var(--page-header-button-bg) !important;
    }
  }
</style>

<script>
  const win = window as Window & { __paloFixedBackgrounds?: boolean }

  if (!win.__paloFixedBackgrounds) {
    win.__paloFixedBackgrounds = true

    const updateFixedBackgrounds = () => {
      document
        .querySelectorAll<HTMLElement>(
          '.hero--background-fixed, .creative-section.has-fixed-background, .palo-page-header--background-fixed'
        )
        .forEach((section) => {
          section.style.setProperty('--fixed-background-offset', `${section.getBoundingClientRect().top * -1}px`)
        })
    }

    let frame = 0
    const requestUpdate = () => {
      if (frame) return
      frame = window.requestAnimationFrame(() => {
        frame = 0
        updateFixedBackgrounds()
      })
    }

    updateFixedBackgrounds()
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
    document.addEventListener('astro:page-load', updateFixedBackgrounds)
  }
</script>
