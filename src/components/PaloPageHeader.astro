---
import { Heading } from 'accessible-astro-components'
import sanitizeHtml from 'sanitize-html'
import { createPageHeaderVisuals } from '@utils/pageHeaderVisuals'

type PaddingBlock =
  | ''
  | '5xs'
  | '4xs'
  | '3xs'
  | '2xs'
  | 'xs'
  | 's'
  | 'sm'
  | 'm'
  | 'md'
  | 'l'
  | 'lg'
  | 'xl'
  | '2xl'
  | '3xl'
  | '4xl'
  | '5xl'
  | (string & {})

type DividerPlacement = boolean | '' | 'top' | 'both' | 'bottom' | '上方' | '上下' | '下方' | 'true' | 'false'

interface Props {
  class?: string
  title: string
  subtitle?: string
  fullscreen?: boolean
  backgroundImage?: string
  backgroundVideo?: string
  backgroundColor?: string
  backgroundFixed?: boolean
  backgroundOverlayOpacity?: number
  contentColor?: string
  topNavigationTheme?: string
  /**
   * 分割线位置 / Divider position.
   * 默认 true 或留空为下方；可选 top/both/bottom/false，也支持 上方/上下/下方.
   * Defaults to bottom when true or empty; accepts top/both/bottom/false.
   */
  showDivider?: DividerPlacement
  /**
   * 上下内边距 / Vertical padding.
   * 留空默认使用 var(--space-xl) / Empty defaults to var(--space-xl).
   * 支持 space token: 5xs, 4xs, 3xs, 2xs, xs, s, m, l, xl, 2xl, 3xl, 4xl, 5xl.
   * 也支持别名 sm/md/lg，以及具体 CSS 值，如 "4rem"、"48px"、"clamp(2rem, 5vw, 6rem)".
   * Supports space tokens, sm/md/lg aliases, and custom CSS values such as "4rem", "48px", or "clamp(2rem, 5vw, 6rem)".
   */
  paddingBlock?: PaddingBlock
  contentVerticalAlign?: '' | 'top' | 'center' | 'bottom'
  contentHorizontalAlign?: '' | 'left' | 'center' | 'right'
  textAlign?: '' | 'left' | 'center' | 'right'
}

const {
  class: className,
  title,
  subtitle,
  fullscreen = false,
  backgroundImage = '',
  backgroundVideo = '',
  backgroundColor = '',
  backgroundFixed = false,
  backgroundOverlayOpacity = 0,
  contentColor = '',
  topNavigationTheme = '',
  showDivider = true,
  paddingBlock,
  contentVerticalAlign = '',
  contentHorizontalAlign = 'left',
  textAlign = '',
} = Astro.props

const paddingBlockMap: Record<Exclude<PaddingBlock, ''>, string> = {
  '5xs': 'var(--space-5xs)',
  '4xs': 'var(--space-4xs)',
  '3xs': 'var(--space-3xs)',
  '2xs': 'var(--space-2xs)',
  xs: 'var(--space-xs)',
  s: 'var(--space-s)',
  sm: 'var(--space-s)',
  m: 'var(--space-m)',
  md: 'var(--space-m)',
  l: 'var(--space-l)',
  lg: 'var(--space-l)',
  xl: 'var(--space-xl)',
  '2xl': 'var(--space-2xl)',
  '3xl': 'var(--space-3xl)',
  '4xl': 'var(--space-4xl)',
  '5xl': 'var(--space-5xl)',
}
const resolvePaddingBlock = (value?: PaddingBlock): string => {
  const normalizedValue = typeof value === 'string' ? value.trim() : ''
  return normalizedValue ? (paddingBlockMap[normalizedValue] ?? normalizedValue) : 'var(--space-xl)'
}
const pageHeaderPaddingBlock = resolvePaddingBlock(paddingBlock)
const resolvedContentVerticalAlign =
  contentVerticalAlign === 'top' || contentVerticalAlign === 'bottom' ? contentVerticalAlign : 'center'
const pageHeaderContentAlignMap = {
  top: 'start',
  center: 'center',
  bottom: 'end',
} as const
const resolveDividerPlacement = (value: DividerPlacement = true): 'top' | 'both' | 'bottom' | false => {
  const normalizedValue = typeof value === 'string' ? value.trim().toLowerCase() : value
  if (normalizedValue === false || normalizedValue === 'false') return false
  if (normalizedValue === 'top' || normalizedValue === '上方') return 'top'
  if (normalizedValue === 'both' || normalizedValue === '上下') return 'both'
  return 'bottom'
}
const dividerPlacement = resolveDividerPlacement(showDivider)
const contentHorizontalAlignValue = contentHorizontalAlign || textAlign
const resolvedContentHorizontalAlign =
  contentHorizontalAlignValue === 'center' || contentHorizontalAlignValue === 'right' ? contentHorizontalAlignValue : 'left'
const pageHeaderTextAlignMap = {
  left: 'start',
  center: 'center',
  right: 'end',
} as const
const pageHeaderItemsAlignMap = {
  left: 'flex-start',
  center: 'center',
  right: 'flex-end',
} as const
const normalizedBackgroundOverlayOpacity = Number(backgroundOverlayOpacity)
const resolvedBackgroundOverlayOpacity =
  Number.isFinite(normalizedBackgroundOverlayOpacity)
    ? Math.min(1, Math.max(0, normalizedBackgroundOverlayOpacity))
    : 0

const { resolvedTopNavigationTheme, style: pageHeaderStyle } = createPageHeaderVisuals({
  backgroundColor,
  backgroundImage,
  contentColor,
  topNavigationTheme,
})
const resolvedPageHeaderStyle = [
  pageHeaderStyle,
  `--page-header-padding-block: ${pageHeaderPaddingBlock}`,
  `--page-header-content-align: ${pageHeaderContentAlignMap[resolvedContentVerticalAlign]}`,
  `--page-header-text-align: ${pageHeaderTextAlignMap[resolvedContentHorizontalAlign]}`,
  `--page-header-items-align: ${pageHeaderItemsAlignMap[resolvedContentHorizontalAlign]}`,
  `--page-header-background-overlay-opacity: ${resolvedBackgroundOverlayOpacity}`,
]
  .filter(Boolean)
  .join('; ')

const sanitizedSubtitle: string = subtitle
  ? sanitizeHtml(subtitle, {
      allowedTags: ['b', 'i', 'em', 'strong', 'a', 'span', 'br'],
      allowedAttributes: {
        a: ['href', 'title', 'target', 'rel'],
        span: ['class'],
      },
    })
  : ''
---

<section
  class:list={[
    className,
    'palo-page-header',
    fullscreen ? 'section-fullscreen' : 'palo-page-header--standard',
    backgroundFixed && 'palo-page-header--background-fixed',
    (dividerPlacement === 'top' || dividerPlacement === 'both') && 'palo-page-header--with-divider-top',
    (dividerPlacement === 'bottom' || dividerPlacement === 'both') && 'palo-page-header--with-divider-bottom',
  ]}
  data-top-navigation-theme={resolvedTopNavigationTheme}
  style={resolvedPageHeaderStyle || undefined}
>
  {backgroundVideo && (
    <div class="palo-page-header__background-media" aria-hidden="true">
      <video class="palo-page-header__background-video" src={backgroundVideo} autoplay muted loop playsinline />
    </div>
  )}

  {!backgroundVideo && backgroundImage && (
    <div class="palo-page-header__background-media palo-page-header__background-image" aria-hidden="true"></div>
  )}

  {(backgroundVideo || backgroundImage) && <div class="palo-page-header__background-overlay" aria-hidden="true"></div>}

  <div class="container palo-page-header__content space-content">
    <Heading level="h1">{title}</Heading>
    {sanitizedSubtitle && <p class="text-xl" set:html={sanitizedSubtitle} />}
  </div>
</section>

<style lang="scss">
  @layer components {
    .palo-page-header {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background-color: var(--page-header-background-color, transparent);
    }

    .palo-page-header--background-fixed {
      overflow: hidden;
      overflow: clip;
      contain: paint;
      clip-path: inset(0);
      background-image: none;
    }

    .palo-page-header--standard {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: var(--page-header-content-align, center);
      justify-content: stretch;
      justify-items: stretch;
      padding-block-start: calc(var(--header-height, 0px) + var(--page-header-padding-block, var(--space-xl)));
      padding-block-end: var(--page-header-padding-block, var(--space-xl));
    }

    .palo-page-header--with-divider-top {
      border-block-start: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    .palo-page-header--with-divider-bottom {
      border-block-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
    }

    .palo-page-header > .container {
      position: relative;
      z-index: 2;
      width: 100%;
      inline-size: 100%;
      max-width: none;
      max-inline-size: none;
    }

    .palo-page-header__background-media {
      position: absolute;
      z-index: 0;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      pointer-events: none;
    }

    .palo-page-header--background-fixed .palo-page-header__background-media {
      position: absolute;
      inline-size: 100vw;
      block-size: 100vh;
      transform: translate3d(0, var(--fixed-background-offset, 0px), 0);
    }

    .palo-page-header__background-video {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      object-position: center;
    }

    .palo-page-header__background-image {
      background-image: var(--page-header-background-image, none);
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .palo-page-header__background-overlay {
      position: absolute;
      z-index: 1;
      inset: 0;
      pointer-events: none;
      background-color: rgb(0 0 0 / var(--page-header-background-overlay-opacity, 0));
    }

    .palo-page-header__content {
      display: flex;
      flex-direction: column;
      align-items: var(--page-header-items-align, flex-start);
      text-align: var(--page-header-text-align, start);
      color: var(--page-header-content-color, inherit);
    }

    .palo-page-header[data-top-navigation-theme='light'] .button,
    .palo-page-header[data-top-navigation-theme='dark'] .button {
      --btn-bg: var(--page-header-button-bg, var(--brand-primary)) !important;
      --btn-text: var(--page-header-button-text, var(--color-neutral-100)) !important;
      background-color: var(--btn-bg) !important;
      border-color: var(--page-header-button-border, var(--btn-bg)) !important;
      color: var(--btn-text) !important;
    }

    .palo-page-header[data-top-navigation-theme='light'] .button:hover,
    .palo-page-header[data-top-navigation-theme='dark'] .button:hover {
      background-color: var(--btn-text) !important;
      border-color: var(--btn-text) !important;
      color: var(--btn-bg) !important;
    }

    .palo-page-header[data-top-navigation-theme='light'] .button.button--outlined,
    .palo-page-header[data-top-navigation-theme='dark'] .button.button--outlined {
      background-color: transparent !important;
      color: var(--page-header-button-text) !important;
      border-color: var(--page-header-button-border) !important;
    }

    .palo-page-header[data-top-navigation-theme='light'] .button.button--outlined:hover,
    .palo-page-header[data-top-navigation-theme='dark'] .button.button--outlined:hover {
      background-color: var(--page-header-button-border) !important;
      color: var(--page-header-button-bg) !important;
    }
  }
</style>

<script>
  const win = window as Window & { __paloFixedBackgrounds?: boolean }

  if (!win.__paloFixedBackgrounds) {
    win.__paloFixedBackgrounds = true

    const updateFixedBackgrounds = () => {
      document
        .querySelectorAll<HTMLElement>(
          '.hero--background-fixed, .creative-section.has-fixed-background, .palo-page-header--background-fixed'
        )
        .forEach((section) => {
          section.style.setProperty('--fixed-background-offset', `${section.getBoundingClientRect().top * -1}px`)
        })
    }

    let frame = 0
    const requestUpdate = () => {
      if (frame) return
      frame = window.requestAnimationFrame(() => {
        frame = 0
        updateFixedBackgrounds()
      })
    }

    updateFixedBackgrounds()
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
    document.addEventListener('astro:page-load', updateFixedBackgrounds)
  }
</script>
