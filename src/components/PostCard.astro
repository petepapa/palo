---
import ContentImage from '@components/ContentImage.astro'
import type { ImageMetadata } from 'astro'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { parseResponsiveGap } from '@utils/tailwindSpacing'
import themeConfig from '@config'

/**
 * PostCard Component
 *
 * @description A blog post preview with ContentMedia-style image and content columns
 */
type PostCardHeadingLevel = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'

interface Props {
  /**
   * Additional classes to apply to the card
   */
  class?: string
  /**
   * Post title
   */
  title: string
  /**
   * Post URL
   */
  url: string
  /**
   * Optimized Astro image metadata or a static image path
   */
  image: ImageMetadata | string
  /**
   * Alt text for the image
   * @default ""
   */
  imageAlt?: string
  /**
   * CSS aspect-ratio value for the cover image
   * @default "8 / 5"
   */
  imageRatio?: string
  /**
   * Heading level for the title
   * @default "h3"
   */
  headingLevel?: PostCardHeadingLevel
  /**
   * Footer content
   */
  footer?: string
  /**
   * CSS gap class between image and content columns
   * @default "gap-12 md:gap-24"
   */
  cardGap?: string
  /**
   * CSS class for the description text
   * @default ""
   */
  descriptionClass?: string
}

const {
  class: className,
  title,
  url,
  image,
  imageAlt = '',
  imageRatio = '8 / 5',
  headingLevel = 'h3',
  footer,
  cardGap = 'gap-12 md:gap-24',
  descriptionClass = '',
} = Astro.props

const HeadingTag = headingLevel
const postUrl = ensureTrailingSlash(url)
const imageRatioStyle = `--post-card-image-ratio: ${imageRatio}`
const cardRadius = themeConfig?.radius?.card ?? themeConfig?.radius?.global ?? '0'
const gapTokens = parseResponsiveGap(cardGap, '3rem')
const gapBase = gapTokens.base ?? '3rem'
const gapMdValue = gapTokens.md ?? gapBase
---

<!--
  直接使用 inline style 设置 gap base 值，确保最高优先级。
  md 断点覆盖通过 is:global 样式实现，避免 Astro scoped CSS 特异性问题。
-->
<article
  class:list={['post-card grid grid-cols-1 md:grid-cols-2', className]}
  style={`--card-gap: ${gapBase}; --card-gap-md: ${gapMdValue}`}
>
  <a class="post-card__media" href={postUrl} aria-label={`Read post: ${title}`} style={`${imageRatioStyle}; --post-card-radius: ${cardRadius}`}>
    <ContentImage src={image} alt={imageAlt} width={800} height={500} class="post-card__image" />
  </a>
  <div class="post-card__content space-content flex flex-col justify-center">
    <HeadingTag class="post-card__title">
      <a href={postUrl}>{title}</a>
    </HeadingTag>
    <div class={['post-card__description', descriptionClass].filter(Boolean).join(' ')}>
      <slot />
    </div>
    {footer && <small class="post-card__footer">{footer}</small>}
  </div>
</article>

<style lang="scss">
  .post-card {
    color: inherit;
    border: none;
    border-radius: 0;
  }

  .post-card {
    gap: var(--card-gap);
  }

  @media (min-width: 768px) {
    .post-card {
      gap: var(--card-gap-md);
    }
  }

    .post-card__media {
      display: block;
      background-color: light-dark(var(--color-neutral-100), var(--color-neutral-900));
      aspect-ratio: var(--post-card-image-ratio, 8 / 5);
      overflow: hidden;
      border-radius: var(--post-card-radius, 0);
    }

    .post-card__media :where(img) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      border-radius: var(--post-card-radius, 0);
      transition: transform var(--animation-speed-slow, 500ms) var(--cubic-bezier, ease),
        filter var(--animation-speed-slow, 500ms) var(--cubic-bezier, ease);
    }

    :global(.post-card__image) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      border-radius: var(--post-card-radius, 0);
      transition: transform var(--animation-speed-slow, 500ms) var(--cubic-bezier, ease),
        filter var(--animation-speed-slow, 500ms) var(--cubic-bezier, ease);
    }

    /* Remove focus outline/box-shadow for blog list cards (visual only) */
    .post-card__media:where(:focus, :focus-visible) {
      outline: none;
      box-shadow: none;
    }

    .post-card__title {
      margin: 0;
      letter-spacing: 0;
    }

    .post-card__title a {
      color: inherit;
      text-decoration: none;
      transition: color 300ms ease;
    }

    .post-card__title a:where(:hover, :focus-visible) {
      color: var(--color-primary);
    }

    .post-card__media:where(:hover, :focus-visible) {
      :where(img) {
        transform: scale(1.04);
      }

      :global(.post-card__image) {
        transform: scale(1.04);
      }
    }

    .post-card__footer {
      color: var(--color-neutral-700);
    }
    
  @media (prefers-reduced-motion: reduce) {
    :global(.post-card__image),
    .post-card__title {
      transition: none;
    }
  }
</style>
