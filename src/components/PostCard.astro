---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import themeConfig from '@config'

/**
 * PostCard Component
 *
 * @description A blog post preview with ContentMedia-style image and content columns
 */
type PostCardHeadingLevel = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'

interface Props {
  /**
   * Additional classes to apply to the card
   */
  class?: string
  /**
   * Post title
   */
  title: string
  /**
   * Post URL
   */
  url: string
  /**
   * Optimized Astro image metadata or a static image path
   */
  image: ImageMetadata | string
  /**
   * Alt text for the image
   * @default ""
   */
  imageAlt?: string
  /**
   * CSS aspect-ratio value for the cover image
   * @default "8 / 5"
   */
  imageRatio?: string
  /**
   * Heading level for the title
   * @default "h3"
   */
  headingLevel?: PostCardHeadingLevel
  /**
   * Footer content
   */
  footer?: string
}

const {
  class: className,
  title,
  url,
  image,
  imageAlt = '',
  imageRatio = '8 / 5',
  headingLevel = 'h3',
  footer,
} = Astro.props

const HeadingTag = headingLevel
const postUrl = ensureTrailingSlash(url)
const imageRatioStyle = `--post-card-image-ratio: ${imageRatio}`
const cardRadius = themeConfig?.radius?.cardSize ?? themeConfig?.radius?.globalSize ?? '0'
---

<article class:list={['post-card grid grid-cols-1 gap-12 md:gap-24 md:grid-cols-2', className]}>
  <a class="post-card__media" href={postUrl} aria-label={`Read post: ${title}`} style={`${imageRatioStyle}; --post-card-radius: ${cardRadius}`}>
    {
      typeof image === 'string' ? (
        <img src={image} alt={imageAlt} width="800" height="500" loading="lazy" decoding="async" class="post-card__image" />
      ) : (
        <Image src={image} alt={imageAlt} width={800} height={500} loading="lazy" class="post-card__image" />
      )
    }
  </a>
  <div class="post-card__content space-content flex flex-col justify-center">
    <HeadingTag class="post-card__title">
      <a href={postUrl}>{title}</a>
    </HeadingTag>
    <div class="post-card__description">
      <slot />
    </div>
    {footer && <small class="post-card__footer">{footer}</small>}
  </div>
</article>

<style lang="scss">
  @layer components {
    .post-card {
      color: inherit;
      border: none;
      border-radius: 0;
    }

    .post-card__media {
      display: block;
      background-color: light-dark(var(--color-neutral-100), var(--color-neutral-900));
      aspect-ratio: var(--post-card-image-ratio, 8 / 5);
      overflow: hidden;
      border-radius: var(--post-card-radius, 0);
    }

    .post-card__media :where(img),
    .post-card__image {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      border-radius: var(--post-card-radius, 0);
      transition: transform var(--animation-speed-slow, 500ms) var(--cubic-bezier, ease),
        filter var(--animation-speed-slow, 500ms) var(--cubic-bezier, ease);
    }

    /* Remove focus outline/box-shadow for blog list cards (visual only) */
    .post-card__media:where(:focus, :focus-visible) {
      outline: none;
      box-shadow: none;
    }

    .post-card__title {
      margin: 0;
      letter-spacing: 0;
    }

    .post-card__title a {
      color: inherit;
      text-decoration: none;
      transition: color 300ms ease;
    }

    .post-card__title a:where(:hover, :focus-visible) {
      color: var(--color-primary);
    }

    .post-card__media:where(:hover, :focus-visible) {
      .post-card__image,
      :where(img) {
        transform: scale(1.04);
      }
    }

    .post-card__footer {
      color: var(--color-neutral-700);
    }
    
    @media (prefers-reduced-motion: reduce) {
      .post-card__image,
      .post-card__title {
        transition: none;
      }
    }
  }
</style>
