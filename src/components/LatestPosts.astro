---
import PostCard from '@components/PostCard.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getPostDefaultImage, resolveCollectionCoverImage } from '@utils/contentImages'

type SortBy = 'latest' | 'earliest'

/**
 * LatestPosts Component
 *
 * @description A component that displays the latest blog posts from Astro Content Collections
 */
interface Props {
  /**
   * Additional classes to apply to the section
   */
  class?: string
  /**
   * The number of posts to display
   * @default 3
   */
  limit?: number
  /**
   * The title for the section
   * @default "Latest posts"
   */
  title?: string
  /**
   * Sort posts by: latest (newest first), earliest (oldest first)
   * @default "latest"
   */
  sortBy?: SortBy
}

const { class: className, limit = 3, title = 'Latest posts', sortBy = 'latest' } = Astro.props

const coverImageRatio = '8 / 5'

// Get posts from content collection (过滤草稿)
const posts = (await getCollection('posts')).filter((post) => !post.data.draft)

// Dual-axis sorting: Featured First (by featuredOrder ASC) + Timeline Fallback (by sortBy)
const featuredPostsList = posts.filter((post) => post.data.featuredOrder !== undefined)
const regularPostsList = posts.filter((post) => post.data.featuredOrder === undefined)

featuredPostsList.sort(
  (a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity),
)
regularPostsList.sort((a, b) => {
  const aDate = a.data.publishDate?.valueOf() ?? 0
  const bDate = b.data.publishDate?.valueOf() ?? 0
  switch (sortBy) {
    case 'latest':
      return bDate - aDate
    case 'earliest':
      return aDate - bDate
    default:
      return bDate - aDate
  }
})

const sortedPosts = [...featuredPostsList, ...regularPostsList]

// Limit posts and map to display data
const latestPosts = sortedPosts.slice(0, limit).map((post, index) => {
  const author = typeof post.data.author === 'object' ? post.data.author.name : post.data.author
  return {
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    author,
    featuredImage: resolveCollectionCoverImage(
      post.data.coverImage,
      post.id,
      'posts',
      getPostDefaultImage(),
    ),
    url: ensureTrailingSlash(`/blog/${post.id}`),
  }
})
---

<section class:list={[className, 'my-8']}>
  <div class="container">
    <Heading level="h2" class="mb-6">{title}</Heading>
    <ul class="my-8 grid grid-cols-1 gap-24">
      {
        latestPosts.map((post) => (
          <li>
            <PostCard
              image={post.featuredImage}
              imageRatio={coverImageRatio}
              url={post.url}
              title={post.title}
              footer={post.author}
            >
              {post.description}
            </PostCard>
          </li>
        ))
      }
    </ul>
    <div class="mt-12 flex justify-end">
      <Link href={ensureTrailingSlash('/blog')} isButton animateOnHover animationType="nudge">
        Read all posts
        <Icon aria-hidden="true" name="ph:arrow-right" size="1.5rem" />
      </Link>
    </div>
  </div>
</section>
