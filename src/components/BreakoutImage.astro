---
/**
 * BreakoutImage Component
 *
 * @description A component for displaying a landscape image that can break out of the container
 *              with progressive streaming: main-color placeholder → native onload fade-in
 *
 * @example
 * // Default: full width (breaks out of container)
 * <BreakoutImage src="/some-img.png" alt="Full width image" />
 *
 * // Constrained: within container
 * <BreakoutImage src="/some-img.png" alt="Constrained image" layout="contained" />
 *
 * // Wide: expands but leaves gap
 * <BreakoutImage src="/some-img.png" alt="Wide image" layout="wide" />
 *
 * // Decorative image
 * <BreakoutImage src="/some-img.png" decorative />
 *
 * // Using ImageMetadata object (from import)
 * <BreakoutImage src={myImage} alt="My image" layout="wide" />
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { isImageMetadata, isRelativeContentImage } from '@utils/contentImages'
import { getDominantColor } from '@utils/imageColor'

// ═══════════════════════════════════════════════════════════════════
// 🔬 Eager Glob 引擎：构建时一次性导入全站内容图片，
//    使 BreakoutImage 能解析 MDX 中传入的纯相对路径（如 ./cover.jpg）
//    并通过 filename → ImageMetadata 索引快速命中。
// ═══════════════════════════════════════════════════════════════════
// 不使用 import: 'default' —— 改为完整模块对象再提取 .default，确保获得
// Astro 图片管道的完整 ImageMetadata（含 width/height/format），而非退化 URL 字符串。
const contentImageGlob = import.meta.glob(
  '/src/content/**/*.{jpg,jpeg,png,gif,webp,avif}',
  { eager: true }
)

type ResolvedImageEntry = {
  metadata: ImageMetadata
  publicPath: string
}

const imageByFilename: Record<string, ResolvedImageEntry> = {}
for (const [filePath, mod] of Object.entries(contentImageGlob)) {
  const metadata = (mod as { default: unknown }).default
  if (isImageMetadata(metadata)) {
    const filename = filePath.split('/').pop()!
    const publicPath = filePath.includes('/src/content/posts/')
      ? `/posts/${filePath.replace('/src/content/posts/', '')}`
      : filePath.includes('/src/content/projects/')
        ? `/projects/${filePath.replace('/src/content/projects/', '')}`
        : metadata.src

    imageByFilename[filename] = { metadata, publicPath }
  }
}

/**
 * 解析 MDX 中传入的图片 src。
 * - 若已是 ImageMetadata 对象 → 原样返回
 * - 若为相对路径（./ 或 ../）→ 在 glob 缓存中以文件名查找对应的 ImageMetadata
 * - 其他字符串（如绝对路径）→ 原样返回
 */
function resolveImageSrc(rawSrc: string | ImageMetadata): string | ImageMetadata {
  if (typeof rawSrc !== 'string') return rawSrc
  if (!isRelativeContentImage(rawSrc)) return rawSrc

  const filename = rawSrc.replace(/^\.\//, '').split('/').pop()!
  const match = imageByFilename[filename]

  if (!match) return rawSrc

  if (import.meta.env.DEV) {
    return {
      ...match.metadata,
      src: match.publicPath,
    }
  }

  return match.metadata
}

type Props = {
  /**
   * The image source
   * Can be a path string, public URL, or ImageMetadata object
   */
  src: string | ImageMetadata
  /**
   * The layout style of the image (default: 'full')
   * - 'full': Expands left and right to touch the screen edges, forced sharp/straight corners.
   * - 'wide': Expands left and right but leaves a small gap to the screen edges, retaining rounded corners.
   * - 'contained': Stays within the normal container, retaining rounded corners.
   */
  layout?: 'full' | 'wide' | 'contained'
  /**
   * Deprecated: Use layout="contained" instead.
   * Whether the image should break out of the container to be full width (default: true)
   */
  fullWidth?: boolean
} & (
  | {
      /**
       * Alt text describing the image for screen readers.
       * Required if the image is not decorative.
       */
      alt: string
      decorative?: never
    }
  | {
      /**
       * Set to true if the image is purely decorative
       */
      decorative: true
      alt?: never
    }
)

const { src, layout, fullWidth, decorative = false, alt = '' } = Astro.props

// ── 解析 src：将 MDX 中传入的相对路径（如 ./cover.jpg）转换为 ImageMetadata ──
const resolvedSrc = resolveImageSrc(src)

// ═══════════════════════════════════════════════════════
//  Dev 模式缓存破防：public/ 绝对路径强制附加时间戳后缀
//  浏览器对固定路径的 304 强缓存会吞掉 <img> 的 onload 事件，
//  动态后缀迫使浏览器发起完整 HTTP 请求，精准激活状态机。
// ═══════════════════════════════════════════════════════
let imageSrc: string | ImageMetadata = resolvedSrc
if (import.meta.env.DEV && typeof imageSrc === 'string' && imageSrc.startsWith('/')) {
  imageSrc = `${imageSrc}?palo-breakout-bypass=${Date.now()}`
}

const imageWidth = isImageMetadata(resolvedSrc) ? resolvedSrc.width : undefined
const imageHeight = isImageMetadata(resolvedSrc) ? resolvedSrc.height : undefined

// Determine layout style, supporting backward compatibility with fullWidth
// Default: 'full' — applies when layout is undefined or empty
let resolvedLayout: 'full' | 'wide' | 'contained' = 'full'
if (layout) {
  resolvedLayout = layout
} else if (fullWidth !== undefined) {
  resolvedLayout = fullWidth ? 'full' : 'contained'
}

const altText = decorative ? '' : alt

// ── 计算容器的纵横比 ──
const hasImageSize = isImageMetadata(resolvedSrc)

// 对于无法获取尺寸的 public 图片，使用 data-fallback-ratio 属性 + CSS 控制 8:5 比例
//   → 加载完成后通过 onload 释放，恢复原图真实比例
// 对于 ImageMetadata（有真实尺寸），直接写入行内 aspect-ratio（永不改变）
const isFallbackRatio = !hasImageSize

const realAspectRatioInline = hasImageSize
  ? `aspect-ratio: ${resolvedSrc.width} / ${resolvedSrc.height}`
  : ''

// ── 提取主色调，作为图片加载前的纯色占位背景 ──
const dominantColor = await getDominantColor(resolvedSrc)

// 加载完成后背景色淡出为透明（通栏大图统一行为）
const loadedBgColor = 'transparent'

const containerInlineStyle = [
  `background-color: ${dominantColor}`,
  `--loaded-bg-color: ${loadedBgColor}`,
  realAspectRatioInline,
].filter(Boolean).join('; ')

// Layout margins and border-radius are handled by CSS in <style is:global> below,
// using data-layout attribute selectors — no responsive breakpoints needed.

---

<div
  class:list={['relative', 'my-8', 'breakout-image-container', 'overflow-hidden']}
  style={(containerInlineStyle || '') + 'transition-property: background-color, aspect-ratio; transition-duration: var(--animation-speed-slow); transition-timing-function: var(--cubic-bezier);'}
  data-layout={resolvedLayout}
  data-fallback-ratio={isFallbackRatio ? 'true' : undefined}
>
  {isImageMetadata(resolvedSrc) ? (
    <Image
      src={resolvedSrc}
      alt={altText}
      width={imageWidth!}
      height={imageHeight!}
      widths={[560, 840, 1120, 1400, 1680]}
      class:list={['progressive-img-inner', 'h-auto w-full object-cover opacity-0']}
      style="transition: opacity var(--animation-speed-slow) var(--cubic-bezier) !important;"
      loading="lazy"
      decoding="async"
      onload="this.setAttribute('data-loaded','true');var c=this.closest('.breakout-image-container');this.classList.remove('opacity-0');if(c){c.setAttribute('data-loaded','true')}"
    />
  ) : (
    <img
      src={typeof imageSrc === 'string' ? imageSrc : ''}
      alt={altText}
      class:list={['progressive-img-inner', 'absolute inset-0 w-full h-full object-cover opacity-0']}
      style="transition: opacity var(--animation-speed-slow) var(--cubic-bezier) !important;"
      loading="eager"
      decoding="async"
      onload="var i=this;i.setAttribute('data-loaded','true');i.classList.remove('opacity-0');var c=i.closest('.breakout-image-container');if(c){c.setAttribute('data-loaded','true');var w=i.naturalWidth;var h=i.naturalHeight;if(w&&h){c.style.transition='aspect-ratio var(--animation-speed-slow) var(--cubic-bezier), background-color var(--animation-speed-slow) var(--cubic-bezier)';c.style.aspectRatio=w+' / '+h}}"
    />
  )}
  <style is:global>
    .breakout-image-container {
      aspect-ratio: 8 / 5;
    }

    .breakout-image-container[data-loaded="true"] {
      background-color: var(--loaded-bg-color, transparent) !important;
    }

    /* Base: high-specificity selector used by all layouts */
    .breakout-image-container.breakout-image-container {
      --breakout-radius: var(--radius-media, var(--radius-global, 0.5rem));
    }

    .breakout-image-container.breakout-image-container :is(img, > div.absolute) {
      border-radius: var(--breakout-radius) !important;
    }

    /* ── full：贴近左右屏幕边缘，直角 ── */
    .breakout-image-container.breakout-image-container[data-layout="full"] {
      --breakout-radius: 0;
      margin-left: calc(calc(var(--viewport-width, 100vw) / -2) + 50%);
      margin-right: calc(calc(var(--viewport-width, 100vw) / -2) + 50%);
      border-radius: 0 !important;
    }

    /* ── wide：距离左右屏幕 1rem 间隙，圆角 ── */
    .breakout-image-container.breakout-image-container[data-layout="wide"] {
      margin-left: calc(calc(var(--viewport-width, 100vw) / -2) + 50% + 1rem);
      margin-right: calc(calc(var(--viewport-width, 100vw) / -2) + 50% + 1rem);
      border-radius: var(--breakout-radius) !important;
    }

    /* ── contained：对齐页面最大宽度容器，圆角 ── */
    .breakout-image-container.breakout-image-container[data-layout="contained"] {
      --breakout-contained-padding: var(--grid-gutter, 1rem);
      margin-left: calc(50% - min(calc(var(--viewport-width, 100vw) / 2), var(--grid-max-width) / 2) + var(--breakout-contained-padding));
      margin-right: calc(50% - min(calc(var(--viewport-width, 100vw) / 2), var(--grid-max-width) / 2) + var(--breakout-contained-padding));
      border-radius: var(--breakout-radius) !important;
    }

    @media (min-width: 768px) {
      .breakout-image-container.breakout-image-container[data-layout="contained"] {
        --breakout-contained-padding: 2rem;
      }
    }

    @media (min-width: 1280px) {
      .breakout-image-container.breakout-image-container[data-layout="contained"] {
        --breakout-contained-padding: 1rem;
      }
    }

    /* ── TOC 模式（≥768px 侧栏显示时）：三种 layout 宽度统一为主内容列宽度，不突破 ── */
    @media (min-width: 768px) {
      .article-content--with-toc .breakout-image-container.breakout-image-container {
        margin-left: 0 !important;
        margin-right: 0 !important;
      }
    }
  </style>
  <noscript>
    <style>
      .breakout-image-container[data-fallback-ratio="true"] {
        aspect-ratio: auto !important;
      }
      .breakout-image-container img {
        opacity: 1 !important;
      }
      .breakout-image-container[data-fallback-ratio="true"] img {
        position: static !important;
        width: 100% !important;
        height: auto !important;
      }
    </style>
  </noscript>
  <div class:list={['absolute inset-0 shadow-inner pointer-events-none']}></div>
</div>

<!-- is:inline → 脚本内联于 HTML 流中，首帧即刻执行，不受外部 JS 阻塞 -->
<script is:inline>
  // ── 视口宽度精确测量：修正 100vw 包含滚动条导致的对齐偏差 ──
  var updateBreakoutViewportWidth = function() {
    var vw = document.documentElement.clientWidth;
    document.documentElement.style.setProperty('--viewport-width', vw + 'px');
  };

  // 首帧立即执行，避免 FOUC
  updateBreakoutViewportWidth();
  window.addEventListener('resize', updateBreakoutViewportWidth);

  // ── BreakoutImage DOM 状态机：public/ 路径 304 缓存吞 onload 的终极防御 ──
  var enforceBreakoutStatus = function() {
    var imgs = document.querySelectorAll('.breakout-image-container .progressive-img-inner, .breakout-image-container img');
    for (var i = 0; i < imgs.length; i++) {
      var img = imgs[i];
      if (!(img instanceof HTMLImageElement)) continue;

      var container = img.closest('.breakout-image-container');
      if (!container) continue;

      // 核心防线：浏览器缓存命中 (304/强缓存) → img.complete 瞬时为 true
      if (img.complete) {
        img.setAttribute('data-loaded', 'true');
        img.classList.remove('opacity-0');
        container.setAttribute('data-loaded', 'true');
        var w = img.naturalWidth;
        var h = img.naturalHeight;
        if (w && h) {
          container.style.transition = 'aspect-ratio var(--animation-speed-slow) var(--cubic-bezier)';
          container.style.aspectRatio = w + ' / ' + h;
        }
      } else {
        // 慢速网络拉取：只用 addEventListener，不覆盖内联 onload
        img.addEventListener('load', function() {
          img.setAttribute('data-loaded', 'true');
          img.classList.remove('opacity-0');
          container.setAttribute('data-loaded', 'true');
          var w = img.naturalWidth;
          var h = img.naturalHeight;
          if (w && h) {
            container.style.transition = 'aspect-ratio var(--animation-speed-slow) var(--cubic-bezier)';
            container.style.aspectRatio = w + ' / ' + h;
          }
        });
      }
    }
  };

  // 全生命周期绑定：首屏、SPA 导航、View Transitions 交换，无一遗漏
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enforceBreakoutStatus);
    document.addEventListener('DOMContentLoaded', updateBreakoutViewportWidth);
  } else {
    enforceBreakoutStatus();
    updateBreakoutViewportWidth();
  }
  document.addEventListener('astro:page-load', enforceBreakoutStatus);
  document.addEventListener('astro:page-load', updateBreakoutViewportWidth);
  document.addEventListener('astro:after-swap', enforceBreakoutStatus);
  document.addEventListener('astro:after-swap', updateBreakoutViewportWidth);
</script>

{import.meta.env.DEV && (
  <script is:inline>
    // DEV 专属：Astro / Vite HMR 热更新后 DOM 节点替换，防止 opacity: 0 假死
    var breakoutObserver = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        mutation.addedNodes.forEach(function(node) {
          if (!(node instanceof HTMLElement) || !node.querySelectorAll) return;
          var hmrImgs = node.querySelectorAll('.progressive-img-inner, img');
          for (var i = 0; i < hmrImgs.length; i++) {
            (function(img) {
              var container = img.closest('.breakout-image-container');
              if (!container) return;
              if (img.complete) {
                img.setAttribute('data-loaded', 'true');
                img.classList.remove('opacity-0');
                container.setAttribute('data-loaded', 'true');
              } else {
                img.addEventListener('load', function() {
                  img.setAttribute('data-loaded', 'true');
                  img.classList.remove('opacity-0');
                  container.setAttribute('data-loaded', 'true');
                });
              }
            })(hmrImgs[i]);
          }
        });
      });
    });
    breakoutObserver.observe(document.body, { childList: true, subtree: true });
  </script>
)}
