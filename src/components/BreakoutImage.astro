---
/**
 * BreakoutImage Component
 *
 * @description A component for displaying a landscape image that can break out of the container
 *              with progressive streaming: main-color placeholder → native onload fade-in
 *
 * @example
 * // Default: full width (breaks out of container)
 * <BreakoutImage src="/some-img.png" alt="Full width image" />
 *
 * // Constrained: within container
 * <BreakoutImage src="/some-img.png" alt="Constrained image" layout="contained" />
 *
 * // Wide: expands but leaves gap
 * <BreakoutImage src="/some-img.png" alt="Wide image" layout="wide" />
 *
 * // Decorative image
 * <BreakoutImage src="/some-img.png" decorative />
 *
 * // Using ImageMetadata object (from import)
 * <BreakoutImage src={myImage} alt="My image" layout="wide" />
 */
import type { ImageMetadata } from 'astro'
import { getDominantColor } from '@utils/imageColor'

type Props = {
  /**
   * The image source
   * Can be a path string, public URL, or ImageMetadata object
   */
  src: string | ImageMetadata
  /**
   * The layout style of the image (default: 'full')
   * - 'full': Expands left and right to touch the screen edges, forced sharp/straight corners.
   * - 'wide': Expands left and right but leaves a small gap to the screen edges, retaining rounded corners.
   * - 'contained': Stays within the normal container, retaining rounded corners.
   */
  layout?: 'full' | 'wide' | 'contained'
  /**
   * Deprecated: Use layout="contained" instead.
   * Whether the image should break out of the container to be full width (default: true)
   */
  fullWidth?: boolean
} & (
  | {
      /**
       * Alt text describing the image for screen readers.
       * Required if the image is not decorative.
       */
      alt: string
      decorative?: never
    }
  | {
      /**
       * Set to true if the image is purely decorative
       */
      decorative: true
      alt?: never
    }
)

const { src, layout, fullWidth, decorative = false, alt = '' } = Astro.props

// Determine layout style, supporting backward compatibility with fullWidth
let resolvedLayout: 'full' | 'wide' | 'contained' = 'full'
if (layout) {
  resolvedLayout = layout
} else if (fullWidth !== undefined) {
  resolvedLayout = fullWidth ? 'full' : 'contained'
}

const altText = decorative ? '' : alt

// ── 提取图片主色调 ──
const dominantColor = await getDominantColor(src)
const containerBgStyle = dominantColor ? `background-color: ${dominantColor};` : ''

// Define container spacing classes based on layout
const containerClasses = {
  full: '-mx-4 md:-mx-8 lg:-mx-[calc(50vw-50%+2rem)]',
  wide: 'mx-0 md:-mx-4 lg:-mx-[calc(50vw-50%-1rem)]',
  contained: 'mx-0 md:-mx-[calc(50vw-2rem-50%)] lg:-mx-[calc(min(50vw-1rem,var(--grid-max-width)/2-1rem)-50%)]',
}[resolvedLayout]

// Define border radius classes based on layout
const radiusClass = resolvedLayout === 'full'
  ? 'rounded-none'
  : 'rounded-[var(--radius-media,var(--radius-global,0.5rem))]'

// Resolve string src for native <img> - handle both string paths and ImageMetadata objects
let resolvedSrc: string | undefined
if (typeof src === 'string') {
  resolvedSrc = src
} else if (typeof src === 'object' && src !== null && 'src' in src) {
  resolvedSrc = (src as ImageMetadata).src
}
const aspectRatioStyle = 'aspect-ratio: 1400 / 700;'
---

<div
  class:list={['relative', 'my-8', 'breakout-image-container', containerClasses]}
  style={`${containerBgStyle} ${aspectRatioStyle}`}
>
  <img
    src={resolvedSrc}
    alt={altText}
    width={1400}
    height={700}
    class:list={['h-auto w-full object-cover opacity-0 transition-opacity duration-500 ease-out', radiusClass]}
    loading="lazy"
    decoding="async"
    onload="if ('decode' in this) { this.decode().then(() => this.classList.remove('opacity-0')).catch(() => this.classList.remove('opacity-0')) } else { this.classList.remove('opacity-0') }"
  />
  <noscript>
    <style>
      .breakout-image-container img {
        opacity: 1 !important;
      }
    </style>
  </noscript>
  <div class:list={['absolute inset-0 shadow-inner pointer-events-none', radiusClass]}></div>
</div>

<script>
  const checkBreakoutImages = () => {
    document.querySelectorAll('.breakout-image-container img').forEach((img) => {
      if (img instanceof HTMLImageElement && img.complete) {
        if ('decode' in img) {
          img.decode()
            .then(() => img.classList.remove('opacity-0'))
            .catch(() => img.classList.remove('opacity-0'));
        } else {
          img.classList.remove('opacity-0');
        }
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkBreakoutImages);
  } else {
    checkBreakoutImages();
  }

  document.addEventListener('astro:page-load', checkBreakoutImages);
</script>