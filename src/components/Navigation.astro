      );
      --mobile-menu-dropdown-item-padding-block: calc(
        0.25em * var(--navigation-mobile-dropdown-menu-line-height-scale, 1)
      );
      --mobile-menu-dropdown-offset: calc(
        0.5em * var(--navigation-mobile-dropdown-menu-line-height-scale, 1)
      );
      --mobile-menu-icon-group-gap: calc(1em * var(--navigation-main-menu-line-height-scale, 1));

      .desktop-launcher {
