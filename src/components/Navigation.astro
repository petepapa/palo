---
import ResponsiveToggle from './ResponsiveToggle.astro'
import NavigationItems from './NavigationItems.astro'
import Logo from './Logo.astro'
import LauncherTrigger from './LauncherTrigger.astro'
import themeConfig from '@config'

/**
 * Navigation Component
 *
 * @description A component that displays the navigation menu for the website
 */
const { site, typography } = themeConfig
const navMinHeight = themeConfig.navigation?.minHeight ?? ''
const navActiveStyle = themeConfig.navigation?.activeStyle ?? typography.navigationActiveStyle ?? 'wavy'
const navAlignment =
  themeConfig.navigation?.desktopMenuAlignment ?? site.desktopNavigationMenuAlignment ?? site.navigationAlignment ?? 'center'
const navDropdownDesktopColorMode = themeConfig.navigation?.dropdownDesktopColorMode ?? 'theme'
const navMainMenuLineHeightScale = themeConfig.navigation?.mainMenuLineHeightScale ?? 1
const navDesktopDropdownLineHeightScale = themeConfig.navigation?.desktopDropdownLineHeightScale ?? 1
const navMobileDropdownLineHeightScale = themeConfig.navigation?.mobileDropdownLineHeightScale ?? 1
const launcherGradientBorder = site.launcher === 'gradientBorder'

const navStyle = [
  navMinHeight ? `--nav-min-height: ${navMinHeight}` : '',
  `--navigation-main-menu-line-height-scale: ${navMainMenuLineHeightScale}`,
  `--navigation-desktop-dropdown-menu-line-height-scale: ${navDesktopDropdownLineHeightScale}`,
  `--navigation-mobile-dropdown-menu-line-height-scale: ${navMobileDropdownLineHeightScale}`,
]
  .filter(Boolean)
  .join('; ')
---

<div
  id="main-navigation"
  class=""
  data-nav-active-style={navActiveStyle}
  data-dropdown-desktop-color-mode={navDropdownDesktopColorMode}
  data-dropdown-color-mode-config={navDropdownDesktopColorMode}
  style={navStyle}
>
  <div class="container">
    <div class="nav-bar">
      <Logo />
      <div class="wrapper">
        <nav class={`desktop-menu desktop-menu--${navAlignment}`} aria-label="Main navigation desktop">
          <NavigationItems variant="primary" includeLauncher={false} />
          <NavigationItems variant="utility" />
        </nav>
        <ResponsiveToggle />
        {
          site.launcher && (
            <div class="mobile-launcher">
              <LauncherTrigger
                launcherId="site-launcher"
                iconOnly={true}
                gradientBorder={launcherGradientBorder}
              />
            </div>
          )
        }
      </div>
    </div>
    <nav class="mobile-menu" aria-label="Main navigation mobile">
      <NavigationItems includeLauncher={false} />
    </nav>
  </div>
</div>

<script is:inline>
  (function(){
    if (document.readyState !== 'loading') return;
    var path = window.location.pathname;
    if (path.length > 1 && path.endsWith('/')) path = path.slice(0, -1);
    document.querySelectorAll('#main-navigation a[href]').forEach(function(a) {
      if (a.getAttribute('rel')?.includes('external')) return;
      var href = a.pathname;
      if (href.length > 1 && href.endsWith('/')) href = href.slice(0, -1);
      var isHome = a.textContent.trim() === 'Home';
      var isActive = isHome ? (path === '/' || path === '') : (path === href || path.startsWith(href + '/'));
      if (isActive) {
        a.classList.add('is-active');
        a.setAttribute('aria-current', 'page');
        var li = a.closest('li');
        if (li) li.classList.add('is-active');
      }
    });
  })();
</script>

<script>
  // 从 data 属性读取原始 dropdownColorMode 配置（inverse 或 theme）
  const getDropdownColorMode = () => {
    const mainNav = document.querySelector('#main-navigation')
    return mainNav?.dataset.dropdownColorModeConfig || 'theme'
  }

  let handleOutsideClick: ((event: MouseEvent) => void) | null = null
  let handleDropdownClick: ((event: MouseEvent) => void) | null = null

  const initNavigation = () => {
    // 清理旧的全局点击监听器，避免重复绑定
    if (handleOutsideClick) {
      window.removeEventListener('click', handleOutsideClick)
    }
    // variables
    const mainNav = document.querySelector('#main-navigation') as HTMLElement | null
    if (!mainNav) return
    // 清理旧的 mainNav 点击监听器
    if (handleDropdownClick) {
      mainNav.removeEventListener('click', handleDropdownClick)
    }
    const navBreakpoint = window.matchMedia('(min-width: 1050px)')

    const mainContainer = mainNav.querySelector(':scope > .container') as HTMLElement | null
    const mobileMenu = mainNav.querySelector('.mobile-menu') as HTMLElement | null
    const keyboardMenus = [
      ...mainNav.querySelectorAll('.desktop-menu .menu--primary, .mobile-menu .menu'),
    ] as HTMLUListElement[]
    const dropdownMenus = [...document.querySelectorAll('.has-dropdown button')] as HTMLButtonElement[]

    // functions
    const setActiveMenuItem = (): void => {
      const mobileDesktopMenus = mainNav.querySelectorAll('.desktop-menu .menu, .mobile-menu .menu')
      const currentPathname = window.location.pathname

      // Normalize a path by stripping trailing slash (for comparison purposes)
      const normalizePath = (path: string): string => {
        if (path.length > 1 && path.endsWith('/')) {
          return path.slice(0, -1)
        }
        return path
      }

      const normalizedCurrent = normalizePath(currentPathname)

      mobileDesktopMenus.forEach((menu) => {
        const menuItems = [...menu.querySelectorAll('a[href]:not([rel*="external"])')] as HTMLAnchorElement[]

        menuItems.forEach((menuItem) => {
          const isHomeItem = menuItem.textContent?.trim() === 'Home'
          const normalizedHref = normalizePath(menuItem.pathname)

          if (isHomeItem) {
            // Home only matches the root path exactly
            if (normalizedCurrent === '/' || normalizedCurrent === '') {
              menuItem.classList.add('is-active')
              menuItem.setAttribute('aria-current', 'page')
            }
          } else {
            // For other items, match if the current pathname starts with the item's href
            // This handles both exact matches (/blog === /blog) and sub-pages (/blog/some-post starts with /blog)
            if (normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(normalizedHref + '/')) {
              menuItem.classList.add('is-active')
              menuItem.setAttribute('aria-current', 'page')
            }
          }
        })
      })
    }

    const openDropdownMenu = (dropdownMenu: HTMLButtonElement): void => {
      const dropdownList = dropdownMenu.parentNode?.querySelector('ul') as HTMLUListElement | null
      if (!dropdownList) return

      if (!navBreakpoint.matches && dropdownMenu.closest('.mobile-menu')) {
        dropdownList.hidden = false
        dropdownList.style.height = 'auto'
        const targetHeight = dropdownList.scrollHeight
        dropdownList.style.height = '0px'

        requestAnimationFrame(() => {
          dropdownMenu.classList.add('show')
          dropdownMenu.setAttribute('aria-expanded', 'true')
          dropdownList.style.height = `${targetHeight}px`
        })
        return
      }

      dropdownList.style.removeProperty('--dropdown-max-inline-size')
      dropdownMenu.classList.add('show')
      dropdownMenu.setAttribute('aria-expanded', 'true')

      if (mainContainer) {
        const containerBounds = mainContainer.getBoundingClientRect()
        const dropdownBounds = dropdownList.getBoundingClientRect()
        const availableWidth = containerBounds.right - dropdownBounds.left

        if (availableWidth > 0) {
          dropdownList.style.setProperty('--dropdown-max-inline-size', `${Math.floor(availableWidth)}px`)
        }
      }
    }

    const closeDropdownMenu = (dropdownMenu: HTMLButtonElement): void => {
      const dropdownList = dropdownMenu.parentNode?.querySelector('ul') as HTMLUListElement | null
      if (!dropdownList) return

      if (!navBreakpoint.matches && dropdownMenu.closest('.mobile-menu')) {
        const currentHeight = dropdownList.scrollHeight
        dropdownList.style.height = `${currentHeight}px`

        requestAnimationFrame(() => {
          dropdownMenu.classList.remove('show')
          dropdownMenu.setAttribute('aria-expanded', 'false')
          dropdownList.style.height = '0px'
        })
        return
      }

      dropdownList?.style.removeProperty('--dropdown-max-inline-size')
      dropdownMenu.classList.remove('show')
      dropdownMenu.setAttribute('aria-expanded', 'false')
    }

    const closeAllDropdownMenus = (): void => {
      for (let i = 0; i < dropdownMenus.length; i++) {
        closeDropdownMenu(dropdownMenus[i])
      }
    }

    handleOutsideClick = (event: MouseEvent) => {
      const element = event.target as Element
      const isDropdownButton = element.closest('[aria-haspopup]') !== null
      const isSubmenuItem = element.closest('.submenu-item') !== null
      if (!isDropdownButton && !isSubmenuItem) {
        closeAllDropdownMenus()
      }
    }

    const toggleDropdownMenu = (event: MouseEvent): void => {
      const target = event.currentTarget as HTMLButtonElement
      if (target.getAttribute('aria-expanded') === 'false') {
        closeAllDropdownMenus()
        openDropdownMenu(target)
      } else {
        closeDropdownMenu(target)
      }
    }

    const updateDropdownColorMode = (): void => {
      const header = document.querySelector('header') as HTMLElement | null
      const dropdownColorMode = getDropdownColorMode()

      // 页面到顶且有 topNavigationTheme：使用用户设置的主题
      // 滚动后或无主题：使用系统主题
      const headerTheme = header?.dataset.topNavigationTheme
      const isDarkmode = document.documentElement.classList.contains('darkmode')
      const currentTheme = headerTheme || (isDarkmode ? 'dark' : 'light')

      // 计算下拉菜单应该使用的颜色模式
      let computedMode = dropdownColorMode
      if (dropdownColorMode === 'inverse') {
        // inverse: 与当前导航主题相反
        // inverse-dark = 白底黑字（对 dark 取反）
        // inverse-light = 黑底白字（对 light 取反）
        computedMode = currentTheme === 'dark' ? 'inverse-dark' : 'inverse-light'
      }

      mainNav.setAttribute('data-dropdown-desktop-color-mode', computedMode)
    }

    updateDropdownColorMode()
    window.addEventListener('astro:page-load', updateDropdownColorMode)
    window.addEventListener('astro:after-swap', updateDropdownColorMode)
    // 监听 Header 主题变化事件，实时更新下拉菜单样式
    window.addEventListener('palo:header-theme-change', updateDropdownColorMode)
    // 监听主题切换（darkmode 类变化），实时更新下拉菜单样式
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
          updateDropdownColorMode()
        }
      })
    })
    observer.observe(document.documentElement, { attributes: true })

    mainNav.querySelectorAll('.mobile-menu .has-dropdown > ul').forEach((dropdownList) => {
      const list = dropdownList as HTMLUListElement
      list.hidden = true
      list.style.height = '0px'
    })

    mainNav.addEventListener('transitionend', (event: TransitionEvent) => {
      const target = event.target as HTMLElement | null
      if (!target || event.propertyName !== 'height') return

      if (target.matches('.mobile-menu')) {
        if (target.classList.contains('show')) {
          mobileMenu?.dispatchEvent(new CustomEvent('palo:content-resize'))
        } else {
          target.style.overflowY = 'hidden'
        }
      }

      if (target.matches('.mobile-menu .has-dropdown > ul')) {
        const trigger = target.parentElement?.querySelector(':scope > button') as HTMLButtonElement | null
        if (trigger?.classList.contains('show')) {
          target.style.height = 'auto'
          target.hidden = false
        } else {
          target.hidden = true
        }

        mobileMenu?.dispatchEvent(new CustomEvent('palo:content-resize'))
      }
    })

    navBreakpoint.addEventListener('change', (event) => {
      if (event.matches) {
        mainNav.querySelectorAll('.mobile-menu .has-dropdown > ul').forEach((dropdownList) => {
          const list = dropdownList as HTMLUListElement
          list.hidden = true
          list.style.height = '0px'
        })
      }
    })

    keyboardMenus.forEach((menu) => {
      menu.addEventListener('keydown', (event: KeyboardEvent) => {
        const element = event.target as Element
        const currentMenuItem = element.closest('li')
        const menuItems = [...menu.querySelectorAll('.menu-item')] as HTMLLIElement[]
        const currentDropdownMenu = element.closest('.has-dropdown button') as HTMLButtonElement | null
        const currentDropdownMenuItem = element.closest('.has-dropdown li') as HTMLLIElement | null
        const currentIndex = currentMenuItem ? menuItems.findIndex((item) => item === currentMenuItem) : -1

        const key = event.key
        let targetItem: Element | null = null

        if (key === 'ArrowRight') {
          if (currentMenuItem && menuItems.indexOf(currentMenuItem as HTMLLIElement) === menuItems.length - 1) {
            targetItem = menuItems[0]
          } else if (currentMenuItem) {
            targetItem = menuItems[currentIndex + 1]
          }
        }

        if (key === 'ArrowLeft') {
          if (currentMenuItem && menuItems.indexOf(currentMenuItem as HTMLLIElement) === 0) {
            targetItem = menuItems[menuItems.length - 1]
          } else if (currentMenuItem) {
            targetItem = menuItems[currentIndex - 1]
          }
        }

        if (key === 'Escape') {
          targetItem = menuItems[0]
        }

        if (currentDropdownMenu) {
          const nextElement = currentDropdownMenu.nextElementSibling as Element | null
          if (nextElement) {
            const firstDropdownItem = nextElement.querySelector('li')

            if (key === 'ArrowDown') {
              event.preventDefault()
              openDropdownMenu(currentDropdownMenu)
              targetItem = firstDropdownItem
            }
          }

          if (key === 'Escape') {
            closeDropdownMenu(currentDropdownMenu)
          }
        }

        if (currentDropdownMenuItem) {
          const currentDropdownList = currentDropdownMenuItem.parentNode as Element | null
          if (currentDropdownList) {
            const dropdownMenuItems = [...currentDropdownList.querySelectorAll('li')] as HTMLLIElement[]
            const currentIndex = dropdownMenuItems.findIndex((item) => item === currentDropdownMenuItem)

            if (key === 'ArrowDown') {
              event.preventDefault()

              if (dropdownMenuItems.indexOf(currentDropdownMenuItem) === dropdownMenuItems.length - 1) {
                targetItem = dropdownMenuItems[0]
              } else {
                targetItem = dropdownMenuItems[currentIndex + 1]
              }
            }

            if (key === 'ArrowUp') {
              event.preventDefault()

              if (dropdownMenuItems.indexOf(currentDropdownMenuItem) === 0) {
                targetItem = dropdownMenuItems[dropdownMenuItems.length - 1]
              } else {
                targetItem = dropdownMenuItems[currentIndex - 1]
              }
            }

            if (key === 'Escape') {
              const currentDropdownMenu = currentDropdownList.previousElementSibling as HTMLButtonElement | null
              if (currentDropdownMenu) {
                targetItem = currentDropdownMenu.parentElement
                closeAllDropdownMenus()
              }
            }

            if (key === 'Tab') {
              const currentDropdownMenu = currentDropdownList.previousElementSibling as HTMLButtonElement | null
              if (currentDropdownMenu) {
                if (dropdownMenuItems.indexOf(currentDropdownMenuItem) === dropdownMenuItems.length - 1) {
                  closeDropdownMenu(currentDropdownMenu)
                }
              }
            }
          }
        }

        if (targetItem) {
          const focusableElement = targetItem.querySelector('a, button, input') as HTMLElement | null
          if (focusableElement) {
            focusableElement.focus()
          }
        }
      })
    })

    handleDropdownClick = (event: MouseEvent) => {
      const button = (event.target as Element).closest('.has-dropdown > button')
      if (button instanceof HTMLButtonElement && button.hasAttribute('aria-haspopup')) {
        const isExpanded = button.getAttribute('aria-expanded') === 'true'
        if (!isExpanded) {
          closeAllDropdownMenus()
          openDropdownMenu(button)
        } else {
          closeDropdownMenu(button)
        }
      }
    }

    mainNav.addEventListener('click', handleDropdownClick)

    setActiveMenuItem()
    window.addEventListener('click', handleOutsideClick)
  }

  document.addEventListener('astro:page-load', initNavigation)
  document.addEventListener('astro:after-swap', initNavigation)
  initNavigation()
</script>

<style lang="scss" is:global>
  @use 'scss/base/mixins' as *;
  @use 'scss/base/breakpoint' as *;

  #main-navigation {
    --mobile-menu-duration: 0.18s;
    --mobile-menu-fade-duration: 0.14s;
    --mobile-menu-easing: cubic-bezier(0.2, 0, 0, 1);

    display: flex;
    flex-direction: column;

    > .container {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
    }

    .nav-bar {
      display: flex;
      flex: 1 1 100%;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-m);
      min-block-size: var(--nav-min-height, auto);
    }

    // Mobile-first: show mobile menu by default
    .mobile-menu {
      position: absolute;
      z-index: 110 !important;
      inset-block-start: 100%;
      inset-inline: 0;
      flex: 1 1 100%;
      height: 0;
      opacity: 0;
      overflow: hidden;
      contain: layout paint;
      will-change: height, opacity;
      border-radius: var(--radius-surface, var(--radius-global, var(--radius-m)));
      background-color: var(--background-color);
      transition:
        height var(--mobile-menu-duration) var(--mobile-menu-easing),
        opacity var(--mobile-menu-fade-duration) ease-out;
      padding-inline: var(--grid-gutter);
      padding-block-start: 0;
      padding-block-end: 0;

      @include breakpoint(m) {
        padding-inline: 2rem;
      }

      &.show {
        opacity: 1;
        overflow-y: hidden;
        pointer-events: auto;
        padding-block-start: var(--space-m);
        padding-block-end: var(--space-2xs);
      }

      &:not(.show) {
        padding-block-start: 0;
        padding-block-end: 0;
      }
    }

    .responsive-toggle {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);

      svg {
        width: 26px;
        height: 21px;
        flex-shrink: 0;
      }
    }

    .mobile-launcher {
      display: flex;
    }

    .desktop-menu {
      display: none;
    }

    // Desktop: switch to desktop menu at nav breakpoint
    @include breakpoint('nav') {
      > .container {
        column-gap: var(--space-l);
      }

      .nav-bar {
        flex: 1 1 auto;
      }

      .mobile-menu {
        display: none;
      }

      .responsive-toggle {
        display: none;
      }

      .mobile-launcher {
        display: none;
      }

      .desktop-menu {
        display: grid;
        flex: 1 1 auto;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: var(--space-m);
        min-inline-size: 0;
      }

      .desktop-menu > ul {
        display: flex;
        align-items: center;
        gap: var(--space-m);
        list-style-type: none;
      }

      .desktop-menu > ul > li {
        align-content: center;
      }

      .menu--primary {
        min-inline-size: 0;
      }

      .menu--utility {
        justify-self: end;
      }

      .desktop-menu--left .menu--primary {
        justify-self: start;
      }

      .desktop-menu--center .menu--primary {
        justify-self: center;
      }

      .desktop-menu--right .menu--primary {
        justify-self: end;
      }

      &[data-dropdown-desktop-color-mode='theme'] {
        .desktop-menu .menu--primary .dropdown-menu {
          --foreground-color: var(--color-neutral-800);
          --background-color: var(--color-neutral-100);
          --icon-color: var(--color-neutral-800);
          --border-color: var(--color-neutral-900);
          --border-color-subtle: var(--color-neutral-300);
          --link-color: var(--color-primary-400);
          --link-hover-color: var(--color-primary-300);
          --text-decoration-color: var(--color-neutral-700);
          --outline-color: var(--color-outline-200);
          color-scheme: light;
        }
      }

      .darkmode &[data-dropdown-desktop-color-mode='theme'] {
        .desktop-menu .menu--primary .dropdown-menu {
          --foreground-color: var(--color-neutral-100);
          --background-color: var(--color-neutral-900);
          --icon-color: var(--color-neutral-100);
          --border-color: var(--color-neutral-100);
          --border-color-subtle: var(--color-neutral-800);
          --link-color: var(--color-secondary-100);
          --link-hover-color: var(--color-secondary-200);
          --text-decoration-color: var(--color-neutral-100);
          --outline-color: var(--color-outline-100);
          color-scheme: dark;
        }
      }

      &[data-dropdown-desktop-color-mode='inverse'] {
        .desktop-menu .menu--primary .dropdown-menu {
          --foreground-color: var(--color-neutral-100);
          --background-color: var(--color-neutral-900);
          --icon-color: var(--color-neutral-100);
          --border-color: var(--color-neutral-100);
          --border-color-subtle: var(--color-neutral-800);
          --link-color: var(--color-secondary-100);
          --link-hover-color: var(--color-secondary-200);
          --text-decoration-color: var(--color-neutral-100);
          --outline-color: var(--color-outline-100);
          color-scheme: dark;
        }
      }

      .darkmode &[data-dropdown-desktop-color-mode='inverse'] {
        .desktop-menu .menu--primary .dropdown-menu {
          --foreground-color: var(--color-neutral-800);
          --background-color: var(--color-neutral-100);
          --icon-color: var(--color-neutral-800);
          --border-color: var(--color-neutral-900);
          --border-color-subtle: var(--color-neutral-300);
          --link-color: var(--color-primary-400);
          --link-hover-color: var(--color-primary-300);
          --text-decoration-color: var(--color-neutral-700);
          --outline-color: var(--color-outline-200);
          color-scheme: light;
        }
      }

      &[data-dropdown-desktop-color-mode='inverse-dark'] {
        .desktop-menu .menu--primary .dropdown-menu {
          --foreground-color: var(--color-neutral-800);
          --background-color: var(--color-neutral-100);
          --icon-color: var(--color-neutral-800);
          --border-color: var(--color-neutral-900);
          --border-color-subtle: var(--color-neutral-300);
          --link-color: var(--color-primary-400);
          --link-hover-color: var(--color-primary-300);
          --text-decoration-color: var(--color-neutral-700);
          --outline-color: var(--color-outline-200);
          color-scheme: light;
        }
      }

      &[data-dropdown-desktop-color-mode='inverse-light'] {
        .desktop-menu .menu--primary .dropdown-menu {
          --foreground-color: var(--color-neutral-100);
          --background-color: var(--color-neutral-900);
          --icon-color: var(--color-neutral-100);
          --border-color: var(--color-neutral-100);
          --border-color-subtle: var(--color-neutral-800);
          --link-color: var(--color-secondary-100);
          --link-hover-color: var(--color-secondary-200);
          --text-decoration-color: var(--color-neutral-100);
          --outline-color: var(--color-outline-100);
          color-scheme: dark;
        }
      }

      .wrapper {
        flex: 1 1 auto;
        justify-content: flex-start;
        min-inline-size: 0;
      }
    }

    .wrapper {
      display: flex;
      align-items: center;
      gap: var(--space-m);
    }

    a,
    button {
      color: var(--foreground-color);
      font-weight: var(--font-weight-accent, 400);
    }

    // --- Active / hover / focus indicator styles (shared between desktop & mobile) ---

    // Base: all interactive states get underline styling (except responsive-toggle)
    a:hover,
    a:focus-visible,
    .is-active,
    button[aria-expanded='true']:not(.responsive-toggle),
    .has-dropdown > button:hover,
    .has-dropdown > button:focus-visible {
      text-decoration: underline;
      text-decoration-thickness: max(1.5px, 0.0625em);
      text-underline-offset: 0.4375em;
    }

    // Default (wavy mode): wavy underline (except responsive-toggle)
    a:hover,
    a:focus-visible,
    .is-active,
    button[aria-expanded='true']:not(.responsive-toggle),
    .has-dropdown > button:hover,
    .has-dropdown > button:focus-visible {
      text-decoration-style: wavy;
    }

    .is-active {
      font-weight: var(--font-weight-accent, 400);
    }

    // Underline mode: solid underline (except responsive-toggle)
    &[data-nav-active-style='underline'] {
      a:hover,
      a:focus-visible,
      .is-active,
      button[aria-expanded='true']:not(.responsive-toggle),
      .has-dropdown > button:hover,
      .has-dropdown > button:focus-visible {
        text-decoration-style: solid;
      }
    }

    // Bold mode: hover/focus → solid underline, active → bold heading weight (no underline)
    &[data-nav-active-style='bold'] {
      a:hover,
      a:focus-visible,
      button[aria-expanded='true']:not(.responsive-toggle),
      .has-dropdown > button:hover,
      .has-dropdown > button:focus-visible {
        text-decoration-style: solid;
      }

      .is-active {
        text-decoration: none;
