    // Bold + wavy mode: active → bold heading weight with wavy underline
    &[data-nav-active-style='boldwavy'] {
      .is-active {
        font-weight: var(--font-weight-heading);
      }
    }

    // Bold + underline mode: all interactive states → solid underline, active → bold heading weight
    &[data-nav-active-style='boldunderline'] {
      a:hover,
      a:focus-visible,
      .is-active,
      button[aria-expanded='true']:not(.responsive-toggle),
      .has-dropdown > button:hover,
      .has-dropdown > button:focus-visible {
