        padding-block: var(--mobile-menu-dropdown-item-padding-block);
      }

      svg {
        width: 1em;
        height: 1em;
      }
    }

    // Dropdown offset = space-m + surface border width
    // This ensures the dropdown aligns with the container's inner edge
    .has-dropdown {
      position: relative;
      --dropdown-offset-inline: calc(var(--space-m) + var(--border-width-surface, var(--border-width-global)));

      > button {
        display: flex;
        align-items: center;
        gap: var(--space-4xs);
        margin-block-start: -1px;

        svg {
          transition: all var(--animation-speed-instant) var(--cubic-bezier);
        }

        &.show {
          svg {
            scale: -1;
          }
        }
      }

      ul {
        display: flex;
        position: absolute;
        flex-direction: column;
        gap: var(--space-2xs);
        visibility: hidden;
        pointer-events: none;
        transform: translate(calc(var(--dropdown-offset-inline) * -1), 1rem);
        opacity: 0;
        z-index: 100;
        inset-block-start: 125%;
        inset-inline-start: 0;
        inline-size: max-content;
        max-inline-size: var(--dropdown-max-inline-size, none);
        box-shadow: var(--elevation-4);
        border: var(--border-width-surface, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        border-radius: var(--radius-surface, var(--radius-global, var(--radius-m)));
        background-color: var(--background-color);
        padding: var(--space-m);
        min-inline-size: 275px;
        overflow-wrap: anywhere;
        word-break: break-word;

        transition:
          opacity var(--animation-speed-fast) var(--cubic-bezier),
          transform var(--animation-speed-fast) var(--cubic-bezier),
          visibility 0s linear var(--animation-speed-fast);
      }

      > button.show ~ ul {
        visibility: visible;
        pointer-events: auto;
        transform: translate(calc(var(--dropdown-offset-inline) * -1), 0);
        opacity: 1;
        transition-delay: 0s;
      }
    }

    .mobile-menu .has-dropdown ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      inline-size: 100%;
      position: relative;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      opacity: 1;
      inset: auto;
      box-shadow: none;
      border: none;
      border-radius: 0;
      background: transparent;
      padding: 0;
      min-inline-size: auto;
      height: 0;
      overflow: hidden;
      will-change: height;
      transition:
        height var(--mobile-menu-duration) var(--mobile-menu-easing);

      a {
        inline-size: 100%;
      }
    }

    .mobile-menu .has-dropdown > button.show ~ ul {
      margin-block-start: var(--mobile-menu-dropdown-offset);
      padding-block-start: 0;
      padding-block-end: 0;
      transform: none;
    }

    .mobile-menu .has-dropdown .submenu-item {
      padding-inline: 0;
    }

    // Ensure dropdown ul is left-aligned with its parent button in mobile
    .mobile-menu li.menu-item.has-dropdown {
      padding-inline: 0;
      flex-direction: column;
    }

    .mobile-menu .has-dropdown > button {
      padding-inline: 0;
    }

    .mobile-menu .menu-item:not(.type-icon) {
      flex: 0 0 100%;
    }

    .mobile-menu .menu-item.type-icon {
      display: inline-flex;
      flex: 0 0 auto;
      margin-block-start: var(--mobile-menu-icon-group-gap);
    }

    .mobile-menu .menu-item.type-icon + .menu-item.type-icon {
      margin-inline-start: 0;
    }

    .darkmode-toggle {
      border: none;
      padding: 0;

      .icon {
        inline-size: 1em;
        block-size: 1em;
      }

      &:where(:hover, :focus-visible) {
        box-shadow: none;
      }

      &:focus {
        @include outline;

        &:not(:focus-visible) {
          outline: none;
          box-shadow: none;
        }
      }
    }
  }
</style>

