---
import ResponsiveToggle from './ResponsiveToggle.astro'
import NavigationItems from './NavigationItems.astro'
import Logo from './Logo.astro'
import { LauncherTrigger } from 'accessible-astro-launcher'
import themeConfig from '@config'

/**
 * Navigation Component
 *
 * @description A component that displays the navigation menu for the website
 */
const { site, typography } = themeConfig
const navMinHeight = themeConfig.navigation?.minHeight ?? ''
const navActiveStyle = themeConfig.navigation?.activeStyle ?? typography.navigationActiveStyle ?? 'wavy'
const navAlignment =
  themeConfig.navigation?.desktopMenuAlignment ?? site.desktopNavigationMenuAlignment ?? site.navigationAlignment ?? 'center'
---

<div
  id="main-navigation"
  class=""
  data-nav-active-style={navActiveStyle}
  style={navMinHeight ? `--nav-min-height: ${navMinHeight}` : ''}
>
  <div class="container">
    <div class="nav-bar">
      <Logo />
      <div class="wrapper">
        <nav class={`desktop-menu desktop-menu--${navAlignment}`} aria-label="Main navigation desktop">
          <NavigationItems variant="primary" includeLauncher={false} />
          <NavigationItems variant="utility" />
        </nav>
        <ResponsiveToggle />
        {
          site.showLauncher && (
            <div class="mobile-launcher">
              <LauncherTrigger launcherId="site-launcher" iconOnly={true} gradientBorder={true} />
            </div>
          )
        }
      </div>
    </div>
    <nav class="mobile-menu" aria-label="Main navigation mobile">
      <NavigationItems includeLauncher={false} />
    </nav>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // variables
    const mainNav = document.querySelector('#main-navigation') as HTMLElement | null
    if (!mainNav) return

    const mainContainer = mainNav.querySelector(':scope > .container') as HTMLElement | null
    const keyboardMenus = [
      ...mainNav.querySelectorAll('.desktop-menu .menu--primary, .mobile-menu .menu'),
    ] as HTMLUListElement[]
    const dropdownMenus = [...document.querySelectorAll('.has-dropdown button')] as HTMLButtonElement[]

    // functions
    const setActiveMenuItem = (): void => {
      const mobileDesktopMenus = mainNav.querySelectorAll('.desktop-menu .menu, .mobile-menu .menu')
      const currentPathname = window.location.pathname

      // Normalize a path by stripping trailing slash (for comparison purposes)
      const normalizePath = (path: string): string => {
        if (path.length > 1 && path.endsWith('/')) {
          return path.slice(0, -1)
        }
        return path
      }

      const normalizedCurrent = normalizePath(currentPathname)

      mobileDesktopMenus.forEach((menu) => {
        const menuItems = [...menu.querySelectorAll('a[href]:not([rel*="external"])')] as HTMLAnchorElement[]

        menuItems.forEach((menuItem) => {
          const isHomeItem = menuItem.textContent?.trim() === 'Home'
          const normalizedHref = normalizePath(menuItem.pathname)

          if (isHomeItem) {
            // Home only matches the root path exactly
            if (normalizedCurrent === '/' || normalizedCurrent === '') {
              menuItem.classList.add('is-active')
              menuItem.setAttribute('aria-current', 'page')
            }
          } else {
            // For other items, match if the current pathname starts with the item's href
            // This handles both exact matches (/blog === /blog) and sub-pages (/blog/some-post starts with /blog)
            if (normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(normalizedHref + '/')) {
              menuItem.classList.add('is-active')
              menuItem.setAttribute('aria-current', 'page')
            }
          }
        })
      })
    }

    const openDropdownMenu = (dropdownMenu: HTMLButtonElement): void => {
      const dropdownList = dropdownMenu.parentNode?.querySelector('ul') as HTMLUListElement | null
      if (!dropdownList) return

      dropdownList.style.removeProperty('--dropdown-max-inline-size')
      dropdownMenu.classList.add('show')
      dropdownMenu.setAttribute('aria-expanded', 'true')

      if (mainContainer) {
        const containerBounds = mainContainer.getBoundingClientRect()
        const dropdownBounds = dropdownList.getBoundingClientRect()
        const availableWidth = containerBounds.right - dropdownBounds.left

        if (availableWidth > 0) {
          dropdownList.style.setProperty('--dropdown-max-inline-size', `${Math.floor(availableWidth)}px`)
        }
      }
    }

    const closeDropdownMenu = (dropdownMenu: HTMLButtonElement): void => {
      const dropdownList = dropdownMenu.parentNode?.querySelector('ul') as HTMLUListElement | null
      dropdownList?.style.removeProperty('--dropdown-max-inline-size')
      dropdownMenu.classList.remove('show')
      dropdownMenu.setAttribute('aria-expanded', 'false')
    }

    const closeAllDropdownMenus = (): void => {
      for (let i = 0; i < dropdownMenus.length; i++) {
        closeDropdownMenu(dropdownMenus[i])
      }
    }

    const toggleDropdownMenu = (event: MouseEvent): void => {
      const target = event.target as HTMLButtonElement
      if (target.getAttribute('aria-expanded') === 'false') {
        closeAllDropdownMenus()
        openDropdownMenu(target)
      } else {
        closeDropdownMenu(target)
      }
    }

    // execution
    keyboardMenus.forEach((menu) => {
      menu.addEventListener('keydown', (event: KeyboardEvent) => {
        const element = event.target as Element
        const currentMenuItem = element.closest('li')
        const menuItems = [...menu.querySelectorAll('.menu-item')] as HTMLLIElement[]
        const currentDropdownMenu = element.closest('.has-dropdown button') as HTMLButtonElement | null
        const currentDropdownMenuItem = element.closest('.has-dropdown li') as HTMLLIElement | null
        const currentIndex = currentMenuItem ? menuItems.findIndex((item) => item === currentMenuItem) : -1

        const key = event.key
        let targetItem: Element | null = null

        if (key === 'ArrowRight') {
          if (currentMenuItem && menuItems.indexOf(currentMenuItem as HTMLLIElement) === menuItems.length - 1) {
            targetItem = menuItems[0]
          } else if (currentMenuItem) {
            targetItem = menuItems[currentIndex + 1]
          }
        }

        if (key === 'ArrowLeft') {
          if (currentMenuItem && menuItems.indexOf(currentMenuItem as HTMLLIElement) === 0) {
            targetItem = menuItems[menuItems.length - 1]
          } else if (currentMenuItem) {
            targetItem = menuItems[currentIndex - 1]
          }
        }

        if (key === 'Escape') {
          targetItem = menuItems[0]
        }

        if (currentDropdownMenu) {
          const nextElement = currentDropdownMenu.nextElementSibling as Element | null
          if (nextElement) {
            const firstDropdownItem = nextElement.querySelector('li')

            if (key === 'ArrowDown') {
              event.preventDefault()
              openDropdownMenu(currentDropdownMenu)
              targetItem = firstDropdownItem
            }
          }

          if (key === 'Escape') {
            closeDropdownMenu(currentDropdownMenu)
          }
        }

        if (currentDropdownMenuItem) {
          const currentDropdownList = currentDropdownMenuItem.parentNode as Element | null
          if (currentDropdownList) {
            const dropdownMenuItems = [...currentDropdownList.querySelectorAll('li')] as HTMLLIElement[]
            const currentIndex = dropdownMenuItems.findIndex((item) => item === currentDropdownMenuItem)

            if (key === 'ArrowDown') {
              event.preventDefault()

              if (dropdownMenuItems.indexOf(currentDropdownMenuItem) === dropdownMenuItems.length - 1) {
                targetItem = dropdownMenuItems[0]
              } else {
                targetItem = dropdownMenuItems[currentIndex + 1]
              }
            }

            if (key === 'ArrowUp') {
              event.preventDefault()

              if (dropdownMenuItems.indexOf(currentDropdownMenuItem) === 0) {
                targetItem = dropdownMenuItems[dropdownMenuItems.length - 1]
              } else {
                targetItem = dropdownMenuItems[currentIndex - 1]
              }
            }

            if (key === 'Escape') {
              const currentDropdownMenu = currentDropdownList.previousElementSibling as HTMLButtonElement | null
              if (currentDropdownMenu) {
                targetItem = currentDropdownMenu.parentElement
                closeAllDropdownMenus()
              }
            }

            if (key === 'Tab') {
              const currentDropdownMenu = currentDropdownList.previousElementSibling as HTMLButtonElement | null
              if (currentDropdownMenu) {
                if (dropdownMenuItems.indexOf(currentDropdownMenuItem) === dropdownMenuItems.length - 1) {
                  closeDropdownMenu(currentDropdownMenu)
                }
              }
            }
          }
        }

        if (targetItem) {
          const focusableElement = targetItem.querySelector('a, button, input') as HTMLElement | null
          if (focusableElement) {
            focusableElement.focus()
          }
        }
      })
    })

    dropdownMenus &&
      dropdownMenus.forEach((dropdownMenu) => {
        dropdownMenu.addEventListener('click', toggleDropdownMenu as EventListener)
      })

    setActiveMenuItem()
    window.addEventListener('click', (event: MouseEvent) => {
      const element = event.target as Element
      if (!element.hasAttribute('aria-haspopup') && !element.classList.contains('submenu-item')) {
        closeAllDropdownMenus()
      }
    })
  })
</script>

<style lang="scss" is:global>
  @use 'scss/base/mixins' as *;
  @use 'scss/base/breakpoint' as *;

  #main-navigation {
    display: flex;
    flex-direction: column;

    > .container {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
    }

    .nav-bar {
      display: flex;
      flex: 1 1 100%;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-m);
      min-block-size: var(--nav-min-height, auto);
    }

    // Mobile-first: show mobile menu by default
    .mobile-menu {
      flex: 1 1 100%;
      max-block-size: 0;
      opacity: 0;
      overflow: hidden;
      will-change: max-block-size, opacity;
      // 仅动画 opacity + max-block-size，去掉 layout-heavy 的 margin/padding 过渡
      transition:
        max-block-size var(--animation-speed-medium) var(--cubic-bezier),
        opacity var(--animation-speed-medium) var(--cubic-bezier);
      margin-block-start: 0;
      padding-block-start: 0;
      padding-block-end: 0;

      &.show {
        max-block-size: calc(100vh - 8rem);
        opacity: 1;
        overflow-y: auto;
        margin-block-start: var(--space-m);
        padding-block-start: var(--space-2xs);
        padding-block-end: var(--space-2xs);
      }
    }

    .responsive-toggle {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);

      svg {
        width: 26px;
        height: 21px;
        flex-shrink: 0;
      }
    }

    .mobile-launcher {
      display: flex;
    }

    .desktop-menu {
      display: none;
    }

    // Desktop: switch to desktop menu at nav breakpoint
    @include breakpoint('nav') {
      > .container {
        column-gap: var(--space-l);
      }

      .nav-bar {
        flex: 1 1 auto;
      }

      .mobile-menu {
        display: none;
      }

      .responsive-toggle {
        display: none;
      }

      .mobile-launcher {
        display: none;
      }

      .desktop-menu {
        display: grid;
        flex: 1 1 auto;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: var(--space-m);
        min-inline-size: 0;
      }

      .desktop-menu > ul {
        display: flex;
        align-items: center;
        gap: var(--space-m);
        list-style-type: none;
      }

      .desktop-menu > .menu--primary {
        min-inline-size: 0;
      }

      .desktop-menu > .menu--utility {
        justify-self: end;
      }

      .desktop-menu--left > .menu--primary {
        justify-self: start;
      }

      .desktop-menu--center > .menu--primary {
        justify-self: center;
      }

      .desktop-menu--right > .menu--primary {
        justify-self: end;
      }

      .wrapper {
        flex: 1 1 auto;
        justify-content: flex-start;
        min-inline-size: 0;
      }
    }

    .wrapper {
      display: flex;
      align-items: center;
      gap: var(--space-m);
    }

    a,
    button {
      color: var(--foreground-color);
      font-weight: var(--font-weight-accent, 400);
    }

    // --- Active / hover / focus indicator styles (shared between desktop & mobile) ---

    // Base: all interactive states get underline styling (except responsive-toggle)
    a:hover,
    a:focus-visible,
    .is-active,
    button[aria-expanded='true']:not(.responsive-toggle),
    .has-dropdown > button:hover,
    .has-dropdown > button:focus-visible {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 7px;
    }

    // Default (wavy mode): wavy underline (except responsive-toggle)
    a:hover,
    a:focus-visible,
    .is-active,
    button[aria-expanded='true']:not(.responsive-toggle),
    .has-dropdown > button:hover,
    .has-dropdown > button:focus-visible {
      text-decoration-style: wavy;
    }

    .is-active {
      font-weight: var(--font-weight-accent, 400);
    }

    // Underline mode: solid underline (except responsive-toggle)
    &[data-nav-active-style='underline'] {
      a:hover,
      a:focus-visible,
      .is-active,
      button[aria-expanded='true']:not(.responsive-toggle),
      .has-dropdown > button:hover,
      .has-dropdown > button:focus-visible {
        text-decoration-style: solid;
      }
    }

    // Bold mode: hover/focus → solid underline, active → bold heading weight (except responsive-toggle)
    &[data-nav-active-style='bold'] {
      a:hover,
      a:focus-visible,
      button[aria-expanded='true']:not(.responsive-toggle),
      .has-dropdown > button:hover,
      .has-dropdown > button:focus-visible {
        text-decoration-style: solid;
      }

      .is-active {
        text-decoration: none;
        font-weight: var(--font-weight-heading);
      }
    }

    .desktop-menu {
      .menu--primary a,
      .menu--primary button,
      .menu--utility > .type-icon > a,
      .menu--utility > .type-icon > button {
        font-size: var(--navigation-desktop-font-size, 1rem);
      }

      .menu--primary .dropdown-menu a,
      .menu--primary .dropdown-menu button {
        font-size: var(--navigation-dropdown-desktop-font-size, var(--navigation-desktop-font-size, 1rem));
      }

      svg {
        width: 1em;
        height: 1em;
      }

      .desktop-launcher .launcher-trigger .trigger,
      .desktop-launcher .launcher-trigger .key {
        font-size: initial;
      }
    }

    nav {
      > ul {
        display: flex;
        gap: var(--space-m);
        list-style-type: none;

        li {
          align-content: center;
        }

        .highlight a {
          display: inline-flex;
          align-items: center;
          gap: var(--space-2xs);
          transition: all var(--animation-speed-fast) var(--cubic-bezier);
          margin-block-start: calc(var(--space-4xs) * -1);
          border: var(--border-width-button, var(--border-width-global, 3px)) solid var(--foreground-color);
          border-radius: var(--radius-large);
          padding: var(--space-4xs) var(--space-2xs);
          text-decoration: none;

          &:where(:hover, :focus-visible) {
            background-color: var(--foreground-color);
            color: var(--background-color) !important;
          }
        }
      }
    }

    .mobile-menu {
      .desktop-launcher {
        display: none;
      }

      > ul {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: flex-start;

        ul {
          position: relative;
          margin-block-start: var(--space-m);
        }
      }

      a,
      button {
        display: block;
        font-size: var(--navigation-mobile-font-size, 1rem);
        padding: var(--space-2xs) 0;
        inline-size: 100%;
      }

      .dropdown-menu a,
      .dropdown-menu button {
        font-size: var(--navigation-dropdown-mobile-font-size, var(--navigation-mobile-font-size, 1rem));
      }

      svg {
        width: 1em;
        height: 1em;
      }
    }

    // Dropdown offset = space-m + surface border width
    // This ensures the dropdown aligns with the container's inner edge
    .has-dropdown {
      position: relative;
      --dropdown-offset-inline: calc(var(--space-m) + var(--border-width-surface, var(--border-width-global)));

      > button {
        display: flex;
        align-items: center;
        gap: var(--space-4xs);
        margin-block-start: -1px;

        svg {
          transition: all var(--animation-speed-instant) var(--cubic-bezier);
        }

        &.show {
          svg {
            scale: -1;
          }
        }
      }

      ul {
        display: flex;
        position: absolute;
        flex-direction: column;
        gap: var(--space-2xs);
        visibility: hidden;
        pointer-events: none;
        transform: translate(calc(var(--dropdown-offset-inline) * -1), 1rem);
        opacity: 0;
        z-index: 100;
        inset-block-start: 125%;
        inset-inline-start: 0;
        inline-size: max-content;
        max-inline-size: var(--dropdown-max-inline-size, none);
        box-shadow: var(--elevation-4);
        border: var(--border-width-surface, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        border-radius: var(--radius-surface, var(--radius-global, var(--radius-m)));
        background-color: var(--background-color);
        padding: var(--space-m);
        min-inline-size: 275px;
        overflow-wrap: anywhere;
        word-break: break-word;

        transition:
          opacity var(--animation-speed-fast) var(--cubic-bezier),
          transform var(--animation-speed-fast) var(--cubic-bezier),
          visibility 0s linear var(--animation-speed-fast);
      }

      > button.show ~ ul {
        visibility: visible;
        pointer-events: auto;
        transform: translate(calc(var(--dropdown-offset-inline) * -1), 0);
        opacity: 1;
        transition-delay: 0s;
      }
    }

    .mobile-menu .has-dropdown ul {
      display: flex;
      inline-size: 100%;
      position: relative;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      opacity: 1;
      inset: auto;
      box-shadow: none;
      border: none;
      border-radius: 0;
      background: transparent;
      padding: 0;
      padding-inline-start: 0;
      margin-inline-start: 0;
      min-inline-size: auto;
      max-block-size: 0;
      overflow: hidden;
      will-change: max-block-size;
      transition:
        max-block-size var(--animation-speed-medium) var(--cubic-bezier);
      margin-block-start: 0;
      margin-inline-start: 0;
      padding-block-start: 0;
      padding-block-end: 0;

      a {
        inline-size: 100%;
      }
    }

    .mobile-menu .has-dropdown > button.show ~ ul {
      max-block-size: 500px;
      margin-block-start: var(--space-m);
      padding-block-start: var(--space-2xs);
      padding-block-end: var(--space-2xs);
      transform: none;
    }

    .mobile-menu .has-dropdown .submenu-item {
      padding-inline: 0;
    }

    // Ensure dropdown ul is left-aligned with its parent button in mobile
    .mobile-menu li.menu-item.has-dropdown {
      padding-inline: 0;
    }

    .mobile-menu .has-dropdown > button {
      padding-inline: 0;
    }

    .mobile-menu .menu-item:not(.type-icon) {
      flex: 0 0 100%;
    }

    .mobile-menu .menu-item.type-icon {
      display: inline-flex;
      flex: 0 0 auto;
    }

    .mobile-menu .menu-item.type-icon + .menu-item.type-icon {
      margin-inline-start: 0;
    }

    .darkmode-toggle {
      border: none;
      padding: 0;

      .icon {
        inline-size: 1em;
        block-size: 1em;
      }

      &:where(:hover, :focus-visible) {
        box-shadow: none;
      }

      &:focus {
        @include outline;

        &:not(:focus-visible) {
          outline: none;
          box-shadow: none;
        }
      }
    }
  }
</style>

<style is:global>
  #main-navigation .mobile-launcher .launcher-trigger svg,
  #main-navigation .desktop-launcher .launcher-trigger svg {
    width: 20px !important;
    height: 20px !important;
  }
</style>
