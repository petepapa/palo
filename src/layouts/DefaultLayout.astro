<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ defaultTheme, darkModeToggle }}>
      try {
        const storedTheme = localStorage.getItem('darkMode')
        // Locked theme: when defaultTheme is explicitly set (not auto) and toggle is off,
        // force the configured theme and clear any stale localStorage value.
        if (defaultTheme !== 'auto' && !darkModeToggle) {
          const useDarkTheme = defaultTheme === 'dark'
          document.documentElement.classList.toggle('darkmode', useDarkTheme)
          document.documentElement.style.colorScheme = useDarkTheme ? 'dark' : 'light'
          if (storedTheme) {
            localStorage.removeItem('darkMode')
          }
        } else if (!storedTheme) {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          const useDarkTheme = defaultTheme === 'dark' || (defaultTheme === 'auto' && prefersDark)
          document.documentElement.classList.toggle('darkmode', useDarkTheme)
          document.documentElement.style.colorScheme = useDarkTheme ? 'dark' : 'light'
        }
      } catch {
        // Keep the static light theme if browser storage or media queries are unavailable.
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href={themeConfig.metadata.favicon || '/favicon.svg'} />
    <!-- Preload body weight font to reduce CLS -->
    {bodyFontPreloadUrl && bodyFontIsWoff2 && (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={bodyFontPreloadUrl} />
    )}

    {fontFaceCss && <style is:global set:html={`@layer base { ${fontFaceCss} }`} />}

    <style is:global set:html={`@layer tokens { ${themeVariablesCss} }`}></style>

    <SEO
      title={seoTitle}
      titleTemplate={seoTitleTemplate}
      titleDefault={themeConfig.metadata.title}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: imageUrl,
      }}
      extend={{
        meta: [
          {
            name: 'author',
            content: author,
          },
        ],
      }}
    />

    <!-- Enable Astro View Transitions for all browsers -->
    <ClientRouter />

    <!-- ═══════════════════════════════════════════════════════════════
         Critical CSS Anti-FOUC Shield
         在慢速网络（3G/4G）下，浏览器在外部 CSS bundle 到达前会先用
         默认样式渲染 HTML（白底黑字、蓝链接、无约束布局）。
         此内联块涵盖首屏必需规则，确保第一帧即有正确的颜色和骨架。
         ═══════════════════════════════════════════════════════════════ -->
    <style is:global>
      @layer base {
        /* ── Body & link colors —— 防止白底/蓝链闪烁 ── */
        body {
          background-color: var(--background-color);
          color: var(--foreground-color);
          font-family: var(--font-body);
        }

        a {
          color: var(--link-color);
        }
      }

      @layer components {
        /* ── 核心容器布局骨架 —— 防止内容区坍塌 ── */
        .container {
          margin-inline: auto;
          padding-inline: var(--grid-gutter);
          width: min(100%, var(--grid-max-width));
          max-width: var(--grid-max-width);
        }

        /* ── 文章详情页 Grid 布局 —— 防止 TOC 无约束平铺 ── */
        .article-content {
          display: grid;
          grid-template-columns: 1fr;
          gap: var(--space-l);
        }

        .article-content__main {
          min-width: 0;
        }

        /* ── TOC 容器初始约束 —— 防止未样式化列表铺满全屏 ── */
        .article-content__toc {
          display: block;
          grid-row: 1;
        }

        .article-toc {
          max-width: 100%;
          overflow-wrap: break-word;
          word-wrap: break-word;
        }

        .article-toc ul {
          list-style: none;
          padding-inline-start: 0;
        }

        .article-toc a {
          display: inline-block;
          max-width: 100%;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          text-decoration: none;
          color: var(--link-color);
        }

        /* ── Tags 标签栏 & 页脚导航：CSS 到达前屏蔽浏览器默认下划线 ── */
        .palo-nav-list a {
          text-decoration: none;
        }

        @media (min-width: 768px) {
          .article-content--with-toc {
            grid-template-columns: minmax(0, 1fr) 280px;
          }

          .article-content__toc {
            grid-row: auto;
            position: sticky;
            align-self: start;
            top: calc(var(--header-height, 0px) + var(--space-l, 2rem));
            max-height: calc(100vh - calc(var(--header-height, 0px) + var(--space-l, 2rem)));
            overflow-y: auto;
          }
        }

        /* ── 图片渐进加载骨架 —— 主色调占位 + 淡入刚性容器 ── */
        .progressive-img-container {
          position: relative;
          display: block;
          overflow: hidden;
          inline-size: 100%;
          block-size: 100%;
        }

        .progressive-img-inner {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
          opacity: 0;
        }

        /* ── PostHeader 封面图骨架 —— 防止图片区域坍塌 ── */
        .post-header__image {
          position: relative;
          left: 50%;
          right: 50%;
          margin-left: -50vw;
          margin-right: -50vw;
          width: 100vw;
          max-width: 100vw;
          height: 60vh;
          min-height: 60dvh;
          overflow: hidden;
        }

        /* ── Breakout 图片容器初始 rigid 约束 ── */
        .breakout-image-container {
          position: relative;
          overflow: hidden;
        }

        .breakout-image-container img {
          display: block;
          width: 100%;
          height: auto;
        }

        /* ── 窄文栏居中 ── */
        .narrow {
          margin-inline: auto;
          max-width: 65ch;
        }

        /* ── prose 正文区域基础样式 ── */
        .prose {
          color: var(--foreground-color);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main id="main-content" transition:animate="fade" style={`padding-top: ${mainPaddingTop} !important;`}>
      <slot />

      <!-- ⚡ Markdown 正文原生图片：纯淡入动画，无黑底占位，无强制宽高 -->
      <style is:inline>
        .prose img:not(.progressive-img-inner),
        .markdown-content img:not(.progressive-img-inner),
        article img:not(.progressive-img-inner) {
          opacity: 0;
          transition: opacity 0.5s ease-out !important;
        }

        .prose img:not(.progressive-img-inner).is-markdown-loaded,
        .markdown-content img:not(.progressive-img-inner).is-markdown-loaded,
        article img:not(.progressive-img-inner).is-markdown-loaded {
          opacity: 1 !important;
        }

        /* 组件隔离：BreakoutImage/ContentImage 不受上述 prose 淡入影响 */
        .breakout-image-container img,
        .progressive-img-container img {
          opacity: initial !important;
          transition: initial !important;
        }
      </style>

      <noscript>
        <style>
          .prose img:not(.progressive-img-inner),
          .markdown-content img:not(.progressive-img-inner),
          article img:not(.progressive-img-inner) {
            opacity: 1 !important;
          }
        </style>
      </noscript>

      <script is:inline>
        const initMarkdownImagesFadeIn = () => {
          const containers = document.querySelectorAll('.prose, .markdown-content, article');
          containers.forEach(container => {
            container.querySelectorAll('img').forEach(img => {
              // 排除已经被 ContentImage 组件处理好的图片，避免双重淡入冲突
              if (img.classList.contains('progressive-img-inner')) return;

              const triggerFadeIn = () => {
                if ('decode' in img) {
                  img.decode()
                    .then(() => img.classList.add('is-markdown-loaded'))
                    .catch(() => img.classList.add('is-markdown-loaded'));
                } else {
                  img.classList.add('is-markdown-loaded');
                }
              };

              if (img.complete) {
                triggerFadeIn();
              } else {
                img.addEventListener('load', triggerFadeIn);
                img.addEventListener('error', triggerFadeIn);
              }
            });
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMarkdownImagesFadeIn);
        } else {
          initMarkdownImagesFadeIn();
        }

        document.addEventListener('astro:page-load', initMarkdownImagesFadeIn);
      </script>
    </main>
    <Footer />
    <script is:inline>
      const paloInitCodeBlocks = () => {
        const copyIcon = `
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
        `
        const checkIcon = `
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        `
        const languageLabels = {
          js: 'JS',
          jsx: 'JSX',
          ts: 'TS',
          tsx: 'TSX',
          html: 'HTML',
          css: 'CSS',
          scss: 'SCSS',
          astro: 'Astro',
          md: 'Markdown',
          mdx: 'MDX',
          sh: 'Shell',
          bash: 'Bash',
          zsh: 'Zsh',
          json: 'JSON',
          yaml: 'YAML',
          yml: 'YAML',
        }

        const getLanguage = (pre) => {
          const rawLanguage =
            pre.dataset.language ||
            pre.querySelector('code')?.className?.match(/language-([^\s]+)/)?.[1] ||
            pre.className.match(/language-([^\s]+)/)?.[1] ||
            ''
          const normalizedLanguage = String(rawLanguage).trim().toLowerCase()
          return languageLabels[normalizedLanguage] || normalizedLanguage || 'Code'
        }

        const copyText = async (text) => {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text)
            return
          }

          const textarea = document.createElement('textarea')
          textarea.value = text
          textarea.setAttribute('readonly', '')
          textarea.style.position = 'fixed'
          textarea.style.insetBlockStart = '-9999px'
          document.body.append(textarea)
          textarea.select()
          document.execCommand('copy')
          textarea.remove()
        }

        document.querySelectorAll('pre').forEach((pre) => {
          if (!(pre instanceof HTMLElement) || pre.dataset.paloCodeBlockEnhanced === 'true') return
          if (pre.closest('.code-block')) return

          const code = pre.querySelector('code')
          if (!(code instanceof HTMLElement)) return

          const isMermaid = /\b(?:language|lang)-mermaid\b/.test(pre.dataset.language || pre.className || '') || /\b(?:language|lang)-mermaid\b/.test(code.className || '')
          if (isMermaid) return

          const wrapper = document.createElement('div')
          wrapper.className = 'code-block'

          const header = document.createElement('div')
          header.className = 'code-block__header'

          const language = document.createElement('span')
          language.className = 'code-block__language'
          language.textContent = getLanguage(pre)

          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'code-block__copy'
          button.setAttribute('aria-label', 'Copy code')
          button.innerHTML = `${copyIcon}<span class="sr-only">Copy code</span>`

          button.addEventListener('click', async () => {
            await copyText(code.innerText)
            button.innerHTML = `${checkIcon}<span class="sr-only">Copied</span>`
            button.setAttribute('aria-label', 'Copied')
            window.setTimeout(() => {
              button.innerHTML = `${copyIcon}<span class="sr-only">Copy code</span>`
              button.setAttribute('aria-label', 'Copy code')
            }, 1800)
          })

          header.append(language, button)
          pre.before(wrapper)
          wrapper.append(header, pre)
          pre.dataset.paloCodeBlockEnhanced = 'true'
        })
      }

      document.addEventListener('astro:page-load', paloInitCodeBlocks)
      document.addEventListener('astro:after-swap', paloInitCodeBlocks)
      paloInitCodeBlocks()
    </script>
    <script is:inline>
      const paloInitAccordionFallback = () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        document.querySelectorAll('.accordion details.wrapper').forEach((wrapper) => {
          if (wrapper.dataset.paloAccordionBound === 'true') return

          const summary = wrapper.querySelector('.title')
          const content = wrapper.querySelector('.content')
          if (!(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) return

          const setExpandedState = (isOpen) => {
            summary.setAttribute('aria-expanded', isOpen ? 'true' : 'false')
            if (isOpen) {
              wrapper.setAttribute('open', '')
            } else {
              wrapper.removeAttribute('open')
            }
          }

          const getContentHeight = () => content.scrollHeight

          const stopTransition = () => {
            content.style.transition = 'none'
          }

          const startTransition = () => {
            content.style.transition = prefersReducedMotion
              ? 'none'
              : 'max-height 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), opacity 0.3s cubic-bezier(0.165, 0.84, 0.44, 1)'
          }

          const resetToClosedState = () => {
            stopTransition()
            content.style.maxHeight = '0px'
            content.style.opacity = '0'
            void content.offsetHeight
            startTransition()
          }

          const resetToOpenState = () => {
            stopTransition()
            content.style.maxHeight = `${getContentHeight()}px`
            content.style.opacity = '1'
            void content.offsetHeight
            startTransition()
          }

          const openAccordion = () => {
            const groupName = wrapper.getAttribute('name')
            if (groupName) {
              document.querySelectorAll(`.accordion details.wrapper[name="${groupName}"]`).forEach((item) => {
                if (item !== wrapper && item instanceof HTMLDetailsElement && item.open) {
                  const otherSummary = item.querySelector('.title')
                  const otherContent = item.querySelector('.content')
                  if (!(otherSummary instanceof HTMLElement) || !(otherContent instanceof HTMLElement)) return

                  if (prefersReducedMotion) {
                    otherContent.style.maxHeight = '0px'
                    otherContent.style.opacity = '0'
                    item.removeAttribute('open')
                    otherSummary.setAttribute('aria-expanded', 'false')
                    return
                  }

                  otherContent.style.maxHeight = `${otherContent.scrollHeight}px`
                  otherContent.style.opacity = '1'
                  void otherContent.offsetHeight
                  requestAnimationFrame(() => {
                    otherContent.style.maxHeight = '0px'
                    otherContent.style.opacity = '0'
                  })
                  otherContent.addEventListener(
                    'transitionend',
                    (event) => {
                      if (event.propertyName !== 'max-height') return
                      item.removeAttribute('open')
                      otherSummary.setAttribute('aria-expanded', 'false')
                    },
                    { once: true },
                  )
                }
              })
            }

            if (prefersReducedMotion) {
              content.style.maxHeight = `${getContentHeight()}px`
              content.style.opacity = '1'
              setExpandedState(true)
              return
            }

            setExpandedState(true)
            resetToClosedState()

            requestAnimationFrame(() => {
              content.style.maxHeight = `${getContentHeight()}px`
              content.style.opacity = '1'
            })
          }

          const closeAccordion = () => {
            if (prefersReducedMotion) {
              content.style.maxHeight = '0px'
              content.style.opacity = '0'
              setExpandedState(false)
              return
            }

            resetToOpenState()
            setExpandedState(false)

            requestAnimationFrame(() => {
              content.style.maxHeight = '0px'
              content.style.opacity = '0'
            })

            content.addEventListener(
              'transitionend',
              (event) => {
                if (event.propertyName !== 'max-height') return
                content.style.maxHeight = '0px'
                content.style.opacity = '0'
              },
              { once: true },
            )
          }

          summary.setAttribute('aria-expanded', wrapper.hasAttribute('open') ? 'true' : 'false')
          content.style.overflow = 'hidden'
          startTransition()

          if (wrapper.hasAttribute('open')) {
            content.style.maxHeight = `${getContentHeight()}px`
            content.style.opacity = '1'
          } else {
            content.style.maxHeight = '0px'
            content.style.opacity = '0'
          }

          summary.addEventListener('click', (event) => {
            event.preventDefault()
            wrapper.hasAttribute('open') ? closeAccordion() : openAccordion()
          })

          wrapper.dataset.paloAccordionBound = 'true'
        })
      }

      document.addEventListener('astro:page-load', paloInitAccordionFallback)
      document.addEventListener('astro:after-swap', paloInitAccordionFallback)
      paloInitAccordionFallback()
    </script>
    <script is:inline>
      function paloInitFloatingFormLabels() {
        const groups = document.querySelectorAll('.input-group, .textarea-group')
        if (!groups.length) return

        groups.forEach((group) => {
          const control = group.querySelector('input, textarea')
          if (!(control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement)) return

          const syncState = () => {
            const hasValue = control.value.trim().length > 0
            group.setAttribute('data-floating-active', hasValue ? 'true' : 'false')
          }

          if (group.getAttribute('data-palo-floating-bound') !== 'true') {
            control.addEventListener('input', syncState)
            control.addEventListener('change', syncState)
            control.addEventListener('blur', syncState)
            control.addEventListener('animationstart', syncState)
            group.setAttribute('data-palo-floating-bound', 'true')
          }

          syncState()
          requestAnimationFrame(syncState)
          setTimeout(syncState, 0)
        })
      }

      document.addEventListener('astro:page-load', paloInitFloatingFormLabels)
      document.addEventListener('astro:after-swap', paloInitFloatingFormLabels)
      paloInitFloatingFormLabels()
    </script>
    <script is:inline>
      /**
       * Modal 淡出动画
       * 拦截组件原生 closeModal，先播放 .closing 动画再真正关闭
       * Escape 由 capture 阶段 keydown 统一处理（见下方）
       */
      let __origCloseModal = null

      function paloInitModalAnimation() {
        const dialogs = document.querySelectorAll('.modal')
        if (!dialogs.length) return

        // 保存原始 closeModal（Escape 和后续使用）
        if (typeof window.closeModal === 'function' && !__origCloseModal) {
          __origCloseModal = window.closeModal
        }

        // 包装全局 closeModal（关闭按钮 + 遮罩点击）
        if (typeof window.closeModal === 'function') {
          const origClose = window.closeModal
          window.closeModal = () =>
            closeWithAnimation(document.querySelector('.modal[open]'), origClose)
        }

        // 处理每个 Modal
        dialogs.forEach((dialog) => {
          // 监听 cancel 事件防止原生关闭行为
          dialog.addEventListener('cancel', (e) => {
            e.preventDefault()
          }, { capture: true })

          // 监听原生 open 方法，在打开前清理 closing 类
          const originalShowModal = dialog.showModal.bind(dialog)
          dialog.showModal = function() {
            dialog.classList.remove('closing')
            originalShowModal()
          }
        })
      }

      function closeWithAnimation(dialog, fallbackClose) {
        if (!dialog || dialog.classList.contains('closing')) return

        dialog.classList.add('closing')

        const finish = () => {
          dialog.classList.remove('closing')
          if (fallbackClose) fallbackClose()
          else dialog.close()
        }

        // 只监听 dialog 自身 fade-out，忽略 ::backdrop 冒泡上来的 animationend
        dialog.addEventListener('animationend', (e) => {
          if (e.target === dialog) finish()
        }, { once: true })
        // fallback：确保动画异常时也能关闭
        setTimeout(finish, 300)
      }

      document.addEventListener('astro:page-load', paloInitModalAnimation)
      document.addEventListener('astro:after-swap', paloInitModalAnimation)
      paloInitModalAnimation()
    </script>
    <script is:inline>
      /**
       * Launcher 淡入淡出动画
       * 使用 capture 阶段拦截全部关闭路径（关闭按钮、遮罩、Cmd+K），
       * 先播放 .closing 动画再真正 close。
       * Escape 由 capture 阶段 keydown 统一处理（见下方）。
       * Safari 兼容：capture 事件、keydown、keyframes—均广泛支持。
       */
      function paloInitLauncherAnimation() {
        const dialogs = document.querySelectorAll('.launcher')
        if (!dialogs.length) return

        dialogs.forEach((dialog) => {
          // 监听 cancel 事件防止原生关闭行为
          dialog.addEventListener('cancel', (e) => {
            e.preventDefault()
          }, { capture: true })

          // 监听原生 open 方法，在打开前清理 closing 类
          const originalShowModal = dialog.showModal.bind(dialog)
          dialog.showModal = function() {
            dialog.classList.remove('closing')
            originalShowModal()
          }

          // 1) 关闭按钮 — capture 阶段拦截，阻止组件 bubbling handler
          const closeBtn = dialog.querySelector('.close')
          if (closeBtn) {
            closeBtn.addEventListener(
              'click',
              (e) => {
                e.stopPropagation()
                closeLauncher(dialog)
              },
              { capture: true },
            )
          }

          // 2) 遮罩点击 — capture 阶段拦截位置在 dialog 自身上的 click
          dialog.addEventListener(
            'click',
            (e) => {
              if (e.target === dialog) {
                e.stopPropagation()
                closeLauncher(dialog)
              }
            },
            { capture: true },
          )
        })

        // 3) Cmd+K / Ctrl+K 快捷键 — capture 阶段提前拦截
        document.addEventListener(
          'keydown',
          (e) => {
            const isMac = navigator.userAgent.toLowerCase().includes('mac')
            const mod = isMac ? e.metaKey : e.ctrlKey
            if (mod && e.key.toLowerCase() === 'k') {
              const launcher = document.querySelector('.launcher[open]')
              if (launcher) {
                e.preventDefault()
                e.stopPropagation()
                closeLauncher(launcher)
              }
            }
          },
          { capture: true },
        )
      }

      function closeLauncher(dialog) {
        if (!dialog || dialog.classList.contains('closing')) return
        dialog.classList.add('closing')

        const finish = () => {
          dialog.classList.remove('closing')
          dialog.close()
        }
        // 只监听 dialog 自身 fade-out，忽略 ::backdrop 冒泡上来的 animationend
        dialog.addEventListener('animationend', (e) => {
          if (e.target === dialog) finish()
        }, { once: true })
        setTimeout(finish, 300)
      }

      document.addEventListener('astro:page-load', paloInitLauncherAnimation)
      document.addEventListener('astro:after-swap', paloInitLauncherAnimation)
      paloInitLauncherAnimation()

      // ═══════════════════════════════════════════
      //  Escape 统一处理（Modal + Launcher）
      //  使用 capture 阶段 keydown 在 dialog 原生处理之前拦截，
      //  解决 Safari 下 cancel 事件 preventDefault() 不可靠的问题。
      // ═══════════════════════════════════════════
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key !== 'Escape') return

          // 优先检查 Launcher（Launcher 打开时 modal 不显示）
          const launcher = document.querySelector('.launcher[open]')
          if (launcher && !launcher.classList.contains('closing')) {
            e.preventDefault()
            e.stopPropagation()
            closeLauncher(launcher)
            return
          }

          // 检查 Modal
          const modal = document.querySelector('.modal[open]')
          if (modal && !modal.classList.contains('closing')) {
            e.preventDefault()
            e.stopPropagation()
            closeWithAnimation(modal, __origCloseModal)
          }
        },
        { capture: true },
      )
    </script>
    <style lang="scss" is:global>
      @use 'scss/base/mixins' as *;

      @layer components {
        .accordion details.wrapper > .content {
          display: block;
        }

        .accordion details.wrapper.variant-default > .content {
          padding: 0;
        }

        .accordion details.wrapper.variant-default > .content > * {
          padding: 0 0 1.5rem 2.2rem;
        }

        .accordion details.wrapper.variant-chevron > .content {
          padding-block-end: 0;
        }

        .accordion details.wrapper.variant-chevron > .content > * {
          padding-block-end: 2.2rem;
        }

        html,
        body {
          height: 100%;
          overflow-x: clip;
        }

        body {
          display: flex;
          flex-direction: column;

          main {
            flex: 1 0 auto;
          }

          footer {
            flex-shrink: 0;
          }
        }

        pre {
          border: var(--border-width-surface, var(--border-width-global, 3px)) solid var(--link-color);
          border-radius: var(--radius-s);
          padding: 1rem;
        }

        .card {
          a {
            @include text-decoration(transparent, var(--foreground-color), 4px, 2px);
          }
        }
      }
    </style>
  </body>
