---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import { existsSync, readdirSync } from 'node:fs'
import { resolve } from 'node:path'
import { SEO } from 'astro-seo'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import type { ImageMetadata } from 'astro'
import themeConfig from '@config'
import { getCanonical } from '@utils/trailingSlash'

interface Props {
  /**
   * The title of the page
   */
  title?: string
  /**
   * The description of the page
   */
  description?: string
  /**
   * The URL of the page
   */
  url?: string
  /**
   * The image path for social sharing (can be ImageMetadata or string path)
   */
  image?: ImageMetadata | string | null
  /**
   * The author of the page
   */
  author?: string
  /**
   * The type of content (default: 'website')
   */
  type?: 'website' | 'article'
  /**
   * Whether to use the title template (default: true)
   * Set to false to use the title as-is without appending site name
   */
  useTitleTemplate?: boolean
}

const {
  title = themeConfig.metadata.title,
  description = themeConfig.metadata.description ?? '',
  url = Astro.url.href,
  image = themeConfig.metadata.image ?? null,
  author = themeConfig.metadata.author ?? '',
  type = 'website',
  useTitleTemplate = true,
} = Astro.props

const isHomePage = Astro.url.pathname === '/'

// ──────────────────────────────────────────────
//  Canonical URL & Trailing Slash Logic
// ──────────────────────────────────────────────
// Strip trailing slash from siteUrl for safe concatenation
const siteUrl = themeConfig.metadata.siteUrl.replace(/\/+$/, '')
/**
 * Ensure a path starts with '/'.
 * If path is empty or undefined, defaults to '/social-preview-image.png'.
 */
function ensureLeadingSlash(p: string): string {
  if (!p || p.trim() === '') {
    return '/social-preview-image.png'
  }
  return p.startsWith('/') ? p : `/${p}`
}

/**
 * Build an absolute URL for an image path, with double-slash protection.
 * Handles both ImageMetadata objects and string paths.
 */
function buildImageUrl(img: ImageMetadata | string | null): string {
  if (!img) {
    return `${siteUrl}/social-preview-image.png`
  }

  const path = typeof img === 'string' ? img : img.src
  const safePath = ensureLeadingSlash(path)

  // Use URL constructor for safe concatenation (handles double-slash)
  return new URL(safePath, `${siteUrl}/`).href
}

// Generate canonical URL from the current request URL's pathname
const canonicalUrl = getCanonical(Astro.url.pathname, themeConfig.metadata.siteUrl)

// Generate OG image URL
const imageUrl = buildImageUrl(image)

// ──────────────────────────────────────────────
//  Dynamic title generation
//  Rules:
//    - Homepage without explicit title → show themeConfig.metadata.title directly
//    - All other cases → {pageTitle} {titleSeparator} {siteName}
// ──────────────────────────────────────────────
const hasExplicitTitle = 'title' in Astro.props
const shouldUseRawTitle = isHomePage && !hasExplicitTitle

const seoTitle = shouldUseRawTitle ? themeConfig.metadata.title : title
const seoTitleTemplate =
  shouldUseRawTitle || !useTitleTemplate ? undefined : `%s ${themeConfig.site.titleSeparator} ${themeConfig.site.name}`

// ──────────────────────────────────────────────
//  Dynamic brand variables from config.yaml
// ──────────────────────────────────────────────
const {
  branding: { colors, font },
  layout,
  typography,
} = themeConfig

// ──────────────────────────────────────────────
//  Color-to-RGB helper for pulse colors
//  Accepts hex (#333, #333333) or named CSS colors ('orange').
// ──────────────────────────────────────────────
function colorToRgbTriplet(color: string): string {
  // Named CSS color → hex map (common subset)
  const namedColorMap: Record<string, string> = {
    orange: '#ffa500',
    red: '#ff0000',
    blue: '#0000ff',
    green: '#008000',
    yellow: '#ffff00',
    purple: '#800080',
    pink: '#ffc0cb',
    cyan: '#00ffff',
    white: '#ffffff',
    black: '#000000',
    gray: '#808080',
    grey: '#808080',
    silver: '#c0c0c0',
    maroon: '#800000',
    navy: '#000080',
    olive: '#808000',
    teal: '#008080',
    aqua: '#00ffff',
    fuchsia: '#ff00ff',
    lime: '#00ff00',
  }
  const hex = namedColorMap[color.toLowerCase()] ?? color
  return hexToRgbTriplet(hex)
}

function hexToRgbTriplet(hex: string): string {
  // Strip # and handle shorthand hex (e.g. #333 → #333333)
  let normalized = hex.replace(/^#/, '')
  if (normalized.length === 3) {
    normalized = normalized
      .split('')
      .map((c) => c + c)
      .join('')
  }
  const num = parseInt(normalized, 16)
  if (isNaN(num)) return '0, 0, 0'
  const r = (num >> 16) & 255
  const g = (num >> 8) & 255
  const b = num & 255
  return `${r}, ${g}, ${b}`
}

const defaultContainerMaxWidth = '90rem'
const containerMaxWidth = (() => {
  const raw = String(layout.containerMaxWidth ?? '').trim()
  if (!raw) {
    return defaultContainerMaxWidth
  }

  if (/^\d+(\.\d+)?(px|rem|em|vw|vh|vmin|vmax|ch|cm|mm|in|pc|%)$/i.test(raw)) {
    return raw
  }

  if (/^\d+(\.\d+)?$/.test(raw)) {
    return `${raw}px`
  }

  console.warn(
    `\n[Config Warning] layout.containerMaxWidth '${raw}' is not a valid CSS length. Falling back to ${defaultContainerMaxWidth}.\n`,
  )
  return defaultContainerMaxWidth
})()

const publicRoot = resolve(process.cwd(), 'public')
const fontDirectory = resolve(publicRoot, font.path.replace(/^\//, ''))

const fontWeightFileHints: Record<number, string[]> = {
  100: ['thin', '100'],
  200: ['extralight', 'extra-light', '200'],
  300: ['light', '300'],
  400: ['regular', '400'],
  500: ['medium', '500'],
  600: ['semibold', 'semi-bold', '600'],
  700: ['bold', '700'],
  800: ['extrabold', 'extra-bold', '800'],
  900: ['black', '900'],
}

const getPublicUrl = (absoluteFilePath: string): string => {
  const relativePath = absoluteFilePath.slice(publicRoot.length).replace(/\\/g, '/')
  return relativePath.startsWith('/') ? relativePath : `/${relativePath}`
}

const findFontFiles = (): string[] => {
  if (!existsSync(fontDirectory)) return []

  const stack = [fontDirectory]
  const files: string[] = []

  while (stack.length > 0) {
    const currentDirectory = stack.pop()
    if (!currentDirectory) continue

    for (const entry of readdirSync(currentDirectory, { withFileTypes: true })) {
      const entryPath = resolve(currentDirectory, entry.name)

      if (entry.isDirectory()) {
        stack.push(entryPath)
        continue
      }

      if (/\.(woff2|woff|ttf|otf)$/i.test(entry.name)) {
        files.push(entryPath)
      }
    }
  }

  return files.sort()
}

const availableFontFiles = findFontFiles()
const uniqueConfiguredWeights = [...new Set([font.weights.body, font.weights.accent, font.weights.heading])]

const selectStaticFontFile = (weight: number): string | null => {
  const hints = fontWeightFileHints[weight] ?? [String(weight)]
  const normalizedFiles = availableFontFiles.map((filePath) => ({
    path: filePath,
    name: filePath.split('/').pop()?.toLowerCase() ?? '',
  }))

  for (const hint of hints) {
    const match = normalizedFiles.find((file) => file.name.includes(hint))
    if (match) return match.path
  }

  return null
}

const variableFontFile =
  availableFontFiles.find((filePath) => /variablefont/i.test(filePath) && /\.(woff2|woff|ttf|otf)$/i.test(filePath)) ??
  null

const buildFontFaceCss = (): string => {
  if (variableFontFile) {
    const publicUrl = getPublicUrl(variableFontFile)
    const format = publicUrl.endsWith('.woff2')
      ? 'woff2'
      : publicUrl.endsWith('.woff')
        ? 'woff'
        : publicUrl.endsWith('.otf')
          ? 'opentype'
          : 'truetype'

    return `
@font-face {
  font-family: "${font.name}";
  src: url("${publicUrl}") format("${format}");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}
`.trim()
  }

  return uniqueConfiguredWeights
    .map((weight) => {
      const filePath = selectStaticFontFile(weight)
      if (!filePath) return ''

      const publicUrl = getPublicUrl(filePath)
      const format = publicUrl.endsWith('.woff2')
        ? 'woff2'
        : publicUrl.endsWith('.woff')
          ? 'woff'
          : publicUrl.endsWith('.otf')
            ? 'opentype'
            : 'truetype'

      return `
@font-face {
  font-family: "${font.name}";
  src: url("${publicUrl}") format("${format}");
  font-style: normal;
  font-weight: ${weight};
  font-display: swap;
}
`.trim()
    })
    .filter(Boolean)
    .join('\n')
}

const fontFaceCss = buildFontFaceCss()

const mobileScale = typography.mobileHeadingScale
const desktopScale = typography.desktopHeadingScale
const viewportMin = 375
const viewportMax = 1440
const rootFontSizePx = Number.parseFloat(typography.baseFontSize)

const buildScaleStep = (step: number) => {
  const mobileValueRem = step >= 0 ? Math.pow(mobileScale, step) : 1 / Math.pow(mobileScale, Math.abs(step))
  const desktopValueRem = step >= 0 ? Math.pow(desktopScale, step) : 1 / Math.pow(desktopScale, Math.abs(step))
  const mobileValuePx = mobileValueRem * rootFontSizePx
  const desktopValuePx = desktopValueRem * rootFontSizePx
  const slope = ((desktopValuePx - mobileValuePx) / (viewportMax - viewportMin)) * 100
  const intercept = (mobileValuePx - (slope * viewportMin) / 100) / rootFontSizePx

  return {
    min: Math.min(mobileValueRem, desktopValueRem),
    max: Math.max(mobileValueRem, desktopValueRem),
    slope,
    intercept,
  }
}

const fontScaleSteps = [-2, -1, 0, 1, 2, 3, 4, 5, 6, 7, 8] as const
const fontScaleMap = Object.fromEntries(fontScaleSteps.map((step) => [step, buildScaleStep(step)])) as Record<
  (typeof fontScaleSteps)[number],
  { min: number; max: number; slope: number; intercept: number }
>

const themeVariablesCss = `
:root:root {
  font-size: ${typography.baseFontSize};
  --m-scale: ${mobileScale};
  --d-scale: ${desktopScale};
  --heading-line-height-scale: ${typography.headingLineHeightScale};

  --brand-primary: ${colors.primary} !important;
  --brand-secondary: ${colors.secondary} !important;
  --brand-neutral: ${colors.neutral} !important;
  --brand-outline: ${colors.outline} !important;

  --color-pulse-primary: ${colorToRgbTriplet(colors.primary)} !important;
  --color-pulse-secondary: ${colorToRgbTriplet(colors.secondary)} !important;

  --brand-info: ${colors.info} !important;
  --brand-success: ${colors.success} !important;
  --brand-warning: ${colors.warning} !important;
  --brand-error: ${colors.error} !important;

  --color-pulse-info: ${colorToRgbTriplet(colors.info)} !important;
  --color-pulse-success: ${colorToRgbTriplet(colors.success)} !important;
  --color-pulse-warning: ${colorToRgbTriplet(colors.warning)} !important;
  --color-pulse-error: ${colorToRgbTriplet(colors.error)} !important;

  /* Semantic color variables — override accessible-astro-components hardcoded HSL values */
  --color-default-border: light-dark(var(--color-neutral-700), var(--color-neutral-400)) !important;
  --color-default-bg: light-dark(var(--color-neutral-200), var(--color-neutral-800)) !important;
  --color-default-text: light-dark(var(--color-neutral-900), var(--color-neutral-100)) !important;
  --color-info-border: var(--brand-info) !important;
  --color-info-bg: light-dark(oklch(from var(--brand-info) 95% c h), oklch(from var(--brand-info) 20% c h)) !important;
  --color-info-text: light-dark(var(--color-neutral-800), var(--color-neutral-100)) !important;
  --color-success-border: var(--brand-success) !important;
  --color-success-bg: light-dark(oklch(from var(--brand-success) 95% c h), oklch(from var(--brand-success) 20% c h)) !important;
  --color-success-text: light-dark(var(--color-neutral-800), var(--color-neutral-100)) !important;
  --color-warning-border: var(--brand-warning) !important;
  --color-warning-bg: light-dark(oklch(from var(--brand-warning) 95% c h), oklch(from var(--brand-warning) 20% c h)) !important;
  --color-warning-text: light-dark(var(--color-neutral-800), var(--color-neutral-100)) !important;
  --color-error-border: var(--brand-error) !important;
  --color-error-bg: light-dark(oklch(from var(--brand-error) 95% c h), oklch(from var(--brand-error) 20% c h)) !important;
  --color-error-text: light-dark(var(--color-neutral-800), var(--color-neutral-100)) !important;
  --color-pulse-default: 100, 100, 100;

  --font-family-name: "${font.name}";
  --font-body-family: "${font.name}";
  --font-heading-family: "${font.name}";
  --font-family-default: "${font.name}", sans-serif;
  --font-family-special: "${font.name}", sans-serif;
  --font-heading: var(--font-family-special);
  --font-body: var(--font-family-default);
  --font-weight-body: ${font.weights.body};
  --font-weight-accent: ${font.weights.accent};
  --font-weight-heading: ${font.weights.heading};
  --line-height-scale: ${typography.lineHeightScale};
  --display-text-transform: ${typography.uppercaseDisplayText ? 'uppercase' : 'none'};
  --font-size--2: clamp(${fontScaleMap[-2].min}rem, calc(${fontScaleMap[-2].intercept}rem + ${fontScaleMap[-2].slope}vw), ${fontScaleMap[-2].max}rem);
  --font-size--1: clamp(${fontScaleMap[-1].min}rem, calc(${fontScaleMap[-1].intercept}rem + ${fontScaleMap[-1].slope}vw), ${fontScaleMap[-1].max}rem);
  --font-size-0: clamp(${fontScaleMap[0].min}rem, calc(${fontScaleMap[0].intercept}rem + ${fontScaleMap[0].slope}vw), ${fontScaleMap[0].max}rem);
  --font-size-1: clamp(${fontScaleMap[1].min}rem, calc(${fontScaleMap[1].intercept}rem + ${fontScaleMap[1].slope}vw), ${fontScaleMap[1].max}rem);
  --font-size-2: clamp(${fontScaleMap[2].min}rem, calc(${fontScaleMap[2].intercept}rem + ${fontScaleMap[2].slope}vw), ${fontScaleMap[2].max}rem);
  --font-size-3: clamp(${fontScaleMap[3].min}rem, calc(${fontScaleMap[3].intercept}rem + ${fontScaleMap[3].slope}vw), ${fontScaleMap[3].max}rem);
  --font-size-4: clamp(${fontScaleMap[4].min}rem, calc(${fontScaleMap[4].intercept}rem + ${fontScaleMap[4].slope}vw), ${fontScaleMap[4].max}rem);
  --font-size-5: clamp(${fontScaleMap[5].min}rem, calc(${fontScaleMap[5].intercept}rem + ${fontScaleMap[5].slope}vw), ${fontScaleMap[5].max}rem);
  --font-size-6: clamp(${fontScaleMap[6].min}rem, calc(${fontScaleMap[6].intercept}rem + ${fontScaleMap[6].slope}vw), ${fontScaleMap[6].max}rem);
  --font-size-7: clamp(${fontScaleMap[7].min}rem, calc(${fontScaleMap[7].intercept}rem + ${fontScaleMap[7].slope}vw), ${fontScaleMap[7].max}rem);
  --font-size-8: clamp(${fontScaleMap[8].min}rem, calc(${fontScaleMap[8].intercept}rem + ${fontScaleMap[8].slope}vw), ${fontScaleMap[8].max}rem);
  --text-xs--line-height: calc((1 / 0.75) * var(--line-height-scale));
  --text-sm--line-height: calc((1.25 / 0.875) * var(--line-height-scale));
  --text-base--line-height: calc(1.5 * var(--line-height-scale));
  --text-lg--line-height: calc((1.75 / 1.125) * var(--line-height-scale));
  --text-xl--line-height: calc((1.75 / 1.25) * var(--line-height-scale));
  --text-2xl--line-height: calc((2 / 1.5) * var(--line-height-scale));
  --text-3xl--line-height: calc(1.2 * var(--line-height-scale));
  --text-4xl--line-height: calc((2.5 / 2.25) * var(--line-height-scale));
  --text-5xl--line-height: calc(1 * var(--line-height-scale));
  --text-6xl--line-height: calc(1 * var(--line-height-scale));
  --text-7xl--line-height: calc(1 * var(--line-height-scale));
  --text-8xl--line-height: calc(1 * var(--line-height-scale));
  --text-9xl--line-height: calc(1 * var(--line-height-scale));

  --grid-max-width: ${containerMaxWidth};
}
`.trim()
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {fontFaceCss && <style is:global set:html={fontFaceCss} />}

    <style is:global set:html={themeVariablesCss}></style>

    <SEO
      title={seoTitle}
      titleTemplate={seoTitleTemplate}
      titleDefault={themeConfig.metadata.title}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: imageUrl,
      }}
      extend={{
        meta: [
          {
            name: 'author',
            content: author,
          },
        ],
      }}
    />

    <!-- Enable Astro View Transitions for all browsers -->
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <style lang="scss" is:global>
      @use 'scss/base/mixins' as *;

      // sticky footer on low content pages
      html,
      body {
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;

        main {
          flex: 1 0 auto;
        }

        footer {
          flex-shrink: 0;
        }
      }

      pre {
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      .card {
        a {
          @include text-decoration(transparent, var(--foreground-color), 4px, 2px);
        }
      }
    </style>
  </body>
</html>
