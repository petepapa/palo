---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import { SEO } from 'astro-seo'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import type { ImageMetadata } from 'astro'
import themeConfig from '@config'

interface Props {
  /**
   * The title of the page
   */
  title?: string
  /**
   * The description of the page
   */
  description?: string
  /**
   * The URL of the page
   */
  url?: string
  /**
   * The image path for social sharing (can be ImageMetadata or string path)
   */
  image?: ImageMetadata | string | null
  /**
   * The author of the page
   */
  author?: string
  /**
   * The type of content (default: 'website')
   */
  type?: 'website' | 'article'
  /**
   * Whether to use the title template (default: true)
   * Set to false to use the title as-is without appending site name
   */
  useTitleTemplate?: boolean
}

const {
  title = themeConfig.metadata.title,
  description = themeConfig.metadata.description ?? '',
  url = Astro.url.href,
  image = themeConfig.metadata.image ?? null,
  author = themeConfig.metadata.author ?? '',
  type = 'website',
  useTitleTemplate = true,
} = Astro.props

const isHomePage = Astro.url.pathname === '/'

// ──────────────────────────────────────────────
//  Canonical URL & Trailing Slash Logic
// ──────────────────────────────────────────────
// Strip trailing slash from siteUrl for safe concatenation
const siteUrl = themeConfig.metadata.siteUrl.replace(/\/+$/, '')
const shouldTrailingSlash = themeConfig.site.trailingSlash

/**
 * Build an absolute URL respecting trailingSlash setting.
 * If the pathname is '/' (homepage), it always ends with '/'.
 * For other paths, append '/' only if trailingSlash is enabled.
 */
function buildCanonicalUrl(pathname: string): string {
  const normalized = pathname.replace(/\/+$/, '') || '/'
  if (normalized === '/') {
    return `${siteUrl}/`
  }
  if (shouldTrailingSlash) {
    return `${siteUrl}${normalized}/`
  }
  return `${siteUrl}${normalized}`
}

/**
 * Ensure a path starts with '/'.
 * If path is empty or undefined, defaults to '/social-preview-image.png'.
 */
function ensureLeadingSlash(p: string): string {
  if (!p || p.trim() === '') {
    return '/social-preview-image.png'
  }
  return p.startsWith('/') ? p : `/${p}`
}

/**
 * Build an absolute URL for an image path, with double-slash protection.
 * Handles both ImageMetadata objects and string paths.
 */
function buildImageUrl(img: ImageMetadata | string | null): string {
  if (!img) {
    return `${siteUrl}/social-preview-image.png`
  }

  const path = typeof img === 'string' ? img : img.src
  const safePath = ensureLeadingSlash(path)

  // Use URL constructor for safe concatenation (handles double-slash)
  return new URL(safePath, `${siteUrl}/`).href
}

// Generate canonical URL from the current request URL's pathname
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname)

// Generate OG image URL
const imageUrl = buildImageUrl(image)

// ──────────────────────────────────────────────
//  Dynamic title generation
//  Rules:
//    - Homepage without explicit title → show themeConfig.metadata.title directly
//    - All other cases → {pageTitle} {titleSeparator} {siteName}
// ──────────────────────────────────────────────
const hasExplicitTitle = 'title' in Astro.props
const shouldUseRawTitle = isHomePage && !hasExplicitTitle

const seoTitle = shouldUseRawTitle ? themeConfig.metadata.title : title
const seoTitleTemplate = shouldUseRawTitle || !useTitleTemplate
  ? undefined
  : `%s ${themeConfig.site.titleSeparator} ${themeConfig.site.name}`

// ──────────────────────────────────────────────
//  Dynamic brand variables from config.yaml
// ──────────────────────────────────────────────
const {
  branding: { colors, fontFamily },
  layout,
  typography,
} = themeConfig

// ──────────────────────────────────────────────
//  Utopia fluid type scale generator
//  Algorithm:
//    minFont = baseFontSize * (mobileScale ^ level)
//    maxFont = baseFontSize * (desktopScale ^ level)
//    slope   = ((maxFont - minFont) / (viewportMax - viewportMin)) * 100
//    clamp(minFont, slope cqi + intercept, maxFont)
// ──────────────────────────────────────────────
const baseFontSize = parseInt(typography.baseFontSize, 10) || 16
const viewportMin = 320
const viewportMax = 1240
const mobileScale = typography.mobileHeadingScale
const desktopScale = typography.desktopHeadingScale

function clampFontSize(level: number): string {
  const min = baseFontSize * Math.pow(mobileScale, level)
  const max = baseFontSize * Math.pow(desktopScale, level)
  const slope = ((max - min) / (viewportMax - viewportMin)) * 100
  const intercept = min - (slope * viewportMin) / 100
  return `clamp(${(min / baseFontSize).toFixed(4)}rem, ${slope.toFixed(4)}cqi + ${(intercept / baseFontSize).toFixed(4)}rem, ${(max / baseFontSize).toFixed(4)}rem)`
}

// Generate levels -2 through 8 to match _root.scss existing variable set
const fontSizeLevels: Record<string, string> = {}
for (let lvl = -2; lvl <= 8; lvl++) {
  const label = lvl < 0 ? `--font-size-${lvl}` : `--font-size-${lvl}`
  fontSizeLevels[label] = clampFontSize(lvl)
}
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- theme: brand colors, fonts, layout, and fluid typography injected from config.yaml -->
    <style is:global>
      :root {
        /* brand colors */
        --brand-primary: {colors.primary};
        --brand-secondary: {colors.secondary};
        --brand-neutral: {colors.neutral};
        --brand-outline: {colors.outline};

        /* font family */
        --font-family-default: {fontFamily};
        --font-family-special: {fontFamily};
        --font-heading: var(--font-family-special);
        --font-body: var(--font-family-default);

        /* layout */
        --grid-max-width: {layout.containerMaxWidth};

        /* fluid font sizes from Utopia algorithm */
        {Object.entries(fontSizeLevels).map(([key, val]) => `        ${key}: ${val};`).join('\n')}
      }
    </style>

    <SEO
      title={seoTitle}
      titleTemplate={seoTitleTemplate}
      titleDefault={themeConfig.metadata.title}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: imageUrl,
      }}
      extend={{
        meta: [
          {
            name: 'author',
            content: author,
          },
        ],
      }}
    />

    <!-- Enable Astro View Transitions for all browsers -->
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <style lang="scss" is:global>
      @use 'scss/base/mixins' as *;

      // sticky footer on low content pages
      html,
      body {
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;

        main {
          flex: 1 0 auto;
        }

        footer {
          flex-shrink: 0;
        }
      }

      pre {
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      .card {
        a {
          @include text-decoration(transparent, var(--foreground-color), 4px, 2px);
        }
      }
    </style>
  </body>
</html>