      // CSS 默认 overflow-y: auto（慢网/无 JS 安全）
      // JS 加载后动态切换状态：
      //   .is-un-stuck-locked → overflow-y: hidden（未贴顶时滚轮滚页面）
      //   .is-stuck → overflow-y: auto（贴顶后滚轮滚内部）
      const ELASTIC_SIDEBAR_SELECTORS = [
        '.article-content__toc',
        '.components-navigation',
      ]

      const checkSidebarStuck = (sidebar: HTMLElement): boolean => {
        const stickyTopStr = getComputedStyle(sidebar).top
        const stickyTop = parseFloat(stickyTopStr)
        if (isNaN(stickyTop)) return false

        const actualTop = sidebar.getBoundingClientRect().top
        return Math.abs(actualTop - stickyTop) < 2
      }

      const __paloSidebarStuckStates = new WeakMap<HTMLElement, boolean>()

      const updateSidebarStuckState = () => {
        const sidebars = document.querySelectorAll(ELASTIC_SIDEBAR_SELECTORS.join(','))
        sidebars.forEach((el) => {
          const sidebar = el as HTMLElement
          if (sidebar.offsetParent === null) return

          const isStuck = checkSidebarStuck(sidebar)
          const wasStuck = __paloSidebarStuckStates.get(sidebar) ?? false

          sidebar.classList.toggle('is-stuck', isStuck)
          sidebar.classList.toggle('is-un-stuck-locked', !isStuck)

          // 从 stuck → un-stuck 时刚性复位 scrollTop，确保标题始终在视口内
          if (wasStuck && !isStuck && sidebar.scrollTop > 0) {
            sidebar.scrollTop = 0
          }

          __paloSidebarStuckStates.set(sidebar, isStuck)
        })
      }

      let elasticScrollRaf = 0
      const scheduleElasticUpdate = () => {
        if (elasticScrollRaf) return
        elasticScrollRaf = requestAnimationFrame(() => {
          updateSidebarStuckState()
          elasticScrollRaf = 0
        })
      }

      const initElasticSidebarScroll = () => {
        const sidebars = document.querySelectorAll(ELASTIC_SIDEBAR_SELECTORS.join(','))
        if (sidebars.length === 0) return

