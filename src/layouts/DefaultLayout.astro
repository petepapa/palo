  --color-error-border: var(--brand-error) !important;
  --color-error-bg: light-dark(var(--color-error-200), var(--color-error-400)) !important;
  --color-error-text: light-dark(var(--color-neutral-800), var(--color-neutral-100)) !important;
  --color-pulse-default: 100, 100, 100;

  --font-family-name: "${font.name}";
  --font-body-family: "${font.name}";
  --font-heading-family: "${font.name}";
  --font-family-default: "${font.name}", sans-serif;
  --font-family-special: "${font.name}", sans-serif;
  --font-heading: var(--font-family-special);
  --font-body: var(--font-family-default);
  --font-weight-body: ${font.weights.body};
  --font-weight-accent: ${font.weights.accent};
  --font-weight-heading: ${font.weights.heading};
  --font-cap-height-offset: ${font.capHeightOffset || '-0.05em'};
  --line-height-scale: ${typography.lineHeightScale};
  --border-width-global: ${defaultBorderWidth};
  --border-width-button: ${buttonBorderWidth};
  --border-width-card: ${cardBorderWidth};
  --border-width-accordion: ${accordionBorderWidth};
  --border-width-tabs: ${tabsBorderWidth};
  --border-width-avatar: ${avatarBorderWidth};
  --border-width-badge: ${badgeBorderWidth};
  --border-width-notification: ${notificationBorderWidth};
  --border-width-form: ${formBorderWidth};
  --border-width-pagination: ${paginationBorderWidth};
  --border-width-toggle: ${toggleBorderWidth};
  --border-width-media: ${mediaBorderWidth};
  --border-width-surface: ${surfaceBorderWidth};
  --border-width-code-block: ${codeBlockBorderWidth};
  --border-width-modal: ${modalBorderWidth};
  --border-width-divider: ${dividerBorderWidth};
  --radius-global: ${defaultRadiusSize};
  --radius-xs: calc(${defaultRadiusSize} * 0.25);
  --radius-s: calc(${defaultRadiusSize} * 0.5);
  --radius-m: ${defaultRadiusSize};
  --radius-l: calc(${defaultRadiusSize} * 1.5);
  --radius-h: calc(${defaultRadiusSize} * 2);
  --radius-md: var(--radius-m);
  --radius-small: var(--radius-s);
  --radius-large: var(--radius-m);
  --radius-button: ${buttonRadiusSize};
  --radius-card: ${cardRadiusSize};
  --radius-media: ${mediaRadiusSize};
  --radius-tabs: ${tabsRadiusSize};
  --radius-avatar: ${avatarRadiusSize};
  --radius-badge: ${badgeRadiusSize};
  --radius-form: ${formRadiusSize};
  --radius-notification: ${notificationRadiusSize};
  --radius-pagination: ${paginationRadiusSize};
  --radius-toggle: ${toggleRadiusSize};
  --radius-surface: ${surfaceRadiusSize};
  --radius-code-block: ${codeBlockRadiusSize};
  --radius-modal: ${modalRadiusSize};
  --navigation-desktop-font-size: ${navigationDesktopFontSize};
  --navigation-mobile-font-size: ${navigationMobileFontSize};
  --navigation-dropdown-desktop-font-size: ${navigationDropdownDesktopFontSize};
  --navigation-dropdown-mobile-font-size: ${navigationDropdownMobileFontSize};
  --palo-nav-horizontal-space: ${navListHorizontalGapRem};
  --palo-nav-vertical-scale: ${navListVerticalScale};
  --palo-nav-heading-gap: calc(1em * var(--line-height-body, 1.5) * var(--palo-nav-vertical-scale, 1) * 1.5);
  --line-height-body: calc(1.6 * var(--line-height-scale));
  --logo-size: ${logoSize};
  --display-text-transform: ${typography.uppercaseDisplayText ? 'uppercase' : 'none'};
  --font-size--2: clamp(${fontScaleMap[-2].min}rem, calc(${fontScaleMap[-2].intercept}rem + ${fontScaleMap[-2].slope}vw), ${fontScaleMap[-2].max}rem) !important;
  --font-size--1: clamp(${fontScaleMap[-1].min}rem, calc(${fontScaleMap[-1].intercept}rem + ${fontScaleMap[-1].slope}vw), ${fontScaleMap[-1].max}rem) !important;
  --font-size-0: clamp(${fontScaleMap[0].min}rem, calc(${fontScaleMap[0].intercept}rem + ${fontScaleMap[0].slope}vw), ${fontScaleMap[0].max}rem) !important;
  --font-size-1: clamp(${fontScaleMap[1].min}rem, calc(${fontScaleMap[1].intercept}rem + ${fontScaleMap[1].slope}vw), ${fontScaleMap[1].max}rem) !important;
  --font-size-2: clamp(${fontScaleMap[2].min}rem, calc(${fontScaleMap[2].intercept}rem + ${fontScaleMap[2].slope}vw), ${fontScaleMap[2].max}rem) !important;
  --font-size-3: clamp(${fontScaleMap[3].min}rem, calc(${fontScaleMap[3].intercept}rem + ${fontScaleMap[3].slope}vw), ${fontScaleMap[3].max}rem) !important;
  --font-size-4: clamp(${fontScaleMap[4].min}rem, calc(${fontScaleMap[4].intercept}rem + ${fontScaleMap[4].slope}vw), ${fontScaleMap[4].max}rem) !important;
  --font-size-5: clamp(${fontScaleMap[5].min}rem, calc(${fontScaleMap[5].intercept}rem + ${fontScaleMap[5].slope}vw), ${fontScaleMap[5].max}rem) !important;
  --font-size-6: clamp(${fontScaleMap[6].min}rem, calc(${fontScaleMap[6].intercept}rem + ${fontScaleMap[6].slope}vw), ${fontScaleMap[6].max}rem) !important;
  --font-size-7: clamp(${fontScaleMap[7].min}rem, calc(${fontScaleMap[7].intercept}rem + ${fontScaleMap[7].slope}vw), ${fontScaleMap[7].max}rem) !important;
  --font-size-8: clamp(${fontScaleMap[8].min}rem, calc(${fontScaleMap[8].intercept}rem + ${fontScaleMap[8].slope}vw), ${fontScaleMap[8].max}rem) !important;
  --font-size-9: clamp(${fontScaleMap[9].min}rem, calc(${fontScaleMap[9].intercept}rem + ${fontScaleMap[9].slope}vw), ${fontScaleMap[9].max}rem) !important;
  --font-size-10: clamp(${fontScaleMap[10].min}rem, calc(${fontScaleMap[10].intercept}rem + ${fontScaleMap[10].slope}vw), ${fontScaleMap[10].max}rem) !important;
  --font-size-11: clamp(${fontScaleMap[11].min}rem, calc(${fontScaleMap[11].intercept}rem + ${fontScaleMap[11].slope}vw), ${fontScaleMap[11].max}rem) !important;
  --font-size-12: clamp(${fontScaleMap[12].min}rem, calc(${fontScaleMap[12].intercept}rem + ${fontScaleMap[12].slope}vw), ${fontScaleMap[12].max}rem) !important;
  --font-size-13: clamp(${fontScaleMap[13].min}rem, calc(${fontScaleMap[13].intercept}rem + ${fontScaleMap[13].slope}vw), ${fontScaleMap[13].max}rem) !important;
  /* 正文文本 - 基于 baseFontSize 动态计算 */
${bodyTextSizes}
${bodyLineHeights}

  --grid-max-width: ${containerMaxWidth};

  /* ── 语义颜色令牌（内联到首帧，慢速网络首帧即有颜色）── */
  --color-neutral-100: oklch(from var(--brand-neutral) 100% 0 0);
  --color-neutral-200: oklch(from var(--brand-neutral) 95% c h);
  --color-neutral-300: oklch(from var(--brand-neutral) 90% c h);
  --color-neutral-700: oklch(from var(--brand-neutral) 40% c h);
  --color-neutral-800: oklch(from var(--brand-neutral) 30% c h);
  --color-neutral-900: oklch(from var(--brand-neutral) 15% c h);
  --color-primary-400: oklch(from var(--brand-primary) 60% c h);
  --color-secondary-100: oklch(from var(--brand-secondary) 90% c h);
  --color-secondary-200: oklch(from var(--brand-secondary) 80% c h);
  --foreground-color: light-dark(var(--color-neutral-800), var(--color-neutral-100));
  --background-color: light-dark(var(--color-neutral-100), var(--color-neutral-900));
  --link-color: light-dark(var(--color-primary-400), var(--color-secondary-100));
  --border-color-subtle: light-dark(var(--color-neutral-300), var(--color-neutral-800));
}
`.trim()
---

<html lang="en" dir="ltr" class:list={[hideScrollbar && 'hide-scrollbar']}>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ defaultTheme, darkModeToggle }}>
      try {
        const storedTheme = localStorage.getItem('darkMode')
        // Locked theme: when defaultTheme is explicitly set (not auto) and toggle is off,
        // force the configured theme and clear any stale localStorage value.
        if (defaultTheme !== 'auto' && !darkModeToggle) {
          const useDarkTheme = defaultTheme === 'dark'
          document.documentElement.classList.toggle('darkmode', useDarkTheme)
          document.documentElement.style.colorScheme = useDarkTheme ? 'dark' : 'light'
          if (storedTheme) {
            localStorage.removeItem('darkMode')
          }
        } else if (!storedTheme) {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          const useDarkTheme = defaultTheme === 'dark' || (defaultTheme === 'auto' && prefersDark)
          document.documentElement.classList.toggle('darkmode', useDarkTheme)
          document.documentElement.style.colorScheme = useDarkTheme ? 'dark' : 'light'
        }
      } catch {
        // Keep the static light theme if browser storage or media queries are unavailable.
      }
    </script>

    {enableCustomCursor && (
      <script is:inline>
        document.documentElement.classList.add('has-custom-cursor')
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('has-custom-cursor')
        })
      </script>
    )}

    <style is:global set:html={`@layer tokens { ${themeVariablesCss} }`}></style>

    <!-- ═══════════════════════════════════════════════════════════════
         Anti-FOUC Shield / 刚性尺寸锚定版
         Slow 4G 下外部 CSS 到达前：
           • 纯黑底色，系统字体秒开导航文字（不再隐藏）
           • 导航栏锁死 64px + flex + gap 刚性布局，杜绝字体替换偏移
           • 右侧动态组件（图标/搜索框）隐藏，防止塌陷撑开
         font-display: swap 已在 @font-face 声明中配置，文字不会隐形。
         CSS 就绪后 data-css-ready="true" 激活，骨架平滑绽放。
         ═══════════════════════════════════════════════════════════════ -->
    <style is:inline>
      html:not([data-css-ready="true"]) {
        background-color: var(--background-color, #f8fafc) !important;
        color: var(--foreground-color, #1f2937) !important;
      }

      html:not([data-css-ready="true"]) body {
        margin: 0 !important;
        min-height: 100vh !important;
        background-color: var(--background-color, #f8fafc) !important;
        color: var(--foreground-color, #1f2937) !important;
      }

      html.darkmode:not([data-css-ready="true"]) {
        background-color: var(--background-color, #0f172a) !important;
        color: var(--foreground-color, #f8fafc) !important;
      }

      html.darkmode:not([data-css-ready="true"]) body {
        background-color: var(--background-color, #0f172a) !important;
        color: var(--foreground-color, #f8fafc) !important;
      }

      /* Header 背景与 Header.astro 内联关键 CSS 保持像素级一致，避免盾牌释放时跳变 */
      html:not([data-css-ready="true"]) header {
        position: ${shieldHeaderPosition} !important;
        inset-block-start: 0 !important;
        inset-inline-start: 0 !important;
        inset-inline-end: 0 !important;
        width: 100% !important;
        min-block-size: var(--nav-min-height, 4.5rem) !important;
        box-sizing: border-box !important;
        z-index: 50 !important;
        background-color: color-mix(
          in oklab,
          var(--background-color, #f8fafc) calc(var(--header-bg-opacity, ${headerBgOpacity}) * 100%),
          transparent
        ) !important;
        backdrop-filter: blur(var(--header-bg-blur, ${headerBgBlur})) !important;
        -webkit-backdrop-filter: blur(var(--header-bg-blur, ${headerBgBlur})) !important;
        transition: none !important;
      }

      html.darkmode:not([data-css-ready="true"]) header {
        background-color: color-mix(
          in oklab,
          var(--background-color, #0f172a) calc(var(--header-bg-opacity, ${headerBgOpacity}) * 100%),
          transparent
        ) !important;
      }

      html:not([data-css-ready="true"]) #main-navigation {
        background-color: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }

      html:not([data-css-ready="true"]) header.is-menu-open {
        background-color: var(--background-color, #f8fafc) !important;
        backdrop-filter: blur(var(--header-bg-blur, ${headerBgBlur})) !important;
        -webkit-backdrop-filter: blur(var(--header-bg-blur, ${headerBgBlur})) !important;
      }

      html.darkmode:not([data-css-ready="true"]) header.is-menu-open {
        background-color: var(--background-color, #0f172a) !important;
      }

      html:not([data-css-ready="true"]) header.is-at-top:not(.is-menu-open) {
        background-color: transparent !important;
        backdrop-filter: blur(0) !important;
        -webkit-backdrop-filter: blur(0) !important;
      }

      html:not([data-css-ready="true"]) header.is-at-top[data-top-navigation-theme='light'] {
        --foreground-color: #1f2937 !important;
        --background-color: #f8fafc !important;
        --icon-color: #1f2937 !important;
        --link-color: #1d4ed8 !important;
        --link-hover-color: #1e40af !important;
        --border-color: #111827 !important;
        --text-decoration-color: #374151 !important;
        --text-decoration-color-hover: #111827 !important;
        --outline-color: #d1d5db !important;
        color-scheme: light !important;
      }

      html:not([data-css-ready="true"]) header.is-at-top[data-top-navigation-theme='dark'] {
        --foreground-color: #f8fafc !important;
        --background-color: #111827 !important;
        --icon-color: #f8fafc !important;
        --link-color: #f8fafc !important;
        --link-hover-color: #e5e7eb !important;
        --border-color: #f8fafc !important;
        --text-decoration-color: #e5e7eb !important;
        --text-decoration-color-hover: #f8fafc !important;
        --outline-color: #f8fafc !important;
        color-scheme: dark !important;
      }

      html:not([data-css-ready="true"]) header.is-at-top[data-top-navigation-theme] :where(a, button, svg, .logo-text) {
        color: var(--foreground-color) !important;
      }

      html:not([data-css-ready="true"]) #main-navigation > .container {
        position: relative !important;
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: space-between !important;
        align-items: flex-start !important;
        width: 100% !important;
        max-width: var(--grid-max-width, 90rem) !important;
        margin-inline-start: auto !important;
        margin-inline-end: auto !important;
        padding-inline-start: var(--grid-gutter, 1.5rem) !important;
        padding-inline-end: var(--grid-gutter, 1.5rem) !important;
        box-sizing: border-box !important;
      }

      @media (min-width: 768px) {
        html:not([data-css-ready="true"]) #main-navigation > .container {
          padding-inline-start: 2rem !important;
          padding-inline-end: 2rem !important;
        }
      }

      @media (min-width: 1280px) {
        html:not([data-css-ready="true"]) #main-navigation > .container {
          padding-inline-start: 1rem !important;
          padding-inline-end: 1rem !important;
        }
      }

      html:not([data-css-ready="true"]) #main-navigation .nav-bar {
        display: flex !important;
        flex: 1 1 100% !important;
        justify-content: space-between !important;
        align-items: center !important;
        gap: var(--space-m, 1rem) !important;
        min-block-size: var(--nav-min-height, 4.5rem) !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }

      html:not([data-css-ready="true"]) #main-navigation > .container > .nav-bar > .wrapper {
        display: flex !important;
        align-items: center !important;
        gap: var(--space-m, 1rem) !important;
        min-block-size: var(--nav-min-height, 4.5rem) !important;
      }

      html:not([data-css-ready="true"]) .logo-link {
        display: flex !important;
        align-items: center !important;
        gap: 0.5rem !important;
        opacity: 1 !important;
        visibility: visible !important;
      }

      html:not([data-css-ready="true"]) .desktop-menu {
        display: none !important;
      }

      html:not([data-css-ready="true"]) .desktop-menu > ul {
        display: flex !important;
        align-items: center !important;
        gap: var(--space-m, 1rem) !important;
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      html:not([data-css-ready="true"]) .responsive-toggle,
      html:not([data-css-ready="true"]) .mobile-launcher {
        display: flex !important;
        align-items: center !important;
        gap: var(--space-2xs, 0.25rem) !important;
        min-block-size: var(--nav-min-height, 4.5rem) !important;
      }

      html:not([data-css-ready="true"]) .mobile-menu {
        display: none !important;
      }

      @media (min-width: 1050px) {
        html:not([data-css-ready="true"]) #main-navigation > .container {
          column-gap: var(--space-l, 1.5rem) !important;
        }

        html:not([data-css-ready="true"]) #main-navigation .nav-bar {
          flex: 1 1 auto !important;
        }

        html:not([data-css-ready="true"]) #main-navigation > .container > .nav-bar > .wrapper {
          flex: 1 1 auto !important;
          justify-content: flex-start !important;
          min-inline-size: 0 !important;
        }

        html:not([data-css-ready="true"]) .desktop-menu {
          display: grid !important;
          flex: 1 1 auto !important;
          grid-template-columns: minmax(0, 1fr) auto !important;
          align-items: center !important;
          column-gap: var(--space-m, 1rem) !important;
          min-inline-size: 0 !important;
        }

        html:not([data-css-ready="true"]) .desktop-menu > ul {
          display: flex !important;
          align-items: center !important;
          gap: var(--space-m, 1rem) !important;
          list-style: none !important;
          margin: 0 !important;
          padding: 0 !important;
          box-sizing: border-box !important;
        }

        html:not([data-css-ready="true"]) .desktop-menu > ul > li {
          align-content: center !important;
        }

        html:not([data-css-ready="true"]) .menu--utility {
          justify-self: end !important;
        }

        html:not([data-css-ready="true"]) .desktop-menu--left .menu--primary {
          justify-self: start !important;
        }

        html:not([data-css-ready="true"]) .desktop-menu--center .menu--primary {
          justify-self: center !important;
        }

        html:not([data-css-ready="true"]) .desktop-menu--right .menu--primary {
          justify-self: end !important;
        }

        html:not([data-css-ready="true"]) .menu-item {
          display: flex !important;
          align-items: center !important;
          list-style: none !important;
        }

        html:not([data-css-ready="true"]) header li.type-icon {
          display: block !important;
          translate: 0 4px !important;
        }

        html:not([data-css-ready="true"]) header li.type-icon button {
          border: none !important;
          border-radius: 0 !important;
        }

        html:not([data-css-ready="true"]) header li.type-icon svg {
          inline-size: 30px !important;
          block-size: 30px !important;
        }

        html:not([data-css-ready="true"]) header li.type-icon ~ li.type-icon {
          margin-inline-start: calc(var(--space-2xs, 0.25rem) * -1) !important;
        }

        html:not([data-css-ready="true"]) .mobile-launcher,
        html:not([data-css-ready="true"]) .mobile-menu,
        html:not([data-css-ready="true"]) .responsive-toggle {
          display: none !important;
        }
      }

      html:not([data-css-ready="true"]) #main-navigation a,
      html:not([data-css-ready="true"]) #main-navigation button:not(.trigger) {
        color: var(--foreground-color, #f8fafc) !important;
        background-color: transparent !important;
        border: none !important;
        text-decoration: none !important;
        font-size: var(--navigation-desktop-font-size, 1rem) !important;
        font-weight: var(--font-weight-accent, 400) !important;
        line-height: 1.5 !important;
        box-sizing: border-box !important;
      }

      html:not([data-css-ready="true"]) #main-navigation a:hover,
      html:not([data-css-ready="true"]) #main-navigation button:not(.trigger):hover,
      html:not([data-css-ready="true"]) #main-navigation a:focus-visible,
      html:not([data-css-ready="true"]) #main-navigation button:not(.trigger):focus-visible,
      html:not([data-css-ready="true"]) #main-navigation .is-active {
        text-decoration: underline !important;
        text-decoration-thickness: max(1.5px, 0.0625em) !important;
        text-underline-offset: 0.4375em !important;
        text-decoration-style: wavy !important;
      }

      /* Active 样式 — 与 Navigation.astro data-nav-active-style 各模式保持一致 */
      html:not([data-css-ready="true"]) #main-navigation[data-nav-active-style='underline'] .is-active {
        text-decoration-style: solid !important;
      }

      html:not([data-css-ready="true"]) #main-navigation[data-nav-active-style='bold'] .is-active {
        text-decoration: none !important;
        font-weight: var(--font-weight-heading) !important;
      }

      html:not([data-css-ready="true"]) #main-navigation[data-nav-active-style='boldwavy'] .is-active {
        font-weight: var(--font-weight-heading) !important;
      }

