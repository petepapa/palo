---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import { existsSync, readdirSync } from 'node:fs'
import { resolve } from 'node:path'
import { SEO } from 'astro-seo'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import type { ImageMetadata } from 'astro'
import themeConfig from '@config'
import { getCanonical } from '@utils/trailingSlash'

interface Props {
  /**
   * The title of the page
   */
  title?: string
  /**
   * The description of the page
   */
  description?: string
  /**
   * The URL of the page
   */
  url?: string
  /**
   * The image path for social sharing (can be ImageMetadata or string path)
   */
  image?: ImageMetadata | string | null
  /**
   * The author of the page
   */
  author?: string
  /**
   * The type of content (default: 'website')
   */
  type?: 'website' | 'article'
  /**
   * Whether to use the title template (default: true)
   * Set to false to use the title as-is without appending site name
   */
  useTitleTemplate?: boolean
}

const {
  title = themeConfig.metadata.title,
  description = themeConfig.metadata.description ?? '',
  url = Astro.url.href,
  image = themeConfig.metadata.image ?? null,
  author = themeConfig.metadata.author ?? '',
  type = 'website',
  useTitleTemplate = true,
} = Astro.props

const isHomePage = Astro.url.pathname === '/'

// ──────────────────────────────────────────────
//  Canonical URL & Trailing Slash Logic
// ──────────────────────────────────────────────
// Strip trailing slash from siteUrl for safe concatenation
const siteUrl = themeConfig.metadata.siteUrl.replace(/\/+$/, '')
/**
 * Ensure a path starts with '/'.
 * If path is empty or undefined, defaults to '/social-preview-image.png'.
 */
function ensureLeadingSlash(p: string): string {
  if (!p || p.trim() === '') {
    return '/social-preview-image.png'
  }
  return p.startsWith('/') ? p : `/${p}`
}

/**
 * Build an absolute URL for an image path, with double-slash protection.
 * Handles both ImageMetadata objects and string paths.
 */
function buildImageUrl(img: ImageMetadata | string | null): string {
  if (!img) {
    return `${siteUrl}/social-preview-image.png`
  }

  const path = typeof img === 'string' ? img : img.src
  const safePath = ensureLeadingSlash(path)

  // Use URL constructor for safe concatenation (handles double-slash)
  return new URL(safePath, `${siteUrl}/`).href
}

// Generate canonical URL from the current request URL's pathname
const canonicalUrl = getCanonical(Astro.url.pathname, themeConfig.metadata.siteUrl)

// Generate OG image URL
const imageUrl = buildImageUrl(image)

// ──────────────────────────────────────────────
//  Dynamic title generation
//  Rules:
//    - Homepage without explicit title → show themeConfig.metadata.title directly
//    - All other cases → {pageTitle} {titleSeparator} {siteName}
// ──────────────────────────────────────────────
const hasExplicitTitle = 'title' in Astro.props
const shouldUseRawTitle = isHomePage && !hasExplicitTitle

const seoTitle = shouldUseRawTitle ? themeConfig.metadata.title : title
const seoTitleTemplate =
  shouldUseRawTitle || !useTitleTemplate ? undefined : `%s ${themeConfig.site.titleSeparator} ${themeConfig.site.name}`

// ──────────────────────────────────────────────
//  Dynamic brand variables from config.yaml
// ──────────────────────────────────────────────
const {
  branding: { colors, font },
  layout,
  typography,
} = themeConfig

const defaultContainerMaxWidth = '90rem'
const containerMaxWidth = (() => {
  const raw = String(layout.containerMaxWidth ?? '').trim()
  if (!raw) {
    return defaultContainerMaxWidth
  }

  if (/^\d+(\.\d+)?(px|rem|em|vw|vh|vmin|vmax|ch|cm|mm|in|pc|%)$/i.test(raw)) {
    return raw
  }

  if (/^\d+(\.\d+)?$/.test(raw)) {
    return `${raw}px`
  }

  console.warn(
    `\n[Config Warning] layout.containerMaxWidth '${raw}' is not a valid CSS length. Falling back to ${defaultContainerMaxWidth}.\n`,
  )
  return defaultContainerMaxWidth
})()

const publicRoot = resolve(process.cwd(), 'public')
const fontDirectory = resolve(publicRoot, font.path.replace(/^\//, ''))

const fontWeightFileHints: Record<number, string[]> = {
  100: ['thin', '100'],
  200: ['extralight', 'extra-light', '200'],
  300: ['light', '300'],
  400: ['regular', '400'],
  500: ['medium', '500'],
  600: ['semibold', 'semi-bold', '600'],
  700: ['bold', '700'],
  800: ['extrabold', 'extra-bold', '800'],
  900: ['black', '900'],
}

const getPublicUrl = (absoluteFilePath: string): string => {
  const relativePath = absoluteFilePath.slice(publicRoot.length).replace(/\\/g, '/')
  return relativePath.startsWith('/') ? relativePath : `/${relativePath}`
}

const findFontFiles = (): string[] => {
  if (!existsSync(fontDirectory)) return []

  const stack = [fontDirectory]
  const files: string[] = []

  while (stack.length > 0) {
    const currentDirectory = stack.pop()
    if (!currentDirectory) continue

    for (const entry of readdirSync(currentDirectory, { withFileTypes: true })) {
      const entryPath = resolve(currentDirectory, entry.name)

      if (entry.isDirectory()) {
        stack.push(entryPath)
        continue
      }

      if (/\.(woff2|woff|ttf|otf)$/i.test(entry.name)) {
        files.push(entryPath)
      }
    }
  }

  return files.sort()
}

const availableFontFiles = findFontFiles()
const uniqueConfiguredWeights = [...new Set([font.weights.body, font.weights.accent, font.weights.heading])]

const selectStaticFontFile = (weight: number): string | null => {
  const hints = fontWeightFileHints[weight] ?? [String(weight)]
  const normalizedFiles = availableFontFiles.map((filePath) => ({
    path: filePath,
    name: filePath.split('/').pop()?.toLowerCase() ?? '',
  }))

  for (const hint of hints) {
    const match = normalizedFiles.find((file) => file.name.includes(hint))
    if (match) return match.path
  }

  return null
}

const variableFontFile =
  availableFontFiles.find((filePath) => /variablefont/i.test(filePath) && /\.(woff2|woff|ttf|otf)$/i.test(filePath)) ??
  null

const buildFontFaceCss = (): string => {
  if (variableFontFile) {
    const publicUrl = getPublicUrl(variableFontFile)
    const format = publicUrl.endsWith('.woff2')
      ? 'woff2'
      : publicUrl.endsWith('.woff')
        ? 'woff'
        : publicUrl.endsWith('.otf')
          ? 'opentype'
          : 'truetype'

    return `
@font-face {
  font-family: "${font.name}";
  src: url("${publicUrl}") format("${format}");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}
`.trim()
  }

  return uniqueConfiguredWeights
    .map((weight) => {
      const filePath = selectStaticFontFile(weight)
      if (!filePath) return ''

      const publicUrl = getPublicUrl(filePath)
      const format = publicUrl.endsWith('.woff2')
        ? 'woff2'
        : publicUrl.endsWith('.woff')
          ? 'woff'
          : publicUrl.endsWith('.otf')
            ? 'opentype'
            : 'truetype'

      return `
@font-face {
  font-family: "${font.name}";
  src: url("${publicUrl}") format("${format}");
  font-style: normal;
  font-weight: ${weight};
  font-display: swap;
}
`.trim()
    })
    .filter(Boolean)
    .join('\n')
}

const fontFaceCss = buildFontFaceCss()

// ──────────────────────────────────────────────
//  Utopia fluid type scale generator
//  Algorithm:
//    minFont = baseFontSize * (mobileScale ^ level)
//    maxFont = baseFontSize * (desktopScale ^ level)
//    slope   = ((maxFont - minFont) / (viewportMax - viewportMin)) * 100
//    clamp(minFont, slope cqi + intercept, maxFont)
// ──────────────────────────────────────────────
const baseFontSize = parseInt(typography.baseFontSize, 10) || 16
const viewportMin = 320
const viewportMax = 1240
const mobileScale = typography.mobileHeadingScale
const desktopScale = typography.desktopHeadingScale

function clampFontSize(level: number): string {
  const min = baseFontSize * Math.pow(mobileScale, level)
  const max = baseFontSize * Math.pow(desktopScale, level)
  const slope = ((max - min) / (viewportMax - viewportMin)) * 100
  const intercept = min - (slope * viewportMin) / 100
  return `clamp(${(min / baseFontSize).toFixed(4)}rem, ${slope.toFixed(4)}cqi + ${(intercept / baseFontSize).toFixed(4)}rem, ${(max / baseFontSize).toFixed(4)}rem)`
}

// Generate levels -2 through 8 to match _root.scss existing variable set
const fontSizeLevels: Record<string, string> = {}
for (let lvl = -2; lvl <= 8; lvl++) {
  const label = lvl < 0 ? `--font-size-${lvl}` : `--font-size-${lvl}`
  fontSizeLevels[label] = clampFontSize(lvl)
}

const themeVariablesCss = `
:root {
  font-size: ${typography.baseFontSize};

  --brand-primary: ${colors.primary};
  --brand-secondary: ${colors.secondary};
  --brand-neutral: ${colors.neutral};
  --brand-outline: ${colors.outline};

  --font-family-name: "${font.name}";
  --font-body-family: "${font.name}";
  --font-heading-family: "${font.name}";
  --font-family-default: "${font.name}", sans-serif;
  --font-family-special: "${font.name}", sans-serif;
  --font-heading: var(--font-family-special);
  --font-body: var(--font-family-default);
  --font-weight-body: ${font.weights.body};
  --font-weight-accent: ${font.weights.accent};
  --font-weight-heading: ${font.weights.heading};
  --line-height-scale: ${typography.lineHeightScale};
  --heading-line-height-scale: ${typography.headingLineHeightScale};
  --display-text-transform: ${typography.uppercaseDisplayText ? 'uppercase' : 'none'};
  --heading-line-height-h1: calc(1.05 * var(--line-height-scale) * var(--heading-line-height-scale));
  --heading-line-height-h2: calc(1.12 * var(--line-height-scale) * var(--heading-line-height-scale));
  --heading-line-height-h3: calc(1.18 * var(--line-height-scale) * var(--heading-line-height-scale));
  --heading-line-height-h4: calc(1.24 * var(--line-height-scale) * var(--heading-line-height-scale));
  --heading-line-height-h5: calc(1.3 * var(--line-height-scale) * var(--heading-line-height-scale));
  --heading-line-height-h6: calc(1.35 * var(--line-height-scale) * var(--heading-line-height-scale));
  --text-xs--line-height: calc((1 / 0.75) * var(--line-height-scale));
  --text-sm--line-height: calc((1.25 / 0.875) * var(--line-height-scale));
  --text-base--line-height: calc(1.5 * var(--line-height-scale));
  --text-lg--line-height: calc((1.75 / 1.125) * var(--line-height-scale));
  --text-xl--line-height: calc((1.75 / 1.25) * var(--line-height-scale));
  --text-2xl--line-height: calc((2 / 1.5) * var(--line-height-scale));
  --text-3xl--line-height: calc(1.2 * var(--line-height-scale));
  --text-4xl--line-height: calc((2.5 / 2.25) * var(--line-height-scale));
  --text-5xl--line-height: calc(1 * var(--line-height-scale));
  --text-6xl--line-height: calc(1 * var(--line-height-scale));
  --text-7xl--line-height: calc(1 * var(--line-height-scale));
  --text-8xl--line-height: calc(1 * var(--line-height-scale));
  --text-9xl--line-height: calc(1 * var(--line-height-scale));

  --grid-max-width: ${containerMaxWidth};

${Object.entries(fontSizeLevels)
  .map(([key, val]) => `  ${key}: ${val};`)
  .join('\n')}
}
`.trim()
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {fontFaceCss && <style is:global set:html={fontFaceCss} />}

    <style is:global set:html={themeVariablesCss}></style>

    <SEO
      title={seoTitle}
      titleTemplate={seoTitleTemplate}
      titleDefault={themeConfig.metadata.title}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: imageUrl,
      }}
      extend={{
        meta: [
          {
            name: 'author',
            content: author,
          },
        ],
      }}
    />

    <!-- Enable Astro View Transitions for all browsers -->
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <style lang="scss" is:global>
      @use 'scss/base/mixins' as *;

      // sticky footer on low content pages
      html,
      body {
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        overflow-x: clip;

        main {
          flex: 1 0 auto;
        }

        footer {
          flex-shrink: 0;
        }
      }

      pre {
        border: 2px solid var(--link-color);
        border-radius: 0.35rem;
        padding: 1rem;
      }

      .card {
        a {
          @include text-decoration(transparent, var(--foreground-color), 4px, 2px);
        }
      }
    </style>
  </body>
</html>
