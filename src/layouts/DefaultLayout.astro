      /* ── 关键修复：Shield 阶段刚性宽度锚定 ──
         在 prose 增强脚本执行前（表格尚未被 .table-wrapper 包裹），
         防止宽表格 / 代码块 / BreakoutImage 撑破视口，
         避免 iOS Safari 文档宽度被污染，造成 Shield 骨架横向拉伸错乱。

         ⚠️ 兼容性注意：
         - 用 overflow-x: hidden 而不是 clip：clip 在 iOS Safari <16 支持不一致，
           可能降级为 visible，完全失去作用。hidden 更保守、更可靠。
         - contain: layout paint size：强制 iOS Safari 在计算视口宽度时
           忽略子元素溢出尺寸，真正把宽度锁死。 */
      html:not([data-css-ready="true"]),
      html:not([data-css-ready="true"]) body {
        overflow-x: hidden !important;
        contain: layout paint;
      }

      html:not([data-css-ready="true"]) main,
      html:not([data-css-ready="true"]) .container,
      html:not([data-css-ready="true"]) .prose,
      html:not([data-css-ready="true"]) .article-content,
      html:not([data-css-ready="true"]) .article-content__main,
      html:not([data-css-ready="true"]) section > .container,
      html:not([data-css-ready="true"]) #main-content > * {
        max-width: 100% !important;
        overflow-x: hidden !important;
        box-sizing: border-box !important;
        min-width: 0 !important;
      }

      /* Shield 阶段裸表格 / 代码块强制不撑破父容器
         注意：不再使用 table-layout: fixed / td max-width:0 这种过激规则，
         因为 _prose.scss 已给裸 table 加了 display:block + overflow-x:auto 的永久兜底，
         过激规则会导致 Shield→正常态切换时出现瞬间布局跳动，反而让 iOS Safari 计算错乱 */
      html:not([data-css-ready="true"]) .prose table,
      html:not([data-css-ready="true"]) .prose pre,
      html:not([data-css-ready="true"]) .prose blockquote {
        max-width: 100% !important;
        overflow-x: auto !important;
        display: block !important;
        box-sizing: border-box !important;
        -webkit-overflow-scrolling: touch !important;
      }

      html:not([data-css-ready="true"]) .prose code,
      html:not([data-css-ready="true"]) .prose pre code {
        white-space: pre-wrap !important;
        word-wrap: break-word !important;
        word-break: break-word !important;
      }

      /* Shield 阶段 BreakoutImage 不参与横向突破，防止 100vw fallback 撑破 iOS Safari */
      html:not([data-css-ready="true"]) .breakout-image,
      html:not([data-css-ready="true"]) [data-breakout-image],
      html:not([data-css-ready="true"]) .breakout-image-wrapper,
      html:not([data-css-ready="true"]) .breakout {
        max-width: 100% !important;
        width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        overflow: hidden !important;
      }

    </style>

    <script is:inline>
      (function () {
        function getStorageKey() {
          return 'palo_scroll_' + window.location.pathname + window.location.search;
        }

        if (window.location.hash) {
          window['__paloCustomHashScroll'] = true;
          window['__paloInitialHash'] = window.location.hash.replace('#', '');
          history.replaceState(null, '', window.location.pathname + window.location.search);
          window.scrollTo(0, 0);
        } else {
          window['__paloCustomHashScroll'] = false;
        }

        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }

        var activeScrollFrame = null
        var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        function cancelSmoothScroll() {
          if (activeScrollFrame !== null) {
            cancelAnimationFrame(activeScrollFrame)
            activeScrollFrame = null
          }
        }

        function smoothScrollTo(targetY) {
          if (prefersReducedMotion) {
            window.scrollTo(0, targetY)
            return
          }

          cancelSmoothScroll()
          var startY = window.scrollY
          var distance = targetY - startY
          if (Math.abs(distance) < 2) {
            window.scrollTo(0, targetY)
            return
          }

          var duration = Math.min(900, Math.max(300, Math.sqrt(Math.abs(distance)) * 18))
          var startTime = performance.now()
          var rootStyle = document.documentElement.style
          var previousScrollBehavior = rootStyle.scrollBehavior
          rootStyle.scrollBehavior = 'auto'

          function easeOutExpo(t) {
            return t === 0 ? 0 : 1 - Math.pow(2, -10 * t)
          }

          function step(currentTime) {
            var elapsed = currentTime - startTime
            var progress = Math.min(elapsed / duration, 1)
            if (progress >= 1) {
              window.scrollTo(0, targetY)
              rootStyle.scrollBehavior = previousScrollBehavior
              activeScrollFrame = null
            } else {
              var eased = easeOutExpo(progress)
              window.scrollTo(0, startY + distance * eased)
              activeScrollFrame = requestAnimationFrame(step)
            }
          }

          step(startTime)
        }

        var restoredScrollPosition = false

        function restoreScrollPosition() {
          if (restoredScrollPosition || window.location.hash || window['__paloInitialHash']) {
            return
          }
          restoredScrollPosition = true

          var savedY = sessionStorage.getItem(getStorageKey())

          // ── 在滚动动画之前，立即根据 saved 位置同步 header 状态 ──
          // 解决 scroll 恢复时 header.is-at-top 未及时更新的问题
          if (savedY !== null) {
            var header = document.querySelector('header')
            if (header) {
              var headerHeight = header.offsetHeight || 64
              header.classList.toggle('is-at-top', parseInt(savedY, 10) <= headerHeight)
            }
          }

          var rootStyle = document.documentElement.style
          var previousScrollBehavior = rootStyle.scrollBehavior
          rootStyle.scrollBehavior = 'auto'
          window.scrollTo(0, 0)
          rootStyle.scrollBehavior = previousScrollBehavior

          if (savedY !== null) {
            smoothScrollTo(parseInt(savedY, 10))
          }
        }

        function releaseShield() { document.documentElement.setAttribute('data-css-ready', 'true'); }
        function lockShield() { document.documentElement.removeAttribute('data-css-ready'); }

        function syncHeaderThemeFromMain() {
          var header = document.querySelector('header')
          if (!header || !header.classList.contains('is-at-top') || header.dataset.topNavigationTheme) return

          var source = document.querySelector('main [data-top-navigation-theme]')
          var theme = source && source.getAttribute('data-top-navigation-theme')
          if (theme === 'light' || theme === 'dark') {
            header.dataset.topNavigationTheme = theme
          }
        }

        function scheduleReleaseShield() {
          var released = false

          function tryRelease() {
            if (released) return
            released = true
            releaseShield()
          }

          function stylesheetsReady() {
            var links = document.querySelectorAll('link[rel="stylesheet"]')
            if (!links.length) return true

            for (var i = 0; i < links.length; i++) {
              if (!links[i].sheet) return false
            }

            return true
          }

          function waitForPaintReady() {
            if (stylesheetsReady()) {
              requestAnimationFrame(tryRelease)
              return
            }

            setTimeout(waitForPaintReady, 32)
          }

          if (document.readyState === 'complete') {
            tryRelease()
            return
          }

          // DOM + 样式表就绪即可释放；不必等待图片/字体等阻塞资源
          document.addEventListener(
            'DOMContentLoaded',
            function () {
              waitForPaintReady()
            },
            { once: true },
          )

          window.addEventListener('load', tryRelease, { once: true })
          setTimeout(tryRelease, 3000)
        }

        function initScrollRestore() {
          if (document.readyState !== 'loading') {
            restoreScrollPosition()
          } else {
            document.addEventListener('DOMContentLoaded', restoreScrollPosition)
          }
        }

        // 1. 首次加载：DOM 就绪后同步 header 主题，等 CSS 加载完再释放首帧盾牌
        initScrollRestore()
        window.addEventListener('pageshow', initScrollRestore)

        function onDomReady() {
          syncHeaderThemeFromMain()
          scheduleReleaseShield()
        }

        if (document.readyState !== 'loading') {
          onDomReady()
        } else {
          document.addEventListener('DOMContentLoaded', onDomReady)
        }

        // 2. 实时保存滚动位置（100ms 节流）
        var scrollTimer;
        window.addEventListener('scroll', function () {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(function () {
            sessionStorage.setItem(getStorageKey(), String(window.scrollY));
          }, 100);
        }, { passive: true });

        // 3. Astro SPA 生命周期深度适配
        document.addEventListener('astro:before-swap', function () {
          sessionStorage.setItem(getStorageKey(), String(window.scrollY));
          lockShield();
        });

        document.addEventListener('astro:after-swap', function () {
          // DOM 树已替换完毕，节点存在，精确恢复滚动
          restoreScrollPosition();
        });

        document.addEventListener('astro:page-load', function () {
          syncHeaderThemeFromMain();
          releaseShield();
        });
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href={themeConfig.metadata.favicon || '/favicon.svg'} />
    <!-- Preload body weight font to reduce CLS -->
    {bodyFontPreloadUrl && bodyFontIsWoff2 && (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={bodyFontPreloadUrl} />
    )}
    <!-- Preload navigation accent font: 抢在网络请求最前列，杜绝导航 FOUT -->
    {navFontPreloadUrl && (
      <link rel="preload" as="font" type="font/ttf" crossorigin href={navFontPreloadUrl} />
    )}

    {fontFaceCss && <style is:global set:html={`@layer base { ${fontFaceCss} }`} />}

    <SEO
      title={seoTitle}
      titleTemplate={seoTitleTemplate}
      titleDefault={themeConfig.metadata.title}
      description={description}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: imageUrl,
      }}
      extend={{
        meta: [
          {
            name: 'author',
            content: author,
          },
        ],
      }}
    />

    <!-- ClientRouter：Astro 5 内置 SPA 路由 + 视图过渡，保护 CSS 加载顺序避免 FOUC -->
    <ClientRouter />

    <!-- ═══════════════════════════════════════════════════════════════
         Critical CSS Anti-FOUC Shield
         在慢速网络（3G/4G）下，浏览器在外部 CSS bundle 到达前会先用
         默认样式渲染 HTML（白底黑字、蓝链接、无约束布局）。
         此内联块涵盖首屏必需规则，确保第一帧即有正确的颜色和骨架。
         ═══════════════════════════════════════════════════════════════ -->
    <style is:global>
      @layer base {
        /* ── Body & link colors —— 防止白底/蓝链闪烁 ── */
        body {
          background-color: var(--background-color);
          color: var(--foreground-color);
          font-family: var(--font-body);
        }

        a {
          color: var(--link-color);
        }

        /* ── Spacing fallback —— 慢速网络下外部 SCSS 到达前的占位值 ── */
        :root {
          --space-xl: clamp(3rem, 2.8696rem + 0.6522vw, 3.375rem);
          --space-l: clamp(2rem, 1.913rem + 0.4348vw, 2.25rem);
        }

        /* ── PaloPageHeader 骨架：慢速网络下首屏基础 padding ──
           放在 @layer base，确保 config.yaml 中 paloPageHeader.class 的
           pt-* / pb-* / py-* / p-* 工具类（@layer utilities）能覆盖。
           使用 --nav-min-height 而非 --header-height：前者是静态 CSS 变量，
           不依赖 JS 执行，第一帧即有正确的顶部空间。 ── */
        :where(.palo-page-header--standard) {
          padding-top: calc(var(--nav-min-height, 4.5rem) + var(--page-header-padding-block, var(--space-xl, 3rem)));
          padding-bottom: var(--page-header-padding-block, var(--space-xl, 3rem));
        }

        /* ── PaloPageHeader 全屏模式骨架 ── */
        :where(.section-fullscreen.palo-page-header) {
          min-height: 100vh;
          padding-top: calc(var(--nav-min-height, 4.5rem) + var(--page-header-padding-block, var(--space-xl, 3rem)));
          padding-bottom: var(--page-header-padding-block, var(--space-xl, 3rem));
        }

        /* ── PaloPageHeader 非固定导航模式：额外的顶部空间 ── */
        :where(.palo-page-header--needs-header-space) {
          padding-top: var(--nav-min-height, 4.5rem);
        }
      }

      @layer components {
        /* ── 核心容器布局骨架 —— 防止内容区坍塌 ── */
        .container {
          margin-inline: auto;
          padding-inline: var(--grid-gutter);
          width: min(100%, var(--grid-max-width));
          max-width: var(--grid-max-width);
        }

        /* ── PaloPageHeader 布局骨架 —— CSS 到达前确保不会贴顶塌陷 ── */
        .palo-page-header {
          position: relative;
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          overflow: hidden;
          background-color: var(--page-header-background-color, var(--background-color));
        }

        .palo-page-header__content {
          position: relative;
          z-index: 2;
        }

        /* ── 文章详情页 Grid 布局 —— 防止 TOC 无约束平铺 ── */
        .article-content {
          display: grid;
          grid-template-columns: 1fr;
          gap: var(--space-l);
        }

        .article-content__main {
          min-width: 0;
        }

        /* ── TOC 容器初始约束 —— 防止未样式化列表铺满全屏 ── */
        .article-content__toc {
          display: block;
          grid-row: 1;
        }

        .article-toc {
          max-width: 100%;
          overflow-wrap: break-word;
          word-wrap: break-word;
        }

        .article-toc ul {
          list-style: none;
          padding-inline-start: 0;
        }

        .article-toc a {
          display: inline-block;
          max-width: 100%;
          overflow-wrap: break-word;
          word-break: break-word;
          text-decoration: none;
          color: var(--link-color);
        }

        /* ── TOC 骨架屏：慢速网络下首帧即有动画效果 ── */
        .article-toc__skeleton {
          display: block;
          margin-block: 0.35rem;
          list-style: none;
        }

        .article-toc__skeleton span {
          display: block;
          height: 1em;
          border-radius: 0.25rem;
          background: linear-gradient(
            90deg,
            var(--color-neutral-200, #e5e5e5) 25%,
            var(--color-neutral-100, #f5f5f5) 50%,
            var(--color-neutral-200, #e5e5e5) 75%
          );
          background-size: 200% 100%;
          animation: toc-skeleton-shimmer 1.5s linear infinite;
        }

        @media (prefers-color-scheme: dark) {
          .article-toc__skeleton span {
            background: linear-gradient(
              90deg,
              var(--color-neutral-700, #404040) 25%,
              var(--color-neutral-800, #262626) 50%,
              var(--color-neutral-700, #404040) 75%
            );
            background-size: 200% 100%;
          }
        }

        .article-toc__skeleton--h2 span { font-size: 1.25rem; width: 85%; }
        .article-toc__skeleton--h3 span { font-size: 1.125rem; width: 70%; margin-inline-start: 1rem; }
        .article-toc__skeleton--h4 span { font-size: 1rem; width: 60%; margin-inline-start: 2rem; }

        @keyframes toc-skeleton-shimmer {
          0% { background-position: 200% 0; }
          100% { background-position: -200% 0; }
        }

        /* ── TOC 标题 "On this page" 基础样式：慢网下保持正确外观 ── */
        .article-toc > h3,
        .article-toc > h4,
        .article-toc .space-content > h3,
        .article-toc .space-content > h4 {
          font-size: 1.125rem;
          font-weight: 600;
          margin-block: 0 0.75rem;
          color: var(--foreground-color);
        }

        /* ── Tags 标签栏 & 页脚导航：CSS 到达前屏蔽浏览器默认下划线 ── */
        .palo-nav-list a {
          text-decoration: none;
        }

        /* ── Footer / Tags / TOC：标题与第一行的间距统一跟随 verticalScale ── */
        :is(
          footer .flex.flex-col:has(>.palo-nav-list),
          .tags-filter,
          .article-toc
        ) {
          display: flex !important;
          flex-direction: column !important;
          gap: var(--palo-nav-heading-gap) !important;
        }

        .tags-filter .heading,
        .article-toc > * {
          margin-block: 0 !important;
        }

        @media (min-width: 768px) {
          .article-content--with-toc {
            grid-template-columns: minmax(0, 1fr) 280px;
          }

          .article-content__toc {
            grid-row: auto;
            position: sticky;
            align-self: start;
            top: var(--space-l, 2rem);
            max-height: calc(100vh - var(--space-l, 2rem));
            overflow-y: auto;
            padding-block-end: 5rem;
            scrollbar-width: none;
            -ms-overflow-style: none;
          }

          .article-content__toc::-webkit-scrollbar {
            display: none;
          }

          .article-content__toc.is-un-stuck-locked {
            overflow-y: hidden;
          }

          .article-content__toc.is-stuck {
            overflow-y: auto;
          }

          body.has-fixed-header .article-content__toc {
            top: calc(var(--header-height, 0px) + var(--space-l, 2rem));
            max-height: calc(100vh - var(--header-height, 0px) - var(--space-l, 2rem));
          }
        }

        /* ── 图片渐进加载骨架 —— 主色调占位 + 淡入刚性容器 ── */
        .progressive-img-container {
          position: relative;
          display: block;
          overflow: hidden;
          inline-size: 100%;
          block-size: 100%;
        }

        .progressive-img-inner {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
          opacity: 0;
        }

        /* ── PostHeader 封面图骨架 —— 防止图片区域坍塌 ── */
        .post-header__image {
          position: relative;
          left: 50%;
          right: 50%;
          margin-left: -50vw;
          margin-right: -50vw;
          width: 100vw;
          max-width: 100vw;
          height: 60vh;
          min-height: 60dvh;
          overflow: hidden;
        }

        /* ── Breakout 图片容器初始 rigid 约束 ── */
        .breakout-image-container {
          position: relative;
          overflow: hidden;
          --breakout-radius: var(--radius-media, var(--radius-global, 0.5rem));
        }

        .breakout-image-container :is(img, > div.absolute) {
          border-radius: var(--breakout-radius) !important;
        }

        .breakout-image-container img {
          display: block;
          width: 100%;
          height: auto;
        }

        /* ── full：贴近左右屏幕边缘，直角 ── */
        .breakout-image-container[data-layout="full"] {
          --breakout-radius: 0;
          margin-left: calc(calc(var(--viewport-width, 100vw) / -2) + 50%);
          margin-right: calc(calc(var(--viewport-width, 100vw) / -2) + 50%);
          border-radius: 0 !important;
        }

        /* ── wide：距离左右屏幕 1rem 间隙，圆角 ── */
        .breakout-image-container[data-layout="wide"] {
          margin-left: calc(calc(var(--viewport-width, 100vw) / -2) + 50% + 1rem);
          margin-right: calc(calc(var(--viewport-width, 100vw) / -2) + 50% + 1rem);
          border-radius: var(--breakout-radius) !important;
        }

        /* ── contained：对齐页面最大宽度容器，圆角 ── */
        .breakout-image-container[data-layout="contained"] {
          --breakout-contained-padding: var(--grid-gutter, 1rem);
          margin-left: calc(50% - min(calc(var(--viewport-width, 100vw) / 2), var(--grid-max-width) / 2) + var(--breakout-contained-padding));
          margin-right: calc(50% - min(calc(var(--viewport-width, 100vw) / 2), var(--grid-max-width) / 2) + var(--breakout-contained-padding));
          border-radius: var(--breakout-radius) !important;
        }

        @media (min-width: 768px) {
          .breakout-image-container[data-layout="contained"] {
            --breakout-contained-padding: 2rem;
          }
        }

        @media (min-width: 1280px) {
          .breakout-image-container[data-layout="contained"] {
            --breakout-contained-padding: 1rem;
          }
        }

        /* ── TOC 模式（≥768px 侧栏显示时）：三种 layout 宽度统一为主内容列宽度，不突破 ── */
        @media (min-width: 768px) {
          .article-content--with-toc .breakout-image-container {
            margin-left: 0 !important;
            margin-right: 0 !important;
          }
        }

        /* ── 窄文栏居中 ── */
        .narrow {
          margin-inline: auto;
          max-width: 65ch;
        }

        /* ── prose 正文区域基础样式 ── */
        .prose {
          color: var(--foreground-color);
        }

        /* ── 导航链接首帧样式 —— 防止慢网下退化为纯文本堆叠 ── */
        #main-navigation a {
          font-family: var(--font-body);
          font-weight: var(--font-weight-accent, 500);
          font-size: var(--text-base);
          display: inline-flex;
          align-items: center;
          text-decoration: none;
          color: var(--foreground-color);
        }

        #main-navigation .menu-item {
          display: flex;
          align-items: center;
          list-style: none;
        }

        /* ── PostHeader 元信息 & 分割线骨架 —— 防止作者/操作区塌陷 ── */
        .post-header__meta {
          display: grid;
          grid-template-columns: 1fr auto;
          align-items: center;
          gap: 1rem;
          margin-top: 1.5rem;
        }

        .post-header__divider {
          display: block;
          border-block-end: 1px solid var(--border-color-subtle, var(--color-neutral-300));
        }

        .post-header--needs-header-space {
          padding-block-start: var(--nav-min-height, 6rem);
        }

        @media (max-width: 768px) {
          .post-header__meta {
            grid-template-columns: 1fr;
          }
        }

        /* ── 纯图标按钮：完美正方形，图标尺寸由按钮 size 联动 ── */
        .button--icon-only {
          aspect-ratio: 1;
          padding: var(--space-xs);
        }

        .button--icon-only.button--sm {
          padding: var(--space-2xs);
        }

        .button--icon-only.button--lg {
          padding: var(--space-s);
        }

        .button--icon-only svg {
          width: 1.75em !important;
          height: 1.75em !important;
        }
      }
    </style>

    {enableCustomCursor && (
