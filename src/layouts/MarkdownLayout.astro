---
import DefaultLayout from './DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import TableOfContents from '@components/TableOfContents.astro'
import config from '@config'

const { frontmatter } = Astro.props
const toc = frontmatter.toc ?? false
const narrow = frontmatter.narrow ?? false
const pageHeader = frontmatter.pageHeader
const pageHeaderTitle = pageHeader?.title ?? frontmatter.title
const pageHeaderSubtitle = pageHeader?.subtitle ?? frontmatter.description
const pageHeaderBg = pageHeader?.bg ?? {}

// 读取全局 paloPageHeader.divider 默认值（来自 config.yaml）
const globalPaloPageHeaderDivider = config.components?.paloPageHeader?.divider ?? 'top'
// 前台显式传入 ''（空）时让 PaloPageHeader 走 resolveStringProp 回退到 config
// 前台传入具体值（top/bottom/both/false）时直接透传
const divider = pageHeader?.divider === '' || pageHeader?.divider === undefined ? '' : pageHeader?.divider
---

<style is:inline>
  /* ═══════════════════════════════════════════════════════════
     导航栏首帧防御盾（First-Frame Layout Lock）
     与 DefaultLayout 保持同步——MarkdownLayout 文章详情页
     在外部 CSS bundle 到达前，确保导航栏刚性骨架。
     ═══════════════════════════════════════════════════════════ */

  /* 外壳：主题感知底色 */
  html:not([data-css-ready="true"]) {
    background-color: var(--background-color) !important;
  }

  html:not([data-css-ready="true"]) body {
    background-color: var(--background-color) !important;
  }

  /* ── 1. header 骨架壳 ── */
  html:not([data-css-ready="true"]) #main-navigation,
  html:not([data-css-ready="true"]) .site-header,
  html:not([data-css-ready="true"]) header {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100% !important;
    min-height: var(--nav-min-height, 4.5rem) !important;
    height: var(--nav-min-height, 4.5rem) !important;
    background-color: var(--background-color) !important;
    border-bottom: 1px solid var(--border-color-subtle) !important;
    z-index: 9999;
  }

  /* ── 2. 内部容器布局刚性锁定 ── */
  html:not([data-css-ready="true"]) #main-navigation > .container {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    width: 100% !important;
    max-width: var(--grid-max-width, 90rem) !important;
    margin-inline: auto !important;
    padding-inline: var(--grid-gutter, 1.5rem) !important;
  }

  html:not([data-css-ready="true"]) #main-navigation .nav-bar {
    display: flex !important;
    flex: 1 1 100% !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 1rem !important;
    min-block-size: var(--nav-min-height, 4.5rem) !important;
  }

  html:not([data-css-ready="true"]) #main-navigation .wrapper {
    display: flex !important;
    align-items: center !important;
    gap: 1rem !important;
  }

  /* ── 3. 菜单项 UL 布局锁定 ── */
  html:not([data-css-ready="true"]) #main-navigation ul {
    display: flex !important;
    align-items: center !important;
    gap: var(--palo-nav-horizontal-space, 2rem) !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  html:not([data-css-ready="true"]) #main-navigation .menu-item {
    display: flex !important;
    align-items: center !important;
    list-style: none !important;
  }

  /* ── 4. 导航链接文字：主题字体 + CSS 变量色 ── */
  html:not([data-css-ready="true"]) #main-navigation a,
  html:not([data-css-ready="true"]) #main-navigation button:not(.responsive-toggle) {
    font-family: var(--font-body, sans-serif) !important;
    font-weight: var(--font-weight-accent, 500) !important;
    font-size: var(--navigation-desktop-font-size, 1rem) !important;
    display: inline-flex !important;
    align-items: center !important;
    text-decoration: none !important;
    color: var(--foreground-color) !important;
    background: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    -webkit-appearance: none !important;
  }

  /* ── 5. .has-dropdown > button：彻底剥离默认按钮灰色外观 ── */
  html:not([data-css-ready="true"]) .has-dropdown > button {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.25rem !important;
    background: none !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    color: var(--foreground-color) !important;
    font-family: var(--font-body, sans-serif) !important;
    font-weight: var(--font-weight-accent, 500) !important;
    font-size: var(--navigation-desktop-font-size, 1rem) !important;
    line-height: inherit !important;
    box-shadow: none !important;
    outline: none !important;
    cursor: pointer !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }

  html:not([data-css-ready="true"]) .has-dropdown > button:hover {
    cursor: pointer !important;
  }

  html:not([data-css-ready="true"]) .has-dropdown > button svg {
    width: 0.75em !important;
    height: 0.75em !important;
    opacity: 0.5 !important;
  }

  /* ── 6. 下拉菜单初始隐藏 ── */
  html:not([data-css-ready="true"]) .has-dropdown > ul.dropdown-menu {
    display: none !important;
  }

  /* ── 7. 移动端元素骨架期间隐藏 ── */
  html:not([data-css-ready="true"]) .responsive-toggle,
  html:not([data-css-ready="true"]) .mobile-launcher,
  html:not([data-css-ready="true"]) .mobile-menu {
    display: none !important;
  }

  /* 隐藏未水合完的动态组件 + a11y 标签 */
  html:not([data-css-ready="true"]) .skip-to-content,
  html:not([data-css-ready="true"]) [href="#main-content"],
  html:not([data-css-ready="true"]) .search-box,
  html:not([data-css-ready="true"]) .theme-toggle,
  html:not([data-css-ready="true"]) .darkmode-toggle {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* 导航核心图标 VIP 通道：astro-icon 内联 SVG 首帧可见 */
  html:not([data-css-ready="true"]) svg:not(.logo-svg svg, .type-icon svg, .menu-item--utility svg) {
    opacity: 0 !important;
  }

  /* Logo VIP 通道：骨架屏期间 Logo 保持完全可见 */
  html:not([data-css-ready="true"]) .logo-link {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* ═══════════════════════════════════════════════════════════
     纯 CSS 下拉菜单交互兜底（JS 到达前的空窗期防线）
     Slow 4G 下 JS 排队时，:hover/:focus-within 本能接管交互，
     用户悬停/聚焦 PORTFOLIO 立刻弹出菜单，不死等脚本水合。
     ═══════════════════════════════════════════════════════════ */

  /* Hover / 聚焦 → 展开下拉菜单（主题感知配色） */
  html:not([data-css-ready="true"]) .has-dropdown:hover > .dropdown-menu,
  html:not([data-css-ready="true"]) .has-dropdown:focus > .dropdown-menu,
  html:not([data-css-ready="true"]) .has-dropdown:focus-within > .dropdown-menu {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: absolute !important;
    inset-block-start: var(--nav-min-height, 4.5rem) !important;
    inset-inline-start: 0 !important;
    background-color: var(--background-color) !important;
    border: 1px solid var(--border-color-subtle) !important;
    padding: 1rem !important;
    min-inline-size: 275px !important;
    z-index: 100000 !important;
    list-style: none !important;
  }

  html:not([data-css-ready="true"]) .has-dropdown:hover > .dropdown-menu a,
  html:not([data-css-ready="true"]) .has-dropdown:focus > .dropdown-menu a,
  html:not([data-css-ready="true"]) .has-dropdown:focus-within > .dropdown-menu a {
    display: block !important;
    color: var(--foreground-color) !important;
    font-family: var(--font-body, sans-serif) !important;
    font-weight: var(--font-weight-body, 400) !important;
    font-size: 1rem !important;
    text-decoration: none !important;
    padding: 0.25rem 0 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }
</style>

<DefaultLayout
  title={frontmatter.title}
  description={frontmatter.description}
  hasHero={!!pageHeader}
  {...(frontmatter.image ? { image: frontmatter.image } : {})}
  {...(frontmatter.author ? { author: frontmatter.author } : {})}
  {...(frontmatter.type ? { type: frontmatter.type } : {})}
  {...(frontmatter.useTitleTemplate === undefined ? {} : { useTitleTemplate: frontmatter.useTitleTemplate })}
>
  {
    pageHeader && (
      <PaloPageHeader
        title={pageHeaderTitle}
        subtitle={pageHeaderSubtitle}
        fullscreen={pageHeader.fullscreen}
        bg={{
          image: pageHeaderBg.image ?? '',
          video: pageHeaderBg.video ?? '',
          color: pageHeaderBg.color ?? '',
          fixed: pageHeaderBg.fixed ?? false,
          overlayOpacity: pageHeaderBg.overlayOpacity ?? 0,
        }}
        contentColor={pageHeader.contentColor ?? ''}
        topNavigationTheme={pageHeader.topNavigationTheme ?? ''}
        divider={divider}
        alignV={pageHeader.alignV}
        alignH={pageHeader.alignH}
        useContainer={pageHeader.useContainer}
        class={pageHeader.class}
      />
    )
  }
  <section class="my-12">
    <div class="container">
      <div class={`article-content ${toc ? 'article-content--with-toc' : ''}`}>
        <div class="article-content__main">
    <div class={`prose space-content ${narrow ? 'narrow' : ''}`}>
      <slot />
    </div>
        </div>
        {toc && <TableOfContents />}
      </div>
    </div>
  </section>
</DefaultLayout>

<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" is:inline></script>
<script is:inline>
  const initProseEnhancements = async () => {
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'
    // 1. Table responsive wrapping
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return
      
      const wrapper = document.createElement('div')
      wrapper.className = 'table-wrapper overflow-x-auto my-6 max-w-full rounded-lg'
      
      table.parentNode?.insertBefore(wrapper, table)
      wrapper.appendChild(table)
    })

    // 2. Dynamic client-side Mermaid rendering
    const allMermaidBlocks = []
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.dataset.paloMermaidProcessed === 'true') return
      
      const code = pre.querySelector('code')
      if (!code) return
      
      // Check if it's a mermaid block - check multiple possible locations
      const isMermaid = pre.dataset.language === 'mermaid' ||
                        code.classList.contains('language-mermaid') || 
                        code.classList.contains('lang-mermaid') ||
                        /\blanguage-mermaid\b|\blang-mermaid\b/.test(pre.className)
      
      if (isMermaid) {
        if (DEBUG) console.log('Found Mermaid block:', pre)
        allMermaidBlocks.push(pre)
      }
    })

    if (allMermaidBlocks.length > 0 && typeof mermaid !== 'undefined') {
      try {
        if (DEBUG) console.log('Found', allMermaidBlocks.length, 'Mermaid block(s)')

        for (let i = 0; i < allMermaidBlocks.length; i++) {
          const pre = allMermaidBlocks[i]
          const code = pre.querySelector('code')
          const content = code?.textContent || pre.textContent || ''
          
          // 🔥 Create wrapper container with original code backup
          const container = document.createElement('div')
          container.className = 'mermaid-container'
          container.dataset.originalCode = content.trim() // Core: truth source for re-render
          
          // Inner div where Mermaid renders SVG
          const mermaidInner = document.createElement('div')
          mermaidInner.className = 'mermaid'
          mermaidInner.id = 'mermaid-' + Date.now() + '-' + i
          mermaidInner.textContent = content.trim()
          
          container.appendChild(mermaidInner)
          
          pre.dataset.paloMermaidProcessed = 'true'
          pre.replaceWith(container)
        }

        await renderMermaidWithTheme()
        if (DEBUG) console.log('Mermaid render complete')
      } catch (err) {
        console.error('Failed to load or render Mermaid:', err)
      }
    }
  }

  /**
   * 🔥 Read current CSS custom properties and re-initialize + run Mermaid for all .mermaid-container
   * Reads from dataset.originalCode on each .mermaid-container's inner .mermaid div.
   */
  const renderMermaidWithTheme = async () => {
    if (typeof mermaid === 'undefined') return
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'

    const containers = document.querySelectorAll('.mermaid-container')
    if (containers.length === 0) return

    const isDark = document.documentElement.classList.contains('darkmode')

    try {
      const cs = getComputedStyle(document.documentElement)
      const fg = cs.getPropertyValue('--foreground-color')?.trim() || (isDark ? '#fff' : '#111')
      const bg = cs.getPropertyValue('--background-color')?.trim() || (isDark ? '#111' : '#fff')
      const primary = cs.getPropertyValue('--link-color')?.trim() || cs.getPropertyValue('--color-primary-400')?.trim() || '#4f46e5'
      const border = cs.getPropertyValue('--border-color')?.trim() || '#888'

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
        themeVariables: {
          background: bg,
          textColor: fg,
          primaryColor: primary,
          lineColor: border,
        },
      })
    } catch (errTheme) {
      mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'loose' })
    }

    // 🔥 物理擦除重建：解决 Mermaid 10.x data-processed 缓存污染问题
    // 不要复用或修改已有的 .mermaid 节点 —— 必须物理擦除 + 全新创建
    containers.forEach((container) => {
      const rawCode = container.dataset.originalCode
      if (!rawCode) return

      // 1. 完全清空容器，抹除所有 data-processed 属性
      container.innerHTML = ''

      // 2. 创建全新的 div，绝对不携带任何 data-* 残留
      const newId = `mermaid-${Math.random().toString(36).substr(2, 9)}`
      const newDiv = document.createElement('div')
      newDiv.className = 'mermaid'
      newDiv.id = newId
      newDiv.textContent = rawCode // 源码塞入文本节点

      // 3. 追加到容器
      container.appendChild(newDiv)
    })

    try {
      await mermaid.run()
      if (DEBUG) console.log('[Mermaid] Re-render complete (theme:', isDark ? 'dark' : 'light', ')')
    } catch (err) {
      console.error('[Mermaid] Re-render failed:', err)
    }
  }

  /**
   * 🔥 MutationObserver: watch for darkmode class toggle on <html>, re-render Mermaid diagrams
   */
  const paloInitMermaidThemeWatcher = () => {
    // Only set up watcher if at least one .mermaid-container exists
    if (document.querySelectorAll('.mermaid-container').length === 0) return

    let pending = false
    const observer = new MutationObserver(() => {
      if (pending) return
      pending = true

      // Debounce: wait for all class changes to settle (e.g., multiple classList.toggle calls)
      requestAnimationFrame(() => {
        pending = false
        renderMermaidWithTheme()
      })
    })

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
  }



  // Handle standard page loads and View Transitions
  document.addEventListener('astro:page-load', initProseEnhancements)
  document.addEventListener('astro:after-swap', initProseEnhancements)
  
  /** 🔥 Initialize Mermaid theme watcher after prose enhancements have created .mermaid-container elements */
  const paloInitMermaidWatcherWithDelay = () => {
    // Small delay to ensure Mermaid CDN script and initProseEnhancements have run
    setTimeout(paloInitMermaidThemeWatcher, 200)
  }

  document.addEventListener('astro:page-load', paloInitMermaidWatcherWithDelay)
  document.addEventListener('astro:after-swap', paloInitMermaidWatcherWithDelay)
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProseEnhancements)
    document.addEventListener('DOMContentLoaded', paloInitMermaidWatcherWithDelay)
  } else {
    // Small delay to ensure mermaid CDN script is loaded
    setTimeout(initProseEnhancements, 100)
    paloInitMermaidThemeWatcher()
  }
</script>



<style lang="scss" is:global>
  @use 'scss/base/breakpoint' as *;

  @layer components {
    .article-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-l);

      &--with-toc {
        @media (min-width: 768px) {
          grid-template-columns: minmax(0, 1fr) 280px;
        }

        @media (min-width: 1200px) {
          grid-template-columns: minmax(0, 1fr) 320px;
        }
      }
    }

    .article-content__main {
      min-width: 0; // 防止内容溢出
    }

    .article-content--with-toc .article-content__main {
      @media (min-width: 768px) {
        border-inline-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        padding-inline-end: var(--space-l);
      }
    }

    .article-content--with-toc .breakout-image-container {
      margin-inline: 0 !important;
      width: 100% !important;
      max-width: 100% !important;

      img,
      div.absolute {
        border-radius: var(--radius-media, var(--radius-global, 0.5rem)) !important;
      }
    }

    .article-content__toc {
      grid-row: 1;

      @media (min-width: 768px) {
        position: sticky;
        grid-row: auto;
        align-self: start;
        inset-block-start: calc(var(--header-height) + var(--space-l));
        padding-inline-start: 0;
        max-inline-size: 100%;
        max-block-size: calc(100vh - calc(var(--header-height) + var(--space-l)));
        overflow-x: hidden;
        overflow-y: auto;
        transition: inset-block-start 0.6s cubic-bezier(0.075, 0.82, 0.165, 1);
      }
    }

    ul:not([class]) li {
      margin-block-end: 0.35rem;
    }

    .narrow {
      margin-inline: auto;
      max-width: 65ch;
    }
  }
</style>
