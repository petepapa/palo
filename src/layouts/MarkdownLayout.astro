---
import DefaultLayout from './DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'

const { frontmatter } = Astro.props
const containerClass = frontmatter.narrow ? 'narrow container' : 'container'
const pageHeader = frontmatter.pageHeader
const pageHeaderTitle = pageHeader?.title ?? frontmatter.title
const pageHeaderSubtitle = pageHeader?.subtitle ?? frontmatter.description
---

<DefaultLayout
  title={frontmatter.title}
  description={frontmatter.description}
  {...(frontmatter.image ? { image: frontmatter.image } : {})}
  {...(frontmatter.author ? { author: frontmatter.author } : {})}
  {...(frontmatter.type ? { type: frontmatter.type } : {})}
  {...(frontmatter.useTitleTemplate === undefined ? {} : { useTitleTemplate: frontmatter.useTitleTemplate })}
>
  {
    pageHeader && (
      <PaloPageHeader
        title={pageHeaderTitle}
        subtitle={pageHeaderSubtitle}
        fullscreen={pageHeader.fullscreen ?? false}
        backgroundImage={pageHeader.backgroundImage ?? ''}
        backgroundVideo={pageHeader.backgroundVideo ?? ''}
        backgroundColor={pageHeader.backgroundColor ?? ''}
        backgroundFixed={pageHeader.backgroundFixed ?? false}
        backgroundOverlayOpacity={pageHeader.backgroundOverlayOpacity ?? 0}
        contentColor={pageHeader.contentColor ?? ''}
        topNavigationTheme={pageHeader.topNavigationTheme ?? ''}
        showDivider={pageHeader.showDivider ?? true}
        paddingBlock={pageHeader.paddingBlock ?? ''}
        contentVerticalAlign={pageHeader.contentVerticalAlign ?? ''}
        contentHorizontalAlign={pageHeader.contentHorizontalAlign ?? ''}
        textAlign={pageHeader.textAlign ?? ''}
      />
    )
  }
  <div class={containerClass}>
    <div class="prose space-content my-12">
      <slot />
    </div>
  </div>
</DefaultLayout>

<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" is:inline></script>
<script is:inline>
  const initProseEnhancements = async () => {
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'
    // 1. Table responsive wrapping
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return
      
      const wrapper = document.createElement('div')
      wrapper.className = 'table-wrapper overflow-x-auto my-6 max-w-full rounded-lg'
      
      table.parentNode?.insertBefore(wrapper, table)
      wrapper.appendChild(table)
    })

    // 2. Dynamic client-side Mermaid rendering
    const allMermaidBlocks = []
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.dataset.paloMermaidProcessed === 'true') return
      
      const code = pre.querySelector('code')
      if (!code) return
      
      // Check if it's a mermaid block - check multiple possible locations
      const isMermaid = pre.dataset.language === 'mermaid' ||
                        code.classList.contains('language-mermaid') || 
                        code.classList.contains('lang-mermaid') ||
                        /\blanguage-mermaid\b|\blang-mermaid\b/.test(pre.className)
      
      if (isMermaid) {
        if (DEBUG) console.log('Found Mermaid block:', pre)
        allMermaidBlocks.push(pre)
      }
    })

    if (allMermaidBlocks.length > 0 && typeof mermaid !== 'undefined') {
      try {
        if (DEBUG) console.log('Found', allMermaidBlocks.length, 'Mermaid block(s)')
        const isDark = document.documentElement.classList.contains('darkmode')

        // Use site CSS variables so Mermaid matches the site's light/dark themes
        try {
          const cs = getComputedStyle(document.documentElement)
          const fg = cs.getPropertyValue('--foreground-color')?.trim() || (isDark ? '#fff' : '#111')
          const bg = cs.getPropertyValue('--background-color')?.trim() || (isDark ? '#111' : '#fff')
          const primary = cs.getPropertyValue('--link-color')?.trim() || cs.getPropertyValue('--color-primary-400')?.trim() || '#4f46e5'
          const border = cs.getPropertyValue('--border-color')?.trim() || '#888'

          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'default',
            securityLevel: 'loose',
            themeVariables: {
              background: bg,
              textColor: fg,
              primaryColor: primary,
              lineColor: border,
            },
          })
        } catch (errTheme) {
          // fallback to simple init
          mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'loose' })
        }

        for (let i = 0; i < allMermaidBlocks.length; i++) {
          const pre = allMermaidBlocks[i]
          const code = pre.querySelector('code')
          const content = code?.textContent || pre.textContent || ''
          
          // Create container
          const container = document.createElement('div')
          container.className = 'mermaid'
          container.id = 'mermaid-' + Date.now() + '-' + i
          container.textContent = content.trim()
          
          pre.dataset.paloMermaidProcessed = 'true'
          pre.replaceWith(container)
        }

        await mermaid.run()
        if (DEBUG) console.log('Mermaid render complete')
      } catch (err) {
        console.error('Failed to load or render Mermaid:', err)
      }
    }
  }

  // Handle standard page loads and View Transitions
  document.addEventListener('astro:page-load', initProseEnhancements)
  document.addEventListener('astro:after-swap', initProseEnhancements)
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProseEnhancements)
  } else {
    // Small delay to ensure mermaid CDN script is loaded
    setTimeout(initProseEnhancements, 100)
  }
</script>
