---
import DefaultLayout from './DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import { Heading } from 'accessible-astro-components'

const { frontmatter } = Astro.props
const toc = frontmatter.toc ?? false
const narrow = frontmatter.narrow ?? false
const pageHeader = frontmatter.pageHeader
const pageHeaderTitle = pageHeader?.title ?? frontmatter.title
const pageHeaderSubtitle = pageHeader?.subtitle ?? frontmatter.description
const pageHeaderBg = pageHeader?.bg ?? {}
---

<DefaultLayout
  title={frontmatter.title}
  description={frontmatter.description}
  {...(frontmatter.image ? { image: frontmatter.image } : {})}
  {...(frontmatter.author ? { author: frontmatter.author } : {})}
  {...(frontmatter.type ? { type: frontmatter.type } : {})}
  {...(frontmatter.useTitleTemplate === undefined ? {} : { useTitleTemplate: frontmatter.useTitleTemplate })}
>
  {
    pageHeader && (
      <PaloPageHeader
        title={pageHeaderTitle}
        subtitle={pageHeaderSubtitle}
        fullscreen={pageHeader.fullscreen ?? false}
        bg={{
          image: pageHeaderBg.image ?? '',
          video: pageHeaderBg.video ?? '',
          color: pageHeaderBg.color ?? '',
          fixed: pageHeaderBg.fixed ?? false,
          overlayOpacity: pageHeaderBg.overlayOpacity ?? 0,
        }}
        contentColor={pageHeader.contentColor ?? ''}
        topNavigationTheme={pageHeader.topNavigationTheme ?? ''}
        divider={pageHeader.divider ?? true}
        alignV={pageHeader.alignV ?? ''}
        alignH={pageHeader.alignH ?? ''}
      />
    )
  }
  <section class="my-12">
    <div class="container">
      <div class={`article-content ${toc ? 'article-content--with-toc' : ''}`}>
        <div class="article-content__main">
          <div class={`prose space-content ${narrow ? 'narrow' : ''}`}>
            <slot />
          </div>
        </div>
        {toc && (
          <div class="article-content__toc">
            <div class="article-toc space-content">
              <Heading level="h3" size="h4">On this page</Heading>
              <nav aria-label="On this page">
                <ul class="list-none">
                  <!-- 导航项将通过 JS 动态生成 -->
                </ul>
              </nav>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</DefaultLayout>

<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" is:inline></script>
<script is:inline>
  const initProseEnhancements = async () => {
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'
    // 1. Table responsive wrapping
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return
      
      const wrapper = document.createElement('div')
      wrapper.className = 'table-wrapper overflow-x-auto my-6 max-w-full rounded-lg'
      
      table.parentNode?.insertBefore(wrapper, table)
      wrapper.appendChild(table)
    })

    // 2. Dynamic client-side Mermaid rendering
    const allMermaidBlocks = []
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.dataset.paloMermaidProcessed === 'true') return
      
      const code = pre.querySelector('code')
      if (!code) return
      
      // Check if it's a mermaid block - check multiple possible locations
      const isMermaid = pre.dataset.language === 'mermaid' ||
                        code.classList.contains('language-mermaid') || 
                        code.classList.contains('lang-mermaid') ||
                        /\blanguage-mermaid\b|\blang-mermaid\b/.test(pre.className)
      
      if (isMermaid) {
        if (DEBUG) console.log('Found Mermaid block:', pre)
        allMermaidBlocks.push(pre)
      }
    })

    if (allMermaidBlocks.length > 0 && typeof mermaid !== 'undefined') {
      try {
        if (DEBUG) console.log('Found', allMermaidBlocks.length, 'Mermaid block(s)')

        for (let i = 0; i < allMermaidBlocks.length; i++) {
          const pre = allMermaidBlocks[i]
          const code = pre.querySelector('code')
          const content = code?.textContent || pre.textContent || ''
          
          // 🔥 Create wrapper container with original code backup
          const container = document.createElement('div')
          container.className = 'mermaid-container'
          container.dataset.originalCode = content.trim() // Core: truth source for re-render
          
          // Inner div where Mermaid renders SVG
          const mermaidInner = document.createElement('div')
          mermaidInner.className = 'mermaid'
          mermaidInner.id = 'mermaid-' + Date.now() + '-' + i
          mermaidInner.textContent = content.trim()
          
          container.appendChild(mermaidInner)
          
          pre.dataset.paloMermaidProcessed = 'true'
          pre.replaceWith(container)
        }

        await renderMermaidWithTheme()
        if (DEBUG) console.log('Mermaid render complete')
      } catch (err) {
        console.error('Failed to load or render Mermaid:', err)
      }
    }
  }

  /**
   * 🔥 Read current CSS custom properties and re-initialize + run Mermaid for all .mermaid-container
   * Reads from dataset.originalCode on each .mermaid-container's inner .mermaid div.
   */
  const renderMermaidWithTheme = async () => {
    if (typeof mermaid === 'undefined') return
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'

    const containers = document.querySelectorAll('.mermaid-container')
    if (containers.length === 0) return

    const isDark = document.documentElement.classList.contains('darkmode')

    try {
      const cs = getComputedStyle(document.documentElement)
      const fg = cs.getPropertyValue('--foreground-color')?.trim() || (isDark ? '#fff' : '#111')
      const bg = cs.getPropertyValue('--background-color')?.trim() || (isDark ? '#111' : '#fff')
      const primary = cs.getPropertyValue('--link-color')?.trim() || cs.getPropertyValue('--color-primary-400')?.trim() || '#4f46e5'
      const border = cs.getPropertyValue('--border-color')?.trim() || '#888'

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
        themeVariables: {
          background: bg,
          textColor: fg,
          primaryColor: primary,
          lineColor: border,
        },
      })
    } catch (errTheme) {
      mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'loose' })
    }

    // 🔥 物理擦除重建：解决 Mermaid 10.x data-processed 缓存污染问题
    // 不要复用或修改已有的 .mermaid 节点 —— 必须物理擦除 + 全新创建
    containers.forEach((container) => {
      const rawCode = container.dataset.originalCode
      if (!rawCode) return

      // 1. 完全清空容器，抹除所有 data-processed 属性
      container.innerHTML = ''

      // 2. 创建全新的 div，绝对不携带任何 data-* 残留
      const newId = `mermaid-${Math.random().toString(36).substr(2, 9)}`
      const newDiv = document.createElement('div')
      newDiv.className = 'mermaid'
      newDiv.id = newId
      newDiv.textContent = rawCode // 源码塞入文本节点

      // 3. 追加到容器
      container.appendChild(newDiv)
    })

    try {
      await mermaid.run()
      if (DEBUG) console.log('[Mermaid] Re-render complete (theme:', isDark ? 'dark' : 'light', ')')
    } catch (err) {
      console.error('[Mermaid] Re-render failed:', err)
    }
  }

  /**
   * 🔥 MutationObserver: watch for darkmode class toggle on <html>, re-render Mermaid diagrams
   */
  const paloInitMermaidThemeWatcher = () => {
    // Only set up watcher if at least one .mermaid-container exists
    if (document.querySelectorAll('.mermaid-container').length === 0) return

    let pending = false
    const observer = new MutationObserver(() => {
      if (pending) return
      pending = true

      // Debounce: wait for all class changes to settle (e.g., multiple classList.toggle calls)
      requestAnimationFrame(() => {
        pending = false
        renderMermaidWithTheme()
      })
    })

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
  }

  // 目录导航功能
  const paloInitTableOfContents = () => {
    const tocContainer = document.querySelector('.article-toc nav ul')
    if (!tocContainer) return

    // 从内容中找到所有 H2、H3 和 H4 标题
    const contentMain = document.querySelector('.article-content__main')
    if (!contentMain) return

    const headings = [
      ...contentMain.querySelectorAll('h2'),
      ...contentMain.querySelectorAll('h3'),
      ...contentMain.querySelectorAll('h4'),
    ].sort((a, b) => a.offsetTop - b.offsetTop)

    if (headings.length === 0) {
      // 如果没有标题，隐藏目录
      const tocWrapper = document.querySelector('.article-content__toc')
      const mainContent = document.querySelector('.article-content__main')
      if (tocWrapper) tocWrapper.style.display = 'none'
      if (mainContent) mainContent.style.gridColumn = '1 / -1'
      return
    }

    // 为每个标题添加 id（如果没有的话）
    headings.forEach((heading, index) => {
      if (!heading.id) {
        const id = heading.textContent?.trim().toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '') || `heading-${index}`
        heading.id = id
      }
      // 添加滚动边距
      heading.style.scrollMarginBlockStart = 'calc(var(--header-height) + 2rem)'
    })

    // 生成导航链接
    // 先清空容器避免重复
    tocContainer.innerHTML = ''

    const navItems = headings.map((heading) => {
      const level = heading.tagName.toLowerCase()
      const li = document.createElement('li')
      li.className = `my-1 article-toc__item article-toc__item--${level}`
      const a = document.createElement('a')
      a.href = `#${heading.id}`
      a.className = 'text-sm'
      a.textContent = heading.textContent || ''
      li.appendChild(a)
      return li
    })

    navItems.forEach((item) => tocContainer.appendChild(item))

    // 初始化导航高亮和滚动功能
    initTocNavigation()
  }

  const initTocNavigation = () => {
    const navLinks = [...document.querySelectorAll('.article-toc nav a')]
    if (navLinks.length === 0) return

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let activeScrollFrame = null

    const setActiveLink = (activeLink) => {
      navLinks.forEach((link) => {
        const isActive = link === activeLink
        link.classList.toggle('active', isActive)
        if (isActive) {
          link.setAttribute('aria-current', 'true')
        } else {
          link.removeAttribute('aria-current')
        }
      })
    }

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3)

    const smoothScrollToHeading = (heading) => {
      if (prefersReducedMotion) {
        heading.scrollIntoView({ block: 'start' })
        return
      }

      if (activeScrollFrame) {
        cancelAnimationFrame(activeScrollFrame)
        activeScrollFrame = null
      }

      const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0
      const startY = window.scrollY
      const targetY = Math.max(0, window.scrollY + heading.getBoundingClientRect().top - headerHeight)
      const distance = targetY - startY
      const duration = 600
      const startTime = performance.now()
      const rootStyle = document.documentElement.style
      const previousScrollBehavior = rootStyle.scrollBehavior
      rootStyle.scrollBehavior = 'auto'

      if (Math.abs(distance) < 2) {
        rootStyle.scrollBehavior = previousScrollBehavior
        return
      }

      const step = (currentTime) => {
        const elapsed = currentTime - startTime
        const progress = Math.min(elapsed / duration, 1)
        const eased = easeOutCubic(progress)
        window.scrollTo(0, startY + distance * eased)

        if (progress < 1) {
          activeScrollFrame = requestAnimationFrame(step)
        } else {
          rootStyle.scrollBehavior = previousScrollBehavior
          activeScrollFrame = null
        }
      }

      window.scrollTo(0, startY)
      step(startTime)
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntries = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)

        const topEntry = visibleEntries[0]
        if (!topEntry) return

        const link = document.querySelector(`.article-toc nav a[href="#${topEntry.target.id}"]`)
        if (link instanceof HTMLAnchorElement) {
          setActiveLink(link)
        }
      },
      { rootMargin: '-12% 0px -55% 0px', threshold: [0.1, 0.25, 0.5, 0.75, 1] },
    )

    navLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return

      const id = link.getAttribute('href')?.replace('#', '')
      const heading = id && document.getElementById(id)
      if (!heading) return

      observer.observe(heading)

      if (link.dataset.paloBound === 'true') return

      link.addEventListener('click', (event) => {
        event.preventDefault()
        setActiveLink(link)
        history.replaceState(null, '', `#${id}`)
        smoothScrollToHeading(heading)
      })

      link.dataset.paloBound = 'true'
    })

    // 设置初始激活状态
    const initialHash = window.location.hash.replace('#', '')
    if (initialHash) {
      const initialLink = document.querySelector(`.article-toc nav a[href="#${initialHash}"]`)
      if (initialLink instanceof HTMLAnchorElement) {
        setActiveLink(initialLink)
      }
    } else if (navLinks[0] instanceof HTMLAnchorElement) {
      setActiveLink(navLinks[0])
    }
  }

  // Handle standard page loads and View Transitions
  document.addEventListener('astro:page-load', initProseEnhancements)
  document.addEventListener('astro:after-swap', initProseEnhancements)
  document.addEventListener('astro:page-load', paloInitTableOfContents)
  document.addEventListener('astro:after-swap', paloInitTableOfContents)
  
  /** 🔥 Initialize Mermaid theme watcher after prose enhancements have created .mermaid-container elements */
  const paloInitMermaidWatcherWithDelay = () => {
    // Small delay to ensure Mermaid CDN script and initProseEnhancements have run
    setTimeout(paloInitMermaidThemeWatcher, 200)
  }

  document.addEventListener('astro:page-load', paloInitMermaidWatcherWithDelay)
  document.addEventListener('astro:after-swap', paloInitMermaidWatcherWithDelay)
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProseEnhancements)
    document.addEventListener('DOMContentLoaded', paloInitTableOfContents)
    document.addEventListener('DOMContentLoaded', paloInitMermaidWatcherWithDelay)
  } else {
    // Small delay to ensure mermaid CDN script is loaded
    setTimeout(initProseEnhancements, 100)
    paloInitTableOfContents()
    paloInitMermaidThemeWatcher()
  }
</script>

<style lang="scss" is:global>
  @use 'scss/base/breakpoint' as *;

  @layer components {
    .article-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-l);

      &--with-toc {
        @media (min-width: 768px) {
          grid-template-columns: minmax(0, 1fr) 280px;
        }

        @media (min-width: 1200px) {
          grid-template-columns: minmax(0, 1fr) 320px;
        }
      }
    }

    .article-content__main {
      min-width: 0; // 防止内容溢出
    }

    .article-content--with-toc .article-content__main {
      @media (min-width: 768px) {
        border-inline-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        padding-inline-end: var(--space-l);
      }
    }

    .article-content--with-toc .breakout-image-container {
      margin-inline: 0 !important;
      width: 100% !important;
      max-width: 100% !important;

      img,
      div.absolute {
        border-radius: var(--radius-media, var(--radius-global, 0.5rem)) !important;
      }
    }

    .article-content__toc {
      grid-row: 1;

      @media (min-width: 768px) {
        position: sticky;
        grid-row: auto;
        align-self: start;
        inset-block-start: calc(var(--header-height) + var(--space-l));
        padding-inline-start: 0;
        max-inline-size: 100%;
        max-block-size: calc(100vh - calc(var(--header-height) + var(--space-l)));
        overflow-x: hidden;
        overflow-y: auto;
        transition: inset-block-start 0.6s cubic-bezier(0.075, 0.82, 0.165, 1);
      }
    }

    .article-toc {
      max-width: 100%;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }

    .article-toc a {
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      transform-origin: left center;
      transition:
        transform 0.22s var(--cubic-bezier),
        font-size 0.22s var(--cubic-bezier),
        color 0.22s var(--cubic-bezier);
    }


    .article-toc .active {
      transform: scale(1.08) !important;
      font-weight: var(--font-weight-heading, 500) !important;
      font-size: 1.25rem !important;
    }

    ul:not([class]) li {
      margin-block-end: 0.35rem;
    }

    .narrow {
      margin-inline: auto;
      max-width: 65ch;
    }
  }
</style>
