---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PostHeader from '@components/PostHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { publicProjectImages } from '@utils/projectImages'

export async function getStaticPaths() {
  const projects = await getCollection('projects')

  return projects.map((project, index) => {
    const projectWithImage = {
      ...project,
      featuredImage: project.data.coverImage || publicProjectImages[index % publicProjectImages.length],
    }

    return {
      params: { project: project.id },
      props: { project: projectWithImage },
    }
  })
}

interface Props {
  project: CollectionEntry<'projects'> & { featuredImage: string }
}

const { project } = Astro.props
const { Content } = await render(project)

const {
  title,
  description,
  author,
  showBreadcrumbs,
  source,
  liveDemo,
  customBreadcrumbLabels,
  joinLastBreadcrumb,
  showDivider,
  coverImagePosition,
} = project.data

const authorInfo = typeof author === 'object'
  ? {
      name: author.name,
      image: author.image || undefined,
      bio: author.bio || 'Project Creator',
    }
  : {
      name: author || 'Anonymous',
      image: undefined,
      bio: 'Project Creator',
    }
---

<DefaultLayout title={project.data.title} description={project.data.description} url={ensureTrailingSlash(`/portfolio/${project.id}`)} image={project.featuredImage}>
  <PostHeader
    title={title}
    subtitle={description}
    author={authorInfo}
    featuredImage={project.featuredImage}
    showBreadcrumbs={showBreadcrumbs}
    source={source}
    liveDemo={liveDemo}
    customBreadcrumbLabels={customBreadcrumbLabels}
    joinLastBreadcrumb={joinLastBreadcrumb}
    showDivider={showDivider}
    coverImagePosition={coverImagePosition}
  />
  <section class="my-12">
    <div class="narrow prose space-content container">
      <Content />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Share this project</Heading>
      <p>Like this project? Share it with your network!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  @layer components {
    .narrow {
      margin-inline: auto;
      max-width: 65ch;
    }
  }
</style>
