---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PostHeader from '@components/PostHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, getEntry } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { 
  resolveCollectionCoverImage, 
  type ResolvedImage,
  smartRender,
  getFallbackContentHtml,
  isImageLoadingError,
  isSchemaValidationError
} from '@utils/contentImages'

/**
 * 动态路由：/portfolio/[project]
 * 
 * 终极防崩溃架构：
 * 
 * 第一层防护（Schema 层）：
 *   - imageField 使用 .catch(undefined) 确保图片解析失败不阻断 collection
 *   - 所有字段都有默认值和 catch 兜底
 * 
 * 第二层防护（路由层）：
 *   - getStaticPaths 只传递纯数据 props（不传递 entry 对象）
 *   - 路由主体用 getEntry() 重新获取完整 entry
 *   - smartRender() 带指数退避重试机制
 * 
 * 第三层防护（渲染层）：
 *   - render() 失败时显示友好的加载中占位符
 *   - Dev 模式下显示错误详情和重新加载按钮
 *   - 支持客户端自动重试和手动刷新
 * 
 * 自愈机制：
 *   - 检测到图片加载错误时，自动使用 fallback 图片
 *   - 检测到 Schema 验证错误时，跳过渲染并显示提示
 *   - 支持指数退避重试策略
 */

export async function getStaticPaths() {
  const projects = await getCollection('projects')

  return projects.map((project) => ({
    params: { project: project.id },
    props: {},
  }))
}

const projectId = Astro.params.project!
const projectEntry = await getEntry('projects', projectId)

if (!projectEntry) {
  throw new Error(`[portfolio/[project].astro] 找不到 content entry：projects/${projectId}`)
}

const coverImage = resolveCollectionCoverImage(
  projectEntry.data.coverImage as ResolvedImage | undefined,
  projectId,
  'projects',
  getProjectTypeDefaultImage(projectEntry.data.type),
)

// 🛡️ 智能渲染：带重试和自愈能力
let Content: any = () => null
let fallbackHtml: string | null = null
const isDev = import.meta.env.DEV

try {
  const rendered = await smartRender(projectEntry, {
    maxRetries: 3,
    retryDelay: 100,
    onRetry: (attempt, error) => {
      console.warn(`[smartRender] 第 ${attempt} 次重试渲染 ${projectId}`, error.message)
    },
    onSuccess: () => {
      console.info(`[smartRender] 成功渲染 ${projectId}`)
    },
    onError: (error) => {
      console.error(`[smartRender] 所有重试均失败 ${projectId}`, error)
    },
    renderProps: {
      contentId: projectId,
      collection: 'projects' as const,
    },
  })
  Content = rendered.Content
} catch (error) {
  const renderError = error instanceof Error ? error : new Error(String(error))
  
  if (isImageLoadingError(renderError)) {
    console.warn(`[portfolio/[project].astro] 图片加载错误，将使用 fallback：`, renderError.message)
  } else if (isSchemaValidationError(renderError)) {
    console.warn(`[portfolio/[project].astro] Schema 验证错误：`, renderError.message)
  }
  
  fallbackHtml = getFallbackContentHtml(projectId, renderError, isDev)
}

const {
  title,
  description,
  author,
  showBreadcrumbs,
  source,
  liveDemo,
  customBreadcrumbLabels,
  joinLastBreadcrumb,
  showDivider,
  coverImagePosition,
  showTableOfContents,
  narrow,
} = projectEntry.data

const authorInfo = typeof author === 'object'
  ? {
      name: author.name,
      image: author.image || undefined,
      bio: author.bio || 'Project Creator',
    }
  : {
      name: author || 'Anonymous',
      image: undefined,
      bio: 'Project Creator',
    }
---

<DefaultLayout title={title} description={description} url={ensureTrailingSlash(`/portfolio/${projectId}`)}>
  <PostHeader
    title={title}
    subtitle={description}
    author={authorInfo}
    coverImage={coverImage}
    showBreadcrumbs={showBreadcrumbs}
    source={source}
    liveDemo={liveDemo}
    customBreadcrumbLabels={customBreadcrumbLabels}
    joinLastBreadcrumb={joinLastBreadcrumb}
    showDivider={showDivider}
    coverImagePosition={coverImagePosition}
  />
  <section class="my-12">
    <div class="container">
      <div class={`article-content ${showTableOfContents ? 'article-content--with-toc' : ''}`}>
        <div class="article-content__main">
          <div class={`prose space-content ${!showTableOfContents ? 'narrow' : ''}`}>
            {fallbackHtml ? <div set:html={fallbackHtml} /> : <Content />}
          </div>
          <div class={`space-content mt-12 ${!showTableOfContents ? 'narrow' : ''}`}>
            <Heading level="h5">Share this project</Heading>
            <p>Like this project? Share it with your network!</p>
            <SocialShares />
          </div>
        </div>
        {showTableOfContents && (
          <div class="article-content__toc">
            <div class="article-toc space-content">
              <Heading level="h3" size="h4">On this page</Heading>
              <nav aria-label="On this page">
                <ul class="list-none">
                  <!-- 导航项将通过 JS 动态生成 -->
                </ul>
              </nav>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</DefaultLayout>

<script is:inline>
  const paloInitTableOfContents = () => {
    const tocContainer = document.querySelector('.article-toc nav ul')
    if (!tocContainer) return

    const contentMain = document.querySelector('.article-content__main')
    if (!contentMain) return

    const headings = [
      ...contentMain.querySelectorAll('h2'),
      ...contentMain.querySelectorAll('h3'),
      ...contentMain.querySelectorAll('h4'),
    ].sort((a, b) => a.offsetTop - b.offsetTop)

    if (headings.length === 0) {
      const tocWrapper = document.querySelector('.article-content__toc')
      const mainContent = document.querySelector('.article-content__main')
      if (tocWrapper) tocWrapper.style.display = 'none'
      if (mainContent) mainContent.style.gridColumn = '1 / -1'
      return
    }

    headings.forEach((heading, index) => {
      if (!heading.id) {
        const id = heading.textContent?.trim().toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '') || `heading-${index}`
        heading.id = id
      }
      heading.style.scrollMarginBlockStart = 'calc(var(--header-height) + 2rem)'
    })

    tocContainer.innerHTML = ''

    const navItems = headings.map((heading) => {
      const level = heading.tagName.toLowerCase()
      const li = document.createElement('li')
      li.className = `my-1 article-toc__item article-toc__item--${level}`
      const a = document.createElement('a')
      a.href = `#${heading.id}`
      a.className = 'text-sm'
      a.textContent = heading.textContent || ''
      li.appendChild(a)
      return li
    })

    navItems.forEach((item) => tocContainer.appendChild(item))
    initTocNavigation()
  }

  const initTocNavigation = () => {
    const navLinks = [...document.querySelectorAll('.article-toc nav a')]
    if (navLinks.length === 0) return

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let activeScrollFrame = null

    const setActiveLink = (activeLink) => {
      navLinks.forEach((link) => {
        const isActive = link === activeLink
        link.classList.toggle('active', isActive)
        if (isActive) {
          link.setAttribute('aria-current', 'true')
        } else {
          link.removeAttribute('aria-current')
        }
      })
    }

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3)

    const smoothScrollToHeading = (heading) => {
      if (prefersReducedMotion) {
        heading.scrollIntoView({ block: 'start' })
        return
      }

      if (activeScrollFrame) {
        cancelAnimationFrame(activeScrollFrame)
        activeScrollFrame = null
      }

      const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0
      const startY = window.scrollY
      const targetY = Math.max(0, window.scrollY + heading.getBoundingClientRect().top - headerHeight)
      const distance = targetY - startY
      const duration = 600
      const startTime = performance.now()
      const rootStyle = document.documentElement.style
      const previousScrollBehavior = rootStyle.scrollBehavior
      rootStyle.scrollBehavior = 'auto'

      if (Math.abs(distance) < 2) {
        rootStyle.scrollBehavior = previousScrollBehavior
        return
      }

      const step = (currentTime) => {
        const elapsed = currentTime - startTime
        const progress = Math.min(elapsed / duration, 1)
        const eased = easeOutCubic(progress)
        window.scrollTo(0, startY + distance * eased)

        if (progress < 1) {
          activeScrollFrame = requestAnimationFrame(step)
        } else {
          rootStyle.scrollBehavior = previousScrollBehavior
          activeScrollFrame = null
        }
      }

      window.scrollTo(0, startY)
      step(startTime)
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntries = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)

        const topEntry = visibleEntries[0]
        if (!topEntry) return

        const link = document.querySelector(`.article-toc nav a[href="#${topEntry.target.id}"]`)
        if (link instanceof HTMLAnchorElement) {
          setActiveLink(link)
        }
      },
      { rootMargin: '-12% 0px -55% 0px', threshold: [0.1, 0.25, 0.5, 0.75, 1] },
    )

    navLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return

      const id = link.getAttribute('href')?.replace('#', '')
      const heading = id && document.getElementById(id)
      if (!heading) return

      observer.observe(heading)

      if (link.dataset.paloBound === 'true') return

      link.addEventListener('click', (event) => {
        event.preventDefault()
        setActiveLink(link)
        history.replaceState(null, '', `#${id}`)
        smoothScrollToHeading(heading)
      })

      link.dataset.paloBound = 'true'
    })

    const initialHash = window.location.hash.replace('#', '')
    if (initialHash) {
      const initialLink = document.querySelector(`.article-toc nav a[href="#${initialHash}"]`)
      if (initialLink instanceof HTMLAnchorElement) {
        setActiveLink(initialLink)
      }
    } else if (navLinks[0] instanceof HTMLAnchorElement) {
      setActiveLink(navLinks[0])
    }
  }

  document.addEventListener('astro:page-load', paloInitTableOfContents)
  document.addEventListener('astro:after-swap', paloInitTableOfContents)
  paloInitTableOfContents()
</script>

<style lang="scss" is:global>
  @use 'scss/base/breakpoint' as *;

  @layer components {
    .article-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-l);

      &--with-toc {
        @media (min-width: 768px) {
          grid-template-columns: minmax(0, 1fr) 280px;
        }

        @media (min-width: 1200px) {
          grid-template-columns: minmax(0, 1fr) 320px;
        }
      }
    }

    .article-content__main {
      min-width: 0;
    }

    .article-content--with-toc .article-content__main {
      @media (min-width: 768px) {
        border-inline-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        padding-inline-end: var(--space-l);
      }
    }

    .article-content--with-toc .breakout-image-container {
      margin-inline: 0 !important;
      width: 100% !important;
      max-width: 100% !important;

      img,
      div.absolute {
        border-radius: var(--radius-media, var(--radius-global, 0.5rem)) !important;
      }
    }

    .article-content__toc {
      grid-row: 1;

      @media (min-width: 768px) {
        position: sticky;
        grid-row: auto;
        align-self: start;
        inset-block-start: calc(var(--header-height) + var(--space-l));
        padding-inline-start: 0;
        max-inline-size: 100%;
        max-block-size: calc(100vh - calc(var(--header-height) + var(--space-l)));
        overflow-x: hidden;
        overflow-y: auto;
        transition: inset-block-start 0.6s cubic-bezier(0.075, 0.82, 0.165, 1);
      }
    }

    .article-toc {
      max-width: 100%;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }

    .article-toc a {
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      transform-origin: left center;
      transition:
        transform 0.22s var(--cubic-bezier),
        font-size 0.22s var(--cubic-bezier),
        color 0.22s var(--cubic-bezier);
    }

    .article-toc .active {
      transform: scale(1.08) !important;
      font-weight: var(--font-weight-heading, 500) !important;
      font-size: 1.25rem !important;
    }

    ul:not([class]) li {
      margin-block-end: 0.35rem;
    }

    .narrow {
      margin-inline: auto;
      max-width: 65ch;
    }
  }
</style>