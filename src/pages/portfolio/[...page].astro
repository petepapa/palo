---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { resolveCollectionCoverImage } from '@utils/contentImages'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'
import { PORTFOLIO_PAGE_SIZE, PORTFOLIO_SORT_BY } from '@utils/portfolioConfig'
import type { PaginateFunction, Page } from 'astro'

// =========================================================================
// 🎛️ 中央控制台 / Central Page Configuration
// =========================================================================
const pageConfig = {
  // ── 文案与 SEO / Copywriting & SEO (支持 Fallback 机制) ──
  title: 'All Projects',
  subtitle: 'A visual summary of every project, arranged as an overlay masonry gallery.',
  metaTitle: '',        // 选填。留空则自动复用上方 title 做页签标题 / Empty = fallback to title
  metaDescription: 'A complete visual index of portfolio projects, arranged as an overlay masonry gallery.',

  // ── 功能开关中心 / Feature Toggles ──
  showTags: true,       // 是否启用顶部 Tag 标签筛选功能
  showStats: true,      // 是否显示总页面数量和项目统计信息

  // ── 列表布局参数 / List Layout Settings ──
  layout: 'overlay',    // 卡片布局风格：'standard' (网格) | 'overlay' (悬浮遮罩)
  width: 'full' as ProjectListWidth, // 容器宽度：'container' (网页内宽) | 'full' (全屏全宽)
  gap: 'gap-5',         // 项目间距类名 (Tailwind Gap Class)
  colsClass: 'columns-1 sm:columns-2 lg:columns-3 xl:columns-3', // 瀑布流分列配置 (Tailwind Columns)

  // ── 细粒度排版微调 / Typography Fine-Tuning ──
  tagsHeading: 'h5',            // ✨ 完美合并：一键决定 Tags 标题的 HTML 标签级别与字号样式 ('h1' - 'h6')
  projectHeadingLevel: 'h5',    // 项目卡片标题的 HTML 标签级别
  projectDescClass: 'text-base', // 项目卡片摘要文字的 CSS Class
} as const

// ── PaloPageHeader 结构化参数 (对齐大一统新规范) ──
const pageHeader = {
  fullscreen: false,
  contentColor: '',
  topNavigationTheme: '',
  alignV: 'center',
  alignH: 'left',
  divider: 'bottom',
  bg: {
    video: '',
    image: '',
    color: '',
    fixed: false,
    overlayOpacity: 0,
  },
} as const

// =========================================================================
// 📦 数据引擎与沙盒分页 / Data Fetching & Sandbox Pagination
// =========================================================================
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft)

  // 双轴排序引擎：精选置顶 (featuredOrder 升序) + 时间轴兜底
  const featured = allProjects.filter((p) => p.data.featuredOrder !== undefined)
  const regular = allProjects.filter((p) => p.data.featuredOrder === undefined)

  featured.sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))

  if (PORTFOLIO_SORT_BY === 'earliest') {
    regular.sort((a, b) => (a.data.publishDate?.valueOf() || 0) - (b.data.publishDate?.valueOf() || 0))
  } else {
    regular.sort((a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0))
  }

  const sortedProjects = [...featured, ...regular]

  return paginate(sortedProjects, { pageSize: PORTFOLIO_PAGE_SIZE })
}

interface Props {
  page: Page<any>
}

const { page } = Astro.props

// 提取当前上下文所需的各种派生计算属性
const projectListWidthClass = getProjectListWidthClass(pageConfig.width)
const projectListGapSize = resolveTailwindGapClass(pageConfig.gap)
const isFullWidthList = pageConfig.width === 'full'
const resolvedMetaTitle = pageConfig.metaTitle || pageConfig.title

// 💡 仅在开启 showTags 时才在服务器端计算 Tag 集合，避免不必要的性能损耗
let uniqueTags: Array<{ label: string; slug: string }> = []
if (pageConfig.showTags) {
  const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft)
  uniqueTags = [...new Set(allProjects.map((p) => p.data.tags).flat())]
    .sort((a, b) => a.localeCompare(b))
    .map((label) => ({ label, slug: slugify(label) }))
}
---

<DefaultLayout title={resolvedMetaTitle} description={pageConfig.metaDescription}>
  <PaloPageHeader title={pageConfig.title} subtitle={pageConfig.subtitle} {...pageHeader} />

  <section class="my-12">
    <div class="container">
      {pageConfig.showTags && uniqueTags.length > 0 && (
        <div class="tags-filter mb-8">
          <Heading level={pageConfig.tagsHeading} size={pageConfig.tagsHeading} class="mb-3">Tags</Heading>
          <div class="flex flex-wrap gap-4">
            <Link href={ensureTrailingSlash('/portfolio')}>All</Link>
            {uniqueTags.map((tag) => (
              <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
            ))}
          </div>
        </div>
      )}

      {pageConfig.showStats && (
        <p class="mb-6 text-sm text-neutral-500 italic">
          {page.total} total projects · Page {page.currentPage} of {page.lastPage}
        </p>
      )}
    </div>

    <div class={isFullWidthList ? "w-full" : "container"}>
      <ul
        class:list={['project-masonry mt-3', projectListWidthClass, pageConfig.gap, pageConfig.colsClass]}
        style={`--project-list-gap: ${projectListGapSize}`}
      >
        {page.data.map((project: any) => (
          <li class="project-masonry__item break-inside-avoid">
            <ProjectCard
              project={project}
              image={resolveCollectionCoverImage(
                project.data.coverImage,
                project.id,
                'projects',
                getProjectTypeDefaultImage(project.data.type),
              )}
              layout={pageConfig.layout}
              headingLevel={pageConfig.projectHeadingLevel}
              descriptionClass={pageConfig.projectDescClass}
            />
          </li>
        ))}
      </ul>
    </div>

    {page.lastPage > 1 && (
      <div class="mt-12 flex justify-center">
        <Pagination
          firstPage={page.url.prev ? ensureTrailingSlash('/portfolio') : null}
          previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
          nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
          lastPage={page.url.next ? ensureTrailingSlash(`/portfolio/${page.lastPage}`) : null}
          currentPage={`${page.currentPage}`}
          totalPages={`${page.lastPage}`}
          ariaLabel="Portfolio pagination"
        />
      </div>
    )}
  </section>
</DefaultLayout>