---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { resolveCollectionCoverImage } from '@utils/contentImages'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'
import { PAGE_SIZE, SORT_BY } from '@utils/listConfig'
import type { PaginateFunction, Page } from 'astro'
import config from '@config'
import { buildColumnsClass } from '../../types/config'

const portfolioDefaults = config.portfolio?.defaults ?? {}
const portfolioListPage = config.portfolio?.listPage ?? {}
const navListActiveStyle = config.navigation?.navList?.activeStyle ?? 'bold'

// 构建默认 columns 类名（listPage.columns 为空对象 {} 或无值时继承 defaults.columns）
const listPageColumns = portfolioListPage.columns
const effectiveColumns = listPageColumns !== undefined && Object.keys(listPageColumns).length > 0
  ? listPageColumns
  : portfolioDefaults.columns
const defaultColumns = effectiveColumns
  ? buildColumnsClass(effectiveColumns)
  : 'columns-[1] sm:columns-[2] lg:columns-[3] xl:columns-[3]'

// =========================================================================
// 🎛️ 中央控制台 / Central Page Configuration (源自 config.yaml)
//   三级降级链路：listPage → defaults → 硬编码兜底
// =========================================================================
const pageConfig = {
  // ── 文案与 SEO / Copywriting & SEO ──
  title: portfolioListPage.title ?? 'All Projects',
  subtitle: portfolioListPage.subtitle ?? '',
  metaTitle: '',
  metaDescription: 'A complete visual index of portfolio projects, arranged as an overlay masonry gallery.',
  allLabel: portfolioListPage.allLabel ?? 'All Projects',

  // ── 功能开关中心 / Feature Toggles (listPage → defaults) ──
  showTags: portfolioListPage.showTags ?? portfolioDefaults.showTags ?? true,
  showStats: portfolioListPage.showStats ?? portfolioDefaults.showStats ?? true,

  // ── 列表布局参数 / List Layout Settings (listPage → defaults) ──
  layout: portfolioListPage.layout ?? portfolioDefaults.layout ?? 'overlay',
  width: (portfolioListPage.width ?? portfolioDefaults.width ?? 'full') as ProjectListWidth,
  gap: portfolioListPage.gap ?? portfolioDefaults.gap ?? 'gap-5',
  colsClass: defaultColumns,

  // ── 细粒度排版微调 / Typography Fine-Tuning (listPage → defaults) ──
  tagsHeading: portfolioListPage.tagsHeading ?? portfolioDefaults.tagsHeading ?? 'h5',
  projectHeadingLevel: portfolioListPage.projectHeadingLevel ?? portfolioDefaults.projectHeadingLevel ?? 'h5',
  projectDescClass: portfolioListPage.projectDescClass ?? portfolioDefaults.projectDescClass ?? 'text-base',
} as const

// ── PaloPageHeader 结构化参数 (从 config.yaml 读取全局默认值) ──
const pageHeaderDefaults = config.components?.paloPageHeader ?? {}
const pageHeader = {
  fullscreen: false,
  contentColor: '',
  topNavigationTheme: '',
  alignV: pageHeaderDefaults.alignV ?? 'center',
  alignH: pageHeaderDefaults.alignH ?? 'left',
  divider: pageHeaderDefaults.divider ?? 'bottom',
  bg: {
    video: '',
    image: '',
    color: '',
    fixed: false,
    overlayOpacity: 0,
  },
} as const

// =========================================================================
// 📦 数据引擎与沙盒分页 / Data Fetching & Sandbox Pagination
// =========================================================================
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft)

  // 双轴排序引擎：精选置顶 (featuredOrder 升序) + 时间轴兜底
  const featured = allProjects.filter((p) => p.data.featuredOrder !== undefined)
  const regular = allProjects.filter((p) => p.data.featuredOrder === undefined)

  featured.sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))

  if (SORT_BY.portfolio === 'earliest') {
    regular.sort((a, b) => (a.data.publishDate?.valueOf() || 0) - (b.data.publishDate?.valueOf() || 0))
  } else {
    regular.sort((a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0))
  }

  const sortedProjects = [...featured, ...regular]

  return paginate(sortedProjects, { pageSize: PAGE_SIZE.portfolio })
}

interface Props {
  page: Page<any>
}

const { page } = Astro.props

// 提取当前上下文所需的各种派生计算属性
const projectListWidthClass = getProjectListWidthClass(pageConfig.width)
const projectListGapSize = resolveTailwindGapClass(pageConfig.gap)
const isFullWidthList = pageConfig.width === 'full'
const resolvedMetaTitle = pageConfig.metaTitle || pageConfig.title

// 💡 仅在开启 showTags 时才在服务器端计算 Tag 集合，避免不必要的性能损耗
let uniqueTags: Array<{ label: string; slug: string }> = []
if (pageConfig.showTags) {
  const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft)
  uniqueTags = [...new Set(allProjects.map((p) => p.data.tags).flat())]
    .sort((a, b) => a.localeCompare(b))
    .map((label) => ({ label, slug: slugify(label) }))
}
---

<DefaultLayout title={resolvedMetaTitle} description={pageConfig.metaDescription}>
  <PaloPageHeader title={pageConfig.title} subtitle={pageConfig.subtitle} {...pageHeader} />

  <section class="my-12">
    <div class="container">
      {pageConfig.showTags && uniqueTags.length > 0 && (
        <div class="tags-filter mb-8 palo-nav-list" data-active-style={navListActiveStyle}>
          <Heading level={pageConfig.tagsHeading} size={pageConfig.tagsHeading} class="mb-3">Tags</Heading>
          <div class="flex flex-wrap gap-4">
            <Link href={ensureTrailingSlash('/portfolio')} aria-current="page">{pageConfig.allLabel}</Link>
            {uniqueTags.map((tag) => (
              <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
            ))}
          </div>
        </div>
      )}

      {pageConfig.showStats && (
        <p class="mb-6 text-sm text-neutral-500 italic">
          {page.total} total projects · Page {page.currentPage} of {page.lastPage}
        </p>
      )}
    </div>

    <div class={isFullWidthList ? "w-full" : "container"}>
      <ul
        class:list={['project-masonry mt-3', projectListWidthClass, pageConfig.colsClass]}
        style={`--project-list-gap: ${projectListGapSize}`}
      >
        {page.data.map((project: any) => (
          <li class="project-masonry__item break-inside-avoid">
            <ProjectCard
              project={project}
              image={resolveCollectionCoverImage(
                project.data.coverImage,
                project.id,
                'projects',
                getProjectTypeDefaultImage(project.data.type),
              )}
              layout={pageConfig.layout}
              headingLevel={pageConfig.projectHeadingLevel}
              descriptionClass={pageConfig.projectDescClass}
            />
          </li>
        ))}
      </ul>
    </div>

    {page.lastPage > 1 && (
      <div class="mt-12 flex justify-center">
        <Pagination
          firstPage={page.url.prev ? ensureTrailingSlash('/portfolio') : null}
          previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
          nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
          lastPage={page.url.next ? ensureTrailingSlash(`/portfolio/${page.lastPage}`) : null}
          currentPage={`${page.currentPage}`}
          totalPages={`${page.lastPage}`}
          ariaLabel="Portfolio pagination"
        />
      </div>
    )}
  </section>
</DefaultLayout>