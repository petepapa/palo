---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { resolveCollectionCoverImage } from '@utils/contentImages'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'
import type { PaginateFunction, Page } from 'astro'

// Editing guide / 编辑引导
// 1. Edit pageTitle/pageDescription/pageHeading/pageSubtitle for page copy and SEO.
//    修改 pageTitle/pageDescription/pageHeading/pageSubtitle 来调整页面文案和 SEO。
// 2. Edit pageHeaderAppearance to control PaloPageHeader visual behavior.
//    修改 pageHeaderAppearance 来控制 PaloPageHeader 的视觉表现。
// 3. Edit projectListWidth, projectListGapClass, and ProjectCard props near the card list to adjust list width, gap, card layout, or heading level.
//    修改 projectListWidth、projectListGapClass 和卡片列表附近的 ProjectCard 参数，以调整列表宽度、间隙、卡片布局或标题层级。
// 4. Edit pageSize in getStaticPaths to change the number of projects per page (currently 10).
//    修改 getStaticPaths 中的 pageSize 来调整每页显示的项目数量（当前为 10）。

// Page metadata / 页面元信息
const pageTitle = 'Portfolio'
const pageDescription = 'A complete visual index of portfolio projects, arranged as an overlay masonry gallery.'
const pageHeading = 'All Projects'
const pageSubtitle = 'A visual summary of every project, arranged as an overlay masonry gallery.'
const projectListWidth: ProjectListWidth = 'full' // Project list width: container | full / 项目列表宽度：网页宽 | 全屏宽
const projectListGapClass = 'gap-5' // Project list gap class; controls column and row gaps / 项目列表间隙 class，同时控制左右和上下间隙
const projectListWidthClass = getProjectListWidthClass(projectListWidth)
const projectListGapSize = resolveTailwindGapClass(projectListGapClass)
const isFullWidthList = projectListWidth === 'full'

// PaloPageHeader settings / PaloPageHeader 参数设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  alignV: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  alignH: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  divider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
  bg: {
    video: '', // Video path in /public / 背景视频，放在 /public
    image: '', // Image path in /public / 背景图片，放在 /public
    color: '', // Background color; empty = theme / 背景颜色，空=跟随主题
    fixed: false, // Fixed background inside section / 背景在区域内固定
    overlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  },
} as const

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  // Get all projects
  const allProjects = (await getCollection('projects')).filter(
    (project) => !project.data.draft,
  )
  
  // Get all unique tags
  const uniqueTags = [...new Set(allProjects.map((project) => project.data.tags).flat())]
    .sort((a, b) => a.localeCompare(b))
    .map((label) => ({
      label,
      slug: slugify(label),
    }))

  // ========== SORTING CONFIGURATION / 排序配置 ==========
  // Dual-axis sorting: Featured First + Timeline Fallback
  // Step 1: Separate featured (has featuredOrder) and regular (no featuredOrder) items
  // Step 2: Featured items sorted by featuredOrder ASC (1, 2, 3...)
  // Step 3: Regular items sorted by publishDate DESC (newest first)
  // 
  // 修改下方的排序函数来改变项目顺序
  // 当前: 双轴排序 = 精选置顶(按featuredOrder) + 时间线兜底(按发布日期倒序)
  const featuredProjects = allProjects.filter((project) => project.data.featuredOrder !== undefined)
  const regularProjects = allProjects.filter((project) => project.data.featuredOrder === undefined)

  featuredProjects.sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))
  regularProjects.sort((a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0))

  const sortedProjects = [...featuredProjects, ...regularProjects]

  const projectsWithImages = sortedProjects

  // ========== PAGINATION CONFIGURATION / 分页配置 ==========
  // Modify pageSize to change items per page
  // 修改 pageSize 来改变每页显示的项目数量
  // Current: 10 items per page / 当前: 每页10个项目
  return paginate(projectsWithImages, { pageSize: 10 })
}

interface Props {
  page: Page<any>
}

const { page } = Astro.props

// Get all unique tags for display (过滤掉草稿)
const allProjects = (await getCollection('projects')).filter(
  (project) => !project.data.draft,
)
const uniqueTags = [...new Set(allProjects.map((project) => project.data.tags).flat())]
  .sort((a, b) => a.localeCompare(b))
  .map((label) => ({
    label,
    slug: slugify(label),
  }))
---

<DefaultLayout title={pageTitle} description={pageDescription}>
  <!--
    PaloPageHeader custom parameters / PaloPageHeader 自定义参数：
    - title uses pageHeading above / title 使用上方 pageHeading
    - subtitle uses pageSubtitle above / subtitle 使用上方 pageSubtitle
    - pageHeaderAppearance controls background, spacing, divider, and nav theme / pageHeaderAppearance 控制背景、间距、分隔线和导航主题
  -->
  <PaloPageHeader title={pageHeading} subtitle={pageSubtitle} {...pageHeaderAppearance} />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        {
          uniqueTags.map((tag) => (
            <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
          ))
        }
      </div>
      <p class="mt-8 text-sm">
        <em>{page.total} total projects · Page {page.currentPage} of {page.lastPage}</em>
      </p>
      {
        !isFullWidthList && (
          <ul
            class:list={['project-masonry mt-3', projectListWidthClass, projectListGapClass]}
            style={`--project-list-gap: ${projectListGapSize}`}
          >
            {
              page.data.map((project: any) => (
                <li class="project-masonry__item">
                  <ProjectCard
                    project={project}
                    image={resolveCollectionCoverImage(
                      project.data.coverImage,
                      project.id,
                      'projects',
                      getProjectTypeDefaultImage(project.data.type),
                    )}
                    layout="overlay"
                    headingLevel="h5"
                    descriptionClass="text-base"
                  />
                </li>
              ))
            }
          </ul>
        )
      }
    </div>
    {
      isFullWidthList && (
        <ul
          class:list={['project-masonry mt-3', projectListWidthClass, projectListGapClass]}
          style={`--project-list-gap: ${projectListGapSize}`}
        >
          {
            page.data.map((project: any) => (
              <li class="project-masonry__item">
                <ProjectCard
                  project={project}
                  image={resolveCollectionCoverImage(
                    project.data.coverImage,
                    project.id,
                    'projects',
                    getProjectTypeDefaultImage(project.data.type),
                  )}
                  layout="overlay"
                  headingLevel="h5"
                  descriptionClass="text-base"
                />
              </li>
            ))
          }
        </ul>
      )
    }
    <!-- Pagination centered -->
    <div class="mt-12 flex justify-center">
      <Pagination
        firstPage={page.url.prev ? ensureTrailingSlash('/portfolio') : null}
        previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
        nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
        lastPage={page.url.next ? ensureTrailingSlash(`/portfolio/${page.lastPage}`) : null}
        currentPage={`${page.currentPage}`}
        totalPages={`${page.lastPage}`}
        ariaLabel="Portfolio pagination"
      />
    </div>
  </section>
</DefaultLayout>
