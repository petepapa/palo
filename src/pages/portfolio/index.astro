---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { projectImages } from '@utils/projectImages'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'

// Editing guide / 编辑引导
// 1. Edit pageTitle/pageDescription/pageHeading/pageSubtitle for page copy and SEO.
//    修改 pageTitle/pageDescription/pageHeading/pageSubtitle 来调整页面文案和 SEO。
// 2. Edit pageHeaderAppearance to control PaloPageHeader visual behavior.
//    修改 pageHeaderAppearance 来控制 PaloPageHeader 的视觉表现。
// 3. Edit projectListWidth, projectListGapClass, and ProjectCard props near the card list to adjust list width, gap, card layout, or heading level.
//    修改 projectListWidth、projectListGapClass 和卡片列表附近的 ProjectCard 参数，以调整列表宽度、间隙、卡片布局或标题层级。

// Page metadata / 页面元信息
const pageTitle = 'Portfolio'
const pageDescription = 'A complete visual index of portfolio projects, arranged as an overlay masonry gallery.'
const pageHeading = 'All Projects'
const pageSubtitle = 'A visual summary of every project, arranged as an overlay masonry gallery.'
const projectListWidth: ProjectListWidth = 'full' // Project list width: container | full / 项目列表宽度：网页宽 | 全屏宽
const projectListGapClass = 'gap-5' // Project list gap class; controls column and row gaps / 项目列表间隙 class，同时控制左右和上下间隙
const projectListWidthClass = getProjectListWidthClass(projectListWidth)
const projectListGapSize = resolveTailwindGapClass(projectListGapClass)
const isFullWidthList = projectListWidth === 'full'

type SortBy = 'latest' | 'popular' | 'earliest'

// PaloPageHeader settings / PaloPageHeader 参数设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  backgroundVideo: '', // Video path in /public / 背景视频，放在 /public
  backgroundImage: '', // Image path in /public / 背景图片，放在 /public
  backgroundColor: '', // Background color; empty = theme / 背景颜色，空=跟随主题
  backgroundFixed: false, // Fixed background inside section / 背景在区域内固定
  backgroundOverlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  paddingBlock: '', // Vertical padding token or CSS value / 上下内边距 token 或 CSS 值
  contentVerticalAlign: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  contentHorizontalAlign: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  showDivider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
}

const projects = await getCollection('projects')
const uniqueTags = [...new Set(projects.map((project) => project.data.tags).flat())]
  .sort((a, b) => a.localeCompare(b))
  .map((label) => ({
    label,
    slug: slugify(label),
  }))

// Sort projects by latest (default)
const sortedProjects = [...projects].sort((a, b) => b.id.localeCompare(a.id))

const projectsWithImages = sortedProjects.map((project, index) => ({
  ...project,
  featuredImage: project.data.coverImage || projectImages[index % projectImages.length],
}))
---

<DefaultLayout title={pageTitle} description={pageDescription}>
  <!--
    PaloPageHeader custom parameters / PaloPageHeader 自定义参数：
    - title uses pageHeading above / title 使用上方 pageHeading
    - subtitle uses pageSubtitle above / subtitle 使用上方 pageSubtitle
    - pageHeaderAppearance controls background, spacing, divider, and nav theme / pageHeaderAppearance 控制背景、间距、分隔线和导航主题
  -->
  <PaloPageHeader title={pageHeading} subtitle={pageSubtitle} {...pageHeaderAppearance} />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        {
          uniqueTags.map((tag) => (
            <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
          ))
        }
      </div>
      <p class="mt-8 text-sm">
        <em>{projectsWithImages.length} total projects</em>
      </p>
      {
        !isFullWidthList && (
          <ul
            class:list={['project-masonry mt-3', projectListWidthClass, projectListGapClass]}
            style={`--project-list-gap: ${projectListGapSize}`}
          >
            {
              projectsWithImages.map((project) => (
                <li class="project-masonry__item">
                  <ProjectCard
                    project={project}
                    image={project.featuredImage}
                    layout="overlay"
                    headingLevel="h5"
                    descriptionClass="text-base"
                  />
                </li>
              ))
            }
          </ul>
        )
      }
    </div>
    {
      isFullWidthList && (
        <ul
          class:list={['project-masonry mt-3', projectListWidthClass, projectListGapClass]}
          style={`--project-list-gap: ${projectListGapSize}`}
        >
          {
            projectsWithImages.map((project) => (
              <li class="project-masonry__item">
                <ProjectCard
                  project={project}
                  image={project.featuredImage}
                  layout="overlay"
                  headingLevel="h5"
                  descriptionClass="text-base"
                />
              </li>
            ))
          }
        </ul>
      )
    }
  </section>
</DefaultLayout>
