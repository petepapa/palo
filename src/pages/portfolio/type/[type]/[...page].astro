---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { PaginateFunction, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getProjectTypeDefinition, projectTypeIds } from '../../../../projectTypes'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { resolveCollectionCoverImage } from '@utils/contentImages'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'

// =========================================================================
// 🎛️ 中央控制台 / Central Page Configuration
// =========================================================================
const pageConfig = {
  // ── 文案与 SEO / Copywriting & SEO ──
  metaTitle: '',                          // 选填 SEO title，留空自动生成
  metaDescription: '',                    // 选填 SEO description，留空自动生成

  // ── 功能开关中心 / Feature Toggles ──
  showTags: true,                         // 是否启用顶部 Tag 标签筛选功能
  showStats: true,                        // 是否显示项目统计信息

  // ── 列表布局参数 / List Layout Settings ──
  layout: 'standard',                     // 卡片布局风格：'standard' (网格) | 'overlay' (悬浮遮罩)
  width: 'container' as ProjectListWidth, // 容器宽度：'container' (网页内宽) | 'full' (全屏全宽)
  gap: 'gap-8',                           // 项目间距类名 (Tailwind Gap Class)
  colsClass: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3', // 网格列配置

  // ── 细粒度排版微调 / Typography Fine-Tuning ──
  tagsHeading: 'h5',                      // Tags 区域标题的 HTML 标签级别与字号样式 ('h1' - 'h6')
  projectHeadingLevel: 'h5',              // 项目卡片标题的 HTML 标签级别
  projectDescClass: 'text-base',          // 项目卡片摘要文字的 CSS Class
} as const

// ── PaloPageHeader 结构化参数 ──
const pageHeader = {
  fullscreen: false,
  contentColor: '',
  topNavigationTheme: '',
  alignV: 'center',
  alignH: 'left',
  divider: 'bottom',
  bg: {
    video: '',
    image: '',
    color: '',
    fixed: false,
    overlayOpacity: 0,
  },
} as const

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const projects = (await getCollection('projects')).filter(
    (project) => !project.data.draft,
  )
  const uniqueTags = [...new Set(projects.map((project) => project.data.tags).flat())]
    .sort((a, b) => a.localeCompare(b))
    .map((label) => ({
      label,
      slug: slugify(label),
    }))

  const projectsWithImages = projects
  const allPaginatedPages: Array<any> = []

  for (const typeId of projectTypeIds) {
    const currentType = getProjectTypeDefinition(typeId)
    const filteredProjects = projectsWithImages.filter((project) => project.data.type === typeId)

    const sortedFilteredProjects = [...filteredProjects].sort(
      (a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0)
    )

    const paginatedPages = paginate(sortedFilteredProjects, {
      pageSize: 10,
      params: { type: typeId },
      props: {
        currentType,
        uniqueTags,
      },
    })

    allPaginatedPages.push(...paginatedPages)
  }

  return allPaginatedPages
}

interface Props {
  page: Page<CollectionEntry<'projects'> & { featuredImage: any }>
  currentType: { id: string; label: string; ratioLabel: string; description: string }
  uniqueTags: { label: string; slug: string }[]
}

const { page, currentType, uniqueTags } = Astro.props as Props

// 派生计算属性
const currentTypeUrl = `/portfolio/type/${currentType.id}`
const projectListWidthClass = getProjectListWidthClass(pageConfig.width)
const projectListGapSize = resolveTailwindGapClass(pageConfig.gap)
const resolvedMetaTitle = pageConfig.metaTitle || `Portfolio - ${currentType.label}`
const resolvedMetaDescription = pageConfig.metaDescription || `${currentType.label} portfolio projects using the ${currentType.ratioLabel} thumbnail ratio.`
const pageHeading = `${currentType.label} Projects`
const pageSubtitle = `${currentType.description} <a href="/portfolio">View all projects</a>.`
---

<DefaultLayout title={resolvedMetaTitle} description={resolvedMetaDescription}>
  <PaloPageHeader title={pageHeading} subtitle={pageSubtitle} {...pageHeader} />

  <section class="my-12">
    <div class="container">
      {pageConfig.showTags && uniqueTags.length > 0 && (
        <div class="tags-filter mb-8">
          <Heading level={pageConfig.tagsHeading} size={pageConfig.tagsHeading} class="mb-3">Tags</Heading>
          <div class="flex flex-wrap gap-4">
            <Link href={ensureTrailingSlash('/portfolio')}>All</Link>
            {
              uniqueTags.map((tag) => (
                <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
              ))
            }
          </div>
        </div>
      )}

      {pageConfig.showStats && (
        <p class="mb-6 text-sm text-neutral-500 italic">
          {page.total} total {currentType.label} projects · Page {page.currentPage} of {page.lastPage}
        </p>
      )}
    </div>

    <div class="container">
      <ul
        class:list={['mt-3 grid list-none p-0', projectListWidthClass, pageConfig.gap, pageConfig.colsClass]}
        style={`--project-list-gap: ${projectListGapSize}`}
      >
        {
          page.data.map((project) => (
            <li>
              <ProjectCard
                project={project}
                image={resolveCollectionCoverImage(
                  project.data.coverImage,
                  project.id,
                  'projects',
                  getProjectTypeDefaultImage(project.data.type),
                )}
                layout={pageConfig.layout}
                headingLevel={pageConfig.projectHeadingLevel}
                descriptionClass={pageConfig.projectDescClass}
              />
            </li>
          ))
        }
      </ul>

      {page.lastPage > 1 && (
        <div class="mt-12 flex justify-center">
          <Pagination
            firstPage={page.url.prev ? ensureTrailingSlash(currentTypeUrl) : null}
            previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
            nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
            lastPage={page.url.next ? ensureTrailingSlash(`${currentTypeUrl}/${page.lastPage}`) : null}
            currentPage={`${page.currentPage}`}
            totalPages={`${page.lastPage}`}
            ariaLabel={`${currentType.label} portfolio pagination`}
          />
        </div>
      )}
    </div>
  </section>
</DefaultLayout>