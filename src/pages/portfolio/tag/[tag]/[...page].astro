---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { projectImages } from '@utils/projectImages'

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getCollection('projects')
  const allTags = projects.map((project) => project.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const projectsWithImages = projects.map((project, index) => {
    return {
      ...project,
      featuredImage: projectImages[index % projectImages.length],
    }
  })

  // Generate paginated pages for each tag
  const allPaginatedPages = []

  for (const tag of uniqueTags) {
    const filteredProjects = projectsWithImages.filter((project) =>
      project.data.tags.map((tag) => slugify(tag)).includes(tag.slug),
    )

    const paginatedPages = paginate(filteredProjects, {
      pageSize: 6,
      params: { tag: tag.slug },
      props: {
        currentTag: tag,
        uniqueTags,
      },
    })

    allPaginatedPages.push(...paginatedPages)
  }

  return allPaginatedPages
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'projects'> & { featuredImage: any }>
  currentTag: { label: string; slug: string }
  uniqueTags: { label: string; slug: string }[]
}

const { page, currentTag, uniqueTags } = Astro.props

// PaloPageHeader settings / 页面头部设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  backgroundVideo: '', // Video path in /public / 背景视频，放在 /public
  backgroundImage: '', // Image path in /public / 背景图片，放在 /public
  backgroundColor: '', // Background color; empty = theme / 背景颜色，空=跟随主题
  backgroundFixed: false, // Fixed background inside section / 背景在区域内固定
  backgroundOverlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  paddingBlock: '', // Vertical padding token or CSS value / 上下内边距 token 或 CSS 值
  contentVerticalAlign: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  contentHorizontalAlign: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  showDivider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
}
---

<DefaultLayout
  title={`Portfolio - ${currentTag.label}`}
  description={`Projects filtered by ${currentTag.label} tag. Discover our work in ${currentTag.label} and related technologies.`}
>
  <PaloPageHeader
    title={`Portfolio: ${currentTag.label}`}
    subtitle={`Showing ${page.total} project${page.total !== 1 ? 's' : ''} tagged with "${currentTag.label}". <a href="${ensureTrailingSlash('/portfolio')}">View all projects</a> or filter by other tags below.`}
    {...pageHeaderAppearance}
  />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Tags</Heading>
      <div class="flex flex-wrap gap-4">
        <Link href={ensureTrailingSlash('/portfolio')}>All projects</Link>
        {
          uniqueTags.map((tag: { label: string; slug: string }) => {
            const isCurrentTag = tag.slug === currentTag.slug
            return isCurrentTag ? (
              <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)} disabled class="disabled">
                {tag.label}
              </Link>
            ) : (
              <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
            )
          })
        }
      </div>
      <p class="mt-8 text-sm">
        <em
          >Project {page.start + 1} through {page.end + 1} of {page.total} total projects tagged with "{
            currentTag.label
          }"</em
        >
      </p>
      <ul class="project-masonry mt-3">
        {
          page.data.map((project) => (
            <li class="project-masonry__item">
              <ProjectCard project={project} image={project.featuredImage} layout="overlay" />
            </li>
          ))
        }
      </ul>

      <!-- Pagination -->
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? ensureTrailingSlash(`/portfolio/tag/${currentTag.slug}`) : null}
              previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
              nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
              lastPage={page.url.next ? ensureTrailingSlash(`/portfolio/tag/${currentTag.slug}/${page.lastPage}`) : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel={`${currentTag.label} portfolio pagination`}
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  @layer components {
    .project-masonry {
      column-count: 1;
      column-gap: var(--space-m, 1.5rem);
      list-style: none;
      padding: 0;
    }

    .project-masonry__item {
      break-inside: avoid;
      backface-visibility: hidden;
    }

    @media (min-width: 640px) {
      .project-masonry {
        column-count: 2;
      }
    }

    @media (min-width: 1024px) {
      .project-masonry {
        column-count: 3;
      }
    }
  }
</style>
