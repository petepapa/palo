---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ProjectCard from '@components/ProjectCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getProjectTypeDefaultImage } from '@utils/projectImages'
import { resolveCollectionCoverImage } from '@utils/contentImages'
import { resolveTailwindGapClass } from '@utils/tailwindSpacing'
import { getProjectListWidthClass, type ProjectListWidth } from '@utils/projectListWidth'
import { PAGE_SIZE, SORT_BY } from '@utils/listConfig'
import config from '@config'
import { buildProjectListStyle } from '../../../../types/config'

// =========================================================================
// 🎛️ 中央控制台 / Central Page Configuration (源自 config.yaml)
//   三级降级链路：tagPage → defaults → 硬编码兜底
// =========================================================================
const portfolioDefaults = config.portfolio?.defaults ?? {}
const portfolioTagPage = config.portfolio?.tagPage ?? {}
const portfolioListPage = config.portfolio?.listPage ?? {}
const navListActiveStyle = config.navigation?.navList?.activeStyle ?? 'bold'
const GAP_TO_REM: Record<string, string> = {'gap-0':'0','gap-px':'1px','gap-1':'0.25rem','gap-2':'0.5rem','gap-3':'0.75rem','gap-4':'1rem','gap-5':'1.25rem','gap-6':'1.5rem','gap-7':'1.75rem','gap-8':'2rem','gap-9':'2.25rem','gap-10':'2.5rem','gap-12':'3rem','gap-16':'4rem','gap-20':'5rem','gap-24':'6rem','gap-32':'8rem','gap-48':'12rem','gap-64':'16rem'}
const navListHorizontalGapRem = GAP_TO_REM[config.navigation?.navList?.horizontalGap ?? 'gap-4'] ?? '1rem'
const navListVerticalScale = config.navigation?.navList?.verticalScale ?? 1

// 列参数：tagPage.columns 与 defaults.columns 合并（{} 表示完全继承 defaults）

const pageConfig = {
  // ── 文案与 SEO / Copywriting & SEO ──
  metaTitle: '',
  metaDescription: '',
  allLabel: portfolioListPage.allLabel ?? 'All Projects',

  // ── 功能开关中心 / Feature Toggles (tagPage → defaults) ──
  showTags: portfolioTagPage.showTags ?? portfolioDefaults.showTags ?? true,
  showStats: portfolioTagPage.showStats ?? portfolioDefaults.showStats ?? true,

  // ── 列表布局参数 / List Layout Settings (tagPage → defaults) ──
  layout: portfolioTagPage.layout ?? portfolioDefaults.layout ?? 'overlay',
  width: (portfolioTagPage.width ?? portfolioDefaults.width ?? 'full') as ProjectListWidth,
  gap: portfolioTagPage.gap ?? portfolioDefaults.gap ?? 'gap-5',

  // ── 细粒度排版微调 / Typography Fine-Tuning (tagPage → defaults) ──
  tagsHeading: portfolioTagPage.tagsHeading ?? portfolioDefaults.tagsHeading ?? 'h5',
  projectHeadingLevel: portfolioTagPage.projectHeadingLevel ?? portfolioDefaults.projectHeadingLevel ?? 'h5',
  projectDescClass: portfolioTagPage.projectDescClass ?? portfolioDefaults.projectDescClass ?? 'text-base',
} as const

// ── PaloPageHeader 结构化参数 (从 config.yaml 读取全局默认值) ──
const pageHeaderDefaults = config.components?.paloPageHeader ?? {}
const pageHeader = {
  fullscreen: '',
  contentColor: '',
  topNavigationTheme: '',
  alignV: pageHeaderDefaults.alignV ?? 'center',
  alignH: pageHeaderDefaults.alignH ?? 'left',
  divider: pageHeaderDefaults.divider ?? 'bottom',
  bg: {
    video: '',
    image: '',
    color: '',
    fixed: false,
    overlayOpacity: 0,
  },
} as const

export const getStaticPaths = (async ({ paginate }) => {
  const allProjects = (await getCollection('projects')).filter(
    (project) => !project.data.draft,
  )
  const allTags = allProjects.map((project) => project.data.tags).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const allPaginatedPages = []

  for (const tag of uniqueTags) {
    const filteredProjects = allProjects.filter((project) =>
      project.data.tags.map((tag) => slugify(tag)).includes(tag.slug),
    )

    // 双轴排序引擎：精选置顶 (featuredOrder 升序) + 时间轴兜底
    const featured = filteredProjects.filter((p) => p.data.featuredOrder !== undefined)
    const regular = filteredProjects.filter((p) => p.data.featuredOrder === undefined)

    featured.sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))

    if (SORT_BY.portfolio === 'earliest') {
      regular.sort((a, b) => (a.data.publishDate?.valueOf() || 0) - (b.data.publishDate?.valueOf() || 0))
    } else {
      regular.sort((a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0))
    }

    const sortedFilteredProjects = [...featured, ...regular]

    const paginatedPages = paginate(sortedFilteredProjects, {
      pageSize: PAGE_SIZE.portfolio,
      params: { tag: tag.slug },
      props: {
        currentTag: tag,
        uniqueTags,
      },
    })

    allPaginatedPages.push(...paginatedPages)
  }

  return allPaginatedPages
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'projects'> & { featuredImage: any }>
  currentTag: { label: string; slug: string }
  uniqueTags: { label: string; slug: string }[]
}

const { page, currentTag, uniqueTags } = Astro.props

// 派生计算属性
const projectListWidthClass = getProjectListWidthClass(pageConfig.width)
const projectListGapSize = resolveTailwindGapClass(pageConfig.gap)
const projectListStyle = buildProjectListStyle(projectListGapSize, portfolioTagPage.columns, portfolioDefaults.columns)
const isFullWidthList = pageConfig.width === 'full'
const resolvedMetaTitle = pageConfig.metaTitle || `Portfolio - ${currentTag.label}`
const resolvedMetaDescription = pageConfig.metaDescription || `Projects filtered by ${currentTag.label} tag. Discover our work in ${currentTag.label} and related technologies.`
---

<DefaultLayout title={resolvedMetaTitle} description={resolvedMetaDescription} hasHero={true}>
  <PaloPageHeader
    title={`Portfolio: ${currentTag.label}`}
    subtitle={`Showing ${page.total} project${page.total !== 1 ? 's' : ''} tagged with "${currentTag.label}". <a href="${ensureTrailingSlash('/portfolio')}">View all projects</a> or filter by other tags below.`}
    {...pageHeader}
  />

  <section class="my-12">
    <div class="container">
      {pageConfig.showTags && uniqueTags.length > 0 && (
        <div class="tags-filter mb-8 palo-nav-list" data-active-style={navListActiveStyle}>
          <Heading level={pageConfig.tagsHeading} size={pageConfig.tagsHeading} class="mb-3">Tags</Heading>
          <div class="is-horizontal" style={`--palo-nav-horizontal-space: ${navListHorizontalGapRem}; --palo-nav-vertical-scale: ${navListVerticalScale}`}>
            <Link href={ensureTrailingSlash('/portfolio')}>{pageConfig.allLabel}</Link>
            {
              uniqueTags.map((tag: { label: string; slug: string }) => {
                const isCurrentTag = tag.slug === currentTag.slug
                return isCurrentTag ? (
                  <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)} aria-current="page">
                    {tag.label}
                  </Link>
                ) : (
                  <Link href={ensureTrailingSlash('/portfolio/tag/' + tag.slug)}>{tag.label}</Link>
                )
              })
            }
          </div>
        </div>
      )}

      {pageConfig.showStats && (
        <p class="mb-6 text-sm text-neutral-500 italic">
          {page.total} total projects tagged with "{currentTag.label}" · Page {page.currentPage} of {page.lastPage}
        </p>
      )}
    </div>

    <div class={isFullWidthList ? "w-full" : "container"}>
      <ul
        class:list={['project-masonry mt-3', projectListWidthClass]}
        style={projectListStyle}
      >
        {
          page.data.map((project) => (
            <li class="project-masonry__item break-inside-avoid">
              <ProjectCard
                project={project}
                image={resolveCollectionCoverImage(
                  project.data.coverImage,
                  project.id,
                  'projects',
                  getProjectTypeDefaultImage(project.data.type),
                )}
                layout={pageConfig.layout}
                headingLevel={pageConfig.projectHeadingLevel}
                descriptionClass={pageConfig.projectDescClass}
              />
            </li>
          ))
        }
      </ul>
    </div>

    {page.lastPage > 1 && (
      <div class="mt-12 flex justify-center">
        <Pagination
          firstPage={page.url.prev ? ensureTrailingSlash(`/portfolio/tag/${currentTag.slug}`) : null}
          previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
          nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
          lastPage={page.url.next ? ensureTrailingSlash(`/portfolio/tag/${currentTag.slug}/${page.lastPage}`) : null}
          currentPage={`${page.currentPage}`}
          totalPages={`${page.lastPage}`}
          ariaLabel={`${currentTag.label} portfolio pagination`}
        />
      </div>
    )}
  </section>
</DefaultLayout>