---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import CreativeSection from '@components/CreativeSection.astro'
import ContentMedia from '@components/ContentMedia.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import LatestPosts from '@components/LatestPosts.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { Card } from 'accessible-astro-components'
---

<DefaultLayout>

  {/* HERO========================================*/}

  {/* true/空=下方；top/both/bottom/false 可选 / true/empty=bottom; accepts top/both/bottom/false */}
  <Hero
    fullscreen={true}
    contentColor=""
    backgroundVideo=""
    backgroundImage="/hero-bg.png"
    backgroundColor=""
    backgroundFixed={true}
    backgroundOverlayOpacity={0}
    topNavigationTheme=""
    paddingBlock=""
    contentVerticalAlign="center"
    showDivider="true"
  >
    {/* 可编辑区域开始 / Editable Content Start */}
    <div class="flex flex-col items-center  text-center gap-6">
      <img
        src="/favicon.svg"
        alt="Hero Artwork"
        class="w-16 h-16 sm:w-24 sm:h-24 object-contain mb-2"
      />
      <h2>
        Your art doesn't fit in a box.
        Neither should your website.
      </h2>
      <div class="w-full">
        <p class="text-lg">
          Palo is a minimalist Astro theme crafted
          <br class="hidden sm:inline" />
          for artists, musicians, and designers
          <br class="hidden sm:inline" />
          who refuse to look like everyone else.
        </p>
      </div>

      <Link href="https://github.com/petepapa/palo" size="md" isButton type="primary">
        Get on Github
        <Icon aria-hidden="true" name="ph:arrow-right" size="24" />
      </Link>
    </div>
    {/* 可编辑区域结束 / Editable Content End */}
  </Hero>

  <CreativeSection
    fullscreen={false}
    contentColor="#fff" 
    backgroundVideo=""
    backgroundImage=""
    backgroundColor="#ff4b00"
    backgroundFixed={false}
    backgroundOverlayOpacity={0.5}
    paddingBlock=""
    contentVerticalAlign="center"
    showDivider="false" 
  >
    <div class="text-center">
      <p class="text-xl font-semibold">
        A portfolio framework that gets out of your way — and stays true to your aesthetic.
      </p>
      <!--
      <p class="text-xs">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-sm">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-base">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-lg">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-2xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-3xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-4xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-5xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-6xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-7xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-8xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
      <p class="text-9xl">A portfolio framework that gets out of your way — and stays true to your aesthetic.</p>
    -->
    </div>
  </CreativeSection>

  {/* FEATURES======================================== */}

  <CreativeSection
    paddingBlock=''
  >
    <div class=" ">
      
      <h2 class="mb-8">Features</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
    
        <Card 
          img="/123.jpeg"
          title=""
          class="flex flex-col"
          >
          <h4>One Config. Total Control.</h4>
          <p>Set your colors, fonts, border radius, and layout from a single YAML file. No scattered CSS variables, no theme overrides. Palo's design system is a single source of truth.</p>
        </Card>

        <Card 
          img="/123.jpeg"
          title=""
          class="flex flex-col"
          >
          <h4>One Config. Total Control.</h4>
          <p>Set your colors, fonts, border radius, and layout from a single YAML file. No scattered CSS variables, no theme overrides. Palo's design system is a single source of truth.</p>
        </Card>

        <Card 
          img="/123.jpeg"
          title=""
          class="flex flex-col"
          >
          <h4>One Config. Total Control.</h4>
          <p>Set your colors, fonts, border radius, and layout from a single YAML file. No scattered CSS variables, no theme overrides. Palo's design system is a single source of truth.</p>
        </Card>

      </div>

    </div>
  </CreativeSection>

  

  <section class="my-64">
  <FeaturedProjects limit={10} layout="overlay" projectListWidth="full" projectListGapClass="gap-5" />
  </section>

  {/* LATEST POSTS SECTION ========================================*/}
  <section class="my-64">
  <LatestPosts limit={3} />
</section>

</DefaultLayout>

<style>
  @layer components {
    .avatar {
      border: var(--border-width-surface, var(--border-width-global, 3px)) solid var(--border-color-subtle);
      border-radius: var(--radius-surface, var(--radius-global, var(--radius-md)));
      padding: var(--space-s);
    }
  }
</style>
