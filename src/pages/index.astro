---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import CreativeSection from '@components/CreativeSection.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import LatestPosts from '@components/LatestPosts.astro'
import Feature from '@components/Feature.astro'
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout hasHero={true}>

  {/* HERO========================================*/}

  {/* true/空=下方；top/both/bottom/false 可选 / true/empty=bottom; accepts top/both/bottom/false */}
  <Hero
    fullscreen={true}
    contentColor=""
    topNavigationTheme=""
    class="py-8"
    alignV="center"
    alignH="center"
    divider="bottom"
    useContainer={false}
    bg={{
      image: "/branding/hero-bg.png",
      video: "",
      color: "",
      fixed: true,
      overlayOpacity: 0,
    }}
  >
    {/* 可编辑区域开始 / Editable Content Start */}
    <div class="flex flex-col items-center  text-center gap-6">
      <img
        src="/branding/favicon.svg"
        alt="Hero Artwork"
        class="w-16 h-16 sm:w-24 sm:h-24 object-contain mb-2"
      />
      <h2>
        Your art doesn't fit in a box.
        Neither should your website.
      </h2>
      <div class="w-full">
        <p class="text-lg">
          Palo is a minimalist Astro theme crafted
          <br class="hidden sm:inline" />
          for artists, musicians, and designers
          <br class="hidden sm:inline" />
          who refuse to look like everyone else.
        </p>
      </div>

      <Link href="https://github.com/petepapa/palo" size="md" isButton type="primary">
        Get on Github
        <Icon aria-hidden="true" name="ph:arrow-right" size="24" />
      </Link>
    </div>
    {/* 可编辑区域结束 / Editable Content End */}
  </Hero>


  <section class="my-32 md:my-48">
    <div class="container">
      <h2 class="mb-12">Features</h2>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 xl:grid-cols-3">
        <Feature icon="ph:sliders-horizontal" title="One-file creative control">
          Tune branding, typography, navigation, borders, portfolio grids, blog lists, and contact settings from
          <a href="/blog/20260603-config-everything-you-like">one readable YAML file</a>.
        </Feature>

        <Feature icon="ph:image-square" title="Images live with the story">
          Keep covers and article media beside each Markdown file, then use relative paths for responsive images and reliable content moves.
        </Feature>

        <Feature icon="ph:stack" title="Portfolio layouts with range">
          Mix overlay galleries, standard cards, project types, tag pages, featured ordering, and responsive masonry without rebuilding templates.
        </Feature>

        <Feature icon="ph:browser" title="Immersive page sections">
          Build full-screen hero areas, video sections, page headers, dividers, overlays, and fixed backgrounds with reusable Astro components.
        </Feature>

        <Feature icon="ph:person-arms-spread" title="Accessible by default">
          Start from semantic navigation, keyboard-friendly controls, visible focus states, color contrast tooling, and reduced-motion-aware patterns.
        </Feature>

        <Feature icon="ph:paper-plane-tilt" title="Contact forms ready for launch">
          Customize fields in code, send email through Resend, and keep production secrets in deployment environment variables.
        </Feature>
      </div>
    </div>
  </section>


  <CreativeSection
    fullscreen={true}
    contentColor=""
    class="py-16 bg-neutral-900 text-neutral-100"
    alignV="bottom"
    alignH="center"
    divider="both"
    useContainer={false}
    bg={{
      image: "/bg-video.jpg",
      video: "/bg-video.mp4",
      color: "",
      fixed: false,
      overlayOpacity: 0.25,
    }}
  >
      <p class="text-xl font-semibold">
        A PORTFOLIO FRAMEWORK THAT GETS OUT OF YOUR WAY — AND STAYS TRUE TO YOUR AESTHETIC.
      </p>
      

      <p class="text-neutral-300">
        Background Video: Excerpt from "It's Not the End of the World?" MV (Super Furry Animals) / Directed by Numero 6 (David Nicolas).
      </p>

  </CreativeSection>

  {/* FEATURED PROJECTS======================================== */}

  <section class="my-64">
    <FeaturedProjects />
  </section>

  {/* LATEST POSTS SECTION ========================================*/}

  <section class="my-64">
    <LatestPosts />
  </section>

</DefaultLayout>

<style>
  @layer components {
    .avatar {
      border: var(--border-width-surface, var(--border-width-global, 3px)) solid var(--border-color-subtle);
      border-radius: var(--radius-surface, var(--radius-global, var(--radius-md)));
      padding: var(--space-s);
    }
  }
</style>
