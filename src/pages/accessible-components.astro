<style lang="scss" is:global>
  @use 'scss/base/breakpoint' as *;

  @layer components {
    .article-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-l);

      &--with-toc {
        @media (min-width: 768px) {
          grid-template-columns: minmax(0, 1fr) 280px;
        }

        @media (min-width: 1200px) {
          grid-template-columns: minmax(0, 1fr) 320px;
        }
      }
    }

    .article-content__main {
      min-width: 0;
    }

    .article-content--with-toc .article-content__main {
      @media (min-width: 768px) {
        border-inline-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        padding-inline-end: var(--space-l);
      }
    }

    .article-content__toc {
      grid-row: 1;

      @media (min-width: 768px) {
        position: sticky;
        grid-row: auto;
        align-self: start;
        inset-block-start: calc(var(--header-height) + var(--space-l));
        padding-inline-start: 0;
        padding-block-end: 5rem;
        max-inline-size: 100%;
        max-block-size: calc(100vh - var(--header-height) - var(--space-l));
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        transition: inset-block-start 0.6s cubic-bezier(0.075, 0.82, 0.165, 1);

        &::-webkit-scrollbar {
          display: none;
        }

        &.is-un-stuck-locked {
          overflow-y: hidden;
        }

        &.is-stuck {
          overflow-y: auto;
        }
      }
    }

    .badge-notification-demo {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 1rem;
    }

    .badge-notification-demo__item {
      position: relative;
      display: grid;
      place-items: center;
      inline-size: max-content;
      block-size: max-content;
      line-height: 0;
    }

    .badge-notification-demo__trigger {
      display: grid;
      place-items: center;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      line-height: 0;
      vertical-align: top;
    }

    .badge-notification-demo__trigger :global(svg) {
      display: block;
    }

    /* 🔥 防止 Media 组件（ratio=auto）图片加载后撑开布局导致 hash 滚动位偏移 */
    .media-wrapper[data-ratio="auto"] {
      aspect-ratio: 16/9;
    }


    :global(.heading) {
      scroll-margin-block-start: calc(var(--header-height) + var(--space-l, 2rem));
    }
  }
</style>
