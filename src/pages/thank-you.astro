---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import { Heading, Link, Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { ensureTrailingSlash } from '@utils/trailingSlash'

// Page header appearance settings: fullscreen, content color, background video/image, background color, top navigation theme, divider.
// 页面头部外观设置：全屏、内容颜色、背景视频/图片、背景颜色、顶部导航主题、分割线
const pageHeaderAppearance = {
  fullscreen: false,
  contentColor: '',
  backgroundVideo: '',
  backgroundImage: '',
  backgroundColor: '',
  topNavigationTheme: '',
  showDivider: true,
}
---

<DefaultLayout title="Thank You">
  <PaloPageHeader title="Splendid!" subtitle="The form was successfully validated." {...pageHeaderAppearance} />
  <section class="container my-16">
    <div class="space-content">
      <Notification type="info">
        <Icon aria-hidden="true" name="lucide:info" size={24} />
        <p>This was a test of the form validation system, no email was sent 😉.</p>
      </Notification>
      <Link href={ensureTrailingSlash('/contact')} isButton type="primary" animateOnHover animation="boop" pulse>
        <Icon aria-hidden="true" name="lucide:mail" size={24} />
        Send another message
      </Link>
    </div>
  </section>
</DefaultLayout>
