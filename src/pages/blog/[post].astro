---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PostHeader from '@components/PostHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, render } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'

export async function getStaticPaths() {
  const posts = await getCollection('posts')

  const defaultImages = [
    '/posts/post-image-1.png',
    '/posts/post-image-2.png',
    '/posts/post-image-3.png',
    '/posts/post-image-4.png',
    '/posts/post-image-5.png',
    '/posts/post-image-6.png',
  ]

  return posts.map((post, index) => {
    const featuredImage = post.data.coverImage || defaultImages[index % defaultImages.length]

    return {
      params: { post: post.id },
      props: { post, featuredImage },
    }
  })
}

const { post, featuredImage } = Astro.props
const { Content } = await render(post)

const { title, description, author, publishDate, showBreadcrumbs, source, liveDemo, customBreadcrumbLabels, joinLastBreadcrumb, showDivider, coverImagePosition } = post.data

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const authorInfo = typeof author === 'object'
  ? {
      name: author.name,
      image: author.image || undefined,
      bio: author.bio || 'Blog Author',
    }
  : {
      name: author || 'Anonymous',
      image: undefined,
      bio: 'Blog Author',
    }
---

<DefaultLayout title={title} description={description} url={ensureTrailingSlash(`/blog/${post.id}`)}>
  <PostHeader
    title={title}
    subtitle={description}
    author={authorInfo}
    featuredImage={featuredImage}
    showBreadcrumbs={showBreadcrumbs}
    source={source}
    liveDemo={liveDemo}
    customBreadcrumbLabels={customBreadcrumbLabels}
    joinLastBreadcrumb={joinLastBreadcrumb}
    showDivider={showDivider}
    coverImagePosition={coverImagePosition}
  />
  <section class="my-12">
    <div class="narrow prose space-content container">
      <Content />
    </div>
  </section>
  <section class="my-12">
    <div class="narrow space-content container">
      <Heading level="h2">Share this post</Heading>
      <p>Like this post? Share it with your network!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>

<style lang="scss" is:global>
  @layer components {
    .narrow {
      margin-inline: auto;
      max-width: 65ch;
    }
  }
</style>
