---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PostHeader from '@components/PostHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { getCollection, getEntry } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { 
  getPostDefaultImage, 
  resolveCollectionCoverImage, 
  resolveAuthorImageResolved,
  type ResolvedImage,
  smartRender,
  getFallbackContentHtml,
  isImageLoadingError,
  isSchemaValidationError
} from '@utils/contentImages'
import config from '@config'
import TableOfContents from '@components/TableOfContents.astro'

// ───── 从 config.yaml 读取全局默认值 ─────
const postHeaderDefaults = config.components?.postHeader ?? {}
const showShareDefault = postHeaderDefaults.showShare ?? true

/**
 * 动态路由：/blog/[post]
 *
 * 关键渲染策略：
 *   prerender = true  → 构建期静态生成，避免 SSR 下 getStaticPaths 被忽略导致 404 / FOUC
 *
 * 终极防崩溃架构：
 *
 * 第一层防护（Schema 层）：
 *   - imageField 使用 .catch(undefined) 确保图片解析失败不阻断 collection
 *   - 所有字段都有默认值和 catch 兜底
 *
 * 第二层防护（路由层）：
 *   - getStaticPaths 只传递纯数据 props（不传递 entry 对象）
 *   - 路由主体用 getEntry() 重新获取完整 entry
 *   - smartRender() 带指数退避重试机制
 *
 * 第三层防护（渲染层）：
 *   - render() 失败时显示友好的加载中占位符
 *   - Dev 模式下显示错误详情和重新加载按钮
 *   - 支持客户端自动重试和手动刷新
 *
 * 自愈机制：
 *   - 检测到图片加载错误时，自动使用 fallback 图片
 *   - 检测到 Schema 验证错误时，跳过渲染并显示提示
 *   - 支持指数退避重试策略
 */

export const prerender = true

export async function getStaticPaths() {
  const posts = await getCollection('posts')

  // 过滤草稿：draft=true 的文章不生成静态页面，不出现在任何列表
  const publishedPosts = posts.filter((post) => !post.data.draft)

  return publishedPosts.map((post) => ({
    params: { post: post.id },
    props: {},
  }))
}

const postId = Astro.params.post!
const postEntry = await getEntry('posts', postId)

if (!postEntry) {
  throw new Error(`[blog/[post].astro] 找不到 content entry：posts/${postId}`)
}

const coverImage = resolveCollectionCoverImage(
  postEntry.data.coverImage as ResolvedImage | undefined,
  postId,
  'posts',
  getPostDefaultImage(),
)

// 🛡️ 智能渲染：带重试和自愈能力
let Content: any = () => null
let fallbackHtml: string | null = null
const isDev = import.meta.env.DEV

try {
  const rendered = await smartRender(postEntry, {
    maxRetries: 3,
    retryDelay: 100,
    onRetry: (attempt, error) => {
      console.warn(`[smartRender] 第 ${attempt} 次重试渲染 ${postId}`, error.message)
    },
    onSuccess: () => {
      console.info(`[smartRender] 成功渲染 ${postId}`)
    },
    onError: (error) => {
      console.error(`[smartRender] 所有重试均失败 ${postId}`, error)
    },
  })
  Content = rendered.Content
} catch (error) {
  const renderError = error instanceof Error ? error : new Error(String(error))
  
  if (isImageLoadingError(renderError)) {
    console.warn(`[blog/[post].astro] 图片加载错误，将使用 fallback：`, renderError.message)
  } else if (isSchemaValidationError(renderError)) {
    console.warn(`[blog/[post].astro] Schema 验证错误：`, renderError.message)
  }
  
  fallbackHtml = getFallbackContentHtml(postId, renderError, isDev)
}

const { title, description, author } = postEntry.data

const authorInfo = typeof author === 'object'
  ? {
      name: author.name,
      image: author.image || undefined,
      bio: author.bio || 'Blog Author',
    }
  : {
      name: author || 'Anonymous',
      image: undefined,
      bio: 'Blog Author',
    }

const authorImageResolved = resolveAuthorImageResolved(authorInfo.image, postId, 'posts')
---

<DefaultLayout title={title} description={description} url={ensureTrailingSlash(`/blog/${postId}`)} image={coverImage}>
  <PostHeader
    title={title}
    subtitle={description}
    author={authorInfo}
    authorImageResolved={authorImageResolved}
    coverImage={coverImage}
    breadcrumbs={postEntry.data.breadcrumbs}
    source={postEntry.data.source}
    liveDemo={postEntry.data.liveDemo}
    customBreadcrumbLabels={postEntry.data.customBreadcrumbLabels}
    joinLastBreadcrumb={postEntry.data.joinLastBreadcrumb}
    divider={postEntry.data.divider}
    coverImagePosition={postEntry.data.coverImagePosition}
  />
  <section class="my-12">
    <div class="container">
      <div class={`article-content ${postEntry.data.toc ? 'article-content--with-toc' : ''}`}>
        <div class="article-content__main">
          <div class={`prose space-content ${!postEntry.data.toc ? 'narrow' : ''}`}>
            {fallbackHtml ? <div set:html={fallbackHtml} /> : <Content />}
          </div>
          {showShareDefault && postEntry.data.share !== false && (
            <div class={`space-content mt-12 ${!postEntry.data.toc ? 'narrow' : ''}`}>
              <Heading level="h5">Share this post</Heading>
              <p>Like this post? Share it with your network!</p>
              <SocialShares title={title} description={description} />
            </div>
          )}
        </div>
        {postEntry.data.toc && <TableOfContents />}
      </div>
    </div>
  </section>
</DefaultLayout>

<script is:inline>
  // ── Prose 增强：表格响应式滚动包装 + Mermaid 渲染（与 MarkdownLayout 对齐） ──
  const initProseEnhancementsBlog = async () => {
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'
    // 1. Table responsive wrapping
    document.querySelectorAll('.prose table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-wrapper')) return
      
      const wrapper = document.createElement('div')
      wrapper.className = 'table-wrapper overflow-x-auto my-6 max-w-full rounded-lg'
      
      table.parentNode?.insertBefore(wrapper, table)
      wrapper.appendChild(table)
    })

    // 2. Dynamic client-side Mermaid rendering
    const allMermaidBlocks = []
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.dataset.paloMermaidProcessed === 'true') return
      
      const code = pre.querySelector('code')
      if (!code) return
      
      // Check if it's a mermaid block - check multiple possible locations
      const isMermaid = pre.dataset.language === 'mermaid' ||
                        code.classList.contains('language-mermaid') || 
                        code.classList.contains('lang-mermaid') ||
                        /\blanguage-mermaid\b|\blang-mermaid\b/.test(pre.className)
      
      if (isMermaid) {
        if (DEBUG) console.log('Found Mermaid block:', pre)
        allMermaidBlocks.push(pre)
      }
    })

    if (allMermaidBlocks.length > 0 && typeof mermaid !== 'undefined') {
      try {
        if (DEBUG) console.log('Found', allMermaidBlocks.length, 'Mermaid block(s)')

        for (let i = 0; i < allMermaidBlocks.length; i++) {
          const pre = allMermaidBlocks[i]
          const code = pre.querySelector('code')
          const content = code?.textContent || pre.textContent || ''
          
          const container = document.createElement('div')
          container.className = 'mermaid-container'
          container.dataset.originalCode = content.trim()
          
          const mermaidInner = document.createElement('div')
          mermaidInner.className = 'mermaid'
          mermaidInner.id = 'mermaid-' + Date.now() + '-' + i
          mermaidInner.textContent = content.trim()
          
          container.appendChild(mermaidInner)
          
          pre.dataset.paloMermaidProcessed = 'true'
          pre.replaceWith(container)
        }

        await renderMermaidWithThemeBlog()
        if (DEBUG) console.log('Mermaid render complete')
      } catch (err) {
        console.error('Failed to load or render Mermaid:', err)
      }
    }
  }

  const renderMermaidWithThemeBlog = async () => {
    if (typeof mermaid === 'undefined') return
    const DEBUG = document.documentElement.dataset.paloDebug === 'true'

    const containers = document.querySelectorAll('.mermaid-container')
    if (containers.length === 0) return

    const isDark = document.documentElement.classList.contains('darkmode')

    try {
      const cs = getComputedStyle(document.documentElement)
      const fg = cs.getPropertyValue('--foreground-color')?.trim() || (isDark ? '#fff' : '#111')
      const bg = cs.getPropertyValue('--background-color')?.trim() || (isDark ? '#111' : '#fff')
      const primary = cs.getPropertyValue('--link-color')?.trim() || cs.getPropertyValue('--color-primary-400')?.trim() || '#4f46e5'
      const border = cs.getPropertyValue('--border-color')?.trim() || '#888'

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
        themeVariables: {
          background: bg,
          textColor: fg,
          primaryColor: primary,
          lineColor: border,
        },
      })
    } catch (errTheme) {
      mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'loose' })
    }

    containers.forEach((container) => {
      const rawCode = container.dataset.originalCode
      if (!rawCode) return

      container.innerHTML = ''

      const newId = `mermaid-${Math.random().toString(36).substr(2, 9)}`
      const newDiv = document.createElement('div')
      newDiv.className = 'mermaid'
      newDiv.id = newId
      newDiv.textContent = rawCode

      container.appendChild(newDiv)
    })

    try {
      await mermaid.run()
      if (DEBUG) console.log('[Mermaid] Re-render complete (theme:', isDark ? 'dark' : 'light', ')')
    } catch (err) {
      console.error('[Mermaid] Re-render failed:', err)
    }
  }

  const paloInitMermaidThemeWatcherBlog = () => {
    if (document.querySelectorAll('.mermaid-container').length === 0) return

    let pending = false
    const observer = new MutationObserver(() => {
      if (pending) return
      pending = true

      requestAnimationFrame(() => {
        pending = false
        renderMermaidWithThemeBlog()
      })
    })

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    })
  }

  document.addEventListener('astro:page-load', initProseEnhancementsBlog)
  document.addEventListener('astro:after-swap', initProseEnhancementsBlog)
  
  const paloInitMermaidWatcherWithDelayBlog = () => {
    setTimeout(paloInitMermaidThemeWatcherBlog, 200)
  }

  document.addEventListener('astro:page-load', paloInitMermaidWatcherWithDelayBlog)
  document.addEventListener('astro:after-swap', paloInitMermaidWatcherWithDelayBlog)
  
  if (document.readyState === 'loading') {
    // DOMContentLoaded 是同步触发的，此时 releaseShield 的 requestAnimationFrame
    // 还没到执行时机，所以包装一定先完成，Shield 释放时就已经是包装好的表格
    document.addEventListener('DOMContentLoaded', initProseEnhancementsBlog)
    document.addEventListener('DOMContentLoaded', paloInitMermaidWatcherWithDelayBlog)
  } else {
    // readyState 已经是 interactive/complete 时，直接同步执行，避免 100ms 空窗
    // CSS 层面 (_prose.scss table display:block + overflow-x:auto) 也已经兜底，
    // 即使这里执行时 releaseShield 已经先触发，也不会撑破视口
    initProseEnhancementsBlog()
    paloInitMermaidThemeWatcherBlog()
  }
</script>

<style lang="scss" is:global>
  @layer components {
    .article-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-l);

      &--with-toc {
        @media (min-width: 768px) {
          grid-template-columns: minmax(0, 1fr) 280px;
        }

        @media (min-width: 1200px) {
          grid-template-columns: minmax(0, 1fr) 320px;
        }
      }
    }

    .article-content__main {
      min-width: 0;
    }

    .article-content--with-toc .article-content__main {
      @media (min-width: 768px) {
        border-inline-end: var(--border-width-divider, var(--border-width-global, 3px)) solid var(--border-color-subtle);
        padding-inline-end: var(--space-l);
      }
    }

    .article-content__toc {
      grid-row: 1;

      @media (min-width: 768px) {
        position: sticky;
        grid-row: auto;
        align-self: start;
        inset-block-start: var(--space-l);
        padding-inline-start: 0;
        padding-block-end: 5rem;
        max-inline-size: 100%;
        max-block-size: calc(100vh - var(--space-l));
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        transition: inset-block-start var(--animation-speed-slow) var(--cubic-bezier);

        &::-webkit-scrollbar {
          display: none;
        }

        &.is-un-stuck-locked {
          overflow-y: hidden;
        }

        &.is-stuck {
          overflow-y: auto;
        }
      }
    }

    body.has-fixed-header .article-content__toc {
      @media (min-width: 768px) {
        inset-block-start: calc(var(--header-height) + var(--space-l));
        max-block-size: calc(100vh - var(--header-height) - var(--space-l));
      }
    }

    ul:not([class]) li {
      margin-block-end: 0.35rem;
    }

    .narrow {
      margin-inline: auto;
      max-width: 65ch;
    }
  }
</style>
