---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import PostCard from '@components/PostCard.astro'
import { Pagination } from 'accessible-astro-components'
import type { PaginateFunction, Page } from 'astro'
import { getCollection } from 'astro:content'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { getPostDefaultImage, resolveCollectionCoverImage } from '@utils/contentImages'

type SortBy = 'latest' | 'earliest'

interface Post {
  id: string
  title: string
  description: string
  author: string
  publishDate: Date
  coverImage?: string
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = await getCollection('posts')

  const featuredPosts = posts.filter((post) => !post.data.draft && post.data.featuredOrder !== undefined)
  const regularPosts = posts.filter((post) => !post.data.draft && post.data.featuredOrder === undefined)

  featuredPosts.sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))
  regularPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

  const sortedPosts = [...featuredPosts, ...regularPosts]

  const postsWithImages = sortedPosts.map((post) => {
    const { author: originalAuthor, ...rest } = post.data
    const author = typeof originalAuthor === 'object' ? originalAuthor.name : originalAuthor
    return {
      ...rest,
      id: post.id,
      author,
      coverImage: post.data.coverImage,
    }
  })

  // ========== PAGINATION CONFIGURATION / 分页配置 ==========
  // Modify pageSize to change items per page
  // 修改 pageSize 来改变每页显示的文章数量
  // Current: 10 items per page / 当前: 每页10篇文章
  return paginate(postsWithImages, { pageSize: 10 })
}

interface Props {
  page: Page<Post>
}

const { page } = Astro.props as Props
const coverImageRatio = '8 / 5'

// PaloPageHeader settings / 页面头部设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  backgroundVideo: '', // Video path in /public / 背景视频，放在 /public
  backgroundImage: '', // Image path in /public / 背景图片，放在 /public
  backgroundColor: '', // Background color; empty = theme / 背景颜色，空=跟随主题
  backgroundFixed: false, // Fixed background inside section / 背景在区域内固定
  backgroundOverlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  contentVerticalAlign: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  contentHorizontalAlign: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  divider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
}
---

<DefaultLayout
  title="Blog"
  description="Insights, tutorials, and thoughts on web development, accessibility, and design."
>
  <PaloPageHeader
    title="Blog"
    subtitle="Latest articles on web development, accessibility, and design best practices."
    {...pageHeaderAppearance}
  />

  <section class="my-12">
    <div class="container">
      <p class="text-sm"><em>Post {page.start + 1} through {page.end} of {page.total} total posts</em></p>
      <ul class="my-8 grid grid-cols-1 gap-24">
        {
          page.data.map((post, index) => {
            const featuredImage = resolveCollectionCoverImage(
              post.coverImage,
              post.id,
              'posts',
              getPostDefaultImage(),
            )

            return (
              <li>
                <PostCard
                  image={featuredImage}
                  imageRatio={coverImageRatio}
                  url={ensureTrailingSlash('/blog/' + post.id)}
                  title={post.title}
                  footer={post.author}
                >
                  {post.description}
                </PostCard>
              </li>
            )
          })
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? ensureTrailingSlash('/blog') : null}
              previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
              nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
              lastPage={page.url.next ? ensureTrailingSlash(`/blog/${page.lastPage}`) : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Blog pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
