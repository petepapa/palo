---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import { Card, Pagination } from 'accessible-astro-components'
import type { PaginateFunction, Page } from 'astro'
import { BLOG_API_URL } from 'astro:env/server'
import type { ImageMetadata } from 'astro'
import { slugify } from '@utils/slugify'
import { ensureTrailingSlash } from '@utils/trailingSlash'

// Import images directly for optimization
import postImage1 from '@assets/images/posts/post-image-1.png'
import postImage2 from '@assets/images/posts/post-image-2.png'
import postImage3 from '@assets/images/posts/post-image-3.png'
import postImage4 from '@assets/images/posts/post-image-4.png'
import postImage5 from '@assets/images/posts/post-image-5.png'
import postImage6 from '@assets/images/posts/post-image-6.png'

interface ApiPost {
  id: number
  userId: number
  title: string
  body: string
}

interface Post extends ApiPost {
  featuredImage: ImageMetadata
  shortUrl: string
}

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  if (!BLOG_API_URL) {
    console.warn('BLOG_API_URL not set; skipping blog generation.')
    return []
  }
  let data: ApiPost[] = []
  try {
    const response = await fetch(BLOG_API_URL)
    if (!response.ok) {
      console.warn(`BLOG_API_URL returned ${response.status}`)
      return []
    }
    data = (await response.json()) as ApiPost[]
  } catch (error) {
    console.warn('Failed to fetch blog posts', error)
    return []
  }

  const postImages = [postImage1, postImage2, postImage3, postImage4, postImage5, postImage6]

  function truncateTitle(title: string) {
    const words = title.split(' ')
    const truncated = words.slice(0, 4).join(' ')
    return truncated
  }

  // Limit to the first 30 posts for demo purposes
  const postsWithImages = data.slice(0, 30).map((post) => {
    const truncatedTitle = truncateTitle(post.title)
    return {
      ...post,
      featuredImage: postImages[post.id % postImages.length],
      title: truncatedTitle,
      shortUrl: slugify(truncatedTitle),
    }
  })

  return paginate(postsWithImages, { pageSize: 6 })
}

interface Props {
  page: Page<Post>
}

const { page } = Astro.props as Props

// PaloPageHeader settings / 页面头部设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  backgroundVideo: '', // Video path in /public / 背景视频，放在 /public
  backgroundImage: '', // Image path in /public / 背景图片，放在 /public
  backgroundColor: '', // Background color; empty = theme / 背景颜色，空=跟随主题
  backgroundFixed: false, // Fixed background inside section / 背景在区域内固定
  backgroundOverlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  paddingBlock: '', // Vertical padding token or CSS value / 上下内边距 token 或 CSS 值
  contentVerticalAlign: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  contentHorizontalAlign: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  showDivider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
}
---

<DefaultLayout
  title="Blog"
  description="An example of a blog with dynamic content fetched from JSONPlaceholder using the title, body and userId."
>
  <PaloPageHeader
    title="Blog"
    subtitle='An example of a blog with dynamic content fetched from <a href="https://jsonplaceholder.typicode.com/posts">JSONPlaceholder</a> using the title, body and userId. The Accessible Astro Card Component is used here to display al the posts.'
    {...pageHeaderAppearance}
  />

  <section class="my-12">
    <div class="container">
      <p class="text-sm"><em>Post {page.start + 1} through {page.end + 1} of {page.total} total posts</em></p>
      <ul class="my-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((post) => (
            <li>
              <Card
                imageComponent={post.featuredImage}
                url={ensureTrailingSlash('/blog/' + post.shortUrl)}
                title={post.title}
                headingLevel="h2"
                footer={'userId:' + post.userId}
                fullHeight={true}
              >
                {post.body}
              </Card>
            </li>
          ))
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? ensureTrailingSlash('/blog') : null}
              previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
              nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
              lastPage={page.url.next ? ensureTrailingSlash(`/blog/${page.lastPage}`) : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Blog pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
