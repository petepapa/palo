---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import PostCard from '@components/PostCard.astro'
import { Heading, Link, Pagination } from 'accessible-astro-components'
import type { PaginateFunction } from 'astro'
import { getCollection } from 'astro:content'
import { getPostDefaultImage, resolveCollectionCoverImage } from '@utils/contentImages'
import { ensureTrailingSlash } from '@utils/trailingSlash'
import { slugify } from '@utils/slugify'
import { BLOG_PAGE_SIZE, BLOG_SORT_BY } from '@utils/blogConfig'

// =========================================================================
// 🎛️ 中央控制台 / Central Page Configuration
// =========================================================================
const COVER_IMAGE_RATIO = '8 / 5'

const pageConfig = {
  // ── 文案与 SEO / Copywriting & SEO ──
  title: 'Blog',
  subtitle: 'Latest articles on web development, accessibility, and design best practices.',
  metaTitle: '',        // 选填。留空则自动复用 title
  metaDescription: 'Insights, tutorials, and thoughts on web development, accessibility, and design.',

  // ── 功能开关中心 / Feature Toggles ──
  showTags: true,       // 是否启用顶部 Tag 标签筛选功能
  showStats: true,      // 是否显示文章统计信息

  // ── 列表排版参数 / List Layout Settings ──
  itemGap: 'gap-24',    // PostCard 之间的垂直间距 (Tailwind Gap Class)
  cardGap: 'gap-12 md:gap-24', // PostCard 内部图片与文字区块之间的间距 (透传给 PostCard)

  // ── 细粒度排版微调 / Typography Fine-Tuning ──
  tagsHeading: 'h5',    // Tags 区域标题的 HTML 标签级别与字号样式
  postHeadingLevel: 'h3', // PostCard 标题的 HTML 标签级别
  postDescClass: 'text-md', // PostCard 摘要文字的 CSS Class
} as const

// ── PaloPageHeader 结构化参数 (对齐大一统新规范) ──
const pageHeader = {
  fullscreen: false,
  contentColor: '',
  topNavigationTheme: '',
  alignV: '',
  alignH: '',
  divider: true,
  bg: {
    video: '',
    image: '',
    color: '',
    fixed: false,
    overlayOpacity: 0,
  },
} as const

// =========================================================================
// 📦 数据引擎与沙盒分页 / Data Fetching & Sandbox Pagination
// =========================================================================
export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft)

  // 双轴排序引擎：精选置顶 (featuredOrder 升序) + BLOG_SORT_BY 时间轴兜底
  const featured = posts.filter((p) => p.data.featuredOrder !== undefined)
  const regular = posts.filter((p) => p.data.featuredOrder === undefined)

  featured.sort((a, b) => (a.data.featuredOrder ?? Infinity) - (b.data.featuredOrder ?? Infinity))

  if (BLOG_SORT_BY === 'latest') {
    regular.sort((a, b) => (b.data.publishDate?.valueOf() || 0) - (a.data.publishDate?.valueOf() || 0))
  } else {
    regular.sort((a, b) => (a.data.publishDate?.valueOf() || 0) - (b.data.publishDate?.valueOf() || 0))
  }

  const sortedPosts = [...featured, ...regular]

  const postsWithImages = sortedPosts.map((post) => {
    const { author: originalAuthor, ...rest } = post.data
    const author = typeof originalAuthor === 'object' ? originalAuthor.name : originalAuthor
    return {
      ...rest,
      id: post.id,
      author,
      tags: rest.tags ?? [],
      coverImage: post.data.coverImage,
    }
  })

  return paginate(postsWithImages, { pageSize: BLOG_PAGE_SIZE })
}

// 类型由 getStaticPaths 返回值自动推断，无需手写 interface Post
const { page } = Astro.props

const resolvedMetaTitle = pageConfig.metaTitle || pageConfig.title

// 💡 仅在开启 showTags 时才在服务器端计算 Tags 集合，彻底避免不必要的性能损耗与沙盒隔离隐患
let uniqueTags: Array<{ label: string; slug: string }> = []
if (pageConfig.showTags) {
  const allPosts = (await getCollection('posts')).filter((p) => !p.data.draft)
  uniqueTags = [...new Set(allPosts.map((p) => p.data.tags).flat())]
    .filter(Boolean)
    .sort((a, b) => a.localeCompare(b))
    .map((label) => ({ label, slug: slugify(label) }))
}
---

<DefaultLayout title={resolvedMetaTitle} description={pageConfig.metaDescription}>
  <PaloPageHeader
    title={pageConfig.title}
    subtitle={pageConfig.subtitle}
    {...pageHeader}
  />

  <section class="my-12">
    <div class="container">
      {pageConfig.showTags && uniqueTags.length > 0 && (
        <div class="tags-filter mb-8">
          <Heading level={pageConfig.tagsHeading} size={pageConfig.tagsHeading} class="mb-3">Tags</Heading>
          <div class="flex flex-wrap gap-4">
            <Link href={ensureTrailingSlash('/blog')}>All</Link>
            {uniqueTags.map((tag) => (
              <Link href={ensureTrailingSlash('/blog/tag/' + tag.slug)}>{tag.label}</Link>
            ))}
          </div>
        </div>
      )}

      {pageConfig.showStats && (
        <p class="mb-6 text-sm text-neutral-500 italic">
          <em>Post {page.start + 1} through {page.end} of {page.total} total posts · Page {page.currentPage} of {page.lastPage}</em>
        </p>
      )}

      <ul class={['my-8 grid grid-cols-1', pageConfig.itemGap].join(' ')}>
        {
          page.data.map((post) => {
            const featuredImage = resolveCollectionCoverImage(
              post.coverImage,
              post.id,
              'posts',
              getPostDefaultImage(),
            )

            return (
              <li>
                <PostCard
                  image={featuredImage}
                  imageRatio={COVER_IMAGE_RATIO}
                  url={ensureTrailingSlash('/blog/' + post.id)}
                  title={post.title}
                  footer={post.author}
                  headingLevel={pageConfig.postHeadingLevel}
                  cardGap={pageConfig.cardGap}
                  descriptionClass={pageConfig.postDescClass}
                >
                  {post.description}
                </PostCard>
              </li>
            )
          })
        }
      </ul>

      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? ensureTrailingSlash('/blog') : null}
              previousPage={page.url.prev ? ensureTrailingSlash(page.url.prev) : null}
              nextPage={page.url.next ? ensureTrailingSlash(page.url.next) : null}
              lastPage={page.url.next ? ensureTrailingSlash(`/blog/${page.lastPage}`) : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Blog pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>