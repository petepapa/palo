---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import { Notification } from 'accessible-astro-components'

// PaloPageHeader settings / 页面头部设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  backgroundVideo: '', // Video path in /public / 背景视频，放在 /public
  backgroundImage: '', // Image path in /public / 背景图片，放在 /public
  backgroundColor: '', // Background color; empty = theme / 背景颜色，空=跟随主题
  backgroundFixed: false, // Fixed background inside section / 背景在区域内固定
  backgroundOverlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  paddingBlock: '', // Vertical padding token or CSS value / 上下内边距 token 或 CSS 值
  contentVerticalAlign: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  contentHorizontalAlign: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  showDivider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
}
---

<DefaultLayout title="Accessible launcher">
  <PaloPageHeader
    title="Accessible launcher"
    subtitle="This theme includes the Accessible Astro Launcher component from the <a href='https://github.com/incluud/accessible-astro-launcher'>Accessible Astro Launcher</a> NPM package to accelerate accessible development. For detailed documentation and usage examples, visit our <a href='https://accessible-astro-launcher.incluud.dev/'>documentation website</a>."
    {...pageHeaderAppearance}
  />
  <section class="mt-32 mb-12">
    <div class="narrow container">
      <Notification type="info" variant="accent">
        <p>
          Try the Accessible Astro Launcher component by pressing <kbd class="kbd">Cmd + K</kbd> (Mac) or <kbd
            class="kbd">Ctrl + K</kbd
          > (Windows/Linux). The Launcher will open a dialog with a search input and a list of items. The search input is
          automatically focused when the dialog opens.
        </p>
      </Notification>
    </div>
  </section>
</DefaultLayout>
