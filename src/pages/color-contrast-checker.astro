---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PaloPageHeader from '@components/PaloPageHeader.astro'
import ColorContrastComponent from '@components/ColorContrast.astro'
import { Heading } from 'accessible-astro-components'

// PaloPageHeader settings / 页面头部设置
const pageHeaderAppearance = {
  fullscreen: false, // Fill viewport / 撑满屏幕
  contentColor: '', // Text color; empty = theme / 内容颜色，空=跟随主题
  backgroundVideo: '', // Video path in /public / 背景视频，放在 /public
  backgroundImage: '', // Image path in /public / 背景图片，放在 /public
  backgroundColor: '', // Background color; empty = theme / 背景颜色，空=跟随主题
  backgroundFixed: false, // Fixed background inside section / 背景在区域内固定
  backgroundOverlayOpacity: 0, // Overlay opacity 0-1 / 遮罩透明度 0-1
  topNavigationTheme: '', // '' | dark | light / 顶部导航主题
  paddingBlock: '', // Vertical padding token or CSS value / 上下内边距 token 或 CSS 值
  contentVerticalAlign: '', // top | center | bottom; empty = center / 垂直位置，空=居中
  contentHorizontalAlign: '', // left | center | right; empty = left / 水平对齐，空=左对齐
  showDivider: true, // true/empty=bottom; top/both/bottom/false / true或空=下方；上方/上下/下方/false
}
---

<DefaultLayout title="Color Contrast Checker">
  <PaloPageHeader
    title="Color Contrast Checker"
    subtitle="This tool helps you verify which colors in your theme's palette meet the WCAG contrast requirements for accessibility in both light and dark modes."
    {...pageHeaderAppearance}
  />

  <section class="container my-16">
    <div class="space-content">
      <Heading level="h2">Understanding Contrast Ratings</Heading>
      <ul class="flex list-none flex-col gap-2">
        <li><span class="tag excellent">7.0+ AAA</span>Excellent contrast, exceeds WCAG AAA (7:1)</li>
        <li><span class="tag good">4.5+ AA</span>Good contrast, meets WCAG AA for normal text (4.5:1)</li>
        <li><span class="tag fair">3.0+ AA Large</span>Fair contrast, meets WCAG AA for large text only (3:1)</li>
        <li><span class="tag poor">Fail</span>Poor contrast, doesn't meet minimum WCAG requirements</li>
      </ul>
    </div>
  </section>

  <div class="container my-16">
    <ColorContrastComponent />
  </div>

  <style>
  @layer components {
    .tag {
      display: inline-block;
      margin-inline-end: 0.5rem;
      border-radius: var(--radius-xs);
      padding: 0.2rem 0.5rem;
      font-weight: var(--font-weight-accent, 400);
    }

    .excellent {
      background-color: rgb(9, 126, 87);
      color: white;
    }

    .good {
      background-color: rgb(41, 168, 126);
      color: black;
    }

    .fair {
      background-color: rgb(219, 141, 31);
      color: black;
    }

    .poor {
      background-color: rgb(221, 39, 54);
      color: white;
    }
  }
</style>
</DefaultLayout>
