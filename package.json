{
  "name": "palo",
  "description": "A minimalist Astro theme for creative portfolios, blogs, and content-driven artist websites.",
  "version": "0.1.0",
  "author": "Pete Lee",
  "license": "MIT",
  "type": "module",
  "homepage": "https://palo.petepa.com/",
  "scripts": {
    "dev": "node -e \"try{require('node:fs').unlinkSync('node_modules/.astro/data-store.json')}catch(e){}\" && npm run copy-images && astro dev --host 0.0.0.0",
    "dev:legacy": "node scripts/dev-legacy-watch.mjs",
    "start": "node -e \"try{require('node:fs').unlinkSync('node_modules/.astro/data-store.json')}catch(e){}\" && npm run copy-images && astro dev --host 0.0.0.0",
    "build": "npm run generate:contact-config && npm run copy-images && astro build",
    "copy-images": "node scripts/copy-colocated-images.mjs",
    "generate:contact-config": "node scripts/generate-contact-config.mjs",
    "test:slugify": "node --experimental-strip-types --test src/utils/slugify.test.ts",
    "test:contact": "node --experimental-strip-types --test src/utils/contact-email.test.ts",
    "test:contact-request": "node --experimental-strip-types --test src/utils/contact-request.test.ts",
    "test:config": "node --experimental-strip-types --test src/utils/validateConfig.test.ts",
    "test:copy-images": "node --test scripts/copy-colocated-images.test.mjs",
    "preview": "astro preview --host 0.0.0.0"
  },
  "keywords": [
    "astro",
    "astro-component",
    "astro-components",
    "accessible",
    "accessibility",
    "a11y",
    "wcag",
    "responsive",
    "ui-library",
    "theme",
    "portfolio",
    "artist-portfolio",
    "creative-portfolio",
    "content-driven",
    "ui-components",
    "blog",
    "portfolio",
    "palo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petepapa/palo.git"
  },
  "bugs": {
    "url": "https://github.com/petepapa/palo/issues"
  },
  "devDependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/partytown": "^2.1.6",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/mingcute": "^1.2.7",
    "@types/js-yaml": "^4.0.9",
    "@types/opentype.js": "^1.3.10",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "astro": "^6.1.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.4.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sanitize-html": "^2.17.2",
    "sass": "^1.98.0",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@iconify-json/ph": "^1.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "accessible-astro-components": "5.2.0",
    "accessible-astro-launcher": "^2.0.0",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "js-yaml": "^4.1.1",
    "mermaid": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
